@{
    ViewBag.Title = "Delete Entire Requisition";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    .delete-box {
        max-width: 720px;
        margin: 20px auto;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-shadow: 1px 1px 4px #ccc;
        padding: 20px 25px;
    }

        .delete-box h3 {
            margin-top: 0;
            color: #a94442;
            font-weight: 600;
        }

    .info-row {
        margin-bottom: 8px;
        font-size: 14px;
    }

        .info-row label {
            display: inline-block;
            width: 140px;
            font-weight: bold;
            color: #555;
        }

    .danger-zone {
        background: #fdf2f2;
        border: 1px solid #ebccd1;
        padding: 15px;
        border-radius: 4px;
        margin-top: 18px;
    }

    .btn-delete {
        background: #d9534f;
        border-color: #d43f3a;
        color: #fff;
        font-weight: bold;
    }

        .btn-delete:hover {
            background: #c9302c;
            border-color: #ac2925;
            color: #fff;
        }
</style>

<div class="box box-danger box-body" ng-controller="RequisitionDeleteCtrl">
    <div class="box-header with-border bg-red" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">
            Delete Entire Requisition
        </h2>
    </div>

    <div class="delete-box">
        <h3><i class="fa fa-exclamation-triangle"></i> Permanent Delete</h3>
        <p class="text-muted">
            This action will permanently remove the requisition and <strong>all</strong> related data
            (vendor requests, quotations, CS, client quotation, work order, PO, bills, payments, settlements, logs…).
            A log entry will be kept.
        </p>

        <!-- Step 1: Enter ID -->
        <div class="form-group" ng-hide="header">
            <label>Client Requisition ID (only)</label>
            <div class="input-group">
                <input type="text" class="form-control" ng-model="clientReqID"
                       placeholder="e.g. 26111100001" ng-disabled="loading" />
                <span class="input-group-btn">
                    <button class="btn btn-primary" ng-click="load()" ng-disabled="loading || !clientReqID">
                        <i class="fa fa-search"></i> Load
                    </button>
                </span>
            </div>
            <p class="help-block">Delete is allowed only by <code>ClientReqID</code>. Requisition No or Project Name is not accepted.</p>
        </div>

        <!-- Step 2: Confirmation -->
        <div ng-show="header">
            <div class="info-row"><label>ClientReqID:</label> {{header.ClientReqID}}</div>
            <div class="info-row"><label>Requisition No:</label> {{header.ClientReqNo}}</div>
            <div class="info-row"><label>Project / Remarks:</label> {{header.Remarks}}</div>
            <div class="info-row"><label>Client:</label> {{header.ClientName}}</div>
            <div class="info-row"><label>Raised By:</label> {{header.SetByName}} ({{header.SetBy}})</div>
            <div class="info-row"><label>Raised On:</label> {{header.SetOn}}</div>

            <div class="danger-zone">
                <div class="form-group">
                    <label>Delete Reason (optional but recommended)</label>
                    <textarea class="form-control" rows="2" ng-model="deleteReason"
                              placeholder="e.g. Wrong entry / Test data / Duplicate"></textarea>
                </div>

                <div class="checkbox">
                    <label>
                        <input type="checkbox" ng-model="confirmed" />
                        I understand this cannot be undone and I want to permanently delete this requisition.
                    </label>
                </div>

                <button class="btn btn-delete" ng-click="delete()"
                        ng-disabled="!confirmed || loading">
                    <i class="fa fa-trash"></i> Confirm Permanent Delete
                </button>

                <button class="btn btn-default" ng-click="reset()" ng-disabled="loading" style="margin-left:8px;">
                    Cancel
                </button>
            </div>
        </div>

        <div id="mydiv" data-ng-show="loading">
            <div class="overlay">
                <div class="loder">
                    <img src="~/Content/AdminLTE/img/cube.gif" />
                    <span class="text-bold">Processing...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    app.controller('RequisitionDeleteCtrl', ['$scope', '$http', function ($scope, $http) {

        $scope.clientReqID = '';
        $scope.deleteReason = '';
        $scope.header = null;
        $scope.confirmed = false;
        $scope.loading = false;

        // ========== AUTO FILL FROM QUERY STRING ==========
        function getQueryParam(name) {
            var url = window.location.href;
            name = name.replace(/[\[\]]/g, '\\$&');
            var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
            var results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, ' '));
        }

        var idFromUrl = getQueryParam('ClientReqID');
        if (idFromUrl) {
            $scope.clientReqID = idFromUrl;          // fills the input box

            // Optional: automatically click "Load"
            $scope.$evalAsync(function () {
                $scope.load();
            });
        }
        // ==================================================

        $scope.load = function () {
            if (!$scope.clientReqID) return;

            $scope.loading = true;
            $scope.header = null;
            $scope.confirmed = false;

            $http.post('/RequisitionDelete/GetRequisition', { ClientReqID: $scope.clientReqID })
                .then(function (res) {
                    $scope.loading = false;
                    if (res.data.success) {
                        $scope.header = res.data.data;
                        toastr.info(res.data.msg);
                    } else {
                        toastr.error(res.data.msg || 'Failed to load requisition.');
                    }
                }, function () {
                    $scope.loading = false;
                    toastr.error('Server error while loading.');
                });
        };

        $scope.delete = function () {
            if (!$scope.confirmed || !$scope.header) return;

            if (!confirm('FINAL WARNING\n\nThis will permanently delete requisition ' +
                $scope.header.ClientReqID + ' and ALL related data.\n\nAre you absolutely sure?')) {
                return;
            }

            $scope.loading = true;

            $http.post('/RequisitionDelete/DeleteRequisition', {
                ClientReqID: $scope.header.ClientReqID,
                DeleteReason: $scope.deleteReason
            }).then(function (res) {
                $scope.loading = false;
                if (res.data.success) {
                    toastr.success(res.data.msg);
                    $scope.reset();
                } else {
                    toastr.error(res.data.msg || 'Delete failed.');
                }
            }, function () {
                $scope.loading = false;
                toastr.error('Server error during delete.');
            });
        };

        $scope.reset = function () {
            $scope.clientReqID = '';
            $scope.deleteReason = '';
            $scope.header = null;
            $scope.confirmed = false;
        };
    }]);
</script>