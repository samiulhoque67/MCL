                                                <td class="col-lg-1" style="width:6%;">{{row.TermsName}}</td>


                                            </tr>
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="modal-footer">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div class="form-group">
                </div>
            </div>
        </div>
    </div>















