                        <label>
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Default" ng-disabled="VendorCSInfo.BillType" /> Default
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Installment" ng-disabled="VendorCSInfo.BillType" /> Installment
