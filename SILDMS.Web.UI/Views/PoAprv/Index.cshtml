                        <label>Bill Category:</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.Category" value="Normal" ng-disabled="VendorCSInfo.Category" /> Normal
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.Category" value="PlusMinus" ng-disabled="VendorCSInfo.Category" /> Plus Minus
                        </label>
                    </div>
                </div>


                <div class="col-lg-2">
                    <div class="form-group">
                        <label>Bill Type:</label>
