                            <!-- Line Items -->
                            <div class="row">
                                <div class="col-md-12">
                                    <table st-table="PoPrintCollection" st-safe-src="PoPrintList" style="width:100%;" class="table table-condensed table-bordered table-striped table-hover pnlView">
                                        <thead>

                                            <tr>

                                                <th style="text-align: left;" st-sort="">Line</th>
                                                <th style="text-align: left;" st-sort="">Item Name</th>
                                                <th style="text-align: left;" st-sort="">Description</th>
