                                                <td class="col-lg-1 col-md-2 col-sm-2">{{row.PODate}}</td>

                                            </tr>
                                        </tbody>

                                    </table>
                                    <!-- Total Section -->
                                    @*<div class="flex-container" style="margin-top: 10px;">
                                            <div style="font-weight: bold;">Total (BDT):</div>
                                            <div style="font-weight: bold;">Inword:</div>
                                            <div style="font-weight: bold;">Grand Total (BDT):</div>
                                        </div>*@
                                </div>
                            </div>



                            <div class="row">
                                <div class="col-md-12">
                                    <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData" class="table table-condensed table-bordered table-striped table-hover pnlView">
