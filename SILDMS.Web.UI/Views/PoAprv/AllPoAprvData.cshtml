@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .global-search {
        height: 34px;
    }

    .btn-round {
        border-radius: 17px;
    }

    .box.box-solid.box-primary > .box-header {
        text-align: center;
    }

    .tableVen-striped > tbody > tr:nth-of-type(odd) {
        background-color: rgba(23,250,132,0.01);
    }

    .selected-row {
        background-color: #dff0d8;
    }

    /* mode badge */
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-list {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-view {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    /* readonly field */
    .input-readonly {
        background-color: #ffffff !important;
        cursor: default;
    }

    /* info bar */
    .po-info-box {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px 14px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .po-info-box strong {
            color: #31708f;
        }

    /* ── Print slip styles ── */
    #masterRow {
        position: relative;
    }
</style>

<div class="box box-primary box-body" ng-controller="PoAprvCtrl">

    <!-- ══════════════════════════════════════════════════════════════
         TOOLBAR
         ══════════════════════════════════════════════════════════════ -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;border-radius:5px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            All Purchase Order Approved Data
            <span ng-show="p===2" class="mode-badge mode-list">PO LIST</span>
            <span ng-show="p===1" class="mode-badge mode-view">Print</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="btn-group pull-right" style="margin:4px;">
                <button class="button-custom btn-warning" type="button"
                        data-ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                    <i class="fa fa-refresh"></i> Refresh
                </button>
            </div>

            <!-- Print Button - Only visible in Detail View -->
            <div class="btn-group pull-right" style="margin:4px;" ng-show="p===1">
                <button class="button-custom btn-primary" type="button"
                        ng-click="printCurrentPO()">
                    <i class="fa fa-print"></i> Print PO
                </button>
            </div>

            <!-- Back Button -->
            <div class="btn-group pull-right" style="margin:4px;" ng-show="p===1">
                <button class="button-custom btn-default" type="button"
                        ng-click="goBackToList()">
                    <i class="fa fa-arrow-left"></i> Back
                </button>
            </div>
        </div>
    </div>


    <!-- ══════════════════════════════════════════════════════════════
         p === 2  →  PO RECOMMENDATION LIST
         ══════════════════════════════════════════════════════════════ -->
    <div ng-show="p===2">
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888888;padding:5px 10px;">

            <div ng-show="CSClientDisplayedCollection.length <= 0"
                 style="text-align:center;padding:20px;">
                <h4 style="color:red;">No PO Recommendation available for approval!</h4>
            </div>

            <div ng-show="CSClientDisplayedCollection.length > 0"
                 class="row" style="padding:11px;margin-right:15px;margin-left:15px;">

                <div style="background-color:#cbd4d9;padding:0.7%;border-radius:4px;
                            font-size:15px;font-weight:bold;margin-bottom:6px;">
                    PO Approve List
                </div>

                <table st-table="CSClientDisplayedCollection" st-safe-src="CSClientList"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped
                              table-hover pnlView">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th class="col-lg-2">PO Recom ID</th>
                            <th class="col-lg-3">Client Name</th>
                            <th class="col-lg-2">Requisition No</th>
                            <th class="col-lg-2">Requisition Date</th>
                            <th class="col-lg-2">Vendor Name</th>
                            <th class="col-lg-1">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in CSClientDisplayedCollection"
                            style="height:20px;font-size:13px;">
                            <td class="hidden">{{row.ClientID}}</td>
                            <td class="col-lg-2 text-left">{{row.PORecmID}}</td>
                            <td class="col-lg-3 text-left">{{row.ClientName}}</td>
                            <td class="col-lg-2 text-left">{{row.ClientReqNo}}</td>
                            <td class="col-lg-2 text-center">{{row.RequisitionDate}}</td>
                            <td class="col-lg-2 text-center">{{row.VendorName}}</td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-flat btn-primary"
                                        ng-click="openDetail(row)">
                                    <i class="fa fa-eye"></i> Details
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage"
                                     st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div><!-- /p===2 -->
    <!-- ══════════════════════════════════════════════════════════════
         p === 1  →  DETAIL / SAVE VIEW
         ══════════════════════════════════════════════════════════════ -->
    <div ng-show="p===1">

        <!-- Summary bar -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box">
                    <div class="row">
                        <div class="col-lg-3">
                            <strong>PO No:</strong>&nbsp;{{VendorCSInfo.AutoPoNo}}
                        </div>
                        <div class="col-lg-3">
                            <strong>Client:</strong>&nbsp;{{VendorCSInfo.ClientName}}
                        </div>
                        <div class="col-lg-3">
                            <strong>Vendor:</strong>&nbsp;{{VendorCSInfo.VendorName}}
                        </div>
                        <div class="col-lg-3">
                            <strong>Recom Date:</strong>&nbsp;{{VendorCSInfo.CSRecDate}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item grid — all readonly -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="VenCSItemGridDisplayCollection" st-safe-src="VenCSItemList"
                       style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped
                              table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="12" style="text-align:left;color:black;font-weight:100;
                                                   font-family:math;background:#fff;
                                                   border:1px solid #3003eb;">
                                Item List
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Item Name</th>
                            <th style="text-align:right;">QutnQnty</th>
                            <th>Unit</th>
                            <th style="text-align:right;">QutnPrice</th>
                            <th style="text-align:right;">QutnAmt</th>
                            <th style="text-align:right;">POQnty</th>
                            <th style="text-align:right;">PoPrice</th>
                            <th style="text-align:right;">PoAmt</th>
                            <th style="text-align:right;">Vat%</th>
                            <th style="text-align:right;">VatAmt</th>
                            <th style="text-align:right;">PoVatAmt</th>
                            <th style="text-align:right;">PoTotalAmt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in VenCSItemGridDisplayCollection"
                            ng-cloak style="font-size:12px;">
                            <td>{{row.ServiceItemName}}</td>
                            <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>
                            <td>{{row.QutnUnit}}</td>
                            <td style="text-align:right;">{{row.QutnPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.QutnAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.NegoQty | number:2}}</td>
                            <td style="text-align:right;">{{row.NegoPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.NegoAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.VatPerc | number:2}}</td>
                            <td style="text-align:right;">{{row.VatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.NegoVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.NegoTolAmt | number:2}}</td>
                        </tr>
                        <tr ng-if="VenCSItemGridDisplayCollection.length === 0">
                            <td colspan="12" class="text-center text-danger">
                                No items available
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="12" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage"
                                     st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Approval Form -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888888;padding:10px;">

            <!-- Row 1: Bill Category + Bill Type (readonly) -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Bill Category:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Category" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>Bill Type:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.BillType" ng-readonly="true" />
                </div>
            </div>

            <!-- Row 2: Installment (conditional, readonly) -->
            <div class="row" style="margin-bottom:8px;"
                 ng-show="VendorCSInfo.BillType === 'Installment'">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Installment:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Installment" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>Installment Amount:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.InstalledAmount" ng-readonly="true" />
                </div>
            </div>

            <!-- Row 3: PO No (readonly) -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO No:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.AutoPoNo" ng-readonly="true" />
                </div>
            </div>

            <!-- Row 4: PO Amount (readonly) + Approved Amount (editable) -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Amount:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.PoAmount" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>Approved Amount:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control"
                           placeholder="Enter approved amount"
                           ng-model="VendorCSInfo.RecommendedAmount" />
                </div>
            </div>

            <!-- Row 5: PO Date (readonly) + PO Approve Date (editable) -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Date:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.CSRecDate" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>PO Approve Date:</label></div>
                <div class="col-lg-3">
                    <input id="PORecDate" name="PORecDate" type="text"
                           autocomplete="off"
                           class="DatePicker form-control" placeholder="DD/MM/YYYY"
                           ng-model="VendorCSInfo.PORecDate" />
                </div>
            </div>

            <!-- Row 6: Approved By + Note -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Approved By:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control"
                           placeholder="Approved By"
                           ng-model="VendorCSInfo.RecommendedBy" />
                </div>
                <div class="col-lg-2"><label>Note:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control"
                           placeholder="Note for approval"
                           ng-model="VendorCSInfo.AprvRemarks" />
                </div>
            </div>

        </div>

        <!-- Terms table -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888888;padding:5px 10px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqTermGridDisplayCollection"
                       st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped
                              table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="2" style="text-align:left;color:black;font-weight:100;
                                                   font-family:math;background:#fff;
                                                   border:1px solid #3003eb;">
                                Terms &amp; Conditions
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="width:10%;">Terms Code</th>
                            <th style="width:90%;">Terms &amp; Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection"
                            ng-cloak style="font-size:12px;">
                            <td>{{row.TermsCode}}</td>
                            <td>{{row.TermsName}}</td>
                        </tr>
                        <tr ng-if="ReqTermGridDisplayCollection.length === 0">
                            <td colspan="2" class="text-center text-muted">
                                No terms available
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /p===1 -->
    <!-- ══════════════════════════════════════════════════════════════
         PRINT SLIP  (hidden div, rendered into iframe on print)
         ══════════════════════════════════════════════════════════════ -->
    <div id="masterRow" style="display:none;">
        <div class="row">
            <p style="font-weight:bold;font-size:22px;text-align:center;">
                Purchase Order
            </p>
        </div>
        <div class="row">
            <!-- Left: company + supplier -->
            <div class="col-md-5">
                <div>
                    <img src="../../Content/AdminLTE/img/mediacom-logomini.png"
                         style="height:20px;margin-left:-35px;" />
                    <p style="font-weight:bold;margin:0;">MEDIACOM LIMITED</p>
                    <p style="margin:0;">SAMSON CENTER</p>
                    <p style="margin:0;">Levels - 5 to 7</p>
                    <p style="margin:0;">43 South Avenue, Road-126, Plot-CES (G) 5A,</p>
                    <p style="margin:0;">Gulshan 1, Dhaka – 1212</p>
                    <p style="margin:5px 0;color:orangered;font-weight:bold;">
                        IP No. 09610939393 extn: 1200/1205<br />
                        email: mediacombd.com, www.mediacombd.com
                    </p>
                </div>
                <br />
                <div>
                    <p style="font-weight:bold;margin:0;">Corporate Headquarters</p>
                    <p style="margin:0;">SQUARE CENTRE</p>
                    <p style="margin:0;">48, Mohakhali C/A, Dhaka – 1212</p>
                </div>
                <br />
                <div>
                    <p style="font-weight:bold;">Supplier Information</p>
                    <br />
                    <table>
                        <tr>
                            <td style="font-weight:bold;">Supplier No.:</td>
                            <td>{{VendorCSInfo.VendorID}}</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Name:</td>
                            <td>{{VendorCSInfo.VendorName}}</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Address:</td>
                            <td>{{VendorCSInfo.VendorAddress}}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Middle: PO metadata -->
            <div class="col-md-3">
                <table style="width:100%;border-collapse:collapse;font-size:smaller;margin-top:10px;">
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">PO Number:</td>
                        <td style="border:1px solid #000;padding:5px;">{{VendorCSInfo.PONo}}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">Revision:</td>
                        <td style="border:1px solid #000;padding:5px;">-</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">Created by:</td>
                        <td style="border:1px solid #000;padding:5px;">-</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">PR No:</td>
                        <td style="border:1px solid #000;padding:5px;">-</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">WO Ref:</td>
                        <td style="border:1px solid #000;padding:5px;">{{VendorCSInfo.WIInfoID}}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;border:1px solid #000;padding:5px;">PO Hand over date:</td>
                        <td style="border:1px solid #000;padding:5px;">{{VendorCSInfo.PODate}}</td>
                    </tr>
                </table>
            </div>

            <!-- Right: ship/bill info -->
            <div class="col-md-4">
                <table style="width:100%;border-collapse:collapse;">
                    <tr>
                        <td style="font-weight:bold;padding:8px;">Ship To:</td>
                        <td style="padding:8px;">SAMSON CENTER</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;padding:8px;">Bill To:</td>
                        <td style="padding:8px;">SAMSON CENTER</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;padding:8px;">Requester:</td>
                        <td style="padding:8px;">Sumon kumar paul</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;padding:8px;">Confirm To:</td>
                        <td style="padding:8px;">Vendor/supplier</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;padding:8px;">Task Name:</td>
                        <td style="padding:8px;">Printing</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Line items -->
        <div class="row">
            <div class="col-md-12">
                <table st-table="PoPrintCollection" st-safe-src="PoPrintList"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped
                              table-hover pnlView">
                    <thead>
                        <tr>
                            <th>Line</th>
                            <th>Item Name</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Amount</th>
                            <th>Vat</th>
                            <th>Agreed Delivery Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in PoPrintCollection" ng-cloak style="font-size:12px;">
                            <td>{{$index + 1}}</td>
                            <td>{{row.ServiceItemName}}</td>
                            <td>{{row.Description}}</td>
                            <td>{{row.ReqUnit}}</td>
                            <td>{{row.NegoPrice | number:2}}</td>
                            <td>{{row.NegoQty | number:2}}</td>
                            <td>{{row.NegoAmt | number:2}}</td>
                            <td>{{row.NegoVatAmt | number:2}}</td>
                            <td>{{row.PODate}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Terms in print -->
        <div class="row">
            <div class="col-md-12">
                <table st-table="ReqTermGridDisplayCollection"
                       st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped
                              table-hover pnlView">
                    <thead>
                        <tr>
                            <th>Terms Code</th>
                            <th>Terms &amp; Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection"
                            ng-cloak style="font-size:12px;">
                            <td>{{row.TermsCode}}</td>
                            <td>{{row.TermsName}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div><!-- /masterRow -->
    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div><!-- /box -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script type="text/javascript">

    /* ── Datepicker ─────────────────────────────────────────────── */
    $(document).ready(function () {
        var t = new Date();
        var tod = String(t.getDate()).padStart(2, '0') + '/' +
            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
        $('#PORecDate').val(tod);
    });

    /* ══════════════════════════════════════════════════════════════
       Angular Controller
       ══════════════════════════════════════════════════════════════ */
    app.controller('PoAprvCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            /* ── State ─────────────────────────────────────────────── */
            $scope.itemsByPage = 10;
            $scope.loading = false;
            $scope.isSaving = false;
            $scope.isRefreshing = false;
            $scope.p = 2;   // 2 = list,  1 = detail/save

            /* ── Collections ────────────────────────────────────────── */
            $scope.CSClientList = [];
            $scope.CSClientDisplayedCollection = [];
            $scope.VenCSItemList = [];
            $scope.VenCSItemGridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.PoPrintList = [];
            $scope.PoPrintCollection = [];

            /* ── Model ──────────────────────────────────────────────── */
            function emptyInfo() {
                return {
                    PoAprvID: "",   // set after first save (for S201→S202 detection)
                    POPreparationID: "",
                    PORecmID: "",
                    ClientID: "",
                    ClientName: "",
                    ClientReqID: "",
                    VendorID: "",
                    VendorName: "",
                    VendorAddress: "",
                    AutoPoNo: "",
                    PONo: "",
                    WIInfoID: "",
                    CSRecDate: "",   // Recom date (readonly)
                    PORecDate: "",   // Approval date (editable)
                    PODate: "",   // used in print slip
                    PoAmount: "",   // readonly
                    RecommendedAmount: "",   // editable → approved amount
                    BillType: "",
                    Category: "",
                    Installment: "",
                    InstalledAmount: "",
                    RecommendedBy: "",   // editable → approved by
                    Remarks: "",   // original note (readonly)
                    AprvRemarks: "",   // new approval note
                    SetBy: ""
                };
            }
            $scope.VendorCSInfo = emptyInfo();

            /* ── Initial load ─────────────────────────────────────── */
            $scope.loading = true;
            $http.post("/PoAprv/GetPoAprvClientInfo_Saved/")
                .then(function (res) {
                    $scope.CSClientList = res.data.CSClientList || [];
                    $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load PO recommendation list.");
                });

            /* ── Open detail from list ──────────────────────────────── */
            $scope.openDetail = function (row) {
                $scope.loading = true;
                $scope.p = 1;
                $scope.VendorCSInfo = emptyInfo();

                // store keys for save
                $scope.VendorCSInfo.PORecmID = row.PORecmID;
                $scope.VendorCSInfo.POPreparationID = row.POPreparationID;
                $scope.VendorCSInfo.ClientID = row.ClientID;
                $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
                $scope.VendorCSInfo.VendorID = row.VendorID;
                $scope.VendorCSInfo.ClientName = row.ClientName;
                $scope.VendorCSInfo.VendorName = row.VendorName;
                $scope.VendorCSInfo.RecommendedAmount = row.ApprovedAmount;
                $scope.VendorCSInfo.AprvRemarks = row.AprvRemarks;

                // default today for approval date
                $timeout(function () {
                    var t = new Date();
                    var tod = String(t.getDate()).padStart(2, '0') + '/' +
                        String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
                    $('#PORecDate').val(tod);
                    $scope.VendorCSInfo.PORecDate = tod;

                    $('#PORecDate').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                        .off('changeDate.aprv')
                        .on('changeDate.aprv', function (ev) {
                            $scope.$apply(function () {
                                $scope.VendorCSInfo.PORecDate = $(ev.target).val();
                            });
                            $('.datepicker').hide();
                        });
                }, 100);

                // load items
                $http.post("/PoAprv/GetVendorPOAprvQuotationItem", {
                    VendorID: row.VendorID,
                    ClientID: row.ClientID,
                    PORecmID: row.PORecmID
                }).then(function (res) {
                    var items = res.data.VenCSItemList || [];

                    if (items.length > 0) {
                        var h = items[0];
                        $scope.VendorCSInfo.AutoPoNo = h.PONo || "";
                        $scope.VendorCSInfo.PONo = h.PONo || "";
                        $scope.VendorCSInfo.CSRecDate = h.PODate || "";
                        // PoAmount shows the recommendation amount (readonly reference)
                        // We show the last row's NegoTolAmt total as "PO Amount"
                        var total = 0;
                        items.forEach(function (i) {
                            total += parseFloat(i.NegoTolAmt || 0);
                        });
                        $scope.VendorCSInfo.PoAmount = total.toFixed(2);
                        $scope.VendorCSInfo.BillType = h.BillType || "";
                        $scope.VendorCSInfo.Category = h.BillCategory || "";
                        $scope.VendorCSInfo.Installment = h.Installment || "";
                        $scope.VendorCSInfo.InstalledAmount = h.InstalledAmount !== undefined
                            ? h.InstalledAmount
                            : (h.InstallmentAmt || "");
                        $scope.VendorCSInfo.Remarks = h.Remarks || "";
                        $scope.VendorCSInfo.VendorName = h.VendorName || row.VendorName;
                        $scope.VendorCSInfo.RecommendedBy = h.POCreatedBy || "";
                    }

                    $scope.VenCSItemList = items.map(mapItem);
                    $scope.VenCSItemGridDisplayCollection = [].concat($scope.VenCSItemList);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load items.");
                });

                // load terms
                $http.post('/PoAprv/GetPOAprvInfoTermList', { PORecmID: row.PORecmID })
                    .then(function (res) {
                        $scope.ReqTermDataSetupGridData = res.data.VendorCSInfoTermList || [];
                        $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    }, function () {
                        toastr.error("Failed to load terms.");
                    });
            };

            /* ── Back to list ──────────────────────────────────────── */
            $scope.goBackToList = function () {
                $scope.p = 2;
                $scope.VendorCSInfo = emptyInfo();
                $scope.VenCSItemList = [];
                $scope.VenCSItemGridDisplayCollection = [];
                $scope.ReqTermDataSetupGridData = [];
                $scope.ReqTermGridDisplayCollection = [];
                $scope.PoPrintList = [];
                $scope.PoPrintCollection = [];
            };

            /* ── Item mapping helper ────────────────────────────────── */
            function mapItem(item) {
                item.NegoTolAmt = parseFloat(item.NegoTolAmt || 0).toFixed(2);
                item.NegoAmt = parseFloat(item.NegoAmt || 0).toFixed(2);
                item.NegoVatAmt = parseFloat(item.NegoVatAmt || 0).toFixed(2);
                item.QutnQnty = parseFloat(item.QutnQnty || 0).toFixed(2);
                item.QutnPrice = parseFloat(item.QutnPrice || 0).toFixed(2);
                item.QutnAmt = parseFloat(item.QutnAmt || 0).toFixed(2);
                return item;
            }

            /* ── Save / Post ────────────────────────────────────────── */
            $scope.Post = function () {
                if (!$scope.VendorCSInfo.PORecmID) {
                    toastr.error("No PO Recommendation selected."); return;
                }
                if (!$scope.VendorCSInfo.RecommendedAmount) {
                    toastr.error("Approved Amount is required."); return;
                }
                var aprvDate = $('#PORecDate').val() || $scope.VendorCSInfo.PORecDate;
                if (!aprvDate) {
                    toastr.error("PO Approve Date is required."); return;
                }

                $scope.VendorCSInfo.PORecDate = aprvDate;
                $scope.VendorCSInfo.Remarks = $scope.VendorCSInfo.AprvRemarks;
                $scope.isSaving = true;

                $http.post('/PoAprv/SaveVendorPOAprvInfo', {
                    vendorCS: $scope.VendorCSInfo,
                    vendorCSItem: $scope.VenCSItemGridDisplayCollection,
                    vendorCSTerm: $scope.ReqTermGridDisplayCollection
                }).then(function (res) {
                    $scope.isSaving = false;
                    var s = res.data.status;
                    if (s === 'S201') {
                        toastr.success("PO Approval Saved Successfully.");
                        // load print data then print
                        $scope.PoPrint();
                    } else if (s === 'S202') {
                        toastr.success("PO Approval Updated Successfully.");
                        $scope.toggleRefreshTable();
                    } else {
                        toastr.error("Save Failed. Status: " + (s || "unknown"));
                    }
                }, function () {
                    $scope.isSaving = false;
                    toastr.error("Save Failed.");
                });
            };

            /* ── PoPrint: fetch print data then trigger browser print ── */
            $scope.PoPrint = function () {
                $http.post("/PoAprv/PoPrint", { PORecmID: $scope.VendorCSInfo.PORecmID })
                    .then(function (res) {
                        $scope.PoPrintList = res.data.PoPrintList || [];
                        $scope.PoPrintCollection = [].concat($scope.PoPrintList);

                        if ($scope.PoPrintList.length > 0) {
                            var h = $scope.PoPrintList[0];
                            $scope.VendorCSInfo.VendorID = h.VendorID || "";
                            $scope.VendorCSInfo.VendorName = h.VendorName || "";
                            $scope.VendorCSInfo.VendorAddress = h.VendorAddress || "";
                            $scope.VendorCSInfo.PONo = h.PONo || "";
                            $scope.VendorCSInfo.PODate = h.PODate || "";
                            $scope.VendorCSInfo.WIInfoID = h.WIInfoID || "";
                        }

                        // wait one digest so ng-repeat renders into masterRow,
                        // then show masterRow, print, hide again
                        $timeout(function () {
                            document.getElementById('masterRow').style.display = 'block';
                            $scope.printData();
                            $timeout(function () {
                                document.getElementById('masterRow').style.display = 'none';
                                $scope.toggleRefreshTable();
                            }, 500);
                        }, 200);
                    }, function () {
                        toastr.error("Failed to load print data.");
                        $scope.toggleRefreshTable();
                    });
            };

            /* ── Print Current PO ───────────────────────────────────── */
            $scope.printCurrentPO = function () {
                if (!$scope.VendorCSInfo.PORecmID) {
                    toastr.error("No PO selected for printing.");
                    return;
                }

                $scope.loading = true;

                $http.post("/PoAprv/PoPrint", {
                    PORecmID: $scope.VendorCSInfo.PORecmID
                })
                    .then(function (res) {
                        $scope.PoPrintList = res.data.PoPrintList || [];
                        $scope.PoPrintCollection = [].concat($scope.PoPrintList);

                        // Populate header info
                        if ($scope.PoPrintList.length > 0) {
                            var h = $scope.PoPrintList[0];
                            $scope.VendorCSInfo.VendorID = h.VendorID || "";
                            $scope.VendorCSInfo.VendorName = h.VendorName || "";
                            $scope.VendorCSInfo.VendorAddress = h.VendorAddress || "";
                            $scope.VendorCSInfo.PONo = h.PONo || "";
                            $scope.VendorCSInfo.PODate = h.PODate || "";
                            $scope.VendorCSInfo.WIInfoID = h.WIInfoID || "";
                        }

                        $timeout(function () {
                            document.getElementById('masterRow').style.display = 'block';
                            $scope.printData();

                            $timeout(function () {
                                document.getElementById('masterRow').style.display = 'none';
                                $scope.loading = false;
                            }, 800);
                        }, 300);
                    }, function () {
                        $scope.loading = false;
                        toastr.error("Failed to load print data.");
                    });
            };

            /* ── Actual Print via Iframe ─────────────────────────────── */
            $scope.printData = function () {
                var slip = document.getElementById("masterRow");
                if (!slip) return;

                var iframe = document.createElement('iframe');
                iframe.style.cssText = 'position:absolute;width:0;height:0;border:none;';
                document.body.appendChild(iframe);

                var doc = iframe.contentWindow.document;
                doc.open();
                doc.write('<html><head><title>Purchase Order - ' + ($scope.VendorCSInfo.PONo || '') + '</title>');
                doc.write(`
                    <style>
                        body{font-family:Arial, sans-serif; margin:20px; padding:0;}
                        table{border-collapse:collapse; width:100%; margin:10px 0;}
                        td, th{padding:6px 8px; border:1px solid #555; font-size:12px;}
                        th{background:#f0f0f0;}
                        .row{display:flex; flex-wrap:wrap; justify-content:space-between;}
                        p{margin:3px 0;}
                        .text-center{text-align:center;}
                    </style>
                `);
                doc.write('</head><body>');
                doc.write(slip.outerHTML);
                doc.write('</body></html>');
                doc.close();

                iframe.contentWindow.focus();
                iframe.contentWindow.print();

                // Cleanup
                setTimeout(() => document.body.removeChild(iframe), 1000);
            };

            /* ── Refresh ────────────────────────────────────────────── */
            $scope.toggleRefreshTable = function () {
                $scope.isRefreshing = true;
                $timeout(function () { window.location.reload(); }, 1200);
            };

        }]);
</script>
