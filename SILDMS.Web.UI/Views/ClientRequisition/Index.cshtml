@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header {
        font-size: 12px;
    }

    .btn {
        font-size: 12px;
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }

    input.form-control, button.form-control {
        font-size: 12px;
    }

    label {
        font-size: 12px;
    }

    .fa {
        font-size: 12px;
    }

    .text-success {
        color: green;
        font-size: 14px;
    }

    .text-primary {
        color: blue;
        font-size: 14px;
    }
</style>

<div class="box box-primary box-body" ng-controller="ClientRequisitionCtrl">

    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">Requisition From Client</h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTablemain()" class="button-custom">
                        <i class="fa fa-refresh" style="padding-right: 5px"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="SearchClientReqModal()" class="button-custom">
                        <i class="fa fa-search" style="padding-right: 5px"></i> Search
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Post()" class="button-custom btn-primary"
                            ng-disabled="viewmode">
                        <i class="fa fa-save" style="padding-right: 5px"></i>
                        {{ ClientReq.ClientReqID ? 'Update' : 'Save' }}
                    </button>
                </div>

                @*<div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                        <button type="button" data-ng-click="Post()" class="button-custom" ng-disabled="viewonlymode">
                            <i class="fa fa-save" style="padding-right: 5px"></i> Save
                        </button>
                    </div>*@

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    @* BUG FIX: Cancel() function was missing entirely *@
                    <button type="button" data-ng-click="Cancel()" class="button-custom">
                        <i class="fa fa-times" style="padding-right: 5px"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body" style="margin: 1%; padding: 5px;">
        <div class="row">
            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="ClientName">Client Name :</label>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    <div style="position: relative;">
                        <input id="ClientName" name="ClientName" type="text" data-ng-model="ClientReq.ClientName"
                               class="form-control" ng-readonly="true"
                               placeholder="Client Name"
                               style="height: 25px; font-size: smaller;" />
                        <button type="button" data-ng-click="ShowClientList()" ng-hide="viewonlymode"
                                style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                       padding: 0px 10px; border: 2px solid black; background: transparent;">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="RequisitionDate">Requisition Date:</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input ng-readonly="viewonlymode == true" id="RequisitionDate" name="RequisitionDate"
                               type="text" autocomplete="off" class="DatePicker form-control"
                               placeholder="DD/MM/YYYY" ng-model="ClientReq.RequisitionDate" />
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="form-group">
                        <label>Client Requisition No.</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input ng-readonly="viewonlymode == true" id="ClientReqNo" name="ClientReqNo"
                               type="text" autocomplete="off" class="form-control"
                               placeholder="Client Requisition No" ng-model="ClientReq.ClientReqNo" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="Remarks">Project Name :</label>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="form-group">
                        <textarea ng-readonly="viewonlymode == true" id="Remarks" name="Remarks"
                                  data-ng-model="ClientReq.Remarks" class="form-control"
                                  placeholder="Project Name"></textarea>
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="upload_documents">
                            Upload Documents <br>
                            (<span style="color:#ff4900;">PDF Only, Max Size 2MB</span>)
                        </label>
                    </div>
                </div>

                <!-- Show file input only when NOT in view mode -->
                <div ng-hide="viewonlymode" class="col-lg-2">
                    <div class="form-group">
                        <input type="file"
                               style="height:25px; float:left; margin-top:5px;"
                               id="FileUpload1"
                               accept=".pdf"
                               ng-model="uploadedFile"
                               onchange="angular.element(this).scope().fileSelected(this)" />
                    </div>
                </div>

                <!-- View section -->
                <div ng-hide="viewonlymode" class="col-lg-2">
                    <!-- View button -->
                    <button ng-show="ClientReq.DocumentID"
                            ng-click="ViewDocument()"
                            class="btn button-custom btn-sm">
                        <i class="fa fa-eye"></i> View
                    </button>

                </div>

                <div ng-show="viewonlymode" class="col-lg-5">
                    <div class="form-group" style="display:flex; gap:8px; align-items:center;">


                        <!-- View button — only when a document exists -->
                        <button ng-show="ClientReq.DocumentID"
                                ng-click="ViewDocument()"
                                class="btn button-custom btn-sm">
                            <i class="fa fa-eye"></i> View
                        </button>

                        <span ng-hide="ClientReq.DocumentID"
                              style="color:#999; font-size:11px;">No document attached</span>
                    </div>
                </div>

            </div>


        </div>
    </div>

    @* ==================== CLIENT INFO MODAL ====================*@
    <div id="ClientInfoModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" ng-click="ResetSearchModel()"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="ClientDisplayedCollection" st-safe-src="ClientList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Client Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-1" data-ng-click="sort('ClientCode')">Client Code</th>
                                <th class="col-lg-1" data-ng-click="sort('ClientName')">Client Name</th>
                                <th class="col-lg-1" data-ng-click="sort('ContactPerson')">Contact Person</th>
                                <th class="col-lg-1" data-ng-click="sort('ContactNumber')">Contact Number</th>
                                <th class="col-lg-1" data-ng-click="sort('Address')">Address</th>
                                <th class="col-lg-1" data-ng-click="sort('Status')">Status</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientCode" placeholder="Client Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in ClientDisplayedCollection">
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="text-center">{{row.ClientCode}}</td>
                                <td class="text-center">{{row.ClientName}}</td>
                                <td class="hidden">{{row.ClientCategoryID}}</td>
                                <td class="text-center">{{row.ContactPerson}}</td>
                                <td class="text-center">{{row.ContactNumber}}</td>
                                <td class="hidden">{{row.ClientAddressID}}</td>
                                <td class="text-center">{{row.Address}}</td>
                                <td class="text-center">
                                    <span ng-attr-class="{{row.Status=='1' ? 'label label-success' : 'label label-danger'}}">
                                        {{row.Status == '1' ? 'Active' : 'InActive'}}
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleClientSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ==================== SEARCH CLIENT REQ MODAL ====================*@
    <div id="SearchClientReqModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="clientReqDisplayedCollection" st-safe-src="clientReqSearchList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Client Requisition List
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-3" data-ng-click="sort('ClientName')">Client Name</th>
                                <th class="col-lg-1" data-ng-click="sort('Remarks')">Project Name</th>
                                <th class="col-lg-3" data-ng-click="sort('ClientReqNo')">Requisition No</th>
                                <th class="col-lg-1" data-ng-click="sort('RequisitionDate')">Requisition Date</th>
                                @*<th class="col-lg-1" data-ng-click="sort('SubmissionDate')">Submission Date</th>
                                    <th class="col-lg-1" data-ng-click="sort('Status')">Status</th>*@
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="Remarks" placeholder="Project Name" class="input-sm form-control" type="search" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in clientReqDisplayedCollection">
                                <td class="hidden">{{row.ClientReqID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="hidden">{{row.ProcessStatus}}</td>
                                <td class="text-left">{{row.ClientName}}</td>
                                <td class="text-left">{{row.Remarks}}</td>
                                <td class="text-left">{{row.ClientReqNo}}</td>
                                <td class="text-center">{{row.RequisitionDate}}</td>
                                @*<td class="text-center">{{row.SubmissionDate}}</td>
                                    <td class="text-center">
                                        <span ng-attr-class="{{row.Status=='1' ? 'label label-success' : 'label label-danger'}}">
                                            {{row.Status == '1' ? 'Active' : 'InActive'}}
                                        </span>
                                    </td>*@
                                <td class="text-center">

                                    <!-- Edit Button -->
                                    <a class="btn btn-sm btn-flat btn-success"
                                       ng-if="row.ProcessStatus == 'Rcvd'"
                                       ng-click="toggleClientReqSelect(row, 'edit')">
                                        Edit
                                    </a>

                                    <!-- View Button -->
                                    <a class="btn btn-sm btn-flat btn-primary"
                                       ng-click="toggleClientReqSelect(row, 'view')">
                                        View
                                    </a>

                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="100"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ==================== REQUISITION ITEM GRID ====================*@
    <div class="row" style="margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 5px 10px;">
        <div class="row">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px;">
                            <th colspan="10" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                Requisition Item List
                            </th>
                            <th ng-hide="viewonlymode == true" style="background: #ffffff;">
                                <button type="button" id="btnAddReqItem" ng-click="AddReqItemModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Item Code</th>
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: left;">Service Category</th>
                            <th style="text-align: left;">Description</th>
                            <th style="text-align: left;">Delivery Location</th>
                            <th style="text-align: left;">Delivery Date</th>
                            <th style="text-align: left;">Delivery Mode</th>
                            <th style="text-align: left;">Req. Type</th>
                            <th style="text-align: left;">Req. Qnty</th>
                            <th style="text-align: left;">Req. Unit</th>
                            <th ng-hide="viewonlymode == true" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in GridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.ClientReqItemID}}</td>
                            <td class="hidden">{{row.ClientReqID}}</td>
                            <td style="width:5%;">{{row.ServiceItemID}}</td>
                            <td style="width:5%;">{{row.ServiceItemName}}</td>
                            <td style="width:6%;">{{row.ServiceCategoryName}}</td>
                            <td style="width:6%;">{{row.Description}}</td>
                            <td style="width:6%;">{{row.DeliveryLocation}}</td>
                            <td style="width:6%;">{{row.DeliveryDate}}</td>
                            <td style="width:6%;">{{row.DeliveryMode}}</td>
                            <td style="width:6%;">{{row.ReqType}}</td>
                            <td style="width:6%;">{{row.ReqQnty | number:2}}</td>
                            <td style="width:5%;">{{row.ReqUnit}}</td>
                            <td ng-hide="viewonlymode == true" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat"
                                        data-ng-click="toggleReqItemEdit(row, $index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-danger btn-flat"
                                        data-ng-click="toggleReqItemDelete(row, $index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ==================== REQUISITION ITEM MODAL ==================== *@
    <div id="RequisitionItemModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="row">
                        <div class="col-sm-5 col-md-5 col-lg-5">
                            <h4 class="modal-title" style="font-family: initial; font-weight: 700">Requisition Item Information</h4>
                        </div>
                        <div style="text-align: right;">
                            <button type="button" class="btn-danger" data-dismiss="modal" ng-click="resetClientReqItem()"
                                    aria-hidden="true" style="color: #ffffff;">
                                <i class="fa fa-remove"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div ng-cloak>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="ServiceCategory">Service Category:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <select id="ServiceCategory" name="ServiceCategory" class="form-control"
                                        ng-model="ClientReqItem.ServiceCategory"
                                        ng-change="ServiceCategoryChange()"
                                        ng-options="serviceCategory as serviceCategory.ServiceCategoryName for serviceCategory in serviceCategorys track by serviceCategory.ServiceCategoryID"
                                        required="required">
                                    <option value="" style="display: none">-- Select--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="ServiceItem">Item Name :</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <select id="ServiceItem" name="ServiceItem" class="form-control"
                                        ng-model="ClientReqItem.ServiceItem"
                                        ng-options="serviceItem as serviceItem.ServiceItemName for serviceItem in serviceItems track by serviceItem.ServiceItemID"
                                        required="required">
                                    <option value="" style="display: none">-- Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="Description">Description:</label>
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <div class="form-group">
                                <textarea id="Description" name="Description" data-ng-model="ClientReqItem.Description"
                                          placeholder="Description" class="form-control" autofocus></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="DeliveryDate">Delivery Date :</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="DeliveryDate" name="DeliveryDate" readonly type="text"
                                       class="DatePicker form-control" placeholder="DD/MM/YYYY"
                                       ng-model="ClientReqItem.DeliveryDate"
                                       style="background-color:#ffffff;" />
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="DeliveryMode">Delivery Mode :</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <select data-ng-model="ClientReqItem.DeliveryMode" class="form-control">
                                <option value="">-- None --</option>
                                <option value="Hardcopy">Hardcopy</option>
                                <option value="Softcopy">Softcopy</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>Req. Type:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <select id="ReqType" ng-model="ClientReqItem.ReqType" class="form-control">
                                <option value="QV">Quotation from Vendor</option>
                                <option value="QC">Quotation to Client</option>
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="DeliveryLocation">Delivery Location:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="DeliveryLocation" type="text" name="DeliveryLocation"
                                       ng-model="ClientReqItem.DeliveryLocation" class="form-control" autofocus />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="ReqQnty">Req. Qnty :</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="ReqQnty" type="text" name="ReqQnty"
                                       ng-model="ClientReqItem.ReqQnty" class="form-control"
                                       placeholder="0.000" min="0.001" autofocus />
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="ReqUnit">Req. Unit :</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <select data-ng-model="ClientReqItem.ReqUnit" class="form-control">
                                <option value="">-- None --</option>
                                <option value="Hour">Hour</option>
                                <option value="Minute">Minute</option>
                                <option value="Second">Second</option>
                                <option value="Piece">Piece</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div class="btn-group pull-right" style="margin:2px;">
                                <button type="button" id="btnAddReqItem" data-ng-click="AddReqItem()"
                                        class="button-detail btn" ng-disabled="isDuplicateCombination">
                                    <i class="fa fa-save" style="padding-right: 3px"></i>
                                    <span id="btnAddReqItemLabel">Add to Item List</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==================== TERMS & CONDITIONS SEARCH MODAL ==================== *@
    <div id="ClientReqTermsConditionsModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Terms & Conditions Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-1" data-ng-click="sort('FormCode')">Form Code</th>
                                <th class="col-lg-1" data-ng-click="sort('FormName')">Form Name</th>
                                <th class="col-lg-1" data-ng-click="sort('Status')">Status</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="FormCode" placeholder="Form Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="FormName" placeholder="Form Name" class="input-sm form-control" type="search" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in TermsConditionsDisplayedCollection">
                                <td class="hidden">{{row.TermsID}}</td>
                                <td class="text-center">{{row.FormCode}}</td>
                                <td class="text-center">{{row.FormName}}</td>
                                <td class="text-center">
                                    <span ng-attr-class="{{row.Status=='1' ? 'label label-success' : 'label label-danger'}}">
                                        {{row.Status == '1' ? 'Active' : 'InActive'}}
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleTermsConditionsSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ==================== DELETE REQ ITEM CONFIRM MODAL ==================== *@
    <div class="modal fade" id="deleteReqItemModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Delete Selected Item</h4>
                </div>
                <div class="modal-body" style="height: 80px;">Are you sure to delete this item?</div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white; background-color: red;" ng-click="DeleteClientReqItem()">
                        Yes
                    </button>
                    <button type="button" class="btn button-custom" data-dismiss="modal" style="color: white">No</button>
                </div>
            </div>
        </div>
    </div>

    @* ==================== TERMS & CONDITIONS GRID ==================== *@
    <div class="row">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            <th ng-hide="viewonlymode == true" style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="FormName" name="FormName" type="text"
                                           data-ng-model="ClientReq.FormName" class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-hide="viewonlymode == true" style="background: #ffffff;">
                                <button type="button" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Terms Code</th>
                            <th colspan="13" style="text-align: left;">Terms & Conditions</th>
                            <th ng-hide="viewonlymode == true" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.ClientReqTermsID}}</td>
                            <td class="hidden">{{row.ClientReqID}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td style="width:5%;">{{row.TermsCode}}</td>
                            <td colspan="13" style="width:6%;">{{row.TermsName}}</td>
                            <td ng-hide="viewonlymode == true" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat"
                                        ng-click="toggleReqTermEdit(row, $index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-danger btn-flat"
                                        ng-click="toggleReqTermDelete(row, $index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ==================== REQUISITION TERM MODAL ==================== *@
    <div id="RequisitionTermModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="row">
                        <div class="col-sm-5 col-md-5 col-lg-5">
                            <h4 class="modal-title" style="font-family: initial; font-weight: 700">Terms & Conditions Information</h4>
                        </div>
                        <div style="text-align: right;">
                            <button type="button" class="btn-danger" data-dismiss="modal" ng-click="resetClientReqTerm()"
                                    aria-hidden="true" style="color: #ffffff;">
                                <i class="fa fa-remove"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div ng-cloak>
                    <div class="row" style="position:relative; top:5px;">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="TermsCode">Terms & Conditions Code:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="TermsCode" type="text" name="TermsCode"
                                       ng-model="ClientReqTerm.TermsCode" class="form-control" autofocus />
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="TermsName">Terms & Conditions:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="TermsName" type="text" name="TermsName"
                                       ng-model="ClientReqTerm.TermsName" class="form-control" autofocus />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div class="btn-group pull-right" style="margin:2px;">
                                <button type="button" id="btnAddReqTerm" data-ng-click="AddReqTerm()" class="button-detail btn">
                                    <i class="fa fa-save" style="padding-right: 3px"></i>
                                    <span id="btnAddReqTermLabel">Add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==================== DELETE REQ TERM CONFIRM MODAL ==================== *@
    <div class="modal fade" id="deleteReqTermModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Delete Selected Term</h4>
                </div>
                <div class="modal-body" style="height: 80px;">Are you sure to delete this term?</div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white; background-color: red;" ng-click="DeleteReqTerm()">
                        Yes
                    </button>
                    <button type="button" class="btn button-custom" data-dismiss="modal" style="color: white">No</button>
                </div>
            </div>
        </div>
    </div>

    @* ==================== PDF VIEWER MODAL ==================== *@
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header" style="padding: 5px 10px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Document Viewer</h4>
                </div>
                <div class="modal-body" style="padding: 0; margin: 0;">
                    <iframe id="pdfViewer" style="width: 100%; height: 100vh; border: none;" title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Set today's date on RequisitionDate
        var today = new Date();
        var day = String(today.getDate()).padStart(2, '0');
        var month = String(today.getMonth() + 1).padStart(2, '0');
        var year = today.getFullYear();
        var formattedDate = day + '/' + month + '/' + year;
        $('#RequisitionDate').val(formattedDate);
    });

    app.controller('ClientRequisitionCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        $scope.clientReqItemArray = [];
        $scope.clientReqTermArray = [];
        $scope.itemsByPage = 10;
        $scope.viewonlymode = false;

        // ── Load service categories on startup ──────────────────────────────────
        $http.get('/ClientRequisition/GetServicesCategory')
            .success(function (response) {
                $scope.loading = false;
                $scope.serviceCategorys = response.result;
            }).error(function () { });

        // ── Master model ────────────────────────────────────────────────────────
        $scope.ClientReq = {
            ClientReqID: "",
            ClientID: "",
            ClientName: "",
            TermsID: "",
            FormName: "",
            ClientReqNo: "",
            SubmissionDate: "",
            RequisitionDate: "",
            Remarks: "",
            DocumentID: "",   // BUG FIX: Added DocumentID field
            Status: ""
        };

        // ── Item model ──────────────────────────────────────────────────────────
        $scope.ClientReqItem = {
            ClientReqItemID: "",
            ClientReqID: "",
            Description: "",
            DeliveryLocation: "",
            DeliveryDate: "",
            ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
            ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
            DeliveryMode: "",
            ReqType: "QV",
            ReqQnty: "",
            ReqUnit: ""
        };

        // ── Term model ──────────────────────────────────────────────────────────
        $scope.ClientReqTerm = {
            ClientReqTermsID: "",
            ClientReqID: "",
            TermsID: "",
            TermsCode: "",
            TermsName: ""
        };

        // ── Grids ───────────────────────────────────────────────────────────────
        $scope.masterDataSetupGridData = [];
        $scope.GridDisplayCollection = [];
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];

        // ── DatePicker init ─────────────────────────────────────────────────────
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        }).on('changeDate', function () {
            $('.datepicker').hide();
        });

        // DeliveryDate datepicker (inside modal, re-init needed after modal shown)
        $(document).on('shown.bs.modal', '#RequisitionItemModal', function () {
            $('#DeliveryDate').datepicker({
                format: "dd/mm/yyyy",
                autoclose: true
            }).on('changeDate', function () {
                $('.datepicker').hide();
            });
        });

        // ── Duplicate-combination watch ─────────────────────────────────────────
        $scope.isDuplicateCombination = false;
        $scope.$watchGroup(['ClientReqItem.ServiceCategory', 'ClientReqItem.ServiceItem'], function (newValues) {
            var selectedCategory = newValues[0];
            var selectedItem = newValues[1];
            if (selectedCategory && selectedItem) {
                $scope.isDuplicateCombination = $scope.clientReqItemArray.some(function (item) {
                    return item.ServiceCategoryID === selectedCategory.ServiceCategoryID &&
                        item.ServiceItemID === selectedItem.ServiceItemID;
                });
                if ($scope.isDuplicateCombination) {
                    toastr.error("This Service Category and Item combination already exists.");
                }
            }
        });

        // ── Cancel (BUG FIX: was missing entirely) ──────────────────────────────
        $scope.Cancel = function () {
            $scope.clearClientReq();
        };

        // ── Clear / reset full form ─────────────────────────────────────────────
        $scope.clearClientReq = function () {
            $scope.viewonlymode = false;

            $scope.ClientReq = {
                ClientReqID: "",
                ClientID: "",
                ClientCode: "",
                ClientName: "",
                ContactPerson: "",
                ContactNumber: "",
                ClientReqNo: "",
                SubmissionDate: "",
                RequisitionDate: "",
                Remarks: "",
                DocumentID: "",   // BUG FIX: reset DocumentID too
                TermsID: "",
                FormName: "",
                Status: ""
            };

            $scope.resetClientReqItem();
            $scope.resetClientReqTerm();

            $scope.masterDataSetupGridData = [];
            $scope.GridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.clientReqItemArray = [];
            $scope.clientReqTermArray = [];

            // Reset date fields
            $('#RequisitionDate').val('');
            var today = new Date();
            var day = String(today.getDate()).padStart(2, '0');
            var month = String(today.getMonth() + 1).padStart(2, '0');
            var year = today.getFullYear();
            $('#RequisitionDate').val(day + '/' + month + '/' + year);

            // Reset file input
            $('#FileUpload1').val('');
            $scope.uploadedFile = null;
        };

        // ── Show client list ────────────────────────────────────────────────────
        $scope.ShowClientList = function () {
            $http.get("/ClientRequisition/GetClientInfoList")
                .success(function (response) {
                    $scope.ClientList = response.ClientInfoList;
                    $scope.ClientDisplayedCollection = [].concat($scope.ClientList);
                    $scope.loading = false;
                }).error(function () { });

            $('#ClientInfoModal').modal('show');
        };

        // ── Select client from modal ────────────────────────────────────────────
        $scope.toggleClientSelect = function (row) {
            $scope.ClientReq.ClientID = row.ClientID;
            $scope.ClientReq.ClientCode = row.ClientCode;
            $scope.ClientReq.ClientName = row.ClientName;
            $('#ClientInfoModal').modal('hide');
        };

        // ── Service category change ─────────────────────────────────────────────
        $scope.ServiceCategoryChange = function () {
            var ServiceCategoryID = $scope.ClientReqItem.ServiceCategory.ServiceCategoryID;
            $http.post("/ServiceItemInfo/GetServiceItemInfoSearchList?ServiceItemCategoryID=" + ServiceCategoryID)
                .success(function (response) {
                    $scope.serviceItems = response.ServiceItemInfoSearchList;
                    $scope.loading = false;
                }).error(function () { });
        };

        // ── Add Req Item Modal ──────────────────────────────────────────────────
        $scope.AddReqItemModal = function () {
            if (!$scope.ClientReq.ClientName) {
                toastr.error("Client Name Required"); return;
            }
            if ($('#RequisitionDate').val() == "") {
                toastr.error("Requisition Date Required"); return;
            }
            $scope.resetClientReqItem();
            $('#btnAddReqItemLabel').text('Add to Item List');
            $scope.isDuplicateCombination = false;
            $('#RequisitionItemModal').modal('show');
        };

        // ── Add Req Item ────────────────────────────────────────────────────────
        $scope.AddReqItem = function () {
            if (!$scope.ClientReqItem.ServiceCategory || !$scope.ClientReqItem.ServiceCategory.ServiceCategoryID) {
                toastr.error("Service Category Required"); return;
            }
            if (!$scope.ClientReqItem.ServiceItem || !$scope.ClientReqItem.ServiceItem.ServiceItemID) {
                toastr.error("Service Item Required"); return;
            }
            if (!$scope.ClientReqItem.ReqType) {
                toastr.error("Req Type Required"); return;
            }
            if (!$scope.ClientReqItem.DeliveryMode) {
                toastr.error("Delivery Mode Required."); return;
            }
            if (!$scope.ClientReqItem.ReqUnit) {
                toastr.error("Req Unit Required"); return;
            }
            if (!$scope.ClientReqItem.DeliveryLocation) {
                toastr.error("Delivery Location Required"); return;
            }
            if ($('#DeliveryDate').val() == "") {
                toastr.error("Delivery Date Required"); return;
            }
            if (!$scope.ClientReqItem.Description) {
                toastr.error("Description Required."); return;
            }
            if (!$scope.ClientReqItem.ReqQnty) {
                toastr.error("Requisition Qty Required"); return;
            }

            $scope.ClientReqItem.ServiceCategoryID = $scope.ClientReqItem.ServiceCategory.ServiceCategoryID;
            $scope.ClientReqItem.ServiceCategoryName = $scope.ClientReqItem.ServiceCategory.ServiceCategoryName;
            $scope.ClientReqItem.ServiceItemID = $scope.ClientReqItem.ServiceItem.ServiceItemID;
            $scope.ClientReqItem.ServiceItemName = $scope.ClientReqItem.ServiceItem.ServiceItemName;
            $scope.ClientReqItem.DeliveryDate = $('#DeliveryDate').val();

            $scope.clientReqItemArray.push(angular.copy($scope.ClientReqItem));
            $scope.GridDisplayCollection = $scope.GridDisplayCollection.concat(angular.copy($scope.ClientReqItem));

            $scope.resetClientReqItem();
            $('#btnAddReqItemLabel').text('Add to Item List');
            $('#RequisitionItemModal').modal('hide');
        };

        $scope.resetClientReqItem = function () {
            $('#DeliveryDate').val('');
            $scope.ClientReqItem = {
                ClientReqItemID: "",
                ClientReqID: "",
                ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
                ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
                Description: "",
                DeliveryLocation: "",
                ReqType: "QV",
                DeliveryDate: "",
                DeliveryMode: "",
                ReqQnty: "",
                ReqUnit: ""
            };
        };

        // ── Edit Req Item ───────────────────────────────────────────────────────
        $scope.toggleReqItemEdit = function (tableRow, idx) {
            $scope.resetClientReqItem();
            $scope.ClientReqItem.ClientReqItemID = tableRow.ClientReqItemID;
            $scope.ClientReqItem.ClientReqID = tableRow.ClientReqID;
            $scope.ClientReqItem.ServiceCategory = {
                ServiceCategoryID: tableRow.ServiceCategoryID,
                ServiceCategoryName: tableRow.ServiceCategoryName
            };
            $scope.ClientReqItem.ServiceItem = {
                ServiceItemID: tableRow.ServiceItemID,
                ServiceItemName: tableRow.ServiceItemName
            };
            $scope.ClientReqItem.DeliveryMode = tableRow.DeliveryMode;
            $scope.ClientReqItem.DeliveryLocation = tableRow.DeliveryLocation;
            $scope.ClientReqItem.DeliveryDate = tableRow.DeliveryDate;
            $scope.ClientReqItem.Description = tableRow.Description;
            $scope.ClientReqItem.ReqType = tableRow.ReqType;
            $scope.ClientReqItem.ReqQnty = tableRow.ReqQnty;
            $scope.ClientReqItem.ReqUnit = tableRow.ReqUnit;

            // Remove from arrays so it can be re-added on save
            $scope.GridDisplayCollection.splice(idx, 1);
            $scope.clientReqItemArray.splice(idx, 1);
            $scope.isDuplicateCombination = false;

            $http.post("/ServiceItemInfo/GetServiceItemInfoSearchList?ServiceItemCategoryID=" + tableRow.ServiceCategoryID)
                .success(function (response) {
                    $scope.serviceItems = response.ServiceItemInfoSearchList;
                }).error(function () { });

            $('#btnAddReqItemLabel').text('Update');
            $('#RequisitionItemModal').modal('show');
        };

        // ── Delete Req Item ─────────────────────────────────────────────────────
        $scope.pendingDeleteItemIndex = null; // BUG FIX: store index so Delete callback can use it

        $scope.toggleReqItemDelete = function (tableRow, idx) {
            if (!tableRow.ClientReqItemID) {
                // Not yet saved to DB — remove from local arrays
                $scope.GridDisplayCollection.splice(idx, 1);
                $scope.clientReqItemArray.splice(idx, 1);
                toastr.success('Item Deleted Successfully');
            } else {
                $scope.ClientReqItem.ClientReqItemID = tableRow.ClientReqItemID;
                $scope.pendingDeleteItemIndex = idx;
                $('#deleteReqItemModal').modal('show');
            }
        };

        // BUG FIX: $i was undefined — now uses $scope.pendingDeleteItemIndex
        $scope.DeleteClientReqItem = function () {
            var idx = $scope.pendingDeleteItemIndex;
            $http.post('/ClientRequisition/DeleteClientReqItemAndTerm',
                { ClientReqItemID: $scope.ClientReqItem.ClientReqItemID, ClientReqTermID: "" })
                .success(function (response) {
                    if (response.status == "S203") {
                        if (idx !== null) {
                            $scope.GridDisplayCollection.splice(idx, 1);
                            $scope.clientReqItemArray.splice(idx, 1);
                            $scope.pendingDeleteItemIndex = null;
                        }
                        $scope.resetClientReqItem();
                        toastr.success('Item Deleted Successfully');
                    }
                }).error(function () {
                    toastr.error('Delete Failed');
                });
        };

        // ── Search / Select Requisition ─────────────────────────────────────────
        $scope.SearchClientReqModal = function () {
            $scope.GetClientReqSearchList();
            $('#SearchClientReqModal').modal('show');
        };

        $scope.GetClientReqSearchList = function () {
            $http.post("/ClientRequisition/GetClientReqSearchList")
                .success(function (response) {
                    $scope.clientReqSearchList = response.clientReqSearchList;
                    $scope.clientReqDisplayedCollection = [].concat($scope.clientReqSearchList);
                }).error(function () { });
        };

        // BUG FIX: Populate DocumentID from search result so View button works correctly
        $scope.toggleClientReqSelect = function (tableRow, mode) {

            $scope.clearClientReq();

            // view mode control
            $scope.viewonlymode = (mode === 'view');

            // OR if you still want ProcessStatus check:
            // $scope.viewonlymode = (tableRow.ProcessStatus !== 'Rcvd' || mode === 'view');

            $scope.ClientReq.ClientReqID = tableRow.ClientReqID;
            $scope.ClientReq.ClientID = tableRow.ClientID;
            $scope.ClientReq.ClientName = tableRow.ClientName;
            $scope.ClientReq.ClientReqNo = tableRow.ClientReqNo;
            $scope.ClientReq.RequisitionDate = tableRow.RequisitionDate;
            $scope.ClientReq.SubmissionDate = tableRow.SubmissionDate;
            $scope.ClientReq.Remarks = tableRow.Remarks;
            $scope.ClientReq.Status = tableRow.Status;
            $scope.ClientReq.DocumentID = tableRow.DocumentID || "";

            // Load items
            $http.post('/ClientRequisition/GetClientReqItemList', {
                ClientReqID: tableRow.ClientReqID,
                ReqType: "ALL"
            }).success(function (response) {

                $scope.masterDataSetupGridData = response.ClientReqItemList;
                $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            // Load terms
            $http.post('/ClientRequisition/GetClientReqTermList', {
                ClientReqID: tableRow.ClientReqID
            }).success(function (response) {

                $scope.ReqTermDataSetupGridData = response.ClientReqTermList;
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            $('#SearchClientReqModal').modal('hide');
        };

        // ── Terms & Conditions ──────────────────────────────────────────────────
        $scope.ShowTermsConditionsList = function () {
            $http.get("/ClientRequisition/GetTermsConditionsList")
                .success(function (response) {
                    $scope.TermsConditionsList = response.termsConditionsList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { });
            $('#ClientReqTermsConditionsModal').modal('show');
        };

        $scope.toggleTermsConditionsSelect = function (row) {
            $scope.ClientReq.TermsID = row.TermsID;
            $scope.ClientReq.FormName = row.FormName;
            $http.post('/ClientRequisition/GetClientReqTermAgainstFormList', { TermsID: row.TermsID })
                .success(function (response) {
                    $scope.ReqTermDataSetupGridData = response.ClientReqTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#ClientReqTermsConditionsModal').modal('hide');
        };

        // ── Add Term Modal ──────────────────────────────────────────────────────
        $scope.AddReqTermModal = function () {
            if (!$scope.ClientReq.ClientName) {
                toastr.error("Client Name Required"); return;
            }
            if ($('#RequisitionDate').val() == "") {
                toastr.error("Requisition Date Required"); return;
            }
            $scope.resetClientReqTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('show');
        };

        $scope.AddReqTerm = function () {
            if (!$scope.ClientReqTerm.TermsCode) {
                toastr.error("Terms Code Required"); return;
            }
            if (!$scope.ClientReqTerm.TermsName) {
                toastr.error("Terms Name Required."); return;
            }

            $scope.clientReqTermArray.push(angular.copy($scope.ClientReqTerm));
            $scope.ReqTermGridDisplayCollection = $scope.ReqTermGridDisplayCollection.concat(angular.copy($scope.ClientReqTerm));

            $scope.resetClientReqTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('hide');
        };

        $scope.resetClientReqTerm = function () {
            $scope.ClientReqTerm = {
                ClientReqTermsID: "",
                ClientReqID: "",
                TermsID: "",
                TermsCode: "",
                TermsName: ""
            };
        };

        // BUG FIX: toggleReqTermEdit had typo `tableRow.ClientReqTermD` → `tableRow.ClientReqTermID`
        $scope.toggleReqTermEdit = function (tableRow, idx) {
            $scope.resetClientReqTerm();
            $scope.ClientReqTerm.ClientReqTermsID = tableRow.ClientReqTermID;  // BUG FIX: was ClientReqTermD
            $scope.ClientReqTerm.ClientReqID = tableRow.ClientReqID;
            $scope.ClientReqTerm.TermsID = tableRow.TermsID;
            $scope.ClientReqTerm.TermsCode = tableRow.TermsCode;
            $scope.ClientReqTerm.TermsName = tableRow.TermsName;
            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
            $scope.clientReqTermArray.splice(idx, 1);
            $('#btnAddReqTermLabel').text('Update');
            $('#RequisitionTermModal').modal('show');
        };

        $scope.pendingDeleteTermIndex = null; // BUG FIX: same $i-out-of-scope issue as items

        $scope.toggleReqTermDelete = function (tableRow, idx) {
            // BUG FIX: check ClientReqTermID (not ClientReqTermsID which is the model property name)
            if (!tableRow.ClientReqTermID) {
                $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                $scope.clientReqTermArray.splice(idx, 1);
                toastr.success('Term Deleted Successfully');
            } else {
                $scope.ClientReqTerm.ClientReqTermsID = tableRow.ClientReqTermID;
                $scope.pendingDeleteTermIndex = idx;
                $('#deleteReqTermModal').modal('show');
            }
        };

        // BUG FIX: was calling DeleteClientReqTerm but the button called DeleteReqTerm
        $scope.DeleteReqTerm = function () {
            var idx = $scope.pendingDeleteTermIndex;
            $http.post('/ClientRequisition/DeleteClientReqItemAndTerm',
                { ClientReqItemID: "", ClientReqTermID: $scope.ClientReqTerm.ClientReqTermsID })
                .success(function (response) {
                    if (response.status == "S203") {
                        if (idx !== null) {
                            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                            $scope.clientReqTermArray.splice(idx, 1);
                            $scope.pendingDeleteTermIndex = null;
                        }
                        $scope.resetClientReqTerm();
                        toastr.success('Term Deleted Successfully');
                    }
                }).error(function () {
                    toastr.error('Delete Failed');
                });
        };

        // ── File selection ──────────────────────────────────────────────────────
        $scope.uploadedFile = null;
        $scope.fileSelected = function (element) {
            $scope.$apply(function () {
                $scope.uploadedFile = element.files.length > 0 ? element.files[0] : null;
            });
        };

        // ── Save / Post ─────────────────────────────────────────────────────────
        $scope.Post = function () {
            if (!$scope.ClientReq.ClientName) {
                toastr.error("Client Name Required"); return;
            }
            if (!$scope.GridDisplayCollection || $scope.GridDisplayCollection.length === 0) {
                toastr.error("At least one Requisition Item Required"); return;
            }
            if (!$scope.ReqTermGridDisplayCollection || $scope.ReqTermGridDisplayCollection.length === 0) {
                toastr.error("At least one Term Required"); return;
            }
            if ($('#RequisitionDate').val() == "") {
                toastr.error("Requisition Date Required"); return;
            }

            $scope.ClientReq.RequisitionDate = $('#RequisitionDate').val();

            $http.post('/ClientRequisition/SaveClientRequisition',
                {
                    clientReq: $scope.ClientReq,
                    clientReqItem: $scope.GridDisplayCollection,
                    clientReqTerm: $scope.ReqTermGridDisplayCollection
                })
                .success(function (response) {
                    if (response.status == "S201") {
                        toastr.success("Data Saved Successfully.");
                        $scope.ClientReq.ClientReqID = response.ClientReqID;

                        // BUG FIX: upload document for both insert AND update
                        if ($scope.uploadedFile) {
                            $scope.SaveDocument(response.ClientReqID);
                        } else {
                            $scope.clearClientReq();
                            $scope.toggleRefreshTable();
                        }
                    } else if (response.status == "S202") {
                        toastr.success("Data Updated Successfully.");

                        // BUG FIX: also upload/replace document on edit
                        if ($scope.uploadedFile) {
                            $scope.SaveDocument($scope.ClientReq.ClientReqID);
                        } else {
                            $scope.clearClientReq();
                            $scope.toggleRefreshTable();
                        }
                    } else if (response.status == "ERROR_Duplicate") {
                        toastr.error("This requisition no. already exists");
                    } else {
                        toastr.error("Data Save Failed.");
                    }
                    $scope.loading = false;
                })
                .error(function () {
                    toastr.error("Data Save Failed.");
                    $scope.loading = false;
                });
        };

        // ── Save Document (FTP upload) ──────────────────────────────────────────
        $scope.SaveDocument = function (ClientReqID) {
            var fileUpload = document.getElementById("FileUpload1");
            var files = fileUpload.files;

            if (files.length === 0) {
                toastr.error("Please select a file to upload.");
                return;
            }

            var file = files[0];
            var ext = file.name.split('.').pop().toLowerCase();
            var maxSizeInMB = 2;

            if (file.size > maxSizeInMB * 1024 * 1024) {
                toastr.error("File size must be 2 MB or less.");
                return;
            }
            if (ext !== "pdf") {
                toastr.error("Please upload PDF files only.");
                return;
            }

            $scope.loading = true;

            var documentID = "CR_" + ClientReqID;

            var formData = new FormData();
            formData.append("file", file);
            formData.append("serverUrl", "MCL/Client_Requisition");
            formData.append("documentID", documentID);
            formData.append("ext", "pdf");

            $.ajax({
                url: '/ClientRequisition/SaveDocument',
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    toastr.success("Document uploaded successfully.");

                    // BUG FIX: After successful upload, update DocumentID in OBS_ClientReq table
                    $http.post('/ClientRequisition/UpdateDocumentID', {
                        ClientReqID: ClientReqID,
                        DocumentID: documentID
                    }).success(function (resp) {
                        if (resp.status === "S200") {
                            $scope.ClientReq.DocumentID = documentID; // update in scope for View button
                        }
                    }).error(function () {
                        toastr.warning("Document uploaded but failed to link DocumentID to record.");
                    });

                    // Reset file input
                    document.getElementById("FileUpload1").value = "";
                    $scope.uploadedFile = null;
                    $scope.clearClientReq();
                    $scope.toggleRefreshTable();
                },
                error: function (err) {
                    toastr.error("Document upload failed. Please try again.");
                    console.error(err);
                },
                complete: function () {
                    $scope.loading = false;
                }
            });
        };

        // ── View Document ───────────────────────────────────────────────────────
        $scope.ViewDocument = function () {
            if (!$scope.ClientReq.ClientReqID) {
                toastr.error("No record selected to view document.");
                return;
            }

            $scope.loading = true;

            // BUG FIX: Use DocumentID from ClientReq model if available, otherwise fall back to CR_ + ID
            var docID = ($scope.ClientReq.DocumentID && $scope.ClientReq.DocumentID !== "")
                ? $scope.ClientReq.DocumentID
                : "CR_" + $scope.ClientReq.ClientReqID;

            var requestUrl = "/ClientRequisition/ViewDocument?" +
                "&serverUrl=" + encodeURIComponent("MCL/Client_Requisition") +
                "&DocID=" + encodeURIComponent(docID) +
                "&ext=" + encodeURIComponent("pdf");

            $http.get(requestUrl, { responseType: 'arraybuffer' })
                .then(function (response) {
                    var file = new Blob([response.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(file);
                    $("#pdfViewer").attr("src", fileURL + "#view=Fit");
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (error) {
                    toastr.error("Failed to load the PDF. The document may not have been uploaded yet.");
                    console.error(error);
                })
                .finally(function () {
                    $scope.loading = false;
                });
        };

        // ── Refresh helpers ─────────────────────────────────────────────────────
        $scope.toggleRefreshTablemain = function () {
            window.location.reload();
        };

        $scope.toggleRefreshTable = function () {
            $timeout(function () {
                window.location.reload();
            }, 2000);
        };

        $scope.ResetSearchModel = function () {
            // placeholder — add search model reset logic if needed
        };

    }]);
</script>
