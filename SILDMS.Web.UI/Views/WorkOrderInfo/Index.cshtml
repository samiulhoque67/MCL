@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header {
        font-size: 12px;
    }

    .btn {
        font-size: 12px;
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }

    input.form-control, button.form-control {
        font-size: 12px;
    }

    label {
        font-size: 12px;
    }

    .fa {
        font-size: 12px;
    }

    .text-success {
        color: green;
        font-size: 14px;
    }

    .text-primary {
        color: blue;
        font-size: 14px;
    }

    .selected-row {
        background-color: #d4edda !important;
    }

    .mode-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 8px;
        vertical-align: middle;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .mode-view {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    /* ── Print slip container ── */
    #masterRow {
        position: relative;
    }
</style>

<div class="box box-primary box-body" ng-controller="WorkOrderInfoCtrl">

    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Work Order Information
            <span ng-show="pageMode==='edit'" class="mode-badge mode-edit">EDIT</span>
            <span ng-show="pageMode==='view'" class="mode-badge mode-view">VIEW</span>
        </h2>

        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-warning" type="button" data-ng-click="toggleRefreshTable()">
                        <i class="fa fa-refresh" style="padding-right:5px"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-primary" type="button" data-ng-click="SearchWOInfoModal()">
                        <i class="fa fa-search" style="padding-right:5px"></i> Search
                    </button>
                </div>
                <!-- Print button — only meaningful once a WO is loaded (view/edit) -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view' || pageMode==='edit'">
                    <button class="button-custom btn-primary" type="button" data-ng-click="printCurrentWO()">
                        <i class="fa fa-print" style="padding-right:5px"></i> Print WO
                    </button>
                </div>
                <!-- Save/Update hidden in view mode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-hide="pageMode==='view'">
                    <button class="button-custom btn-primary" type="button" data-ng-click="Post()">
                        <i class="fa fa-save" style="padding-right:5px"></i>
                        {{ pageMode === 'edit' ? 'Update' : 'Save' }}
                    </button>
                </div>
                <!-- Edit button shown in view mode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view'">
                    <button class="button-custom btn-warning" type="button" ng-click="switchToEdit()">
                        <i class="fa fa-edit" style="padding-right:5px"></i> Edit
                    </button>
                </div>
                <!-- FIX: Cancel was calling undefined function -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-danger" type="button" data-ng-click="CancelAndReset()">
                        <i class="fa fa-close" style="padding-right:5px"></i>
                        {{ (pageMode==='edit' || pageMode==='view') ? 'New' : 'Cancel' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body" style="margin:1%;padding:5px;">
        <div class="row">

            <!-- Client Name -->
            <div class="row">
                <div class="col-lg-2">
                    <div class="form-group"><label>Client Name :</label></div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    <div style="position:relative;">
                        <input id="ClientName" name="ClientName" type="text"
                               data-ng-model="WOInfo.ClientName" class="form-control"
                               ng-readonly="true" placeholder="Client Name"
                               style="height:25px;font-size:smaller;" />
                        <!-- Search only available in new mode -->
                        <button type="button" data-ng-click="ShowClientList()"
                                ng-hide="pageMode==='view' || pageMode==='edit'"
                                style="position:absolute;right:1px;top:50%;transform:translateY(-50%);
                                       padding:0px 10px;border:2px solid black;background:transparent;">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="form-group"><label>Bill Category:</label></div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input type="radio" ng-model="WOInfo.BillCategory" name="BillCategory"
                               value="Normal" ng-disabled="pageMode==='view'" />
                        <label>Normal</label>
                        <input type="radio" ng-model="WOInfo.BillCategory" name="BillCategory"
                               value="PlusMinus" ng-disabled="pageMode==='view'" />
                        <label>Plus-minus</label>
                    </div>
                </div>
            </div>

            <!-- WO No + Bill Type -->
            <div class="row">
                <div class="col-lg-2">
                    <div class="form-group"><label>Work Order No.</label></div>
                </div>
                <div class="col-lg-3">
                    <input id="WONo" name="WONo" type="text" class="form-control"
                           placeholder="WONo" ng-model="WOInfo.WONo"
                           ng-readonly="pageMode==='view'" />
                </div>
                <div class="col-lg-1"></div>
                <div class="col-lg-2">
                    <div class="form-group"><label>Bill Type:</label></div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input type="radio" ng-model="WOInfo.BillType" name="BillType"
                               value="Default" ng-disabled="pageMode==='view'" />
                        <label>Default</label>
                        <input type="radio" ng-model="WOInfo.BillType" name="BillType"
                               value="Installment" ng-disabled="pageMode==='view'" />
                        <label>Installment</label>
                    </div>
                </div>
            </div>

            <!-- WO Amount + Installment -->
            <div class="row">
                <div class="col-lg-2">
                    <div class="form-group"><label>Work Order Amount:</label></div>
                </div>
                <div class="col-lg-3">
                    <input id="WOAmt" name="WOAmt" style="text-align:right" readonly
                           type="text" class="form-control" placeholder="0.00"
                           ng-model="WOInfo.WOAmt" />
                </div>
                <div class="col-lg-2" ng-show="WOInfo.BillType==='Installment'">
                    <div class="form-group"><label>No of Installment:</label></div>
                </div>
                <div class="col-lg-3" ng-show="WOInfo.BillType==='Installment'">
                    <input id="NoOfInstallment" name="NoOfInstallment" type="text"
                           class="form-control" placeholder="No of Installment"
                           ng-model="WOInfo.NoOfInstallment" ng-change="calculateAmounts()"
                           ng-readonly="pageMode==='view'" />
                </div>
            </div>

            <!-- WO Date + Installment Amount -->
            <div class="row">
                <div class="col-lg-2">
                    <div class="form-group"><label>Work Order Date:</label></div>
                </div>
                <div class="col-lg-3">
                    <input id="WODate" name="WODate" type="text" class="DatePicker form-control"
                           placeholder="DD/MM/YYYY" ng-model="WOInfo.WODate"
                           ng-readonly="pageMode==='view'" />
                </div>
                <div class="col-lg-2" ng-show="WOInfo.BillType==='Installment'">
                    <div class="form-group"><label>Installment Amount:</label></div>
                </div>
                <div class="col-lg-3" ng-show="WOInfo.BillType==='Installment'">
                    <input id="InstallmentAmt" name="InstallmentAmt" type="text"
                           class="form-control" placeholder="0.00"
                           ng-readonly="true" ng-model="WOInfo.InstallmentAmt" />
                </div>
            </div>

            <!-- Remarks -->
            <div class="row">
                <div class="col-lg-2">
                    <div class="form-group"><label>Remarks:</label></div>
                </div>
                <div class="col-lg-8">
                    <input id="Remarks" name="Remarks" type="text"
                           data-ng-model="WOInfo.Remarks" class="form-control"
                           placeholder="Remarks" ng-readonly="pageMode==='view'" />
                </div>
            </div>


            <div class="row">

                <div class="col-lg-2">
                    <div class="form-group">
                        <label for="upload_documents">
                            Upload Documents <br>
                            (<span style="color:#ff4900;">PDF Only, Max Size 2MB</span>)
                        </label>
                    </div>
                </div>

                <!-- Show file input only when NOT in view mode -->
                <div ng-hide="pageMode==='view'" class="col-lg-2">
                    <div class="form-group">
                        <input type="file"
                               style="height:25px; float:left; margin-top:5px;"
                               id="FileUpload1"
                               accept=".pdf"
                               ng-model="uploadedFile"
                               onchange="angular.element(this).scope().fileSelected(this)" />
                    </div>
                </div>

                <!-- View section -->
                <div ng-hide="viewonlymode" class="col-lg-2">
                    <!-- View button -->
                    <button ng-show="WOInfo.DocumentID"
                            ng-click="ViewDocument()"
                            class="btn button-custom btn-sm">
                        <i class="fa fa-eye"></i> View
                    </button>

                </div>

                <div ng-show="viewonlymode" class="col-lg-5">
                    <div class="form-group" style="display:flex; gap:8px; align-items:center;">


                        <!-- View button — only when a document exists -->
                        <button ng-show="WOInfo.DocumentID"
                                ng-click="ViewDocument()"
                                class="btn button-custom btn-sm">
                            <i class="fa fa-eye"></i> View
                        </button>

                        <span ng-hide="ClientReq.DocumentID"
                              style="color:#999; font-size:11px;">No document attached</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ── Client (Approved Quotation) Picker Modal ── -->
    <div id="ClientInfoModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div style="text-align:right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color:#fff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="ClientDisplayedCollection" st-safe-src="ClientList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Client Approved Quotation Information
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>Client Name</th>
                                <th>ProjectName</th>
                                <th>Representive</th>
                                <th>Qutn. Aprv Date</th>
                                <th>Action</th>
                            </tr>
                            <tr>
                                <!-- FIX: correct st-search field names -->
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ProjectName" placeholder="Project Name" class="input-sm form-control" type="search" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in ClientDisplayedCollection">
                                <td class="hidden">{{row.ClientQutnAprvID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="hidden">{{row.ClientReqID}}</td>
                                <td class="hidden">{{row.ClientReqNo}}</td>
                                <td class="hidden">{{row.AprvNo}}</td>
                                <td class="hidden">{{row.ContactNumber}}</td>
                                <td class="hidden">{{row.Address}}</td>

                                <td class="text-center">{{row.ClientName}}</td>
                                <td class="text-center">{{row.ProjectName}}</td>
                                <td class="text-center">{{row.UserFullName}}</td>
                                <td class="text-center">{{row.AprvDate}}</td>

                                @*<td class="text-center">
                                        <span ng-attr-class="{{row.Status=='1'?'label label-success':'label label-danger'}}">
                                            {{row.Status=='1'?'Active':'InActive'}}
                                        </span>
                                    </td>*@
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleClientSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Search Work Orders Modal ── -->
    <div id="SearchWOInfoModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div style="text-align:right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color:#fff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="clientReqDisplayedCollection" st-safe-src="woInfoSearchList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Work Order Information
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>Client Name</th>
                                <th>Work Order No</th>
                                <th>Work Order Date</th>
                                <th>Work Order Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                            <tr>
                                <!-- FIX: correct st-search field names -->
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="WONo" placeholder="Work Order No" class="input-sm form-control" type="search" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in clientReqDisplayedCollection">
                                <td class="hidden">{{row.WOInfoID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="hidden">{{row.ClientQutnAprvID}}</td>
                                <td class="text-left">{{row.ClientName}}</td>
                                <td class="text-left">{{row.WONo}}</td>
                                <td class="text-center">{{row.WODate}}</td>
                                <td class="text-center">{{row.WOAmt}}</td>
                                <td class="hidden">{{row.Remarks}}</td>
                                <td class="text-center">
                                    <span ng-attr-class="{{row.Status=='1'?'label label-success':'label label-danger'}}">
                                        {{row.Status=='1'?'Active':'InActive'}}
                                    </span>
                                </td>
                                <td>
                                    <!-- FIX: separate View and Edit actions -->
                                    <a class="btn btn-sm btn-flat btn-primary" ng-click="toggleWOInfoSelect(row, 'view')">
                                        <i class="fa fa-eye"></i> View
                                    </a>
                                    <a class="btn btn-sm btn-flat btn-warning" ng-click="toggleWOInfoSelect(row, 'edit')" style="margin-left:3px;">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="100"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── WO Item Table ── -->
    <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;">
        <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
            <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                   class="table table-condensed table-bordered table-striped table-hover pnlView">
                <thead>
                    <tr style="font-size:15px;">
                        <th colspan="17" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                            Work Order Item List
                            <small ng-show="pageMode!=='view'" style="color:#888;margin-left:10px;">
                            </small>
                        </th>
                    </tr>
                    <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                    <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Service Category</th>
                        <th>Description</th>
                        <th>Delivery Date</th>
                        <th>Quotation Unit</th>
                        <th>Quotation Qty</th>
                        <th>Quotation Price</th>
                        <th>Quotation Amount</th>

                        <th>WO Qty</th>
                        <th>WO Price</th>
                        <th>WO Amount</th>

                        <th>ASF (%)</th>
                        <th>ASF Amount</th>

                        <th>VAT (%)</th>
                        <th>VAT Amount</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="row in GridDisplayCollection"
                        ng-cloak
                        style="font-size:12px;"
                        ng-class="{'selected-row': row.selected}">

                        <td class="hidden">{{row.ClientQutnAprvItemID}}</td>
                        <td class="hidden">{{row.WOInfoItemID}}</td>
                        <td class="hidden">{{row.WOInfoID}}</td>

                        <td class="text-left">{{row.ServiceItemID}}</td>
                        <td class="text-left">{{row.ServiceItemName}}</td>
                        <td class="text-left">{{row.ServiceCategoryName}}</td>
                        <td class="text-left">{{row.Description}}</td>
                        <td class="text-center">{{row.DeliveryDate}}</td>
                        <td class="text-left">{{row.QutnUnit}}</td>

                        <!-- Quotation Quantity -->
                        <td class="text-right">
                            {{row.QutnQnty | number:2}}
                        </td>

                        <!-- Quotation Price -->
                        <td class="text-right">
                            {{row.QutnPrice | number:2}}
                        </td>

                        <!-- Quotation Amount -->
                        <td class="text-right">
                            {{row.QutnAmt | number:2}}
                        </td>


                        <!-- ================= WO FIELDS ================= -->
                        <!-- WO Quantity -->
                        <td>
                            <span ng-show="pageMode==='view'">
                                {{row.WOQnty | number:2}}
                            </span>

                            <input ng-hide="pageMode==='view'"
                                   class="form-control text-right"
                                   style="width:100%;height:18px;font-size:10px"
                                   type="number"
                                   ng-model="row.WOQnty"
                                   ng-change="checkWOPrice(row)"
                                   ng-disabled="!row.selected" />
                        </td>


                        <!-- WO Price -->
                        <td>
                            <span ng-show="pageMode==='view'">
                                {{row.WOPrice | number:2}}
                            </span>

                            <input ng-hide="pageMode==='view'"
                                   class="form-control text-right"
                                   style="width:100%;height:18px;font-size:10px"
                                   type="number"
                                   ng-model="row.WOPrice"
                                   ng-change="checkWOPrice(row)"
                                   ng-disabled="!row.selected" />
                        </td>


                        <!-- WO Amount -->
                        <td class="text-right" style="color:#126e0f;">
                            {{row.WOAmt | number:2}}
                        </td>



                        <!-- ASF % -->
                        <td>
                            <span ng-show="pageMode==='view'">
                                {{row.ASFPerc | number:2}}
                            </span>

                            <input ng-hide="pageMode==='view'"
                                   class="form-control text-right"
                                   style="width:100%;height:18px;font-size:10px"
                                   type="number"
                                   ng-model="row.ASFPerc"
                                   ng-change="checkWOPrice(row)"
                                   ng-disabled="!row.selected" />
                        </td>

                        <!-- ASF Amount -->
                        <td class="text-right">
                            {{row.TotGivenASFAmt | number:2}}
                        </td>


                        <!-- VAT % -->
                        <td>
                            <span ng-show="pageMode==='view'">
                                {{row.VatPerc | number:2}}
                            </span>

                            <input ng-hide="pageMode==='view'"
                                   class="form-control text-right"
                                   style="width:100%;height:18px;font-size:10px"
                                   type="number"
                                   ng-model="row.VatPerc"
                                   ng-change="checkWOPrice(row)"
                                   ng-disabled="!row.selected" />
                        </td>


                        <!-- VAT Amount -->
                        <td class="text-right">
                            {{row.VatAmt | number:2}}
                        </td>


                        <!-- Total Amount -->
                        <td class="text-right" style="color:#126e0f;">
                            {{row.TolAmt | number:2}}
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── Terms & Conditions Table ── -->
    <div class="row">
        <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;border:1px solid #3003eb;background:#fff;">
                            <th style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            <th ng-hide="pageMode==='view'" style="background:#fff;position:relative;padding:5px;">
                                <div style="position:relative;display:inline-block;width:200px;">
                                    <!-- FIX: was bound to ClientReq.FormName, now WOInfo.FormName -->
                                    <input id="FormName" name="FormName" type="text"
                                           data-ng-model="WOInfo.FormName" class="form-control"
                                           ng-readonly="true"
                                           style="width:100%;height:25px;font-size:smaller;padding-right:35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position:absolute;right:1px;top:50%;transform:translateY(-50%);
                                                   padding:0px 10px;border:2px solid black;background:transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-hide="pageMode==='view'" style="background:#fff;">
                                <button type="button" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right:3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Terms Code</th>
                            <th colspan="13">Terms & Conditions</th>
                            <th ng-hide="pageMode==='view'">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.WOInfoTermsID}}</td>
                            <td class="hidden">{{row.WOInfoID}}</td>
