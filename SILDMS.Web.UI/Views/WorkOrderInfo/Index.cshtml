<script type="text/javascript">

    /* ── Number → Words (South Asian / Lakh-Crore system) ─────────── */
    function numberToWordsTaka(num) {
        num = Math.round(parseFloat(num) || 0);
        if (num === 0) return 'Zero';

        var belowTwenty = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
            'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen',
            'Eighteen', 'Nineteen'];
        var tensWords = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

        function twoDigits(n) {
            if (n < 20) return belowTwenty[n];
            return tensWords[Math.floor(n / 10)] + (n % 10 ? ' ' + belowTwenty[n % 10] : '');
        }
        function threeDigits(n) {
            var h = Math.floor(n / 100);
            var r = n % 100;
            var s = '';
            if (h) s += belowTwenty[h] + ' Hundred';
            if (r) s += (s ? ' ' : '') + twoDigits(r);
            return s;
        }

        var crore = Math.floor(num / 10000000); num %= 10000000;
        var lakh = Math.floor(num / 100000); num %= 100000;
        var thousand = Math.floor(num / 1000); num %= 1000;
        var rest = num;

        var parts = [];
        if (crore) parts.push(threeDigits(crore) + ' Crore');
        if (lakh) parts.push(threeDigits(lakh) + ' Lakh');
        if (thousand) parts.push(threeDigits(thousand) + ' Thousand');
        if (rest) parts.push(threeDigits(rest));

        return parts.join(' ');
    }

    app.controller('WorkOrderInfoCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            /* ── State ── */
            $scope.itemsByPage = 10;
            $scope.pageMode = 'new';   // 'new' | 'view' | 'edit'
            $scope.loading = false;
            $scope.selectedWoItems = [];
            $scope._pendingDeleteTermIndex = -1;

            /* ── Print state ── */
            $scope.PoPrintCollection = [];
            $scope.PoPrintGrandTotal = 0;
            $scope.PoPrintGrandTotalWords = '';

            /* ── Date picker ── */
            $timeout(function () {
                $('.DatePicker').datepicker({ format: "dd/mm/yyyy", autoclose: true })
                    .on('changeDate', function () { $('.datepicker').hide(); });
            }, 300);

            /* ── Models ── */
            function freshWOInfo() {
                var d = new Date();
                var dd = String(d.getDate()).padStart(2, '0');
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                return {
                    WOInfoID: "", ClientID: "", ClientQutnAprvID: "",
                    ClientReqID: "", ClientReqNo: "", ClientName: "",
                    TermsID: "", FormName: "",
                    WONo: "", WOAmt: "0.00",
                    BillCategory: "Normal", BillType: "Default",
                    NoOfInstallment: "", InstallmentAmt: "",
                    WODate: dd + '/' + mm + '/' + d.getFullYear(),
                    Remarks: "", Status: ""
                };
            }
            function freshWOInfoTerm() {
                return { WOInfoTermsID: "", WOInfoID: "", TermsID: "", TermsCode: "", TermsName: "" };
            }

            $scope.WOInfo = freshWOInfo();
            $scope.WOInfoTerm = freshWOInfoTerm();
            $scope.masterDataSetupGridData = [];
            $scope.GridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];

            /* ── Mode helpers ── */
            $scope.switchToEdit = function () {
                $scope.pageMode = 'edit';
            };

            $scope.CancelAndReset = function () { $scope.clearWOInfo(); };

            /* ── Clear / Reset ── */
            $scope.clearWOInfo = function () {
                $scope.pageMode = 'new';
                $scope.selectedWoItems = [];
                $scope.WOInfo = freshWOInfo();
                $scope.WOInfoTerm = freshWOInfoTerm();

                $scope.masterDataSetupGridData = [];
                $scope.GridDisplayCollection = [];
                $scope.ReqTermDataSetupGridData = [];
                $scope.ReqTermGridDisplayCollection = [];

                $scope.PoPrintCollection = [];
                $scope.PoPrintGrandTotal = 0;
                $scope.PoPrintGrandTotalWords = '';

                // Reset file input
                $('#FileUpload1').val('');
                $scope.uploadedFile = null;
            };

            /* ── Installment ── */
            $scope.calculateAmounts = function () {
                if ($scope.WOInfo.BillType === 'Installment') {
                    var wo = parseFloat($scope.WOInfo.WOAmt) || 0;
                    var n = parseFloat($scope.WOInfo.NoOfInstallment) || 0;
                    $scope.WOInfo.InstallmentAmt = n > 0 ? (wo / n).toFixed(2) : '';
                }
            };

            /* ── WO price calc ── */
            /* ── WO Calculation ── */
            $scope.checkWOPrice = function (row) {

                row.WOQnty = parseFloat(row.WOQnty) || 0;
                row.WOPrice = parseFloat(row.WOPrice) || 0;
                row.ASFPerc = parseFloat(row.ASFPerc) || 0;
                row.VatPerc = parseFloat(row.VatPerc) || 0;

                // 1. Base Amount
                row.WOAmt =
                    row.WOPrice * row.WOQnty;

                // 2. ASF Amount
                row.TotGivenASFAmt =
                    row.WOAmt * (row.ASFPerc / 100);

                // 3. VAT on Base + ASF
                var basePlusASF =
                    row.WOAmt + row.TotGivenASFAmt;

                row.VatAmt =
                    basePlusASF * (row.VatPerc / 100);

                // 4. Total
                row.TolAmt =
                    row.WOAmt +
                    row.TotGivenASFAmt +
                    row.VatAmt;

                // Update selected item
                $scope.syncSelectedWoItem(row);

                // Update overall WO amount
                $scope.recalcWOTotal();
            };

            //$scope.checkVatPerc = function (row) {
            //    var vatAmt = ((parseFloat(row.VatPerc) || 0) * (parseFloat(row.WOAmt) || 0)) / 100;
            //    row.VatAmt = vatAmt;
            //    row.TolAmt = (parseFloat(row.WOAmt) || 0) + vatAmt;
            //};

            $scope.syncSelectedWoItem = function (row) {

                var match = $scope.selectedWoItems.find(function (v) {
                    return v.WOInfoItemID === row.WOInfoItemID ||
                        v.ClientQutnAprvItemID === row.ClientQutnAprvItemID;
                });

                if (match) {

                    match.WOQnty = row.WOQnty;
                    match.WOPrice = row.WOPrice;
                    match.WOAmt = row.WOAmt;

                    match.ASFPerc = row.ASFPerc;
                    match.TotGivenASFAmt = row.TotGivenASFAmt;

                    match.VatPerc = row.VatPerc;
                    match.VatAmt = row.VatAmt;

                    match.TolAmt = row.TolAmt;
                }
            };


            $scope.recalcWOTotal = function () {

                var total = 0;

                $scope.selectedWoItems.forEach(function (item) {
                    total += parseFloat(item.TolAmt) || 0;
                });

                $scope.WOInfo.WOAmt = total.toFixed(2);
            };


            function buildSelectedItem(row) {
                return {
                    ClientQutnAprvItemID: row.ClientQutnAprvItemID || '',
                    WOInfoItemID: row.WOInfoItemID || '',

                    ServiceItemID: row.ServiceItemID,
                    ServiceItemName: row.ServiceItemName,
                    ServiceCategoryID: row.ServiceCategoryID,
                    ServiceCategoryName: row.ServiceCategoryName,
                    Description: row.Description,
                    DeliveryLocation: row.DeliveryLocation,
                    DeliveryDate: row.DeliveryDate,
                    DeliveryMode: row.DeliveryMode,

                    QutnUnit: row.QutnUnit,
                    QutnQnty: row.QutnQnty,
                    QutnPrice: row.QutnPrice,
                    QutnAmt: row.QutnAmt,

                    // WO
                    WOQnty: row.WOQnty,
                    WOPrice: row.WOPrice,
                    WOAmt: row.WOAmt,

                    // ASF
                    ASFPerc: row.ASFPerc,
                    TotGivenASFAmt: row.TotGivenASFAmt,

                    // VAT
                    VatPerc: row.VatPerc,
                    VatAmt: row.VatAmt,

                    // Total
                    TolAmt: row.TolAmt
                };
            }
            /* ── Client picker ── */
            $scope.ShowClientList = function () {
                $http.get("/WorkOrderInfo/GetClientInfoList")
                    .success(function (r) {
                        $scope.ClientList = r.ClientInfoList;
                        $scope.ClientDisplayedCollection = [].concat($scope.ClientList);
                    });
                $('#ClientInfoModal').modal('show');
            };

            $scope.toggleClientSelect = function (row) {

                $scope.WOInfo.ClientReqID = row.ClientReqID;
                $scope.WOInfo.ClientReqNo = row.ClientReqNo;
                $scope.WOInfo.ClientID = row.ClientID;
                $scope.WOInfo.ClientName = row.ClientName;
                $scope.WOInfo.Address = row.Address;
                $scope.WOInfo.ClientQutnAprvID = row.ClientQutnAprvID;
                $scope.WOInfo.Remarks = row.Remarks;

                $scope.masterDataSetupGridData = [];
                $scope.GridDisplayCollection = [];
                $scope.ReqTermDataSetupGridData = [];
                $scope.ReqTermGridDisplayCollection = [];
                $scope.selectedWoItems = [];
                $scope.WOInfo.WOAmt = '0.00';

                $http.post('/WorkOrderInfo/GetWOInfoItemList',
                    { ClientQutnAprvID: row.ClientQutnAprvID })
                    .success(function (r) {

                        $scope.masterDataSetupGridData = r.WOInfoItemList;

                        angular.forEach($scope.masterDataSetupGridData, function (item) {

                            item.selected = true;

                            item.WOQnty = parseFloat(item.QutnQnty) || 0;
                            item.WOPrice = parseFloat(item.QutnPrice) || 0;

                            // Calculate values
                            item.WOAmt = item.WOPrice * item.WOQnty;

                            item.ASFPerc = parseFloat(item.ASFPerc) || 0;
                            item.TotGivenASFAmt =
                                item.WOAmt * (item.ASFPerc / 100);

                            item.VatPerc = parseFloat(item.VatPerc) || 0;

                            item.VatAmt =
                                (item.WOAmt + item.TotGivenASFAmt) *
                                (item.VatPerc / 100);

                            item.TolAmt =
                                item.WOAmt +
                                item.TotGivenASFAmt +
                                item.VatAmt;

                            // Push fully calculated item
                            $scope.selectedWoItems.push(buildSelectedItem(item));
                        });

                        $scope.GridDisplayCollection =
                            [].concat($scope.masterDataSetupGridData);

                        $scope.recalcWOTotal();
                    });

                $http.post('/WorkOrderInfo/GetWOInfoTermList',
                    { ClientQutnAprvID: row.ClientQutnAprvID })
                    .success(function (r) {
                        $scope.ReqTermDataSetupGridData = r.WOInfoTermList;
                        $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    });

                $('#ClientInfoModal').modal('hide');
            };

            /* ── Search modal ── */
            $scope.SearchWOInfoModal = function () {
                $http.post("/WorkOrderInfo/GetWOInfoSearchList")
                    .success(function (r) {
                        $scope.woInfoSearchList = r.woInfoSearchList;
                        $scope.clientReqDisplayedCollection = [].concat($scope.woInfoSearchList);
                    });
                $('#SearchWOInfoModal').modal('show');
            };

            /* ── Load existing WO (view OR edit) ── */
            $scope.toggleWOInfoSelect = function (tableRow, mode) {
                $scope.clearWOInfo();
                $scope.pageMode = mode;

                // Populate header — including fields now returned by the fixed SP
                $scope.WOInfo.WOInfoID = tableRow.WOInfoID;
                $scope.WOInfo.ClientID = tableRow.ClientID;
                $scope.WOInfo.ClientQutnAprvID = tableRow.ClientQutnAprvID;
                $scope.WOInfo.ClientName = tableRow.ClientName;
                $scope.WOInfo.Address = tableRow.Address;
                $scope.WOInfo.WONo = tableRow.WONo;
                $scope.WOInfo.WODate = tableRow.WODate;
                $scope.WOInfo.WOAmt = tableRow.WOAmt;
                $scope.WOInfo.BillCategory = tableRow.BillCategory || 'Normal';
                $scope.WOInfo.BillType = tableRow.BillType || 'Default';
                $scope.WOInfo.NoOfInstallment = tableRow.NoOfInstallment || '';
                $scope.WOInfo.InstallmentAmt = tableRow.InstallmentAmt || '';
                $scope.WOInfo.Remarks = tableRow.Remarks;
                $scope.WOInfo.Status = tableRow.Status;
                $scope.WOInfo.DocumentID = tableRow.DocumentID || "";

                // Load saved items — all pre-selected (they were saved = chosen)
                $http.post('/WorkOrderInfo/GetWOInfoSearchItemList',
                    { WOInfoID: tableRow.WOInfoID })
                    .success(function (r) {
                        $scope.selectedWoItems = [];

                        r.WOInfoItemList.forEach(function (item) {
                            item.selected = true;
                            $scope.selectedWoItems.push(buildSelectedItem(item));
                        });

                        $scope.masterDataSetupGridData = r.WOInfoItemList;
                        $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                    });

                $http.post('/WorkOrderInfo/GetWOInfoSearchTermsList',
                    { WOInfoID: tableRow.WOInfoID })
                    .success(function (r) {
                        $scope.ReqTermDataSetupGridData = r.WOInfoTermList;
                        $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    });

                // Sync date picker to loaded value
                $timeout(function () {
                    $('#WODate').val($scope.WOInfo.WODate);
                }, 200);

                $('#SearchWOInfoModal').modal('hide');
            };

            /* ── Terms helpers ── */
            $scope.ShowTermsConditionsList = function () {
                $http.get("/WorkOrderInfo/GetTermsConditionsList")
                    .success(function (r) {
                        $scope.TermsConditionsList = r.termsConditionsList;
                        $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    });
                $('#WOInfoTermsConditionsModal').modal('show');
            };

            $scope.toggleTermsConditionsSelect = function (row) {
                $scope.WOInfo.TermsID = row.TermsID;
                $scope.WOInfo.FormName = row.FormName;
                $http.post('/WorkOrderInfo/GetWOInfoTermAgainstFormList', { TermsID: row.TermsID })
                    .success(function (r) {
                        $scope.ReqTermDataSetupGridData = r.WOInfoTermList;
                        $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    });
                $('#WOInfoTermsConditionsModal').modal('hide');
            };

            $scope.AddReqTermModal = function () {
                if (!$scope.WOInfo.ClientName) { toastr.error("Client Name Required"); return; }
                //if (!$('#WONo').val()) { toastr.error("Work Order No. Required"); return; }
                if (!$('#WODate').val()) { toastr.error("Work Order Date Required"); return; }
                $('#RequisitionTermModal').modal('show');
            };

            $scope.AddReqTerm = function () {
                if (!$('#TermsCode').val()) { toastr.error("Terms Code Required"); return; }
                if (!$('#TermsName').val()) { toastr.error("Terms Name Required."); return; }

                var term = {
                    WOInfoTermsID: "", WOInfoID: "", TermsID: "",
                    TermsCode: $('#TermsCode').val(),
                    TermsName: $('#TermsName').val()
                };
                $scope.ReqTermGridDisplayCollection =
                    $scope.ReqTermGridDisplayCollection.concat(term);
                $scope.resetWOInfoTerm();
                $("#btnAddReqTerm").html('Add');
                $('#RequisitionTermModal').modal('hide');
            };

            $scope.resetWOInfoTerm = function () {
                $scope.WOInfoTerm = freshWOInfoTerm();
            };

            $scope.toggleReqTermEdit = function (tableRow, idx) {
                $scope.resetWOInfoTerm();
                $scope.WOInfoTerm.WOInfoTermID = tableRow.WOInfoTermID;
                $scope.WOInfoTerm.WOInfoID = tableRow.WOInfoID;
                $scope.WOInfoTerm.TermsID = tableRow.TermsID;
                $scope.WOInfoTerm.TermsCode = tableRow.TermsCode;
                $scope.WOInfoTerm.TermsName = tableRow.TermsName;
                $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                $("#btnAddReqTerm").html('Update');
                $('#RequisitionTermModal').modal('show');
            };

            $scope.toggleReqTermDelete = function (tableRow, idx) {
                if (!tableRow.WOInfoTermID) {
                    // Not yet persisted — remove from grid only
                    $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                    toastr.success('Term removed.');
                } else {
                    $scope.WOInfoTerm.WOInfoTermID = tableRow.WOInfoTermID;
                    $scope._pendingDeleteTermIndex = idx;
                    $('#deleteReqTermModal').modal('show');
                }
            };

            $scope.DeleteWOInfoTerm = function () {
                $http.post('/WorkOrderInfo/DeleteWOInfoItemAndTerm', {
                    WOInfoItemID: '',
                    WOInfoTermID: $scope.WOInfoTerm.WOInfoTermID
                }).success(function (r) {
                    if (r.status === 'S203') {
                        var idx = $scope._pendingDeleteTermIndex;
                        if (idx >= 0) $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                        $scope._pendingDeleteTermIndex = -1;
                        $scope.resetWOInfoTerm();
                        toastr.success('Term deleted successfully.');
                    } else {
                        toastr.error('Delete returned: ' + r.status);
                    }
                }).error(function () { toastr.error('Delete failed.'); });
            };

            /* ── Save / Update ── */
            $scope.Post = function () {

                if (!$scope.WOInfo.ClientName) {
                    toastr.error("Client Name Required");
                    return;
                }

                if (!$('#WONo').val()) {
                    toastr.error("Work Order No. Required");
                    return;
                }

                if (!$('#WODate').val()) {
                    toastr.error("Work Order Date Required");
                    return;
                }

                if ($scope.selectedWoItems.length === 0) {
                    toastr.error("Must select at least one item to save");
                    return;
                }

                // Validate file BEFORE save/update
                if ($scope.uploadedFile) {

                    var fileInput = document.getElementById("FileUpload1");

                    if (fileInput && fileInput.files.length > 0) {

                        var file = fileInput.files[0];
                        var ext = file.name.split('.').pop().toLowerCase();
                        var maxSizeInMB = 2;

                        if (ext !== "pdf") {
                            toastr.error("Please upload PDF files only.");
                            return;
                        }

                        if (file.size > (maxSizeInMB * 1024 * 1024)) {
                            toastr.error("File size must be 2 MB or less.");
                            return;
                        }
                    }
                }

                $scope.WOInfo.WODate = $('#WODate').val();
                $scope.WOInfo.TolalItem = $scope.GridDisplayCollection.length;
                $scope.WOInfo.SelectedItem = $scope.selectedWoItems.length;

                $scope.loading = true;

                $http.post('/WorkOrderInfo/SaveWorkOrderInfo', {
                    woInfo: $scope.WOInfo,
                    woInfoItem: $scope.selectedWoItems,
                    woInfoTerm: $scope.ReqTermGridDisplayCollection
                })
                    .success(function (r) {

                        $scope.loading = false;

                        if (r.status === 'S201') {

                            toastr.success("Data Saved Successfully.");

                            if ($scope.uploadedFile) {
                                $scope.SaveDocument(r.WOInfoID);
                            } else {
                                $scope.clearWOInfo();
                                $timeout(function () {
                                    window.location.reload();
                                }, 1500);
                            }

                            return;
                        }

                        if (r.status === 'S202') {

                            toastr.success("Data Updated Successfully.");

                            if ($scope.uploadedFile) {
                                $scope.SaveDocument(r.WOInfoID);
                            } else {
                                $scope.clearWOInfo();
                                $scope.toggleRefreshTable();
                            }

                            return;
                        }

                        if (r.status === 'S203') {
                            toastr.success("Data Deleted Successfully.");
                            $scope.clearWOInfo();
                            return;
                        }

                        toastr.error("Data Save Failed. Status: " + r.status);
                    })
                    .error(function () {
                        $scope.loading = false;
                        toastr.error("Data Save Failed.");
                    });
            };


            $scope.uploadedFile = null;
            $scope.fileSelected = function (element) {
                $scope.$apply(function () {
                    $scope.uploadedFile = element.files.length > 0 ? element.files[0] : null;
                });
            };

            $scope.SaveDocument = function (WOInfoID) {

                var fileInput = document.getElementById("FileUpload1");

                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    toastr.error("Please select a PDF file.");
                    return;
                }

                var file = fileInput.files[0];
                var ext = file.name.split('.').pop().toLowerCase();
                var maxSizeInMB = 2;

                // File validation
                if (ext !== "pdf") {
                    toastr.error("Only PDF files are allowed.");
                    return;
                }

                if (file.size > (maxSizeInMB * 1024 * 1024)) {
                    toastr.error("File size must be 2 MB or less.");
                    return;
                }

                $scope.loading = true;

                var documentID = "WO_" + WOInfoID;

                var formData = new FormData();
                formData.append("file", file);
                formData.append("serverUrl", "MCL/WorkOrder");
                formData.append("documentID", documentID);
                formData.append("ext", "pdf");

                $.ajax({
                    url: "/WorkOrderInfo/SaveDocument",
                    type: "POST",
                    data: formData,
                    contentType: false,
                    processData: false,

                    success: function (result) {

                        if (result && result.Message &&
                            result.Message.toLowerCase().indexOf("success") > -1) {

                            $http.post("/WorkOrderInfo/UpdateDocumentID", {
                                WOInfoID: WOInfoID,
                                DocumentID: documentID
                            })
                                .success(function (resp) {

                                    if (resp.status === "S200") {

                                        $scope.WOInfo.DocumentID = documentID;

                                        toastr.success("Document uploaded successfully.");

                                        fileInput.value = "";
                                        $scope.uploadedFile = null;

                                        $scope.clearWOInfo();
                                        $scope.toggleRefreshTable();
                                    }
                                    else {
                                        toastr.error(resp.message || "Failed to save document information.");
                                    }
                                })
                                .error(function () {
                                    toastr.error("Document uploaded, but failed to update database record.");
                                });
                        }
                        else {
                            toastr.error(result.Message || "File upload failed.");
                        }

                        $scope.$applyAsync();
                    },

                    error: function (xhr) {

                        var errorMessage = "Document upload failed.";

                        if (xhr.responseJSON) {

                            if (xhr.responseJSON.Exception) {
                                errorMessage += " " + xhr.responseJSON.Exception;
                            }

                            if (xhr.responseJSON.Status) {
                                errorMessage += " (" + xhr.responseJSON.Status + ")";
                            }
                        }

                        toastr.error(errorMessage);
                        console.error(xhr);

                        $scope.$applyAsync();
                    },

                    complete: function () {
                        $scope.loading = false;
                        $scope.$applyAsync();
                    }
                });
            };

            // ── View Document ───────────────────────────────────────────────────────
            $scope.ViewDocument = function () {
                if (!$scope.WOInfo.WOInfoID) {
                    toastr.error("No record selected to view document.");
                    return;
                }

                $scope.loading = true;

                // BUG FIX: Use DocumentID from ClientReq model if available, otherwise fall back to CR_ + ID
                var docID = ($scope.WOInfo.DocumentID && $scope.WOInfo.DocumentID !== "")
                    ? $scope.WOInfo.DocumentID
                    : "CR_" + $scope.WOInfo.ClientReqID;

                var requestUrl = "/WorkOrderInfo/ViewDocument?" +
                    "&serverUrl=" + encodeURIComponent("MCL/WorkOrder") +
                    "&DocID=" + encodeURIComponent(docID) +
                    "&ext=" + encodeURIComponent("pdf");

                $http.get(requestUrl, { responseType: 'arraybuffer' })
                    .then(function (response) {
                        var file = new Blob([response.data], { type: 'application/pdf' });
                        var fileURL = URL.createObjectURL(file);
                        $("#pdfViewer").attr("src", fileURL + "#view=Fit");
                        $('#ShowPDFModal').modal('show');
                    })
                    .catch(function (error) {
                        toastr.error("Failed to load the PDF. The document may not have been uploaded yet.");
                        console.error(error);
                    })
                    .finally(function () {
                        $scope.loading = false;
                    });
            };

            /* ── Service category change ── */
            $scope.ServiceCategoryChange = function () {
                var id = $scope.WOInfoItem ? $scope.WOInfoItem.ServiceCategory.ServiceCategoryID : '';
                if (!id) return;
                $http.post("/ServiceItemInfo/GetServiceItemInfoSearchList?ServiceItemCategoryID=" + id)
                    .success(function (r) { $scope.serviceItems = r.ServiceItemInfoSearchList; });
            };

            /* ── Print current Work Order ─────────────────────────────── */
            $scope.printCurrentWO = function () {
                if ($scope.selectedWoItems.length === 0) {
                    toastr.error("No items to print for this Work Order.");
                    return;
                }

                $scope.PoPrintCollection = [].concat($scope.selectedWoItems);

                var grandTotal = 0;
                $scope.PoPrintCollection.forEach(function (row) {
                    grandTotal += parseFloat(row.TolAmt || 0);
                });
                $scope.PoPrintGrandTotal = grandTotal;
                $scope.PoPrintGrandTotalWords = numberToWordsTaka(grandTotal);

                $scope.loading = true;

                $timeout(function () {
                    document.getElementById('masterRow').style.display = 'block';
                    $scope.printData();

                    $timeout(function () {
                        document.getElementById('masterRow').style.display = 'none';
                        $scope.loading = false;
                    }, 800);
                }, 200);
            };

            /* ── Actual Print via Iframe ─────────────────────────────── */
            $scope.printData = function () {
                var slip = document.getElementById("masterRow");
                if (!slip) return;

                var iframe = document.createElement('iframe');
                iframe.style.cssText = 'position:absolute;width:0;height:0;border:none;';
                document.body.appendChild(iframe);

                var doc = iframe.contentWindow.document;
                doc.open();
                doc.write('<html><head><title>Work Order - ' + ($scope.WOInfo.WONo || '') + '</title>');
                doc.write(`
                    <style>
                        /* Removing the page margin removes the space Chrome/Edge use
                           to draw the default print header (date/title) and
                           footer (url/page number) — this hides them without
                           touching the browser's print-dialog checkbox. */
                        @@page {
                            size: auto;
                            margin: 0;
                        }
                        html, body {
                            margin: 0;
                            padding: 0;
                        }
                        body {
                            font-family: Arial, sans-serif;
                            padding: 20px;
                            box-sizing: border-box;
                        }
                        table{border-collapse:collapse; width:100%; margin:10px 0;}
                        td, th{padding:6px 8px; border:1px solid #555; font-size:12px;}
                        th{background:#f0f0f0;}
                        .row{display:flex; flex-wrap:wrap; justify-content:space-between;}
                        p{margin:3px 0;}
                        .text-center{text-align:center;}
                    </style>
                `);
                doc.write('</head><body>');
                doc.write(slip.outerHTML);
                doc.write('</body></html>');
                doc.close();

                iframe.contentWindow.focus();
                iframe.contentWindow.print();

                // Cleanup
                setTimeout(() => document.body.removeChild(iframe), 1000);
            };

            /* ── Refresh ── */
            $scope.toggleRefreshTable = function () {
                $timeout(function () { window.location.reload(); }, 1500);
            };

        }]);
</script>
