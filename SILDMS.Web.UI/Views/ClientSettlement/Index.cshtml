@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .mode-badge {
        display: inline-block; padding: 3px 10px; border-radius: 4px;
        font-size: 11px; font-weight: bold; margin-left: 10px; vertical-align: middle;
    }
    .mode-list { background: #d9edf7; color: #31708f; border: 1px solid #bce8f1; }
    .mode-view { background: #dff0d8; color: #3c763d; border: 1px solid #d6e9c6; }
    .mode-edit { background: #fcf8e3; color: #8a6d3b; border: 1px solid #faebcc; }

    .input-readonly { background-color: #ffffff !important; cursor: default; }

    .po-info-box {
        background: #f5f5f5; border: 1px solid #ddd; border-radius: 4px;
        padding: 8px 14px; margin-bottom: 8px; font-size: 13px;
    }
    .po-info-box strong { color: #31708f; }

    .section-title {
        background-color: #cbd4d9; padding: 0.6%; border-radius: 4px;
        font-size: 14px; font-weight: bold; margin-bottom: 6px;
    }

    .status-pending {
        color: #8a6d3b; background: #fcf8e3; border: 1px solid #faebcc;
        border-radius: 3px; padding: 1px 7px; font-size: 11px;
    }
    .status-done {
        color: #3c763d; background: #dff0d8; border: 1px solid #d6e9c6;
        border-radius: 3px; padding: 1px 7px; font-size: 11px;
    }

    .calc-box {
        background: #eef6fb; border: 1px solid #bce8f1; border-radius: 4px;
        padding: 10px 14px; font-size: 14px;
    }
    .calc-box table { width: 100%; }
    .calc-box td { padding: 3px 4px; }
    .calc-box td.amt { text-align: right; font-weight: bold; color: #31708f; width: 160px; }
    .calc-box tr.total td { border-top: 2px solid #31708f; font-size: 16px; }
    .calc-box .minus { color: #a94442; }

    .due-highlight { font-weight: bold; color: #a94442; }
    .sub-title {
        font-weight: bold; color: #31708f; margin: 4px 15px 8px 15px;
        border-bottom: 1px solid #bbb; padding-bottom: 3px;
    }
</style>

<div class="box box-primary box-body" ng-controller="ClientSettlementCtrl">

    <!-- TOOLBAR -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;border-radius:5px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Client Settlement
            <span ng-show="p===2" class="mode-badge mode-list">COLLECTION LIST</span>
            <span ng-show="p===1 && pageMode==='view'" class="mode-badge mode-view">VIEW HISTORY</span>
            <span ng-show="p===1 && pageMode==='edit'" class="mode-badge mode-edit">NEW SETTLEMENT ENTRY</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">

                <div class="btn-group pull-right" style="margin-left:4px;">
                    <button class="button-custom btn-warning" type="button"
                            ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                        <i class="fa fa-refresh" ng-class="{'fa-spin':isRefreshing}" style="padding-right:5px"></i> Refresh
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1 && pageMode==='edit'">
                    <button class="button-custom btn-success" type="button" ng-click="Post()" ng-disabled="isSaving">
                        <i class="fa fa-check" style="padding-right:5px"></i> Save Settlement
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1">
                    <button class="button-custom btn-default" type="button" ng-click="goBackToList()">
                        <i class="fa fa-arrow-left" style="padding-right:5px"></i> Back
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ p===2 : LIST ══════════════ -->
    <div ng-show="p===2">
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">

            <div ng-show="ListDisplayedCollection.length<=0" style="text-align:center;padding:20px;">
                <h4 style="color:red;">
                    Nothing to settle yet.
                    <br /><small>A collection appears here once it has an AIT amount, or the VAT is paid by the Client.</small>
                </h4>
            </div>

            <div ng-show="ListDisplayedCollection.length>0" class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Client Settlement List</div>

                <table st-table="ListDisplayedCollection" st-safe-src="List"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Client Name</th>
                            <th>Project Name</th>
                            <th>Requisition No</th>
                            <th>WO No</th>
                            <th>Money Receipt No</th>
                            <th style="text-align:right;">AIT Amount</th>
                            <th style="text-align:right;">AIT Due</th>
                            <th style="text-align:right;">VAT Amount (Client)</th>
                            <th style="text-align:right;">Mushak Due</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ListDisplayedCollection" style="height:20px;font-size:13px;">
                            <td>{{row.ClientName}}</td>
                            <td>{{row.ProjectName}}</td>
                            <td class="text-center">{{row.ClientReqNo}}</td>
                            <td class="text-center">{{row.WONo}}</td>
                            <td class="text-center">{{row.MoneyReceiptNo}}</td>
                            <td style="text-align:right;">{{row.AITAmountTotal | number:2}}</td>
                            <td style="text-align:right;" ng-class="{'due-highlight': row.AITDue > 0}">{{row.AITDue | number:2}}</td>
                            <td style="text-align:right;">{{row.VATAmount | number:2}}</td>
                            <td style="text-align:right;" ng-class="{'due-highlight': row.MushakDue > 0}">{{row.MushakDue | number:2}}</td>
                            <td class="text-center">
                                <span ng-show="row.SettlementStatus==='Settled'" class="status-done">Settled</span>
                                <span ng-show="row.SettlementStatus!=='Settled'" class="status-pending">{{row.SettlementStatus}}</span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-flat btn-primary" ng-click="openDetail(row, 'view')">
                                    <i class="fa fa-eye"></i> View
                                </button>
                                <button type="button" class="btn btn-sm btn-flat btn-success" style="margin-left:3px;"
                                        ng-show="row.SettlementStatus!=='Settled'" ng-click="openDetail(row, 'edit')">
                                    <i class="fa fa-plus"></i> Add Settlement
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="11" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div><!-- /p===2 -->

    <!-- ══════════════ p===1 : DETAIL ══════════════ -->
    <div ng-show="p===1">

        <!-- Summary bar -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box">
                    <div class="row">
                        <div class="col-lg-3"><strong>WO No:</strong>&nbsp;{{Settlement.WONo}}</div>
                        <div class="col-lg-3"><strong>Client:</strong>&nbsp;{{Settlement.ClientName}}</div>
                        <div class="col-lg-3"><strong>Project:</strong>&nbsp;{{Settlement.ProjectName}}</div>
                        <div class="col-lg-3"><strong>Status:</strong>&nbsp;{{Settlement.SettlementStatus}}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- The bill collection this settlement belongs to, with its detail grid -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Bill Collection</div>

                <div class="calc-box" style="margin-bottom:10px;">
                    <table>
                        <tr>
                            <td>Bill Total (with ASF {{Settlement.ASFPerc | number:2}}% and VAT {{Settlement.VatPerc | number:2}}%)</td>
                            <td class="amt">{{Settlement.BillItemsAmount | number:2}}</td>
                        </tr>
                        <tr ng-show="Settlement.AdvanceAdjustedAmt > 0">
                            <td class="minus">less: Advance already received</td>
                            <td class="amt minus">- {{Settlement.AdvanceAdjustedAmt | number:2}}</td>
                        </tr>
                        <tr>
                            <td class="minus">
                                less: AIT paid by Client
                                <span class="text-muted" style="font-size:12px;">
                                    (ASF {{Settlement.BillItemsASFAmt | number:2}} - AIT {{Settlement.AITAmountTotal | number:2}} = Net ASF {{Settlement.NetASFAmount | number:2}})
                                </span>
                            </td>
                            <td class="amt minus">- {{Settlement.AITAmountTotal | number:2}}</td>
                        </tr>
                        <tr ng-show="Settlement.VATPaidBy==='Client'">
                            <td class="minus">less: VAT ({{Settlement.VatPerc | number:2}}%) paid directly by Client</td>
                            <td class="amt minus">- {{Settlement.VATAmount | number:2}}</td>
                        </tr>
                        <tr class="total">
                            <td>
                                Collection Amount
                                <span class="text-muted" style="font-size:12px;">
                                    (Money Receipt {{Settlement.MoneyReceiptNo}}, received {{Settlement.ReceiveDate}})
                                </span>
                            </td>
                            <td class="amt">{{Settlement.CollectionAmount | number:2}}</td>
                        </tr>
                    </table>
                </div>

                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Description</th>
                            <th style="text-align:right;">Qty</th>
                            <th style="text-align:right;">Price</th>
                            <th style="text-align:right;">Amount (excl. ASF/VAT)</th>
                            <th style="text-align:right;">ASF (%)</th>
                            <th style="text-align:right;">ASF Amt</th>
                            <th style="text-align:right;">VAT (%)</th>
                            <th style="text-align:right;">VAT Amt</th>
                            <th style="text-align:right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ItemList" ng-cloak>
                            <td>{{row.Description}}</td>
                            <td style="text-align:right;">{{row.BillQty | number:2}}</td>
                            <td style="text-align:right;">{{row.BillPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.BillAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillASFPerc | number:2}}%</td>
                            <td style="text-align:right;">{{row.BillASFAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillVatPerc | number:2}}%</td>
                            <td style="text-align:right;">{{row.BillVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillTotalAmt | number:2}}</td>
                        </tr>
                        <tr ng-if="ItemList.length===0">
                            <td colspan="9" class="text-center text-danger">No items found for this bill</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:bold;background:#f9f9f9;">
                            <td colspan="3" class="text-right">Bill Total</td>
                            <td style="text-align:right;">{{Settlement.BillItemsAmountWithoutASFVat | number:2}}</td>
                            <td style="text-align:right;">{{Settlement.ASFPerc | number:2}}%</td>
                            <td style="text-align:right;">{{Settlement.BillItemsASFAmt | number:2}}</td>
                            <td style="text-align:right;">{{Settlement.VatPerc | number:2}}%</td>
                            <td style="text-align:right;">{{Settlement.BillItemsVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{Settlement.BillItemsAmount | number:2}}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Settlement entries already recorded -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Settlement History</div>
                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Entered On</th>
                            <th style="text-align:right;">Challan Received</th>
                            <th style="text-align:right;">AIT Due After</th>
                            <th>AIT Challan No</th>
                            <th>AIT Challan Date</th>
                            <th>AIT Document</th>
                            <th style="text-align:right;">Mushak Received</th>
                            <th style="text-align:right;">Mushak Due After</th>
                            <th>Mushak No</th>
                            <th>Mushak Date</th>
                            <th>Mushak Document</th>
                            <th>Entered By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="h in History" ng-cloak>
                            <td>{{h.SetOn}}</td>
                            <td style="text-align:right;">{{h.AITChallanReceiveAmt | number:2}}</td>
                            <td style="text-align:right;">{{h.AITDueAmt | number:2}}</td>
                            <td>{{h.AITChallanNo}}</td>
                            <td>{{h.AITChallanDate}}</td>
                            <td>
                                <a ng-show="h.HasAITDoc==='1'" target="_blank"
                                   ng-href="/ClientSettlement/DownloadSettlementDocument?ClientSettlementID={{h.ClientSettlementID}}&DocType=AIT">
                                    {{h.AITDocName}}
                                </a>
                            </td>
                            <td style="text-align:right;">{{h.MushakReceiveAmt | number:2}}</td>
                            <td style="text-align:right;">{{h.MushakDueAmt | number:2}}</td>
                            <td>{{h.MushakNo}}</td>
                            <td>{{h.MushakDate}}</td>
                            <td>
                                <a ng-show="h.HasMushakDoc==='1'" target="_blank"
                                   ng-href="/ClientSettlement/DownloadSettlementDocument?ClientSettlementID={{h.ClientSettlementID}}&DocType=Mushak">
                                    </i> {{h.MushakDocName}}
                                </a>
                            </td>
                            <td>{{h.SetBy}}</td>
                        </tr>
                        <tr ng-if="History.length===0">
                            <td colspan="12" class="text-center text-muted">No settlement has been recorded yet</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- New entry form (edit mode only) -->
        <div ng-show="pageMode==='edit'" class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:10px;">

            <!-- AIT -->
            <div ng-show="showAIT">
                <div class="sub-title">AIT (paid by Client)</div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>AIT Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly" readonly="readonly"
                               ng-model="Settlement.AITAmountTotal" />
                    </div>
                    <div class="col-lg-2"><label>Challan Receive Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                               ng-model="Entry.AITChallanReceiveAmt" ng-disabled="aitFullyReceived"
                               ng-change="recalculateDue()" />
                        <div class="text-muted" style="font-size:11px;" ng-show="aitFullyReceived">AIT challan already received in full.</div>
                        <div class="text-danger" style="font-size:11px;" ng-show="aitOver">
                            Cannot exceed the AIT due ({{Settlement.AITDue | number:2}}).
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>AIT Due Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly due-highlight" readonly="readonly"
                               ng-value="aitDueAfter | number:2" />
                    </div>
                    <div class="col-lg-2"><label>AIT Challan No:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" maxlength="50"
                               ng-model="Entry.AITChallanNo" ng-disabled="aitFullyReceived" />
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>AIT Challan Date:</label></div>
                    <div class="col-lg-3">
                        <input id="AITChallanDate" type="text" autocomplete="off" class="DatePicker form-control"
                               placeholder="DD/MM/YYYY" ng-model="Entry.AITChallanDate" ng-disabled="aitFullyReceived" />
                    </div>
                    <div class="col-lg-2"><label>AIT Document:</label></div>
                    <div class="col-lg-3">
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               file-model="Files.ait" ng-disabled="aitFullyReceived" />
                        <div class="text-muted" style="font-size:11px;">PDF, JPG or PNG, up to 5 MB.</div>
                    </div>
                </div>
            </div>

            <!-- Mushak -->
            <div ng-show="showMushak">
                <div class="sub-title" style="margin-top:14px;">VAT / Mushak (mandatory — VAT paid by Client)</div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>VAT Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly" readonly="readonly"
                               ng-model="Settlement.VATAmount" />
                    </div>
                    <div class="col-lg-2"><label>Mushak Receive Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                               ng-model="Entry.MushakReceiveAmt" ng-disabled="mushakFullyReceived"
                               ng-change="recalculateDue()" />
                        <div class="text-muted" style="font-size:11px;" ng-show="mushakFullyReceived">Mushak already received in full.</div>
                        <div class="text-danger" style="font-size:11px;" ng-show="mushakOver">
                            Cannot exceed the Mushak due ({{Settlement.MushakDue | number:2}}).
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>Mushak Due Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly due-highlight" readonly="readonly"
                               ng-value="mushakDueAfter | number:2" />
                    </div>
                    <div class="col-lg-2"><label>Mushak No:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" maxlength="50"
                               ng-model="Entry.MushakNo" ng-disabled="mushakFullyReceived" />
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>Mushak Date:</label></div>
                    <div class="col-lg-3">
                        <input id="MushakDate" type="text" autocomplete="off" class="DatePicker form-control"
                               placeholder="DD/MM/YYYY" ng-model="Entry.MushakDate" ng-disabled="mushakFullyReceived" />
                    </div>
                    <div class="col-lg-2"><label>Mushak Document:</label></div>
                    <div class="col-lg-3">
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               file-model="Files.mushak" ng-disabled="mushakFullyReceived" />
                        <div class="text-muted" style="font-size:11px;">PDF, JPG or PNG, up to 5 MB.</div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-top:6px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-10 text-muted" style="font-size:12px;">
                    Each save records one receipt. If an amount is still due afterwards, come back and add another entry when the next challan / Mushak arrives.
                </div>
            </div>
        </div>

    </div><!-- /p===1 -->

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div><!-- /box -->

<script type="text/javascript">

    // Lets <input type="file" file-model="Files.ait"> publish the chosen File onto the scope.
    app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            link: function (scope, element, attrs) {
                var model = $parse(attrs.fileModel);
                element.on('change', function () {
                    scope.$apply(function () {
                        model.assign(scope, element[0].files[0] || null);
                    });
                });
            }
        };
    }]);

    app.controller('ClientSettlementCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            $scope.itemsByPage = 10;
            $scope.loading = false;
            $scope.isSaving = false;
            $scope.isRefreshing = false;
            $scope.p = 2;
            $scope.pageMode = 'view';

            $scope.List = [];
            $scope.ListDisplayedCollection = [];
            $scope.ItemList = [];
            $scope.History = [];
            $scope.Settlement = {};
            $scope.Files = { ait: null, mushak: null };

            $scope.showAIT = false;
            $scope.showMushak = false;
            $scope.aitFullyReceived = false;
            $scope.mushakFullyReceived = false;
            $scope.aitDueAfter = 0;
            $scope.mushakDueAfter = 0;
            $scope.aitOver = false;
            $scope.mushakOver = false;

            var MAX_BYTES = 5 * 1024 * 1024;
            var ALLOWED = ['pdf', 'jpg', 'jpeg', 'png'];

            function num(v) { return parseFloat(v) || 0; }
            function round2(v) { return Math.round(v * 100) / 100; }

            function emptyEntry() {
                return {
                    AITChallanReceiveAmt: "", AITChallanNo: "", AITChallanDate: "",
                    MushakReceiveAmt: "", MushakNo: "", MushakDate: ""
                };
            }
            $scope.Entry = emptyEntry();

            /* ── Initial load ── */
            $scope.loading = true;
            $http.post("/ClientSettlement/GetClientSettlementList/")
                .then(function (res) {
                    $scope.List = res.data.ClientSettlementList || [];
                    $scope.ListDisplayedCollection = [].concat($scope.List);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load settlement list.");
                });

            /* ── Dues after this entry (the server recomputes them from stored entries) ── */
            $scope.recalculateDue = function () {
                var aitDue = num($scope.Settlement.AITDue);
                var mushakDue = num($scope.Settlement.MushakDue);
                var aitIn = num($scope.Entry.AITChallanReceiveAmt);
                var mushakIn = num($scope.Entry.MushakReceiveAmt);

                $scope.aitOver = aitIn > aitDue || aitIn < 0;
                $scope.mushakOver = mushakIn > mushakDue || mushakIn < 0;
                $scope.aitDueAfter = round2(aitDue - aitIn);
                $scope.mushakDueAfter = round2(mushakDue - mushakIn);
            };

            function datePickerInit(selector, ns, assign) {
                $(selector).datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                    .off('changeDate.' + ns)
                    .on('changeDate.' + ns, function (ev) {
                        $scope.$apply(function () { assign($(ev.target).val()); });
                        $('.datepicker').hide();
                    });
            }

            /* ── Open detail. view = history only; edit = add one more entry ── */
            $scope.openDetail = function (row, mode) {
                $scope.loading = true;
                $scope.p = 1;
                $scope.pageMode = mode;
                $scope.Settlement = row;
                $scope.Entry = emptyEntry();
                $scope.Files = { ait: null, mushak: null };

                $scope.showAIT = num(row.AITAmountTotal) > 0;
                $scope.showMushak = row.VATPaidBy === 'Client' && num(row.VATAmount) > 0;
                $scope.aitFullyReceived = $scope.showAIT && num(row.AITDue) <= 0;
                $scope.mushakFullyReceived = $scope.showMushak && num(row.MushakDue) <= 0;
                $scope.recalculateDue();

                if (mode === 'edit') {
                    $timeout(function () {
                        datePickerInit('#AITChallanDate', 'ait', function (v) { $scope.Entry.AITChallanDate = v; });
                        datePickerInit('#MushakDate', 'mushak', function (v) { $scope.Entry.MushakDate = v; });
                    }, 100);
                }

                $http.post("/ClientSettlement/GetClientSettlementBillItem", { ClientFinalBillID: row.ClientFinalBillID })
                    .then(function (res) {
                        $scope.ItemList = res.data.ClientSettlementBillItemList || [];
                    }, function () {
                        toastr.error("Failed to load bill items.");
                    });

                $http.post("/ClientSettlement/GetClientSettlementHistory", { ClientBillCollectionID: row.ClientBillCollectionID })
                    .then(function (res) {
                        $scope.History = res.data.ClientSettlementHistory || [];
                        $scope.loading = false;
                    }, function () {
                        $scope.loading = false;
                        toastr.error("Failed to load settlement history.");
                    });
            };

            $scope.goBackToList = function () {
                $scope.p = 2;
                $scope.pageMode = 'view';
                $scope.Settlement = {};
                $scope.ItemList = [];
                $scope.History = [];
                $scope.Entry = emptyEntry();
                $scope.Files = { ait: null, mushak: null };
            };

            var statusMessages = {
                E404: "Collection not found.",
                E420: "Enter a receive amount for AIT, Mushak, or both.",
                E421: "AIT challan amount is invalid or exceeds the AIT due.",
                E422: "AIT Challan No and Challan Date are required.",
                E423: "Mushak amount is invalid or exceeds the Mushak due.",
                E424: "Mushak No and Mushak Date are required.",
                E440: "Session expired. Please sign in again."
            };

            function fileProblem(file, label) {
                if (!file) return null;
                var ext = (file.name.split('.').pop() || '').toLowerCase();
                if (ALLOWED.indexOf(ext) === -1) return label + ": only PDF, JPG or PNG files are allowed.";
                if (file.size > MAX_BYTES) return label + ": the file is larger than 5 MB.";
                return null;
            }

            /* ── Save (multipart: text fields + the two optional documents) ── */
            $scope.Post = function () {
                var e = $scope.Entry;
                var aitIn = num(e.AITChallanReceiveAmt);
                var mushakIn = num(e.MushakReceiveAmt);

                $scope.recalculateDue();
                if (aitIn <= 0 && mushakIn <= 0) { toastr.error(statusMessages.E420); return; }

                var aitDate = $('#AITChallanDate').val() || e.AITChallanDate;
                var mushakDate = $('#MushakDate').val() || e.MushakDate;

                if (aitIn > 0) {
                    if (!$scope.showAIT || $scope.aitOver) { toastr.error(statusMessages.E421); return; }
                    if (!e.AITChallanNo || !e.AITChallanNo.trim() || !aitDate) { toastr.error(statusMessages.E422); return; }
                }
                if (mushakIn > 0) {
                    if (!$scope.showMushak || $scope.mushakOver) { toastr.error(statusMessages.E423); return; }
                    if (!e.MushakNo || !e.MushakNo.trim() || !mushakDate) { toastr.error(statusMessages.E424); return; }
                }

                var problem = (aitIn > 0 ? fileProblem($scope.Files.ait, "AIT Document") : null) ||
                              (mushakIn > 0 ? fileProblem($scope.Files.mushak, "Mushak Document") : null);
                if (problem) { toastr.error(problem); return; }

                var fd = new FormData();
                fd.append('ClientBillCollectionID', $scope.Settlement.ClientBillCollectionID);
                fd.append('AITChallanReceiveAmt', aitIn > 0 ? aitIn : 0);
                fd.append('AITChallanNo', aitIn > 0 ? e.AITChallanNo.trim() : '');
                fd.append('AITChallanDate', aitIn > 0 ? aitDate : '');
                fd.append('MushakReceiveAmt', mushakIn > 0 ? mushakIn : 0);
                fd.append('MushakNo', mushakIn > 0 ? e.MushakNo.trim() : '');
                fd.append('MushakDate', mushakIn > 0 ? mushakDate : '');
                if (aitIn > 0 && $scope.Files.ait) fd.append('AITDocument', $scope.Files.ait);
                if (mushakIn > 0 && $scope.Files.mushak) fd.append('MushakDocument', $scope.Files.mushak);

                $scope.isSaving = true;
                $http.post('/ClientSettlement/SaveClientSettlementInfo', fd, {
                    transformRequest: angular.identity,
                    headers: { 'Content-Type': undefined }
                }).then(function (res) {
                    $scope.isSaving = false;
                    var s = res.data.status;
                    if (s === 'S201') {
                        toastr.success("Settlement entry saved.");
                        $scope.toggleRefreshTable();
                    } else {
                        toastr.error(res.data.msg || statusMessages[s] || ("Save Failed. Status: " + (s || "unknown")));
                    }
                }, function () {
                    $scope.isSaving = false;
                    toastr.error("Save Failed.");
                });
            };

            $scope.toggleRefreshTable = function () {
                $scope.isRefreshing = true;
                $timeout(function () { window.location.reload(); }, 1200);
            };

        }]);
</script>
