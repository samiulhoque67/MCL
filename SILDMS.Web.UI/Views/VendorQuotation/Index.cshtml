    @*==================== PDF VIEWER MODAL ==================== *@
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header" style="padding: 5px 10px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Document Viewer</h4>
                </div>
                <div class="modal-body" style="padding: 0; margin: 0;">
                    <iframe id="pdfViewer" style="width: 100%; height: 100vh; border: none;"
                            title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

</div>

<script type="text/javascript">

    $(document).ready(function () {
        var today = new Date();
        var day = String(today.getDate()).padStart(2, '0');
        var month = String(today.getMonth() + 1).padStart(2, '0');
        var year = today.getFullYear();
        var formattedDate = day + '/' + month + '/' + year;
        $('#QuotationDate').val(formattedDate);
        $('#QutnReceivedDate').val(formattedDate);
    });

    app.controller('VendorQuotationCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        $scope.vendorQutnItemArray = [];
        $scope.vendorQutnTermArray = [];
        $scope.itemsByPage = 10;
        $scope.viewmode = false;   // BUG FIX: declare upfront

        // ── Service categories ───────────────────────────────────────────────────
        $http.get('/VendorQuotation/GetServicesCategory')
            .success(function (response) {
                $scope.serviceCategorys = response.result;
                $scope.loading = false;
            }).error(function () { });

        // ── Master model ─────────────────────────────────────────────────────────
        $scope.VendorQutn = {
            VendorQutnID: "",
            ClientID: "",
            ClientName: "",
            VendorID: "",
            VendorName: "",
            VendorReqID: "",
            ClientReqID: "",
            ClientReqNo: "",
            TermsID: "",
            FormName: "",
            VendorQutnNo: "",
            AutoVendorQutnNo: "",
            QuotationDate: "",
            QutnReceivedDate: "",   // BUG FIX: was "ReceivedDate" in some places
            ProjectName: "",
            Remarks: "",
            RequisitionNo: "",
            RequisitionDate: "",
            SubmissionDate: "",
            LastDateofQuotation: "",
            Status: ""
        };

        // ── Item model ───────────────────────────────────────────────────────────
        $scope.VendorQutnItem = {
            VendorQutnItemID: "", VendorQutnID: "",
            Description: "", DeliveryLocation: "", DeliveryDate: "",
            ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
            ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
            DeliveryMode: "", ReqQnty: "", ReqUnit: "",
            QutnQnty: "", QutnPrice: "", QutnUnit: "",
            QutnAmt: "", VatPerc: "", VatAmt: "", TolAmt: "", CsStatus: ""
        };

        // ── Term model ───────────────────────────────────────────────────────────
        $scope.VendorQutnTerm = {
            VendorQutnTermsID: "", VendorQutnID: "",
            TermsID: "", TermsCode: "", TermsName: ""
        };

        // ── Grids ────────────────────────────────────────────────────────────────
        $scope.masterDataSetupGridData = [];
        $scope.GridDisplayCollection = [];
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];

        // ── DatePicker init ──────────────────────────────────────────────────────
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        }).on('changeDate', function () {
            $('.datepicker').hide();
        });

        // ── Calculation helpers ──────────────────────────────────────────────────
        $scope.checkUnitPrice = function (row) {
            var qty = parseFloat(row.QutnQnty) || 0;
            var price = parseFloat(row.QutnPrice) || 0;
            row.QutnAmt = parseFloat((qty * price).toFixed(2));
            // Recalculate VAT and total after Amt changes
            $scope.checkVatPerc(row);
        };

        $scope.checkVatPerc = function (row) {
            var vatPerc = parseFloat(row.VatPerc) || 0;
            var qutnAmt = parseFloat(row.QutnAmt) || 0;
            row.VatAmt = parseFloat(((vatPerc * qutnAmt) / 100).toFixed(2));
            row.TolAmt = parseFloat((qutnAmt + row.VatAmt).toFixed(2));
        };

        // ── Cancel (BUG FIX: was referenced but never defined) ───────────────────
        $scope.Cancel = function () {
            $scope.clearVendorQutn();
        };

        // ── Clear / reset ────────────────────────────────────────────────────────
        $scope.clearVendorQutn = function () {
            $scope.viewmode = false;

            // inside clearVendorQutn, add to the VendorQutn reset object:
            $scope.VendorQutn = {
                VendorQutnID: "",
                ClientID: "",
                ClientName: "",
                VendorID: "",
                VendorName: "",
                VendorQutnNo: "",
                QuotationDate: "",
                QutnReceivedDate: "",
                Remarks: "",
                DocumentID: "",   // ← NEW
                Status: ""
            };
            $scope.resetVendorQutnItem();
            $scope.resetVendorQutnTerm();

            $scope.masterDataSetupGridData = [];
            $scope.GridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.vendorQutnItemArray = [];
            $scope.vendorQutnTermArray = [];

            $('#DeliveryDate').val('');
            $('#FileUpload1').val('');
            $scope.uploadedFile = null;

            // Reset today's dates
            var today = new Date();
            var d = String(today.getDate()).padStart(2, '0');
            var m = String(today.getMonth() + 1).padStart(2, '0');
            var y = today.getFullYear();
            var td = d + '/' + m + '/' + y;
            $('#QuotationDate').val(td);
            $('#QutnReceivedDate').val(td);
        };

        $scope.resetVendorQutnItem = function () {
            $('#DeliveryDate').val('');
            $scope.VendorQutnItem = {
                VendorQutnItemID: "", VendorQutnID: "",
                ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
                ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
                Description: "", DeliveryLocation: "", DeliveryDate: "",
                DeliveryMode: "", ReqQnty: "", ReqUnit: "",
                QutnQnty: "", QutnPrice: "", QutnUnit: "",
                QutnAmt: "", VatPerc: "", VatAmt: "", TolAmt: "", CsStatus: ""
            };
        };

        $scope.resetVendorQutnTerm = function () {
            $scope.VendorQutnTerm = {
                VendorQutnTermsID: "", VendorQutnID: "",
                TermsID: "", TermsCode: "", TermsName: ""
            };
        };

        // ── Show Vendor Req List ─────────────────────────────────────────────────
        $scope.ShowVendorReqList = function () {
            $http.get("/VendorQuotation/GetShowVendorReqList")
                .success(function (response) {
                    $scope.VendorReqList = response.VendorReqList;
                    $scope.VendorReqDisplayedCollection = [].concat($scope.VendorReqList);
                    $scope.loading = false;
                }).error(function () { });
            $('#VendorReqInfoModal').modal('show');
        };

        // ── Select Vendor Req (new quotation) ────────────────────────────────────
        $scope.toggleVendorReqSelect = function (row) {
            $scope.VendorQutn.ClientID = row.ClientID;
            $scope.VendorQutn.ClientReqID = row.ClientReqID;
            $scope.VendorQutn.ClientReqNo = row.ClientReqNo;
            $scope.VendorQutn.VendorID = row.VendorID;
            $scope.VendorQutn.VendorReqID = row.VendorReqID;
            $scope.VendorQutn.ClientName = row.ClientName;
            $scope.VendorQutn.VendorName = row.VendorName;
            $scope.VendorQutn.RequisitionNo = row.RequisitionNo;
            $scope.VendorQutn.RequisitionDate = row.RequisitionDate;
            $scope.VendorQutn.SubmissionDate = row.SubmissionDate;
            $scope.VendorQutn.LastDateofQuotation = row.LastDateofQuotation;
            $scope.VendorQutn.ProjectName = row.Remarks;
            $scope.VendorQutn.Remarks = row.Remarks;

            $scope.masterDataSetupGridData = [];
            $scope.GridDisplayCollection = [];
            $scope.vendorQutnItemArray = [];

            $http.post('/VendorQuotation/GetVendorReqItemListForVenQutn',
                { VendorID: row.VendorID, VendorReqID: row.VendorReqID })
                .success(function (response) {
                    $scope.masterDataSetupGridData = response.VendorReqItemList;
                    $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                    // BUG FIX: initialise calculation fields to 0 so validation doesn't fail on untouched rows
                    $scope.GridDisplayCollection.forEach(function (item) {
                        item.QutnQnty = item.QutnQnty || item.ReqQnty || 0;
                        item.QutnPrice = item.QutnPrice || 0;
                        item.QutnAmt = item.QutnAmt || 0;
                        item.VatPerc = item.VatPerc || 0;
                        item.VatAmt = item.VatAmt || 0;
                        item.TolAmt = item.TolAmt || 0;
                        item.isInvalid = false;
                    });
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            $http.post('/VendorRequisition/GetVendorReqTermList', { VendorReqID: row.VendorReqID })
                .success(function (response) {
                    $scope.ReqTermDataSetupGridData = response.VendorReqTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            $('#VendorReqInfoModal').modal('hide');
        };

        // ── Service category change ──────────────────────────────────────────────
        $scope.ServiceCategoryChange = function () {
            var ServiceCategoryID = $scope.VendorQutnItem.ServiceCategory.ServiceCategoryID;
            $http.post("/ServiceItemInfo/GetServiceItemInfoSearchList?ServiceItemCategoryID=" + ServiceCategoryID)
                .success(function (response) {
                    $scope.serviceItems = response.ServiceItemInfoSearchList;
                    $scope.loading = false;
                }).error(function () { });
        };

        // ── Search Vendor Quotation Modal ────────────────────────────────────────
        $scope.SearchVendorQutnModal = function () {
            $scope.GetVendorQutnSearchList();
            $('#SearchVendorQutnModal').modal('show');
        };

        $scope.GetVendorQutnSearchList = function () {
            $http.post("/VendorQuotation/GetVendorQutnSearchList")
                .success(function (response) {
                    $scope.vendorQutnSearchList = response.vendorQutnSearchList;
                    $scope.vendorQutnDisplayedCollection = [].concat($scope.vendorQutnSearchList);
                }).error(function () { });
        };

        // ── Select Vendor Quotation (View / Edit) ────────────────────────────────
        // BUG FIX: viewmode was hard-coded to true — should depend on ProcessStatus.
        // Also QuotationDate/QutnReceivedDate not set into the datepicker fields.
        $scope.toggleVendorQutnSelect = function (tableRow, mode) {

            $scope.clearVendorQutn();

            // View mode
            $scope.viewmode = (mode === 'view');

            // OR stricter validation:
            // $scope.viewmode = (tableRow.ProcessStatus !== 'Rcvd' || mode === 'view');

            $scope.VendorQutn.VendorQutnID = tableRow.VendorQutnID;
            $scope.VendorQutn.ClientID = tableRow.ClientID;
            $scope.VendorQutn.ClientName = tableRow.ClientName;
            $scope.VendorQutn.VendorID = tableRow.VendorID;
            $scope.VendorQutn.VendorName = tableRow.VendorName;
            $scope.VendorQutn.VendorQutnNo = tableRow.VendorQutnNo;
            $scope.VendorQutn.AutoVendorQutnNo = tableRow.AutoVendorQutnNo;
            $scope.VendorQutn.QuotationDate = tableRow.QuotationDate;
            $scope.VendorQutn.QutnReceivedDate = tableRow.QutnReceivedDate;
            $scope.VendorQutn.RequisitionNo = tableRow.RequisitionNo;
            $scope.VendorQutn.RequisitionDate = tableRow.RequisitionDate;
            $scope.VendorQutn.VendorReqID = tableRow.VendorReqID;
            $scope.VendorQutn.ProjectName = tableRow.ProjectName;
            $scope.VendorQutn.Remarks = tableRow.Remarks;
            $scope.VendorQutn.Status = tableRow.Status;
            $scope.VendorQutn.DocumentID = tableRow.DocumentID;
            //VendorQutn.ProjectName
            // Set datepicker fields
            $timeout(function () {

                if (tableRow.QuotationDate) {
                    $('#QuotationDate').val(tableRow.QuotationDate);
                }

                if (tableRow.QutnReceivedDate) {
                    $('#QutnReceivedDate').val(tableRow.QutnReceivedDate);
                }

            }, 100);

            // Load items
            $http.post('/VendorQuotation/GetVendorQutnItemList', {
                VendorQutnID: tableRow.VendorQutnID
            }).success(function (response) {

                $scope.masterDataSetupGridData = response.VendorQutnItemList;
                $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);

                // Recalculate total amount
                $scope.GridDisplayCollection.forEach(function (item) {

                    var qutnAmt = parseFloat(item.QutnAmt) || 0;
                    var vatAmt = parseFloat(item.VatAmt) || 0;

                    item.TolAmt = parseFloat((qutnAmt + vatAmt).toFixed(2));
                    item.isInvalid = false;

                });

                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            // Load terms
            $http.post('/VendorQuotation/GetVendorQutnTermList', {
                VendorQutnID: tableRow.VendorQutnID
            }).success(function (response) {

                $scope.ReqTermDataSetupGridData = response.VendorQutnTermList;
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);

                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            $('#SearchVendorQutnModal').modal('hide');
        };

        // ── Terms & Conditions ───────────────────────────────────────────────────
        $scope.ShowTermsConditionsList = function () {
            $http.get("/VendorQuotation/GetTermsConditionsList")
                .success(function (response) {
                    $scope.TermsConditionsList = response.termsConditionsList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { });
            $('#VendorQutnTermsConditionsModal').modal('show');
        };

        $scope.toggleTermsConditionsSelect = function (row) {
            $scope.VendorQutn.TermsID = row.TermsID;
            $scope.VendorQutn.FormName = row.FormName;
            $http.post('/VendorQuotation/GetVendorQutnTermAgainstFormList', { TermsID: row.TermsID })
                .success(function (response) {
                    $scope.ReqTermDataSetupGridData = response.VendorQutnTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#VendorQutnTermsConditionsModal').modal('hide');
        };

        // ── Add Term Modal ───────────────────────────────────────────────────────
        $scope.AddReqTermModal = function () {
            if (!$scope.VendorQutn.VendorName) {
                toastr.error("Vendor Name Required"); return;
            }
            if (!$scope.VendorQutn.VendorQutnNo) {
                toastr.error("Vendor Quotation No. Required"); return;
            }
            // BUG FIX: was checking '#ReceivedDate' which doesn't exist — correct id is '#QutnReceivedDate'
            if ($('#QutnReceivedDate').val() === "") {
                toastr.error("Quotation Received Date Required."); return;
            }
            if ($('#QuotationDate').val() === "") {
                toastr.error("Quotation Date Required"); return;
            }
            $scope.resetVendorQutnTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('show');
        };

        $scope.AddReqTerm = function () {
            if (!$scope.VendorQutnTerm.TermsCode) {
                toastr.error("Terms Code Required"); return;
            }
            if (!$scope.VendorQutnTerm.TermsName) {
                toastr.error("Terms Name Required."); return;
            }
            $scope.vendorQutnTermArray.push(angular.copy($scope.VendorQutnTerm));
            $scope.ReqTermGridDisplayCollection = $scope.ReqTermGridDisplayCollection
                .concat(angular.copy($scope.VendorQutnTerm));
            $scope.resetVendorQutnTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('hide');
        };

        // BUG FIX: toggleReqTermEdit typo `tableRow.VendorQutnTermD` → `tableRow.VendorQutnTermID`
        $scope.toggleReqTermEdit = function (tableRow, idx) {
            $scope.resetVendorQutnTerm();
            $scope.VendorQutnTerm.VendorQutnTermsID = tableRow.VendorQutnTermID;  // BUG FIX: was VendorQutnTermD
            $scope.VendorQutnTerm.VendorQutnID = tableRow.VendorQutnID;
            $scope.VendorQutnTerm.TermsID = tableRow.TermsID;
            $scope.VendorQutnTerm.TermsCode = tableRow.TermsCode;
            $scope.VendorQutnTerm.TermsName = tableRow.TermsName;
            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
            $scope.vendorQutnTermArray.splice(idx, 1);
            $('#btnAddReqTermLabel').text('Update');
            $('#RequisitionTermModal').modal('show');
        };

        // BUG FIX: $i was undefined in delete callbacks — use stored index
        $scope.pendingDeleteTermIndex = null;

        $scope.toggleReqTermDelete = function (tableRow, idx) {
            if (!tableRow.VendorQutnTermID) {
                $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                $scope.vendorQutnTermArray.splice(idx, 1);
                toastr.success('Term Deleted Successfully');
            } else {
                $scope.VendorQutnTerm.VendorQutnTermsID = tableRow.VendorQutnTermID;
                $scope.pendingDeleteTermIndex = idx;
                $('#deleteReqTermModal').modal('show');
            }
        };

        // BUG FIX: button called DeleteReqTerm() but function was DeleteVendorQutnTerm();
        //          also $i was undefined — now uses pendingDeleteTermIndex
        $scope.DeleteReqTerm = function () {
            var idx = $scope.pendingDeleteTermIndex;
            $http.post('/VendorQuotation/DeleteVendorQutnItemAndTerm',
                { VendorQutnItemID: "", VendorQutnTermID: $scope.VendorQutnTerm.VendorQutnTermsID })
                .success(function (response) {
                    if (response.status === "S203") {
                        if (idx !== null) {
                            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                            $scope.vendorQutnTermArray.splice(idx, 1);
                            $scope.pendingDeleteTermIndex = null;
                        }
                        $scope.resetVendorQutnTerm();
                        toastr.success('Term Deleted Successfully');
                    }
                }).error(function () { toastr.error('Delete Failed'); });
        };

        // BUG FIX: DeleteVendorQutnItem also used undefined $i — stored index
        $scope.pendingDeleteItemIndex = null;

        $scope.toggleReqItemDelete = function (tableRow, idx) {
            if (!tableRow.VendorQutnItemID) {
                $scope.GridDisplayCollection.splice(idx, 1);
                $scope.vendorQutnItemArray.splice(idx, 1);
                toastr.success('Item Deleted Successfully');
            } else {
                $scope.VendorQutnItem.VendorQutnItemID = tableRow.VendorQutnItemID;
                $scope.pendingDeleteItemIndex = idx;
                $('#deleteReqItemModal').modal('show');
            }
        };

        $scope.DeleteVendorQutnItem = function () {
            var idx = $scope.pendingDeleteItemIndex;
            $http.post('/VendorQuotation/DeleteVendorQutnItemAndTerm',
                { VendorQutnItemID: $scope.VendorQutnItem.VendorQutnItemID, VendorQutnTermID: "" })
                .success(function (response) {
                    if (response.status === "S203") {
                        if (idx !== null) {
                            $scope.GridDisplayCollection.splice(idx, 1);
                            $scope.vendorQutnItemArray.splice(idx, 1);
                            $scope.pendingDeleteItemIndex = null;
                        }
                        $scope.resetVendorQutnItem();
                        toastr.success('Item Deleted Successfully');
                    }
                }).error(function () { toastr.error('Delete Failed'); });
        };

        // ── File handling ────────────────────────────────────────────────────────
        $scope.uploadedFile = null;
        $scope.fileSelected = function (element) {
            $scope.$apply(function () {
                $scope.uploadedFile = element.files.length > 0 ? element.files[0] : null;
            });
        };

        // ── Save ─────────────────────────────────────────────────────────────────
        $scope.Post = function () {

            if (!$('#VendorName').val()) { toastr.error("Vendor Name Required"); return; }
            if (!$('#VendorQutnNo').val()) { toastr.error("Vendor QutnNo. Required"); return; }
            if ($('#QuotationDate').val() == "") { toastr.error("Quotation Date Required"); return; }
            if ($('#QutnReceivedDate').val() == "") { toastr.error("Qutn. Received Date Required"); return; }

            $scope.VendorQutn.QuotationDate = $('#QuotationDate').val();
            $scope.VendorQutn.QutnReceivedDate = $('#QutnReceivedDate').val();

            function isNumber(val) {
                return val !== null && val !== undefined && val !== "" && !isNaN(val);
            }

            var invalidRows = $scope.GridDisplayCollection.filter(function (row) {
                return !isNumber(row.QutnAmt) || !isNumber(row.VatPerc) ||
                    !isNumber(row.VatAmt) || !isNumber(row.TolAmt);
            });

            if (invalidRows.length > 0) {
                toastr.error("All rows must have valid Qutn Amount, VAT %, VAT Amount, and Total Amount.");
                return;
            }

            $scope.loading = true;

            $http.post('/VendorQuotation/SaveVendorQuotation', {
                vendorQutn: $scope.VendorQutn,
                vendorQutnItem: $scope.GridDisplayCollection,
                vendorQutnTerm: $scope.ReqTermGridDisplayCollection
            })
                .success(function (response) {
                    $scope.loading = false;

                    if (response.status === "S201") {
                        toastr.success("Data Saved Successfully.");
                        $scope.VendorQutn.VendorQutnID = response.VendorQutnID; // ← keep ID live

                        if ($scope.uploadedFile) {
                            $scope.SaveDocument(response.VendorQutnID, function () {
                                $scope.clearVendorQutn();
                                window.location.reload();
                            });
                        } else {
                            $scope.clearVendorQutn();
                            window.location.reload();
                        }
                        window.location.reload();
                        return;
                    }

                    if (response.status === "S202") {
                        toastr.success("Data Updated Successfully.");
                        $scope.VendorQutn.VendorQutnID = response.VendorQutnID;

                        if ($scope.uploadedFile) {
                            // replace existing document
                            $scope.SaveDocument(response.VendorQutnID, function () {
                                $scope.viewmode = true; // stay in view/edit mode
                            });
                        }
                        window.location.reload();
                        return;
                    }

                    if (response.status === "ERROR_Duplicate") {
                        toastr.error("This quotation no. already exists");
                        return;
                    }

                    toastr.error("Data Save Failed.");
                })
                .error(function () {
                    $scope.loading = false;
                    toastr.error("Data Save Failed.");
                });
        };

        // ── Document upload ──────────────────────────────────────────────────────
        $scope.SaveDocument = function (VendorQutnID, callback) {
            var fileUpload = document.getElementById("FileUpload1");
            var files = fileUpload.files;

            if (files.length === 0) {
                toastr.error("Please select a file to upload.");
                return;
            }

            var file = files[0];
            var ext = file.name.split('.').pop().toLowerCase();

            if (file.size > 2 * 1024 * 1024) {
                toastr.error("File size must be 2 MB or less.");
                return;
            }
            if (ext !== "pdf") {
                toastr.error("Please upload PDF files only.");
                return;
            }

            $scope.loading = true;

            var documentID = "VR_" + VendorQutnID;

            var formData = new FormData();
            formData.append("file", file);
            formData.append("serverUrl", "MCL/Vendor_Requisition");
            formData.append("documentID", documentID);
            formData.append("ext", "pdf");
            // serverIP/ftpPort/ftpUser/ftpPassword are read from config server-side

            $.ajax({
                url: '/VendorQuotation/SaveDocument',
                type: 'POST',
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    // ← persist DocumentID into the DB row
                    $http.post('/VendorQuotation/UpdateDocumentID', {
                        VendorQutnID: VendorQutnID,
                        DocumentID: documentID
                    }).success(function () {
                        $scope.VendorQutn.DocumentID = documentID; // keep scope in sync
                        toastr.success("Document uploaded successfully.");
                        document.getElementById("FileUpload1").value = "";
                        if (callback) callback();
                    }).error(function () {
                        toastr.warning("File uploaded but DocumentID not saved.");
                        if (callback) callback();
                    });
                },
                error: function (err) {
                    toastr.error("Document upload failed. Please try again.");
                    console.error(err);
                    $scope.loading = false;
                },
                complete: function () {
                    $scope.loading = false;
                }
            });
        };

        // ── View Document ────────────────────────────────────────────────────────
        $scope.ViewDocument = function () {
            // Use stored DocumentID if present, otherwise build it
            var docID = $scope.VendorQutn.DocumentID
                ? $scope.VendorQutn.DocumentID
                : "VR_" + $scope.VendorQutn.VendorQutnID;

            var requestUrl = "/VendorQuotation/ViewDocument?" +
                "serverUrl=" + encodeURIComponent("MCL/Vendor_Requisition") +
                "&DocID=" + encodeURIComponent(docID) +
                "&ext=pdf";

            $scope.loading = true;

            $http.get(requestUrl, { responseType: 'arraybuffer' })
                .then(function (response) {
                    var blob = new Blob([response.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(blob);
                    $("#pdfViewer").attr("src", fileURL + "#view=Fit");
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function () {
                    toastr.error("Failed to load the PDF. No document may be attached.");
                })
                .finally(function () {
                    $scope.loading = false;
                });
        };

        // ── Refresh ──────────────────────────────────────────────────────────────
        $scope.toggleRefreshTable = function () {
            window.location.reload();
        };

        $scope.ResetSearchModel = function () { /* placeholder */ };

    }]);
</script>
