@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header {
        font-size: 12px;
    }

    .btn {
        font-size: 12px;
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }

    input.form-control, button.form-control {
        font-size: 12px;
    }

    label {
        font-size: 12px;
    }

    .fa {
        font-size: 12px;
    }

    .text-success {
        color: green;
        font-size: 14px;
    }

    .text-primary {
        color: blue;
        font-size: 14px;
    }

    .row-invalid {
        background-color: #ffe0e0 !important;
    }
</style>

<div class="box box-primary box-body" ng-controller="VendorQuotationCtrl">

    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">Vendor Quotation</h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="button-custom btn-warning">
                        <i class="fa fa-refresh" style="padding-right: 5px"></i> Refresh
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="SearchVendorQutnModal()" class="button-custom btn-primary">
                        <i class="fa fa-search" style="padding-right: 5px"></i> Search
                    </button>
                </div>

                @*BUG FIX: btnSave was never defined — Save disabled in viewmode, Cancel never disabled *@
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Post()" class="button-custom btn-primary"
                            ng-disabled="viewmode">
                        <i class="fa fa-save" style="padding-right: 5px"></i>
                        {{ VendorQutn.VendorQutnID ? 'Update' : 'Save' }}
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    @*BUG FIX: Cancel() was referenced but never defined *@
                    <button type="button" data-ng-click="Cancel()" class="button-custom btn-danger">
                        <i class="fa fa-times" style="padding-right: 5px;"></i> Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="box-body" style="margin: 1%; padding: 5px;">
        <div class="row">

            @*Vendor Search *@
            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="VendorName">Quoted Vendor :</label>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    <div style="position: relative;">
                        <input id="VendorName" name="VendorName" type="text"
                               data-ng-model="VendorQutn.VendorName"
                               class="form-control" ng-readonly="true"
                               placeholder="Vendor Name"
                               style="height: 25px; font-size: smaller;" />
                        @*BUG FIX: Hide search button in viewmode *@
                        <button type="button" data-ng-click="ShowVendorReqList()"
                                ng-hide="viewmode"
                                style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                       padding: 0px 10px; border: 2px solid black; background: transparent;">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="ClientName">Client Name :</label>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="form-group">
                        <input id="ClientName" name="ClientName" type="text"
                               data-ng-model="VendorQutn.ClientName"
                               class="form-control" placeholder="Client Name" ng-readonly="true" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="ProjectName">Project Name :</label>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="form-group">
                        <textarea id="ProjectName" name="ProjectName"
                                  data-ng-model="VendorQutn.ProjectName"
                                  class="form-control" placeholder="Project Name"
                                  ng-readonly="true"></textarea>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label>Vendor Quotation No.:</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input id="VendorQutnNo" autocomplete="off" name="VendorQutnNo" type="text"
                               class="form-control" placeholder="Vendor Quotation No"
                               ng-model="VendorQutn.VendorQutnNo"
                               ng-readonly="viewmode" />
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="form-group">
                        <label>Quotation No:</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input id="AutoVendorQutnNo" name="AutoVendorQutnNo"
                               class="form-control" placeholder="Auto Quotation No"
                               ng-model="VendorQutn.VendorQutnID" ng-readonly="true" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label>Quotation Date</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input id="QuotationDate" name="QuotationDate" type="text"
                               class="DatePicker form-control" autocomplete="off"
                               placeholder="DD/MM/YYYY"
                               ng-model="VendorQutn.QuotationDate"
                               ng-readonly="viewmode" />
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="form-group">
                        <label>Quotation Received Date:</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        <input id="QutnReceivedDate" name="QutnReceivedDate" type="text"
                               class="DatePicker form-control" autocomplete="off"
                               placeholder="DD/MM/YYYY"
                               ng-model="VendorQutn.QutnReceivedDate"
                               ng-readonly="viewmode" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="QuotationFor">Quotation For:</label>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="form-group">
                        <textarea id="Remarks" name="Remarks" data-ng-model="VendorQutn.Remarks"
                                  class="form-control" placeholder="Quotation For"
                                  ng-readonly="viewmode"></textarea>
                    </div>
                </div>
            </div>

            @*Document Upload / View *@
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group">
                    <label for="upload_documents">
                        Upload Documents <br>
                        (<span style="color:#ff4900;">PDF Only, Max Size 2MB</span>)
                    </label>
                </div>
            </div>

            <!-- File input: hide in view mode -->
            <div ng-hide="viewmode" class="col-lg-2">

                <div class="form-group">
                    <input type="file" style="height:25px;float:left;margin-top:5px;"
                           id="FileUpload1" accept=".pdf"
                           ng-model="uploadedFile"
                           onchange="angular.element(this).scope().fileSelected(this)" />

                </div>

            </div>


            <div  ng-hide="viewmode" class="col-lg-2">


                <!-- View button — only when a document exists -->
                <button ng-show="VendorQutn.DocumentID"
                        ng-click="ViewDocument()"
                        class="btn button-custom btn-sm">
                    <i class="fa fa-eye"></i> View
                </button>
            </div>

            <!-- In edit mode: allow re-upload AND view existing doc -->
            <div ng-show="viewmode" class="col-lg-5">
                <div class="form-group" style="display:flex; gap:8px; align-items:center;">


                    <!-- View button — only when a document exists -->
                    <button ng-show="VendorQutn.DocumentID"
                            ng-click="ViewDocument()"
                            class="btn button-custom btn-sm">
                        <i class="fa fa-eye"></i> View
                    </button>

                    <span ng-hide="VendorQutn.DocumentID"
                          style="color:#999; font-size:11px;">No document attached</span>
                </div>
            </div>
        </div>

        </div>
    </div>

    @*==================== VENDOR REQ SELECTION MODAL ==================== *@
    <div id="VendorReqInfoModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="VendorReqDisplayedCollection" st-safe-src="VendorReqList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="4" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Vendor Requisition Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-2">Client Name</th>
                                <th class="col-lg-2">Project Name</th>
                                <th class="col-lg-2">Vendor Name</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="Remarks" placeholder="Project Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="VendorName" placeholder="Vendor Name" class="input-sm form-control" type="search" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in VendorReqDisplayedCollection">
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="hidden">{{row.ClientReqID}}</td>
                                <td class="hidden">{{row.ClientReqNo}}</td>
                                <td class="hidden">{{row.VendorID}}</td>
                                <td class="hidden">{{row.VendorReqID}}</td>
                                <td class="hidden">{{row.RequisitionNo}}</td>
                                <td class="hidden">{{row.RequisitionDate}}</td>
                                <td class="hidden">{{row.LastDateofQuotation}}</td>
                                <td class="text-left">{{row.ClientName}}</td>
                                <td class="text-left">{{row.Remarks}}</td>
                                <td class="text-left">{{row.VendorName}}</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleVendorReqSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @*==================== SEARCH VENDOR QUOTATION MODAL ==================== *@
    <div id="SearchVendorQutnModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="vendorQutnDisplayedCollection" st-safe-src="vendorQutnSearchList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="7" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Vendor Quotation Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th style="width:18%;">Client Name</th>
                                <th style="width:18%;">Vendor Name</th>
                                <th style="width:20%;">Vendor Quotation No</th>
                                <th style="width:12%;">Quotation Date</th>
                                <th style="width:12%;">Received Date</th>
                                <th style="width:8%;">Status</th>
                                <th style="width:12%;">Action</th>
                            </tr>

                            <tr>
                                <th>
                                    <input st-search="ClientName"
                                           placeholder="Search Client"
                                           class="input-sm form-control"
                                           type="search" />
                                </th>

                                <th>
                                    <input st-search="VendorName"
                                           placeholder="Search Vendor"
                                           class="input-sm form-control"
                                           type="search" />
                                </th>

                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr ng-repeat="row in vendorQutnDisplayedCollection">

                                <td class="hidden">{{row.VendorQutnID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="hidden">{{row.VendorID}}</td>
                                <td class="hidden">{{row.ProcessStatus}}</td>
                                <td class="hidden">{{row.RequisitionNo}}</td>
                                <td class="hidden">{{row.RequisitionDate}}</td>
                                <td class="hidden">{{row.AutoVendorQutnNo}}</td>
                                <td class="hidden">{{row.Remarks}}</td>

                                <td class="text-left">
                                    {{row.ClientName}}
                                </td>

                                <td class="text-left">
                                    {{row.VendorName}}
                                </td>

                                <td class="text-left">
                                    {{row.VendorQutnNo}}
                                </td>

                                <td class="text-center">
                                    {{row.QuotationDate}}
                                </td>

                                <td class="text-center">
                                    {{row.QutnReceivedDate}}
                                </td>

                                <td class="text-center">
                                    <span ng-class="row.Status=='1'
                                      ? 'label label-success'
                                      : 'label label-danger'">

                                        {{row.Status == '1'
                                    ? 'Active'
                                    : 'InActive'}}
                                    </span>
                                </td>

                                <td class="text-center">

                                    <!-- Edit -->
                                    <button type="button"
                                            class="btn btn-success btn-xs"
                                            ng-if="row.ProcessStatus == 'Rcvd'"
                                            ng-click="toggleVendorQutnSelect(row, 'edit')">

                                        <i class="fa fa-pencil"></i> Edit
                                    </button>

                                    <!-- View -->
                                    <button type="button"
                                            class="btn btn-primary btn-xs"
                                            ng-click="toggleVendorQutnSelect(row, 'view')">

                                        <i class="fa fa-eye"></i> View
                                    </button>

                                </td>

                            </tr>

                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="100"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @*==================== QUOTATION ITEM GRID ==================== *@
    <div class="row" style="margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 5px 10px;">
        <div class="row">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px;">
                            <th colspan="15" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                Quotation Item List
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: left;">Service Category</th>
                            <th style="text-align: left;">Description</th>
                            <th style="text-align: left;">Delivery Location</th>
                            <th style="text-align: left;">Delivery Date</th>
                            <th style="text-align: left;">Delivery Mode</th>
                            <th style="text-align: left;">Req Qnty</th>
                            <th style="text-align: left;">Req Unit</th>
                            <th style="text-align: left;">Qutn Qnty</th>
                            <th style="text-align: left;">Qutn Price</th>
                            <th style="text-align: left;">Qutn Amt</th>
                            <th style="text-align: left;">Vat(%)</th>
                            <th style="text-align: left;">Vat Amt</th>
                            <th style="text-align: left;">Tot Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in GridDisplayCollection" ng-cloak
                            ng-class="{'row-invalid': row.isInvalid}"
                            style="font-size:12px;">
                            <td class="hidden">{{row.VendorQutnItemID}}</td>
                            <td class="hidden">{{row.VendorQutnID}}</td>
                            <td style="width:5%;">{{row.ServiceItemName}}</td>
                            <td style="width:6%;">{{row.ServiceCategoryName}}</td>
                            <td style="width:6%;">{{row.Description}}</td>
                            <td style="width:6%;">{{row.DeliveryLocation}}</td>
                            <td style="width:6%;">{{row.DeliveryDate}}</td>
                            <td style="width:6%;">{{row.DeliveryMode}}</td>
                            <td style="width:6%;">{{row.ReqQnty | number:2}}</td>
                            <td style="width:5%;">{{row.ReqUnit}}</td>

                            @*BUG FIX: Input fields readonly in viewmode *@
                            <td class="col-lg-1">
                                <input class="form-control" style="width:100%; height:18px; font-size:10px"
                                       type="text" min="0"
                                       ng-model="row.QutnQnty"
                                       ng-blur="checkUnitPrice(row)"
                                       ng-readonly="viewmode" />
                            </td>
                            <td class="col-lg-1">
                                <input class="form-control" style="width:100%; height:18px; font-size:10px"
                                       type="text" min="0"
                                       ng-model="row.QutnPrice"
                                       ng-blur="checkUnitPrice(row)"
                                       ng-readonly="viewmode" />
                            </td>
                            <td style="width:5%;">{{row.QutnAmt | number:2}}</td>
                            <td class="col-lg-1">
                                <input class="form-control" style="width:100%; height:18px; font-size:10px"
                                       type="text" min="0"
                                       ng-model="row.VatPerc"
                                       ng-blur="checkVatPerc(row)"
                                       ng-readonly="viewmode" />
                            </td>
                            <td style="width:5%;">{{row.VatAmt | number:2}}</td>
                            <td style="width:5%;">{{row.TolAmt | number:2}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @*==================== DELETE REQ ITEM CONFIRM MODAL ==================== *@
    <div class="modal fade" id="deleteReqItemModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Delete Selected Item</h4>
                </div>
                <div class="modal-body" style="height: 80px;">Are you sure to delete this item?</div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white; background-color: red;"
                            ng-click="DeleteVendorQutnItem()">
                        Yes
                    </button>
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white">
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>

    @*==================== TERMS & CONDITIONS GRID ==================== *@
    <div class="row">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            @*BUG FIX: T&C search and Add button hidden in viewmode *@
                            <th ng-hide="viewmode" style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="FormName" name="FormName" type="text"
                                           data-ng-model="VendorQutn.FormName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-hide="viewmode" style="background: #ffffff;">
                                <button type="button" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Terms Code</th>
                            <th colspan="13" style="text-align: left;">Terms & Conditions</th>
                            @*BUG FIX: Action column hidden in viewmode *@
                            <th ng-hide="viewmode" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.VendorQutnTermsID}}</td>
                            <td class="hidden">{{row.VendorQutnID}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td style="width:5%;">{{row.TermsCode}}</td>
                            <td colspan="13" style="width:6%;">{{row.TermsName}}</td>
                            <td ng-hide="viewmode" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat"
                                        ng-click="toggleReqTermEdit(row, $index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-danger btn-flat"
                                        ng-click="toggleReqTermDelete(row, $index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @*==================== TERMS & CONDITIONS SEARCH MODAL ==================== *@
    <div id="VendorQutnTermsConditionsModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="4" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Terms & Conditions Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th>Form Code</th>
                                <th>Form Name</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="FormCode" placeholder="Form Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="FormName" placeholder="Form Name" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in TermsConditionsDisplayedCollection">
                                <td class="hidden">{{row.TermsID}}</td>
                                <td class="text-center">{{row.FormCode}}</td>
                                <td class="text-center">{{row.FormName}}</td>
                                <td class="text-center">
                                    <span ng-attr-class="{{row.Status=='1' ? 'label label-success' : 'label label-danger'}}">
                                        {{row.Status == '1' ? 'Active' : 'InActive'}}
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleTermsConditionsSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @*==================== REQUISITION TERM MODAL ==================== *@
    <div id="RequisitionTermModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="row">
                        <div class="col-sm-8 col-md-8 col-lg-8">
                            <h4 class="modal-title" style="font-family: initial; font-weight: 700">Terms & Conditions Information</h4>
                        </div>
                        <div style="text-align: right;">
                            <button type="button" class="btn-danger" data-dismiss="modal"
                                    ng-click="resetVendorQutnTerm()" aria-hidden="true" style="color: #ffffff;">
                                <i class="fa fa-remove"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div ng-cloak>
                    <div class="row" style="position:relative; top:5px;">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="TermsCode">Terms Code:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="TermsCode" type="text" name="TermsCode"
                                       ng-model="VendorQutnTerm.TermsCode" class="form-control" autofocus />
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label for="TermsName">Terms & Conditions:</label>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <input id="TermsName" type="text" name="TermsName"
                                       ng-model="VendorQutnTerm.TermsName" class="form-control" autofocus />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="btn-group pull-right" style="margin:2px;">
                        <button type="button" id="btnAddReqTerm" data-ng-click="AddReqTerm()" class="button-detail btn">
                            <i class="fa fa-save" style="padding-right: 3px"></i>
                            <span id="btnAddReqTermLabel">Add</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*==================== DELETE REQ TERM CONFIRM MODAL ==================== *@
    <div class="modal fade" id="deleteReqTermModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Delete Selected Term</h4>
                </div>
                <div class="modal-body" style="height: 80px;">Are you sure to delete this term?</div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white; background-color: red;"
                            ng-click="DeleteReqTerm()">
                        Yes
                    </button>
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white">
                        No
                    </button>
