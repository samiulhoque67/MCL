        $scope.Post = function () {

            // =========================
            // 🔹 HEADER VALIDATION
            // =========================
            if (!$('#VendorName').val()) {
                toastr.error("Vendor Name Required");
                return;
            }

            if (!$('#VendorQutnNo').val()) {
                toastr.error("Vendor QutnNo. Required");
                return;
            }

            if ($('#QuotationDate').val() == "") {
                toastr.error("Quotation Date Required");
                return;
            }

            if ($('#QutnReceivedDate').val() == "") {
                toastr.error("Qutn. Received Date Required");
                return;
            }

            // Assign dates
            $scope.VendorQutn.QuotationDate = $('#QuotationDate').val();
            $scope.VendorQutn.QutnReceivedDate = $('#QutnReceivedDate').val();

            // =========================
            // 🔴 GRID VALIDATION
            // =========================

            function isNumber(val) {
                return val !== null && val !== undefined && val !== "" && !isNaN(val);
            }

            var invalidRows = [];

            $scope.GridDisplayCollection.forEach(function (row) {

                row.isInvalid = false;

                if (!isNumber(row.QutnAmt) ||
                    !isNumber(row.VatPerc) ||
                    !isNumber(row.VatAmt) ||
                    !isNumber(row.TolAmt)) {

                    row.isInvalid = true;
                    invalidRows.push(row);
                }
            });

            if (invalidRows.length > 0) {
                toastr.error("All rows must have valid Qutn Amount, VAT %, VAT Amount, and Total Amount.");
                return;
            }

            // =========================
            // 🚀 API CALL
            // =========================

            $scope.loading = true;

            $http.post('/VendorQuotation/SaveVendorQuotation',
                {
                    vendorQutn: $scope.VendorQutn,
                    vendorQutnItem: $scope.GridDisplayCollection,
                    vendorQutnTerm: $scope.ReqTermGridDisplayCollection
                })
                .success(function (response) {

                    $scope.loading = false;

                    if (response.status == "S201") {
                        toastr.success("Data Saved Successfully.");

                        if ($scope.uploadedFile) {
                            $scope.SaveDocument(response.VendorQutnID);
                        }

                        $scope.clearVendorQutn();
                        window.location.reload();
                        return;
                    }

                    if (response.status == "S202") {
                        toastr.success("Data Updated Successfully.");
                        $scope.clearVendorQutn();
                        return;
                    }

                    if (response.status == "S203") {
                        toastr.success("Data Deleted Successfully.");
                        $scope.clearVendorQutn();
                        return;
                    }

                    if (response.status == "ERROR_Duplicate") {
                        toastr.error("This quotation no. already exists");
                        return;
                    }

                    toastr.error("Data Save Failed.");
                })
                .error(function () {
                    $scope.loading = false;
                    toastr.error("Data Save Failed.");
                });
        };






        $scope.DocCrudStatus = "";
        $scope.SaveDocument = function (VendorQutnID) {
            $scope.DocCrudStatus = "I";

            var fileUpload = document.getElementById("FileUpload1");
            var files = fileUpload.files;

            if (files.length === 0) {
                toastr.error("Please select a file to upload.");
                return;
            }

            var file = files[0];
            var ext = file.name.split('.').pop().toLowerCase();

            var maxSizeInMB = 2;
            if (file.size > maxSizeInMB * 1024 * 1024) {
                toastr.error("File size must be 2 MB or less.");
                return;
            }

            // Validate file extension
            if (ext !== "pdf") {
                toastr.error("Please upload PDF files only.");
                return;
            }

            $scope.loading = true; // Show loading indicator

            // FTP details
            var ftpDetails = {
                serverIP: "172.16.189.34",
                ftpPort: "21",
                ftpUserName: "ftpuser",
                ftpPassword: "Ftp@Cbps#2k25",
                serverUrl: "MCL/Vendor_Requisition",
                documentID: "VR_" + VendorQutnID,
                ext: "pdf"
            };

            function uploadFileToServer(file, ftpDetails) {
                var formData = new FormData();
                formData.append("file", file);
                formData.append("serverIP", ftpDetails.serverIP);
                formData.append("ftpPort", ftpDetails.ftpPort);
                formData.append("ftpUserName", ftpDetails.ftpUserName);
                formData.append("ftpPassword", ftpDetails.ftpPassword);
                formData.append("serverUrl", ftpDetails.serverUrl);
                formData.append("documentID", ftpDetails.documentID);
                formData.append("ext", ftpDetails.ext);

                $.ajax({
                    url: '/VendorQuotation/SaveDocument',
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: formData,
                    success: function (result) {
                        toastr.success("Document uploaded successfully.");
                        resetFileInput();
                    },
                    error: function (err) {
                        toastr.error("Document upload failed. Please try again.");
                        console.error(err);
                    },
                    complete: function () {
                        $scope.loading = false;
                    }
                });
            }

            uploadFileToServer(file, ftpDetails);

            // Helper to reset file input field
            function resetFileInput() {
                var fileInput = document.getElementById("FileUpload1");
                fileInput.value = "";
            }

        };

        $scope.ViewDocument = function () {
            $scope.loading = true; // Show loading indicator
            // FTP details
            var ftpDetails = {
                serverIP: "172.16.189.34",
                ftpPort: "21",
                ftpUserName: "ftpuser",
                ftpPassword: "Ftp@Cbps#2k25",
                serverUrl: "MCL/Vendor_Requisition",
                documentID: "VR_" + $scope.VendorQutn.VendorQutnID,
                ext: "pdf"
            };

            // Construct URL with query parameters
            var requestUrl = "/VendorQuotation/ViewDocument?" +
                "serverIP=" + encodeURIComponent(ftpDetails.serverIP) +
                "&ftpPort=" + encodeURIComponent(ftpDetails.ftpPort) +
                "&ftpUserName=" + encodeURIComponent(ftpDetails.ftpUserName) +
                "&ftpPassword=" + encodeURIComponent(ftpDetails.ftpPassword) +
                "&serverUrl=" + encodeURIComponent(ftpDetails.serverUrl) +
                "&DocID=" + encodeURIComponent(ftpDetails.documentID) +
                "&ext=" + encodeURIComponent(ftpDetails.ext);

            // Make GET request to fetch the PDF
            $http.get(requestUrl, { responseType: 'arraybuffer' })
                .then(function (response) {
                    var file = new Blob([response.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(file);
                    let zoomParam = "#view=Fit";

                    $("#pdfViewer").attr("src", fileURL + zoomParam);
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (error) {
                    toastr.error("Failed to load the PDF.");
                    console.error(error);
                })
                .finally(function () {
                    $scope.loading = false; // Hide the loading indicator
                });
        };


