@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-list {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-view {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .input-readonly {
        background-color: #ffffff !important;
        cursor: default;
    }

    .po-info-box {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px 14px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .po-info-box strong {
            color: #31708f;
        }

    .section-title {
        background-color: #cbd4d9;
        padding: 0.6%;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 6px;
    }

    .qty-exceeded {
        background-color: #f2dede !important;
    }

    .status-pending {
        color: #8a6d3b;
        background: #fcf8e3;
        border: 1px solid #faebcc;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }

    .status-done {
        color: #3c763d;
        background: #dff0d8;
        border: 1px solid #d6e9c6;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }

    .grand-total-box {
        background: #eef6fb;
        border: 1px solid #bce8f1;
        border-radius: 4px;
        padding: 10px 14px;
        font-size: 14px;
    }

        .grand-total-box .amt {
            font-weight: bold;
            color: #31708f;
        }
</style>

<div class="box box-primary box-body" ng-controller="VendorFinalBillCtrl">

    <!-- TOOLBAR -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;border-radius:5px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Vendor Final Bill
            <span ng-show="p===2" class="mode-badge mode-list">PO LIST</span>
            <span ng-show="p===1 && pageMode==='view'" class="mode-badge mode-view">VIEW HISTORY</span>
            <span ng-show="p===1 && pageMode==='edit'" class="mode-badge mode-edit">NEW BILL</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">

                <div class="btn-group pull-right" style="margin-left:4px;">
                    <button class="button-custom btn-warning" type="button"
                            ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                        <i class="fa fa-refresh" ng-class="{'fa-spin':isRefreshing}" style="padding-right:5px"></i> Refresh
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1 && pageMode==='edit'">
                    <button class="button-custom btn-success" type="button"
                            ng-click="Post()" ng-disabled="isSaving">
                        <i class="fa fa-check" style="padding-right:5px"></i> Save Bill
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1">
                    <button class="button-custom btn-default" type="button" ng-click="goBackToList()">
                        <i class="fa fa-arrow-left" style="padding-right:5px"></i> Back
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ p===2 : PO LIST ══════════════ -->
    <div ng-show="p===2">
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;">

            <div ng-show="POListDisplayedCollection.length<=0" style="text-align:center;padding:20px;">
                <h4 style="color:red;">No PO with remaining quantity to bill!</h4>
            </div>

            <div ng-show="POListDisplayedCollection.length>0" class="row" style="padding:11px;margin-right:15px;margin-left:15px;">

                <div class="section-title">Vendor Final Bill List</div>

                <table st-table="POListDisplayedCollection" st-safe-src="POList"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Client Name</th>
                            <th>Project Name</th>
                            <th>Requisition No</th>
                            <th>Vendor Name</th>
                            <th>PO No</th>
                            <th style="text-align:right;">Total PO Amount</th>
                            <th style="text-align:right;">Billed So Far</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in POListDisplayedCollection" style="height:20px;font-size:13px;">
                            <td>{{row.ClientName}}</td>
                            <td>{{row.ProjectName}}</td>
                            <td class="text-center">{{row.ClientReqNo}}</td>
                            <td class="text-center">{{row.VendorName}}</td>
                            <td class="text-center">{{row.PoNo}}</td>
                            <td style="text-align:right;">{{row.TotalPOAmount | number:2}}</td>
                            <td style="text-align:right;">{{row.TotalBilledAmt | number:2}}</td>
                            <td class="text-center">
                                <span ng-show="row.TotalRemainingQty > 0 && row.BillCount > 0" class="status-pending">Partially Billed</span>
                                <span ng-show="row.TotalRemainingQty > 0 && row.BillCount == 0" class="status-pending">Not Billed</span>
                                <span ng-show="row.TotalRemainingQty <= 0" class="status-done">Fully Billed</span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-flat btn-primary"
                                        ng-click="openDetail(row, 'view')">
                                    <i class="fa fa-eye"></i> View
                                </button>
                                <button type="button" class="btn btn-sm btn-flat btn-success" style="margin-left:3px;"
                                        ng-show="row.TotalRemainingQty > 0"
                                        ng-click="openDetail(row, 'edit')">
                                    <i class="fa fa-plus"></i> Add Bill
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div><!-- /p===2 -->
    <!-- ══════════════ p===1 : NEW BILL ══════════════ -->
    <div ng-show="p===1">

        <!-- Summary bar -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box">
                    <div class="row">
                        <div class="col-lg-3"><strong>PO No:</strong>&nbsp;{{VendorFinalBill.PoNo}}</div>
                        <div class="col-lg-3"><strong>Client:</strong>&nbsp;{{VendorFinalBill.ClientName}}</div>
                        <div class="col-lg-3"><strong>Vendor:</strong>&nbsp;{{VendorFinalBill.VendorName}}</div>
                        <div class="col-lg-3"><strong>Total PO Amount:</strong>&nbsp;{{VendorFinalBill.TotalPOAmount | number:2}}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advance Demand History (read-only) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Advance Demand History</div>
                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="text-align:right;">Total PO Amount</th>
                            <th style="text-align:right;">Demand Amount</th>
                            <th style="text-align:right;">Already Adjusted</th>
                            <th style="text-align:right;">Available For Adjustment</th>
                            <th>Demand Date</th>
                            <th>Remarks</th>
                            <th>Demanded By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in AdvanceDemandHistory" ng-cloak>
                            <td style="text-align:right;">{{row.TotalPOAmount | number:2}}</td>
                            <td style="text-align:right;">
                                {{row.DemandAmount | number:2}}
                                <span ng-show="row.IsFullPayment==='1'" class="status-done" style="margin-left:4px;">Full</span>
                            </td>
                            <td style="text-align:right;">{{row.AdvanceAlreadyAdjusted | number:2}}</td>
                            <td style="text-align:right;" class="remaining-highlight">{{row.AdvanceAvailable | number:2}}</td>
                            <td>{{row.DemandDate}}</td>
                            <td>{{row.Remarks}}</td>
                            <td>{{row.SetBy}}</td>
                        </tr>
                        <tr ng-if="AdvanceDemandHistory.length===0">
                            <td colspan="7" class="text-center text-muted">No advance demand has been taken against this PO</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Final Bill History (read-only, prior partial bills) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;"
             ng-show="FinalBillHistory.length>0">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Previous Bills Against This PO</div>
                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="text-align:right;">Item Amt (before VAT)</th>
                            <th style="text-align:right;">Grand Total</th>
                            <th style="text-align:right;">Advance Adjusted</th>
                            <th style="text-align:right;">Net Payable</th>
                            <th>Bill Date</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in FinalBillHistory" ng-cloak>
                            <td style="text-align:right;">{{row.BillItemsAmountWithoutVat | number:2}}</td>
                            <td style="text-align:right;">{{row.GrandTotalAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.AdvanceAdjustedAmt | number:2}}</td>
                            <td style="text-align:right;" class="remaining-highlight">{{row.NetPayableAmt | number:2}}</td>
                            <td>{{row.BillDate}}</td>
                            <td>{{row.Remarks}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Editable Item grid — partial billing (edit mode only; view mode is history-only) -->
        <div ng-show="pageMode==='edit'" class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Items — Remaining Quantity Available For Billing</div>
                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Item Name</th>
                            <th>Description</th>
                            <th>Service Category</th>
                            <th style="text-align:right;">PO Qty</th>
                            <th style="text-align:right;">Already Billed</th>
                            <th style="text-align:right;">Remaining Qty</th>
                            <th style="text-align:right;width:100px;">Bill Qty</th>
                            <th style="text-align:right;width:110px;">Bill Price</th>
                            <th style="text-align:right;width:90px;">Vat %</th>
                            <th style="text-align:right;">Amount</th>
                            <th style="text-align:right;">Vat Amt</th>
                            <th style="text-align:right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ItemGridDisplayCollection" ng-cloak
                            ng-class="{'qty-exceeded': row.BillQty > row.RemainingQty}">
                            <td>{{row.ServiceItemName}}</td>
                            <td>{{row.Description}}</td>
                            <td>{{row.ServiceCategoryName}}</td>
                            <td style="text-align:right;">{{row.POQty | number:2}}</td>
                            <td style="text-align:right;">{{row.AlreadyBilledQty | number:2}}</td>
                            <td style="text-align:right;">{{row.RemainingQty | number:2}}</td>
                            <td>
                                <input type="number" min="0" step="0.01" class="form-control input-sm text-right"
                                       ng-model="row.BillQty" ng-change="recalculateRow(row)" />
                            </td>
                            <td>
                                <input type="number" min="0" step="0.01" class="form-control input-sm text-right"
                                       ng-model="row.BillPrice" ng-change="recalculateRow(row)" />
                            </td>
                            <td>
                                <input type="number" min="0" max="100" step="0.01" class="form-control input-sm text-right"
                                       ng-model="row.BillVatPerc" ng-change="recalculateRow(row)" />
                            </td>
                            <td style="text-align:right;">{{row.BillAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillTotalAmt | number:2}}</td>
                        </tr>
                        <tr ng-if="ItemGridDisplayCollection.length===0">
                            <td colspan="10" class="text-center text-danger">No billable items available</td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-danger" ng-show="anyRowExceedsRemaining()" style="margin-top:4px;">
                    One or more rows bill more quantity than what remains — reduce Bill Qty before saving.
                </div>
            </div>
        </div>

        <!-- Bill date / remarks + totals (edit mode only) -->
        <div ng-show="pageMode==='edit'" class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:10px;">

            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Bill Date:</label></div>
                <div class="col-lg-3">
                    <input id="BillDate" type="text" autocomplete="off" class="DatePicker form-control"
                           placeholder="DD/MM/YYYY" ng-model="VendorFinalBill.BillDate" />
                </div>
                <div class="col-lg-2"><label>Remarks:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control" placeholder="Note for this bill"
                           ng-model="VendorFinalBill.Remarks" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-1"></div>
                <div class="col-lg-10">
                    <div class="grand-total-box">
                        Item Amount (before VAT): <span class="amt">{{billItemsAmountWithoutVat | number:2}}</span>
                        &nbsp;+&nbsp;
                        VAT: <span class="amt">{{billVatAmount | number:2}}</span>
                        &nbsp;=&nbsp;
                        Grand Total: <span class="amt">{{grandTotalAmt | number:2}}</span>
                    </div>
                    <div class="grand-total-box" style="margin-top:6px;" ng-show="advanceAvailable > 0">
                        Advance Available: <span class="amt">{{advanceAvailable | number:2}}</span>
                        &nbsp;&nbsp;→&nbsp;&nbsp;
                        Advance To Be Adjusted (this bill): <span class="amt">{{advanceToAdjust | number:2}}</span>
                        &nbsp;&nbsp;=&nbsp;&nbsp;
                        Net Payable: <span class="amt">{{netPayableAmt | number:2}}</span>
                        <div class="text-muted" style="margin-top:3px;font-size:11px;">
                            Final figures are recomputed and locked in server-side when you save.
                        </div>
                    </div>
                    <div class="grand-total-box" style="margin-top:6px;" ng-show="advanceAvailable <= 0 && AdvanceDemandHistory.length > 0">
                        Advance already fully adjusted against earlier bills — Net Payable: <span class="amt">{{grandTotalAmt | number:2}}</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Terms table (edit mode only) -->
        <div ng-show="pageMode==='edit'" class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table class="table table-condensed table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th colspan="2" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb;">
                                Terms &amp; Conditions
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="width:10%;">Terms Code</th>
                            <th style="width:90%;">Terms &amp; Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in TermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td>{{row.TermsCode}}</td>
                            <td>{{row.TermsName}}</td>
                        </tr>
                        <tr ng-if="TermGridDisplayCollection.length===0">
                            <td colspan="2" class="text-center text-muted">No terms available</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /p===1 -->
    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div><!-- /box -->

<script type="text/javascript">

    app.controller('VendorFinalBillCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            $scope.itemsByPage = 10;
            $scope.loading = false;
            $scope.isSaving = false;
            $scope.isRefreshing = false;
            $scope.p = 2;
            $scope.pageMode = 'view';

            $scope.POList = [];
            $scope.POListDisplayedCollection = [];
            $scope.ItemList = [];
            $scope.ItemGridDisplayCollection = [];
            $scope.TermList = [];
            $scope.TermGridDisplayCollection = [];
            $scope.AdvanceDemandHistory = [];
            $scope.FinalBillHistory = [];

            $scope.billItemsAmountWithoutVat = 0;
            $scope.billVatAmount = 0;
            $scope.billItemsAmount = 0;
            $scope.grandTotalAmt = 0;
            $scope.advanceAvailable = 0;
            $scope.advanceToAdjust = 0;
            $scope.netPayableAmt = 0;

            function emptyBill() {
                return {
                    POAprvID: "", ClientReqID: "", ClientID: "", VendorID: "",
                    ClientName: "", VendorName: "", PoNo: "", TotalPOAmount: "0.00",
                    BillDate: "", Remarks: ""
                };
            }
            $scope.VendorFinalBill = emptyBill();

            /* ── Initial load ── */
            $scope.loading = true;
            $http.post("/VendorFinalBill/GetVendorFinalBillClientInfo/")
                .then(function (res) {
                    $scope.POList = res.data.VendorFinalBillList || [];
                    $scope.POListDisplayedCollection = [].concat($scope.POList);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load PO list.");
                });

            /* ── Per-row live calculation ── */
            $scope.recalculateRow = function (row) {
                var qty = parseFloat(row.BillQty) || 0;
                var price = parseFloat(row.BillPrice) || 0;
                var vatPerc = parseFloat(row.BillVatPerc) || 0;
                var amt = qty * price;
                var vatAmt = amt * vatPerc / 100;
                row.BillAmt = amt.toFixed(2);
                row.BillVatAmt = vatAmt.toFixed(2);
                row.BillTotalAmt = (amt + vatAmt).toFixed(2);
                $scope.recalculateGrandTotal();
            };

            $scope.anyRowExceedsRemaining = function () {
                return $scope.ItemGridDisplayCollection.some(function (r) {
                    return (parseFloat(r.BillQty) || 0) > (parseFloat(r.RemainingQty) || 0);
                });
            };

            /* ── Recomputes: pre-VAT item total, VAT total, Grand Total (with VAT),
                   and the advance-to-adjust estimate. Authoritative figures are
                   always recomputed server-side on save. ── */
            $scope.recalculateGrandTotal = function () {
                var withoutVat = 0, vat = 0;
                $scope.ItemGridDisplayCollection.forEach(function (r) {
                    withoutVat += parseFloat(r.BillAmt) || 0;
                    vat += parseFloat(r.BillVatAmt) || 0;
                });
                $scope.billItemsAmountWithoutVat = withoutVat;
                $scope.billVatAmount = vat;
                $scope.billItemsAmount = withoutVat + vat;
                $scope.grandTotalAmt = $scope.billItemsAmount;

                var available = 0;
                if ($scope.AdvanceDemandHistory && $scope.AdvanceDemandHistory.length > 0) {
                    available = parseFloat($scope.AdvanceDemandHistory[0].AdvanceAvailable) || 0;
                }
                $scope.advanceAvailable = available > 0 ? available : 0;
                $scope.advanceToAdjust = Math.min($scope.advanceAvailable, $scope.grandTotalAmt);
                $scope.netPayableAmt = $scope.grandTotalAmt - $scope.advanceToAdjust;
            };

            /* ── Open detail. mode='view' → history only (no billing possible).
                   mode='edit' → full "Add Bill" workflow. Multiple bills are
                   allowed per PO, so 'edit' is always "add a new bill", never
                   "edit an existing one". ── */
            $scope.openDetail = function (row, mode) {
                $scope.loading = true;
                $scope.p = 1;
                $scope.pageMode = mode;
                $scope.VendorFinalBill = emptyBill();
                $scope.VendorFinalBill.POAprvID = row.POAprvID;
                $scope.VendorFinalBill.ClientReqID = row.ClientReqID;
                $scope.VendorFinalBill.ClientID = row.ClientID;
                $scope.VendorFinalBill.VendorID = row.VendorID;
                $scope.VendorFinalBill.ClientName = row.ClientName;
                $scope.VendorFinalBill.VendorName = row.VendorName;
                $scope.VendorFinalBill.PoNo = row.PoNo;
                $scope.VendorFinalBill.TotalPOAmount = parseFloat(row.TotalPOAmount || 0).toFixed(2);

                if (mode === 'edit') {
                    $timeout(function () {
                        var t = new Date();
                        var tod = String(t.getDate()).padStart(2, '0') + '/' +
                            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
                        $('#BillDate').val(tod);
                        $scope.VendorFinalBill.BillDate = tod;
                        $('#BillDate').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                            .off('changeDate.bill')
                            .on('changeDate.bill', function (ev) {
                                $scope.$apply(function () {
                                    $scope.VendorFinalBill.BillDate = $(ev.target).val();
                                });
                                $('.datepicker').hide();
                            });
                    }, 100);

                    // Items — only fetched in edit mode. Default Bill Qty/Price/Vat
                    // to the PO's remaining/negotiated values.
                    $http.post("/VendorFinalBill/GetVendorFinalBillItem", { POAprvID: row.POAprvID })
                        .then(function (res) {
                            var items = res.data.VendorFinalBillItemList || [];
                            $scope.ItemList = items.map(function (i) {
                                i.BillQty = parseFloat(i.RemainingQty || 0).toFixed(2);
                                i.BillPrice = parseFloat(i.POPrice || 0).toFixed(2);
                                i.BillVatPerc = parseFloat(i.POVatPerc || 0).toFixed(2);
                                $scope.recalculateRow(i);
                                return i;
                            });
                            $scope.ItemGridDisplayCollection = [].concat($scope.ItemList);
                            $scope.recalculateGrandTotal();
                        }, function () {
                            toastr.error("Failed to load items.");
                        });

                    // Terms — only relevant while actually billing
                    $http.post("/VendorFinalBill/GetVendorFinalBillTermList", { POAprvID: row.POAprvID })
                        .then(function (res) {
                            $scope.TermList = res.data.VendorFinalBillTermList || [];
                            $scope.TermGridDisplayCollection = [].concat($scope.TermList);
                        }, function () {
                            toastr.error("Failed to load terms.");
                        });
                } else {
                    $scope.ItemList = [];
                    $scope.ItemGridDisplayCollection = [];
                    $scope.TermList = [];
                    $scope.TermGridDisplayCollection = [];
                }

                // Advance demand history — shown in both view and edit mode
                $http.post("/VendorFinalBill/GetVendorAdvanceDemandHistory", { POAprvID: row.POAprvID })
                    .then(function (res) {
                        $scope.AdvanceDemandHistory = res.data.VendorAdvanceDemandHistory || [];
                    }, function () {
                        toastr.error("Failed to load advance demand history.");
                    });

                // Prior final bill history
                $http.post("/VendorFinalBill/GetVendorFinalBillHistory", { POAprvID: row.POAprvID })
                    .then(function (res) {
                        $scope.FinalBillHistory = res.data.VendorFinalBillHistory || [];
                        $scope.loading = false;
                    }, function () {
                        $scope.loading = false;
                        toastr.error("Failed to load final bill history.");
                    });
            };

            /* ── Back to list ── */
            $scope.goBackToList = function () {
                $scope.p = 2;
                $scope.pageMode = 'view';
                $scope.VendorFinalBill = emptyBill();
                $scope.ItemList = [];
                $scope.ItemGridDisplayCollection = [];
                $scope.TermList = [];
                $scope.TermGridDisplayCollection = [];
                $scope.AdvanceDemandHistory = [];
                $scope.FinalBillHistory = [];
                $scope.billItemsAmountWithoutVat = 0;
                $scope.billVatAmount = 0;
                $scope.billItemsAmount = 0;
                $scope.grandTotalAmt = 0;
                $scope.advanceAvailable = 0;
                $scope.advanceToAdjust = 0;
                $scope.netPayableAmt = 0;
            };

            /* ── Save / Post ── */
            $scope.Post = function () {
                if (!$scope.VendorFinalBill.POAprvID) {
                    toastr.error("No PO selected."); return;
                }
                var billableRows = $scope.ItemGridDisplayCollection.filter(function (r) {
                    return (parseFloat(r.BillQty) || 0) > 0;
                });
                if (billableRows.length === 0) {
                    toastr.error("Enter a Bill Qty for at least one item."); return;
                }
                if ($scope.anyRowExceedsRemaining()) {
                    toastr.error("One or more rows bill more than the remaining quantity."); return;
                }
                var invalidPrice = billableRows.some(function (r) { return (parseFloat(r.BillPrice) || 0) <= 0; });
                if (invalidPrice) {
                    toastr.error("Bill Price must be greater than zero for every billed item."); return;
                }
                var billDate = $('#BillDate').val() || $scope.VendorFinalBill.BillDate;
                if (!billDate) {
                    toastr.error("Bill Date is required."); return;
                }
                $scope.VendorFinalBill.BillDate = billDate;
                $scope.isSaving = true;

                $http.post('/VendorFinalBill/SaveVendorFinalBillInfo', {
                    vendorFinalBill: $scope.VendorFinalBill,
                    vendorFinalBillItem: billableRows
                }).then(function (res) {
                    $scope.isSaving = false;
                    var s = res.data.status;
                    if (s === 'S201') {
                        toastr.success("Vendor Final Bill Saved Successfully.");
                        $scope.toggleRefreshTable();
                    } else if (s === 'E402') {
                        toastr.error("No items submitted.");
                    } else if (s === 'E403') {
                        toastr.error("A bill quantity/price is invalid or exceeds what remains.");
                    } else if (s === 'E404') {
                        toastr.error("PO not found.");
                    } else {
                        toastr.error("Save Failed. Status: " + (s || "unknown"));
                    }
                }, function () {
                    $scope.isSaving = false;
                    toastr.error("Save Failed.");
                });
            };

            /* ── Refresh ── */
            $scope.toggleRefreshTable = function () {
                $scope.isRefreshing = true;
                $timeout(function () { window.location.reload(); }, 1200);
            };

        }]);
</script>
