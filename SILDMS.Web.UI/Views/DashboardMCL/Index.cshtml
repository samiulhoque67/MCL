@{
    ViewBag.Title = "My Work Dashboard";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    .dash-tiles {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 12px 1% 6px 1%;
    }

    .dash-tile {
        flex: 1;
        min-width: 180px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 10px 14px;
        box-shadow: 1px 1px 3px #ccc;
    }

        .dash-tile .t-val {
            font-size: 26px;
            font-weight: bold;
            color: #31708f;
            line-height: 1.1;
        }

        .dash-tile .t-lbl {
            font-size: 11px;
            color: #777;
            text-transform: uppercase;
        }

        .dash-tile.t-late .t-val {
            color: #a94442;
        }

    .dash-bar {
        margin: 8px 1%;
        font-size: 12.5px;
    }

        .dash-bar label {
            font-weight: normal;
            margin-right: 18px;
            cursor: pointer;
        }

    .dash-tabs {
        margin: 8px 1% 0 1%;
        border-bottom: 2px solid #3c8dbc;
    }

        .dash-tabs button {
            border: 0;
            background: #eef1f4;
            padding: 7px 18px;
            margin-right: 3px;
            font-weight: bold;
            color: #555;
            border-radius: 4px 4px 0 0;
        }

            .dash-tabs button.active {
                background: #3c8dbc;
                color: #fff;
            }

    .grp-title {
        margin: 14px 1% 6px 1%;
        font-weight: bold;
        color: #166e19;
        font-size: 14px;
        border-bottom: 1px solid #d3e3e3;
        padding-bottom: 3px;
    }

    .stage-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 0 1%;
    }

    .stage-card {
        position: relative;
        width: 235px;
        background: #fff;
        border: 1px solid #ddd;
        border-left: 5px solid #bbb;
        border-radius: 4px;
        padding: 8px 30px 8px 12px;
        cursor: pointer;
        box-shadow: 1px 1px 3px #ddd;
    }

        .stage-card:hover {
            box-shadow: 2px 2px 6px #aaa;
        }

        .stage-card.selected {
            outline: 2px solid #3c8dbc;
        }

        .stage-card .sc-count {
            font-size: 26px;
            font-weight: bold;
            line-height: 1.1;
        }

        .stage-card .sc-title {
            font-weight: bold;
            font-size: 12.5px;
        }

        .stage-card .sc-meta {
            font-size: 11px;
            color: #777;
        }

        .stage-card .sc-open {
            position: absolute;
            top: 8px;
            right: 9px;
            color: #777;
        }

        .stage-card.age-ok {
            border-left-color: #5cb85c;
        }

            .stage-card.age-ok .sc-count {
                color: #3c763d;
            }

        .stage-card.age-warn {
            border-left-color: #f0ad4e;
        }

            .stage-card.age-warn .sc-count {
                color: #c77c11;
            }

        .stage-card.age-late {
            border-left-color: #d9534f;
        }

            .stage-card.age-late .sc-count {
                color: #a94442;
            }

        .stage-card.sc-none {
            border-left-color: #ccc;
            background: #fafafa;
        }

            .stage-card.sc-none .sc-count {
                color: #bbb;
            }

        .stage-card.sc-optional {
            border-style: dashed;
            border-left-style: solid;
        }

    .opt-badge {
        font-size: 9.5px;
        background: #eef1f4;
        color: #7a8aa0;
        border-radius: 3px;
        padding: 0 4px;
        font-weight: normal;
    }

    .detail-box {
        margin: 14px 1%;
        background: #f0f0f0;
        box-shadow: 2px 2px 5px #888;
        padding: 10px 14px;
    }

        .detail-box h4 {
            margin: 0 0 4px 0;
            font-weight: bold;
        }

        .detail-box .means {
            color: #666;
            font-size: 12px;
            margin-bottom: 8px;
        }

    .dash-table {
        font-size: 12px;
    }

        .dash-table th {
            background: #82b0c9;
            color: #010823;
            font-size: 11px;
            text-align: center;
        }

    .age-badge {
        display: inline-block;
        min-width: 38px;
        padding: 1px 6px;
        border-radius: 3px;
        font-weight: bold;
        font-size: 11px;
        text-align: center;
    }

        .age-badge.age-ok {
            background: #dff0d8;
            color: #3c763d;
        }

        .age-badge.age-warn {
            background: #fcf8e3;
            color: #8a6d3b;
        }

        .age-badge.age-late {
            background: #f2dede;
            color: #a94442;
        }

    .chip {
        display: inline-block;
        background: #eef1f4;
        border: 1px solid #d6dde4;
        border-radius: 10px;
        padding: 0 8px;
        margin: 1px 3px 1px 0;
        font-size: 11px;
    }

    .mine-dot {
        color: #3c8dbc;
    }

    .quick-links {
        margin: 14px 1% 20px 1%;
    }

        .quick-links a {
            display: inline-block;
            margin: 0 8px 8px 0;
            padding: 5px 12px;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
            color: #31708f;
            font-size: 12px;
        }

            .quick-links a:hover {
                background: #eef6fb;
                text-decoration: none;
            }
</style>

<div class="box box-primary box-body" ng-controller="WorkDashboardCtrl">

    <!-- HEADER -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">
            My Work Dashboard
            <small style="color:#fff;margin-left:10px;" ng-show="loadedAt">updated {{loadedAt}}</small>
        </h2>
        <div class="box-tools pull-right">
            <div class="btn-group pull-right" style="margin-left:4px; margin-right:4px;">
                <button type="button" class="button-custom" ng-click="load()" ng-disabled="loading">
                    <i class="fa fa-refresh" ng-class="{'fa-spin': loading}" style="padding-right:5px"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="dash-tiles">
        <div class="dash-tile"><div class="t-val">{{Totals.pending}}</div><div class="t-lbl">Items waiting</div></div>
        <div class="dash-tile"><div class="t-val">{{Totals.stagesWithWork}}</div><div class="t-lbl">Stages with work</div></div>
        <div class="dash-tile"><div class="t-val">{{Totals.requisitions}}</div><div class="t-lbl">Requisitions in progress</div></div>
        <div class="dash-tile" ng-class="{'t-late': Totals.late > 0}"><div class="t-val">{{Totals.late}}</div><div class="t-lbl">Waiting {{LATE}}+ days</div></div>
        <div class="dash-tile"><div class="t-val">{{Totals.oldest}}<small> d</small></div><div class="t-lbl">Longest wait</div></div>
    </div>
    <div class="dash-bar">
        <label><input type="checkbox" ng-model="onlyMine" ng-change="load()" /> Only requisitions I raised</label>
        @*<label><input type="checkbox" ng-model="hideEmpty" /> Hide stages with nothing waiting</label>
        <span class="text-muted">Optional stages (advance demand / claim) are shown but not counted above.</span>*@
    </div>

    <div ng-show="!loading && QueueStages.length === 0" class="detail-box text-center">
        <h4 style="color:#a94442;">No stages available for your login.</h4>
    </div>

    <!-- TABS -->
    <div class="dash-tabs" ng-show="QueueStages.length > 0">
        @*<button type="button" ng-class="{active: tab==='stage'}" ng-click="tab='stage'"><i class="fa fa-th-large"></i> By Stage</button>*@
        <button type="button" ng-class="{active: tab==='req'}" ng-click="tab='req'"><i class="fa fa-list-alt"></i> By Requisition</button>
    </div>

