            </div>
        </div>
    </div>

</div>

<script type="text/javascript">

    app.controller('WorkDashboardCtrl', ['$scope', '$http', function ($scope, $http) {

        // Aging thresholds (days a piece of work has been waiting)
        var WARN = 7, LATE = 15;
        $scope.LATE = LATE;

        $scope.loading = false;
        $scope.loadedAt = '';
        $scope.onlyMine = true;
        $scope.hideEmpty = false;
        $scope.tab = 'req';

        $scope.QueueStages = [];
        $scope.LinkStages = [];
        $scope.Groups = [];
        $scope.Items = [];
        $scope.StageItems = [];
        $scope.ReqGroups = [];
        $scope.Totals = { pending: 0, stagesWithWork: 0, requisitions: 0, late: 0, oldest: 0 };

        $scope.selected = null;
        $scope.search = '';
        $scope.sortBy = '-DaysWaiting';
        $scope.limit = 50;
        $scope.reqSearch = '';
        $scope.reqLimit = 50;

        $scope.enc = function (v) { return encodeURIComponent(v || ''); };

        $scope.ageClass = function (d) {
            d = parseInt(d, 10) || 0;
            return d >= LATE ? 'age-late' : (d >= WARN ? 'age-warn' : 'age-ok');
        };

        $scope.cardClass = function (s) {
            var c = 'stage-card ' + (s.Count === 0 ? 'sc-none' : $scope.ageClass(s.MaxDays));
            if (s.optional) c += ' sc-optional';
            if ($scope.selected && $scope.selected.StageCode === s.StageCode) c += ' selected';
            return c;
        };

        $scope.groupVisible = function (g) {
            return g.stages.some(function (s) { return !$scope.hideEmpty || s.Count > 0; });
        };

        $scope.selectStage = function (s) {
            $scope.selected = s;
            $scope.search = '';
            $scope.limit = 50;
            $scope.StageItems = $scope.Items.filter(function (i) { return i.StageCode === s.StageCode; });
        };

        function build(data) {
            var stages = data.Stages || [];
            var items = data.Items || [];
            var byCode = {};

            stages.forEach(function (s) {
                s.optional = s.IsOptional === '1';
                s.isQueue = s.IsQueue === '1';
                s.Count = 0; s.MaxDays = 0; s._reqs = {};
                byCode[s.StageCode] = s;
            });

            items.forEach(function (i) {
                i.DaysWaiting = parseInt(i.DaysWaiting, 10) || 0;
                var s = byCode[i.StageCode];
                if (!s) return;
                s.Count++;
                s._reqs[i.ClientReqID] = true;
                if (i.DaysWaiting > s.MaxDays) s.MaxDays = i.DaysWaiting;
            });
            stages.forEach(function (s) { s.ReqCount = Object.keys(s._reqs).length; });

            $scope.QueueStages = stages.filter(function (s) { return s.isQueue; });
            $scope.LinkStages = stages.filter(function (s) { return !s.isQueue; });
            $scope.Items = items;

            // groups, in menu order
            var groups = [], idx = {};
            $scope.QueueStages.forEach(function (s) {
                if (!(s.GroupName in idx)) { idx[s.GroupName] = groups.length; groups.push({ name: s.GroupName, stages: [] }); }
                groups[idx[s.GroupName]].stages.push(s);
            });
            $scope.Groups = groups;

            // headline totals — optional layers are not "remaining work"
            var counted = $scope.QueueStages.filter(function (s) { return !s.optional; });
            var countedItems = items.filter(function (i) { return byCode[i.StageCode] && !byCode[i.StageCode].optional; });
            var reqs = {};
            countedItems.forEach(function (i) { reqs[i.ClientReqID] = true; });

            $scope.Totals = {
                pending: counted.reduce(function (a, s) { return a + s.Count; }, 0),
                stagesWithWork: counted.filter(function (s) { return s.Count > 0; }).length,
                requisitions: Object.keys(reqs).length,
                late: countedItems.filter(function (i) { return i.DaysWaiting >= LATE; }).length,
                oldest: counted.reduce(function (a, s) { return Math.max(a, s.MaxDays); }, 0)
            };

            // by-requisition view
            var map = {}, list = [];
            countedItems.forEach(function (i) {
                var r = map[i.ClientReqID];
                if (!r) {
                    r = map[i.ClientReqID] = {
                        ClientReqID: i.ClientReqID, ClientReqNo: i.ClientReqNo, ClientName: i.ClientName,
                        ProjectName: i.ProjectName, RaisedBy: i.RaisedBy, mine: i.IsMine === '1',
                        stages: [], maxDays: 0
                    };
                    list.push(r);
                }
                var st = byCode[i.StageCode];
                var found = r.stages.filter(function (c) { return c.code === i.StageCode; })[0];
                if (!found) { found = { code: i.StageCode, title: st.StageTitle, days: 0 }; r.stages.push(found); }
                if (i.DaysWaiting > found.days) found.days = i.DaysWaiting;
                if (i.DaysWaiting > r.maxDays) r.maxDays = i.DaysWaiting;
            });
            //list.sort(function (a, b) { return b.maxDays - a.maxDays; });
            //$scope.ReqGroups = list;

            list.sort(function (a, b) {
                return new Date(b.RequisitionDate) - new Date(a.RequisitionDate);
            });

            $scope.ReqGroups = list;

            // keep the open stage open across a refresh
            if ($scope.selected) {
                var again = byCode[$scope.selected.StageCode];
                if (again) { $scope.selectStage(again); } else { $scope.selected = null; $scope.StageItems = []; }
            }
        }

        $scope.load = function () {
            $scope.loading = true;
            $http.post('/DashboardMCL/GetWorkDashboard', { OnlyMine: $scope.onlyMine })
                .then(function (res) {
                    build(res.data);
                    $scope.loadedAt = res.data.LoadedAt || '';
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error('Failed to load the dashboard.');
                });
        };

        $scope.load();
    }]);

</script>

