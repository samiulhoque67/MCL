    <!-- ══════════ TAB 2 : BY REQUISITION ══════════ -->
    <div ng-show="tab==='req'">
        <div class="detail-box">
            <h4>Requisitions and where each one is waiting</h4>
            <div class="means">Every requisition that has work waiting in one or more of your stages, longest wait first.</div>
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-4"><input type="text" class="form-control" placeholder="Search requisition, client, project..." ng-model="reqSearch" /></div>
            </div>
            <div style="overflow-x:auto;">
                <table class="table table-condensed table-bordered table-striped table-hover dash-table">
                    <thead>
                        <tr><th>Requisition No</th><th>Client</th><th>Project</th><th>Raised by</th><th>Waiting at</th><th>Longest wait</th><th>Track</th></tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="r in (reqFiltered = (ReqGroups | filter:reqSearch)) | limitTo:reqLimit">
                            <td class="text-center">{{r.ClientReqNo}} <i class="fa fa-user mine-dot" ng-if="r.mine" title="Raised by you"></i></td>
                            <td>{{r.ClientName}}</td>
                            <td>{{r.ProjectName}}</td>
                            <td>{{r.RaisedBy}}</td>
                            <td>
                                <span class="chip" ng-repeat="c in r.stages">{{c.title}} <small>{{c.days}}d</small></span>
                            </td>
                            <td class="text-center"><span class="age-badge" ng-class="ageClass(r.maxDays)">{{r.maxDays}}</span></td>
                            <td class="text-center"><a ng-href="/RequisitionMovement/index?req={{enc(r.ClientReqNo)}}" target="_blank" title="Open in Bill Movement Status"><i class="fa fa-road"></i></a></td>
                        </tr>
                        <tr ng-if="ReqGroups.length === 0"><td colspan="7" class="text-center text-muted">Nothing waiting.</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center" ng-show="reqFiltered.length > reqLimit">
                <button type="button" class="btn btn-sm btn-default" ng-click="reqLimit = reqLimit + 50">Show more ({{reqFiltered.length - reqLimit}} left)</button>
            </div>
        </div>
    </div>

    <!-- QUICK LINKS -->
    @*<div class="quick-links" ng-show="LinkStages.length > 0">
            <div class="grp-title" style="margin-left:0;margin-right:0;">Quick Links</div>
            <a ng-repeat="l in LinkStages" ng-href="{{l.Url}}"><i class="fa fa-arrow-circle-right"></i> {{l.StageTitle}}</a>
        </div>*@

    <!-- loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
