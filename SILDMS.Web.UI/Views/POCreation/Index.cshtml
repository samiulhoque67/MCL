@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .dbody {
        background-color: whitesmoke;
    }

    .font-weight-bold {
        font-weight: bold;
        color: darkgreen;
    }

    .w-100 {
        width: 100%;
    }

    .d-flex {
        display: flex;
    }

    .align-items-center {
        align-items: center;
    }

    .justify-content-center {
        justify-content: center;
    }

    .global-search {
        height: 34px;
    }

    .btn-round {
        border-radius: 17px;
    }

    .box.box-solid.box-primary > .box-header {
        text-align: center;
    }

    .table-header {
        background-color: #8aa4af !important;
        color: darkblue !important;
        font-size: 13px;
    }

    .tableVen-striped > tbody > tr:nth-of-type(odd) {
        background-color: rgba(23, 250, 132, 0.01);
    }

    .selected-row {
        background-color: #dff0d8;
    }

    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-view {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .mode-new {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    .input-readonly {
        background-color: #ffffff !important;
        cursor: default;
    }
</style>

<div class="box box-primary box-body" ng-controller="POCreationCtrl">

    <!-- ── Toolbar ── -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Purchase Order Preparation
            <span ng-show="pageMode==='view'" class="mode-badge mode-view">VIEW</span>
            <span ng-show="pageMode==='edit'" class="mode-badge mode-edit">EDIT</span>
            <span ng-show="pageMode==='new'" class="mode-badge mode-new">NEW</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-warning" type="button"
                            data-ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                        <i class="fa fa-refresh" ng-class="{'fa-spin':isRefreshing}" style="padding-right:5px"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-primary" type="button" data-ng-click="SearchPO()">
                        <i class="fa fa-search" style="padding-right:5px"></i> Search
                    </button>
                </div>
                <!-- Save/Update hidden in view mode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-hide="pageMode==='view'">
                    <button class="button-custom btn-success" type="button"
                            data-ng-click="Post()" ng-disabled="isSaving">
                        <i class="fa fa-save" style="padding-right:5px"></i>
                        {{ pageMode === 'edit' ? 'Update' : 'Save' }}
                    </button>
                </div>
                <!-- Edit button — only in view mode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view'">
                    <button class="button-custom btn-warning" type="button" ng-click="switchToEdit()">
                        <i class="fa fa-edit" style="padding-right:5px"></i> Edit
                    </button>
                </div>
                <!-- New — shown in view/edit mode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;"
                     ng-show="pageMode==='view' || pageMode==='edit'">
                    <button class="button-custom" type="button" ng-click="startNewPO()">
                        <i class="fa fa-plus" style="padding-right:5px"></i> New
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         p === 2  →  NEW MODE
         ══════════════════════════════════════════════════════════════ -->
    <div ng-show="p===2">

        <!-- Client list -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;">
            <div ng-show="CSClientDisplayedCollection.length <= 0" style="text-align:center;">
                <h4 style="color:red;">No client data available!</h4>
            </div>
            <div ng-show="CSClientDisplayedCollection.length > 0"
                 class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="CSClientDisplayedCollection" st-safe-src="CSClientList"
                       style="width:100%;"
                       class="tableVen table-condensed table-bordered table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="5" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Client List
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th class="col-lg-3">Client Name</th>
                            <th class="col-lg-2">Requisition ID</th>
                            <th class="col-lg-2">WorkOrder ID</th>
                            <th class="col-lg-2">Requisition Date</th>
                            <th class="col-lg-1">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in CSClientDisplayedCollection"
                            ng-class="{'selected-row': row.selected}"
                            ng-style="getRowStyle(row)"
                            style="height:20px;font-size:13px;">
                            <td class="col-lg-3 text-left">{{row.ClientName}}</td>
                            <td class="col-lg-2 text-left">{{row.ClientReqID}}</td>
                            <td class="col-lg-2 text-left">{{row.WIInfoID}}</td>
                            <td class="col-lg-2 text-center">{{row.RequisitionDate}}</td>
                            <td class="col-lg-1 text-center" style="font-weight:bold;">
                                <button type="button" ng-click="ClientSelect(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vendor list -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;"
             ng-show="isClientSelected">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="CSVendorDisplayedCollection" st-safe-src="CSVendorList"
                       style="width:100%;"
                       class="tableVen table-condensed table-bordered table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="7" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Vendor List — Client: <strong>{{VendorCSInfo.ClientName}}</strong>
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Vendor Name</th>
                            <th>Contact Person</th>
                            <th>Contact Number</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>No. of Items</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in CSVendorDisplayedCollection" ng-cloak
                            style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}">
                            <td>{{row.VendorName}}</td>
                            <td>{{row.ContactPerson}}</td>
                            <td>{{row.ContactNumber}}</td>
                            <td>{{row.Email}}</td>
                            <td>{{row.CurrentAddress}}</td>
                            <td>{{row.ItemCount}}</td>
                            <td style="font-weight:bold;width:5%;">
                                <button type="button" ng-click="selectEntity(row)" title="Select">
                                    <i ng-show="!row.buttonCheckedforVendor" class="fa fa-square-o"></i>
                                    <i ng-show="row.buttonCheckedforVendor" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Item grid + Form (new mode) -->
        <div ng-show="isVendorSelected">

            <!-- Item grid -->
            <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;overflow-x:auto;">
                <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                    <table st-table="VenCSItemGridDisplayCollection" st-safe-src="VenCSItemList"
                           style="width:100%;font-size:12px;"
                           class="tableVen table-condensed table-bordered table-hover pnlView">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="16" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Item List — Vendor: <strong>{{VendorCSInfo.VendorName}}</strong>
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>Item Name</th>
                                <th style="text-align:right;">ReqQnty</th>
                                <th style="text-align:right;">RemainingQty</th>
                                <th style="text-align:right;">RemainingVendorQty</th>
                                <th>ReqUnit</th>
                                <th style="text-align:right;">QutnQnty</th>
                                <th>POQnty</th>
                                <th style="text-align:right;">QutnPrice</th>
                                <th>PoPrice</th>
                                <th style="text-align:right;">QutnAmt</th>
                                <th>PoAmt</th>
                                <th style="text-align:right;">Vat%</th>
                                <th style="text-align:right;">VatAmt</th>
                                <th>PoVatAmt</th>
                                <th style="text-align:right;">TolAmt</th>
                                <th>PoTotalAmt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in VenCSItemGridDisplayCollection" ng-cloak style="font-size:12px;">
                                <td>{{row.ServiceItemName}}</td>
                                <td style="text-align:right;">{{row.ReqQnty | number:2}}</td>
                                <td style="text-align:right;">{{row.RemainingQty}}</td>
                                <td style="text-align:right;">{{row.RemainingVendorQty}}</td>
                                <td>{{row.ReqUnit}}</td>
                                <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>
                                <td>
                                    <input class="form-control" style="width:80px;height:18px;font-size:10px;"
                                           type="text" ng-model="row.NegoQty" ng-blur="validateNegoQty(row)" />
                                </td>
                                <td style="text-align:right;">{{row.QutnPrice | number:2}}</td>
                                <td>
                                    <input class="form-control" style="width:80px;height:18px;font-size:10px;"
                                           type="text" ng-model="row.NegoPrice" ng-blur="checkUnitPrice(row)" />
                                </td>
                                <td style="text-align:right;">{{row.QutnAmt | number:2}}</td>
                                <td>
                                    <input class="form-control" style="width:80px;height:18px;font-size:10px;"
                                           type="text" ng-model="row.NegoAmt" ng-readonly="true" />
                                </td>
                                <td style="text-align:right;">{{row.VatPerc | number:2}}</td>
                                <td style="text-align:right;">{{row.VatAmt | number:2}}</td>
                                <td>
                                    <input class="form-control" style="width:80px;height:18px;font-size:10px;"
                                           type="text" ng-model="row.NegoVatAmt" ng-readonly="true" />
                                </td>
                                <td style="text-align:right;">{{row.TolAmt | number:2}}</td>
                                <td>
                                    <input class="form-control" style="width:80px;height:18px;font-size:10px;"
                                           type="text" ng-model="row.NegoTolAmt" ng-readonly="true" />
                                </td>
                            </tr>
                            <tr ng-if="VenCSItemGridDisplayCollection.length === 0">
                                <td colspan="16" class="text-center text-danger">No items available</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PO Form (new mode) -->
            <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:10px;">
                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>PO Date:</label></div>
                    <div class="col-lg-3">
                        <input id="CSRecDate1" autocomplete="off" type="text"
                               class="DatePicker form-control" placeholder="DD/MM/YYYY"
                               ng-model="VendorCSInfo.CSRecDate" />
                    </div>
                    <div class="col-lg-2"><label>Bill Category:</label></div>
                    <div class="col-lg-3" style="padding-top:6px;">
                        <label style="margin-right:10px;">
                            <input type="radio" ng-model="VendorCSInfo.Category" value="Normal" /> Normal
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.Category" value="PlusMinus" /> Plus Minus
                        </label>
                    </div>
                </div>
                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>PO Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" placeholder="PO Amount"
                               ng-model="VendorCSInfo.PoAmount" ng-blur="calculateInstallmentAmount()" />
                    </div>
                    <div class="col-lg-2"><label>Bill Type:</label></div>
                    <div class="col-lg-3" style="padding-top:6px;">
                        <label style="margin-right:10px;">
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Default" /> Default
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Installment" /> Installment
                        </label>
                    </div>
                </div>
                <div class="row" style="margin-bottom:8px;" ng-show="VendorCSInfo.BillType === 'Installment'">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>Installment:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" placeholder="Number of Installments"
                               ng-model="VendorCSInfo.Installment" ng-blur="calculateInstallmentAmount()" />
                    </div>
                    <div class="col-lg-2"><label>Installment Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly"
                               ng-model="VendorCSInfo.InstalledAmount" ng-readonly="true" />
                    </div>
                </div>
                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>Note:</label></div>
                    <div class="col-lg-8">
                        <textarea class="form-control" placeholder="Note for PO"
                                  ng-model="VendorCSInfo.Remarks" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <!-- Terms (new mode) -->
            <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;">
                <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                    <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                           class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="3" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Terms &amp; Conditions
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th style="width:35%;">Vendor Name</th>
                                <th style="width:5%;">Terms Code</th>
                                <th style="width:60%;">Terms &amp; Conditions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                                <td>{{row.VendorName}}</td>
                                <td>{{row.TermsCode}}</td>
                                <td>{{row.TermsName}}</td>
                            </tr>
                            <tr ng-if="ReqTermGridDisplayCollection.length === 0">
                                <td colspan="3" class="text-center text-muted">No terms available</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /isVendorSelected -->
    </div><!-- /p===2 -->
    <!-- ══════════════════════════════════════════════════════════════
         p === 1  →  VIEW / EDIT MODE
         ══════════════════════════════════════════════════════════════ -->
    <div ng-show="p===1">

        <!-- PO header bar -->
        <div class="row" style="margin:1%;padding:8px 15px;background:#fff;border:1px solid #ddd;">
            <div class="col-lg-3"><strong>PO No:</strong>         &nbsp;{{VendorCSInfo.VendorCSInfoID}}</div>
            <div class="col-lg-3"><strong>Client Req ID:</strong> &nbsp;{{VendorCSInfo.ClientReqID}}</div>
            <div class="col-lg-3"><strong>Vendor:</strong>        &nbsp;{{VendorCSInfo.VendorName}}</div>
            <div class="col-lg-3"><strong>PO Date:</strong>       &nbsp;{{VendorCSInfo.CSRecDate}}</div>
        </div>

        <!-- Item grid (view/edit) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="VenCSItemGridDisplayCollection" st-safe-src="VenCSItemList"
                       style="width:100%;font-size:12px;"
                       class="tableVen table-condensed table-bordered table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="13" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Item List — Vendor: <strong>{{VendorCSInfo.VendorName}}</strong>
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Item Name</th>
                            <th style="text-align:right;">QutnQnty</th>
                            <th>Unit</th>
                            <th style="text-align:right;">QutnPrice</th>
                            <th style="text-align:right;">QutnAmt</th>
                            <th>POQnty</th>
                            <th>PoPrice</th>
                            <th>PoAmt</th>
                            <th style="text-align:right;">Vat%</th>
                            <th style="text-align:right;">VatAmt</th>
                            <th>PoVatAmt</th>
                            <th style="text-align:right;">TolAmt</th>
                            <th>PoTotalAmt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in VenCSItemGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td>{{row.ServiceItemName}}</td>
                            <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>
                            <td>{{row.QutnUnit}}</td>
                            <td style="text-align:right;">{{row.QutnPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.QutnAmt | number:2}}</td>

                            <!-- POQnty -->
                            <td>
                                <span ng-show="pageMode==='view'">{{row.NegoQty | number:2}}</span>
                                <input ng-show="pageMode==='edit'"
                                       class="form-control" style="width:80px;height:18px;font-size:10px;"
                                       type="text" ng-model="row.NegoQty" ng-blur="checkUnitPrice(row)" />
                            </td>
                            <!-- PoPrice -->
                            <td>
                                <span ng-show="pageMode==='view'">{{row.NegoPrice | number:2}}</span>
                                <input ng-show="pageMode==='edit'"
                                       class="form-control" style="width:80px;height:18px;font-size:10px;"
                                       type="text" ng-model="row.NegoPrice" ng-blur="checkUnitPrice(row)" />
                            </td>
                            <!-- PoAmt — readonly computed -->
                            <td>
                                <span ng-show="pageMode==='view'">{{row.NegoAmt | number:2}}</span>
                                <input ng-show="pageMode==='edit'"
                                       class="form-control" style="width:80px;height:18px;font-size:10px;"
                                       type="text" ng-model="row.NegoAmt" ng-readonly="true" />
                            </td>
                            <td style="text-align:right;">{{row.VatPerc | number:2}}</td>
                            <td style="text-align:right;">{{row.VatAmt | number:2}}</td>
                            <!-- PoVatAmt -->
                            <td>
                                <span ng-show="pageMode==='view'">{{row.NegoVatAmt | number:2}}</span>
                                <input ng-show="pageMode==='edit'"
                                       class="form-control" style="width:80px;height:18px;font-size:10px;"
                                       type="text" ng-model="row.NegoVatAmt" ng-readonly="true" />
                            </td>
                            <td style="text-align:right;">{{row.TolAmt | number:2}}</td>
                            <!-- PoTotalAmt -->
                            <td>
                                <span ng-show="pageMode==='view'">{{row.NegoTolAmt | number:2}}</span>
                                <input ng-show="pageMode==='edit'"
                                       class="form-control" style="width:80px;height:18px;font-size:10px;"
                                       type="text" ng-model="row.NegoTolAmt" ng-readonly="true" />
                            </td>
                        </tr>
                        <tr ng-if="VenCSItemGridDisplayCollection.length === 0">
                            <td colspan="13" class="text-center text-danger">No items available</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PO form (view/edit) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:10px;">

            <!-- PO Date + PO No -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Date:</label></div>
                <div class="col-lg-3">
                    <input ng-show="pageMode==='view'" type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.CSRecDate" ng-readonly="true" />
                    <input ng-show="pageMode==='edit'" id="CSRecDate" type="text"
                           class="DatePicker form-control" placeholder="DD/MM/YYYY"
                           ng-model="VendorCSInfo.CSRecDate" />
                </div>
                <div class="col-lg-2"><label>PO No:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.VendorCSInfoID" ng-readonly="true" />
                </div>
            </div>

            <!-- PO Amount + Bill Type -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Amount:</label></div>
                <div class="col-lg-3">
                    <input ng-show="pageMode==='view'" type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.PoAmount" ng-readonly="true" />
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           placeholder="PO Amount" ng-model="VendorCSInfo.PoAmount"
                           ng-blur="calculateInstallmentAmount()" />
                </div>
                <div class="col-lg-2"><label>Bill Type:</label></div>
                <div class="col-lg-3">
                    <span ng-show="pageMode==='view'" class="form-control input-readonly">
                        {{VendorCSInfo.BillType}}
                    </span>
                    <div ng-show="pageMode==='edit'" style="padding-top:6px;">
                        <label style="margin-right:10px;">
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Default" /> Default
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.BillType" value="Installment" /> Installment
                        </label>
                    </div>
                </div>
            </div>

            <!-- Bill Category + Installment -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Bill Category:</label></div>
                <div class="col-lg-3">
                    <span ng-show="pageMode==='view'" class="form-control input-readonly">
                        {{VendorCSInfo.Category}}
                    </span>
                    <div ng-show="pageMode==='edit'" style="padding-top:6px;">
                        <label style="margin-right:10px;">
                            <input type="radio" ng-model="VendorCSInfo.Category" value="Normal" /> Normal
                        </label>
                        <label>
                            <input type="radio" ng-model="VendorCSInfo.Category" value="PlusMinus" /> Plus Minus
                        </label>
                    </div>
                </div>
                <div class="col-lg-2" ng-show="VendorCSInfo.BillType === 'Installment'">
                    <label>Installment:</label>
                </div>
                <div class="col-lg-1" ng-show="VendorCSInfo.BillType === 'Installment'">
                    <input ng-show="pageMode==='view'" type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Installment" ng-readonly="true" />
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           ng-model="VendorCSInfo.Installment" ng-blur="calculateInstallmentAmount()" />
                </div>
                <div class="col-lg-2" ng-show="VendorCSInfo.BillType === 'Installment'">
                    <label>Installment Amt:</label>
                </div>
                <div class="col-lg-1" ng-show="VendorCSInfo.BillType === 'Installment'">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.InstalledAmount" ng-readonly="true" />
                </div>
            </div>

            <!-- Note -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Note:</label></div>
                <div class="col-lg-8">
                    <input ng-show="pageMode==='view'" type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Remarks" ng-readonly="true" />
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           placeholder="Note for PO" ng-model="VendorCSInfo.Remarks" />
                </div>
            </div>
        </div>

        <!-- Terms (view/edit) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="3" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Terms &amp; Conditions
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="width:35%;">Vendor Name</th>
                            <th style="width:5%;">Terms Code</th>
                            <th style="width:60%;">Terms &amp; Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td>{{row.VendorName}}</td>
                            <td>{{row.TermsCode}}</td>
                            <td>{{row.TermsName}}</td>
                        </tr>
                        <tr ng-if="ReqTermGridDisplayCollection.length === 0">
                            <td colspan="3" class="text-center text-muted">No terms available</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /p===1 -->
    <!-- ── Search Modal ── -->
    <div id="SearchModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div style="text-align:right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            ng-click="ResetSearchModel()" aria-hidden="true" style="color:#fff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak style="padding:10px;">
                    <table st-table="SearchPOListCollection" st-safe-src="SearchPOList"
                           style="width:100%;"
                           class="tableVen table-condensed table-bordered table-hover pnlView">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="7" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Purchase Order List
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>#</th>
                                <th>PO Number</th>
                                <th>Client Req No</th>
                                <th>Vendor ID</th>
                                <th>Vendor Name</th>
                                <th>PO Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in SearchPOListCollection">
                                <td class="text-center">{{$index+1}}</td>
                                <td class="text-center">{{row.PoPreparationID}}</td>
                                <td>{{row.ClientReqID}}</td>
                                <td>{{row.VendorID}}</td>
                                <td>{{row.VendorName}}</td>
                                <td>{{row.PoDate}}</td>
                                <td>
                                    <a class="btn btn-sm btn-flat btn-primary"
                                       ng-click="loadExistingPO(row, 'view')">
                                        <i class="fa fa-eye"></i> View
                                    </a>
                                    <a class="btn btn-sm btn-flat btn-warning"
                                       ng-hide="row.ProcessStatus == 'DONE' || row.ProcessStatus == 'PARTIAL'"
                                       ng-click="loadExistingPO(row, 'edit')"
                                       style="margin-left:3px;">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                </td>
                            </tr>
                            <tr ng-if="!SearchPOListCollection || SearchPOListCollection.length === 0">
                                <td colspan="7" class="text-center text-danger">No items available</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div><!-- /box -->

<script type="text/javascript">

    /* ── New-mode datepicker ── */
    $(document).ready(function () {
        var t = new Date();
        var f = String(t.getDate()).padStart(2, '0') + '/' +
            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
        $('#CSRecDate1').val(f);
    });

    $('#CSRecDate1').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
        .on('changeDate', function (ev) {
            var val = $(ev.target).val();
            if (val) {
                var p = val.split('/');
                if (new Date(p[2], p[1] - 1, p[0]) > new Date()) {
                    $(ev.target).val('');
                    toastr.error("Date should not be greater than system date.");
                } else {
                    var scope = angular.element('#CSRecDate1').scope();
                    if (scope) scope.$apply(function () { scope.VendorCSInfo.CSRecDate = val; });
                }
            }
            $('.datepicker').hide();
        });

    /* ═══════════════════════════════════════════════════════════════
       Angular Controller
       ═══════════════════════════════════════════════════════════════ */
    app.controller('POCreationCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        /* ── State ────────────────────────────────────────────────── */
        $scope.itemsByPage = 10;
        $scope.loading = false;
        $scope.isSaving = false;
        $scope.isRefreshing = false;
        $scope.p = 2;
        $scope.pageMode = 'new';
        $scope.isClientSelected = false;
        $scope.isVendorSelected = false;

        /* ── Collections ──────────────────────────────────────────── */
        $scope.CSClientList = [];
        $scope.CSClientDisplayedCollection = [];
        $scope.CSVendorList = [];
        $scope.CSVendorDisplayedCollection = [];
        $scope.VenCSItemList = [];
        $scope.VenCSItemGridDisplayCollection = [];
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];
        $scope.SelectedVendorForBiddingDisplayedCollection = [];
        $scope.SearchPOList = [];
        $scope.SearchPOListCollection = [];

        /* ── Model factory ────────────────────────────────────────── */
        function emptyInfo() {
            return {
                VendorCSInfoID: "",
                VendorID: "",
                VendorName: "",
                ClientID: "",
                ClientName: "",
                ClientReqID: "",
                WIInfoID: "",
                CSRecDate: "",
                Remarks: "",
                ProcessStatus: "",
                PoAmount: "",
                BillType: "Default",
                Installment: 1,
                InstalledAmount: "",
                Category: "Normal"
            };
        }
        $scope.VendorCSInfo = emptyInfo();

        /* ── Reset helper ─────────────────────────────────────────── */
        function resetCollections() {
            $scope.isClientSelected = false;
            $scope.isVendorSelected = false;
            $scope.CSVendorList = [];
            $scope.CSVendorDisplayedCollection = [];
            $scope.VenCSItemList = [];
            $scope.VenCSItemGridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.SelectedVendorForBiddingDisplayedCollection = [];
            $scope.selectedClientRow = null;
            if ($scope.CSClientList) {
                $scope.CSClientList.forEach(function (c) { c.selected = false; });
                $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
            }
        }

        /* ── Initial load ─────────────────────────────────────────── */
        $scope.loading = true;
        $http.post("/POCreation/GetPoCreationClientInfo/")
            .then(function (res) {
                $scope.CSClientList = res.data.CSClientList;
                $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
                $scope.loading = false;
            }, function () { $scope.loading = false; toastr.error("Failed to load client list."); });

        /* ── Mode helpers ─────────────────────────────────────────── */
        $scope.startNewPO = function () {
            $scope.VendorCSInfo = emptyInfo();
            resetCollections();
            $scope.p = 2;
            $scope.pageMode = 'new';
            $http.post("/POCreation/GetPoCreationClientInfo/")
                .then(function (res) {
                    $scope.CSClientList = res.data.CSClientList;
                    $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
                });
        };

        $scope.switchToEdit = function () {

            if ($scope.VendorCSInfo.ProcessStatus == 'DONE') {
                toastr.error("This PO is already Recommended, can not edit now");
                return;
            }

            $scope.pageMode = 'edit';
            $timeout(function () {
                $('#CSRecDate').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                    .on('changeDate', function (ev) {
                        $scope.$apply(function () { $scope.VendorCSInfo.CSRecDate = $(ev.target).val(); });
                        $('.datepicker').hide();
                    });
                if ($scope.VendorCSInfo.CSRecDate)
                    $('#CSRecDate').val($scope.VendorCSInfo.CSRecDate);
            }, 150);
        };

        /* ── Row style ────────────────────────────────────────────── */
        $scope.getRowStyle = function (row) {
            return row.selected ? { background: '#8bf5d2' } : {};
        };

        /* ── Client selection ─────────────────────────────────────── */
        $scope.selectedClientRow = null;
        $scope.ClientSelect = function (row) {
            if (row.selected) {
                row.selected = false; $scope.selectedClientRow = null;
                $scope.isClientSelected = false; $scope.isVendorSelected = false;
                $scope.CSVendorList = []; $scope.CSVendorDisplayedCollection = [];
                return;
            }
            if ($scope.selectedClientRow) $scope.selectedClientRow.selected = false;
            row.selected = true; $scope.selectedClientRow = row;
            $scope.isClientSelected = true; $scope.isVendorSelected = false;

            $scope.VendorCSInfo.ClientID = row.ClientID;
            $scope.VendorCSInfo.ClientName = row.ClientName;
            $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
            $scope.VendorCSInfo.WIInfoID = row.WIInfoID;

            $scope.loading = true;
            $http.post("/POCreation/OBS_GetPOVendorsUsingClient", {
                ClientReqID: row.ClientReqID, WIInfoID: row.WIInfoID
            }).then(function (res) {
                $scope.CSVendorList = res.data.CSVendorList;
                $scope.CSVendorDisplayedCollection = [].concat($scope.CSVendorList);
                $scope.loading = false;
            }, function () { $scope.loading = false; toastr.error("Error fetching vendors."); });
        };

        /* ── Vendor selection (new mode) ──────────────────────────── */
        $scope.selectEntity = function (row) {
            if (row.buttonCheckedforVendor) {
                row.selected = false; row.buttonCheckedforVendor = false;
                $scope.isVendorSelected = false;
                $scope.SelectedVendorForBiddingDisplayedCollection = [];
                $scope.VenCSItemList = []; $scope.VenCSItemGridDisplayCollection = [];
                $scope.ReqTermDataSetupGridData = []; $scope.ReqTermGridDisplayCollection = [];
                return;
            }
            $scope.CSVendorDisplayedCollection.forEach(function (v) {
                v.selected = false; v.buttonCheckedforVendor = false;
            });
            row.selected = true; row.buttonCheckedforVendor = true;
            $scope.isVendorSelected = true;
            $scope.VendorCSInfo.VendorID = row.VendorID;
            $scope.VendorCSInfo.VendorName = row.VendorName;

            $scope.SelectedVendorForBiddingDisplayedCollection = [{
                VendorID: row.VendorID, VendorName: row.VendorName,
                ContactPerson: row.ContactPerson, ContactNumber: row.ContactNumber
            }];

            $scope.loading = true;
            $http.post("/POCreation/GetVendorPOQuotationItem", {
                VendorID: row.VendorID,
                ClientReqID: $scope.VendorCSInfo.ClientReqID,
                WIInfoID: $scope.VendorCSInfo.WIInfoID
            }).then(function (res) {
                $scope.VenCSItemList = (res.data.VenCSItemList || []).map(mapItem);
                $scope.VenCSItemGridDisplayCollection = [].concat($scope.VenCSItemList);
                $scope.loading = false;
            }, function () { $scope.loading = false; toastr.error("Failed to load items."); });

            $http.post('/POCreation/GetVendorPOInfoTermList', {
                VendorID: row.VendorID,
                ClientReqID: $scope.VendorCSInfo.ClientReqID,
                WIInfoID: $scope.VendorCSInfo.WIInfoID
            }).then(function (res) {
                $scope.ReqTermDataSetupGridData = res.data.VendorCSInfoTermList || [];
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
            }, function () { toastr.error("Failed to load terms."); });
        };

        /* ── Item mapping helper ──────────────────────────────────── */
        function mapItem(item) {
            item.NegoTolAmt = parseFloat(item.NegoTolAmt || 0).toFixed(2);
            item.NegoAmt = parseFloat(item.NegoAmt || 0).toFixed(2);
            item.NegoVatAmt = parseFloat(item.NegoVatAmt || 0).toFixed(2);
            item.QutnQnty = parseFloat(item.QutnQnty || 0).toFixed(2);
            return item;
        }

        /* ── Calculations ─────────────────────────────────────────── */
        $scope.validateNegoQty = function (row) {
            var qty = parseFloat(row.NegoQty) || 0;
            var remaining = parseFloat(row.RemainingVendorQty) || 0;
            var qutnQty = parseFloat(row.QutnQnty) || 0;
            if (remaining > 0 && qty > remaining) {
                toastr.error('POQty cannot exceed Remaining Vendor Qty (' + remaining + ').');
                row.NegoQty = remaining;
            } else if (qty > qutnQty) {
                toastr.error('POQty cannot exceed Quotation Qty (' + qutnQty + ').');
                row.NegoQty = qutnQty;
            }
            $scope.checkUnitPrice(row);
        };

        $scope.checkUnitPrice = function (row) {
            if (!row.NegoQty || row.NegoQty <= 0) { row.NegoQty = row.QutnQnty; }
            if (!row.NegoPrice || row.NegoPrice <= 0) { row.NegoPrice = row.QutnPrice; }
            row.NegoAmt = parseFloat(((parseFloat(row.NegoQty) || 0) * (parseFloat(row.NegoPrice) || 0)).toFixed(2));
            row.NegoVatAmt = parseFloat(((parseFloat(row.VatPerc) || 0) * row.NegoAmt / 100).toFixed(2));
            row.NegoTolAmt = parseFloat((row.NegoAmt + row.NegoVatAmt).toFixed(2));
        };

        $scope.calculateInstallmentAmount = function () {
            var amt = parseFloat($scope.VendorCSInfo.PoAmount) || 0;
            var inst = parseInt($scope.VendorCSInfo.Installment) || 1;
            if (amt > 0 && inst > 0)
                $scope.VendorCSInfo.InstalledAmount = (amt / inst).toFixed(2);
        };

        /* ── Search ───────────────────────────────────────────────── */
        $scope.SearchPO = function () {
            $scope.loading = true;
            $http.post('/POCreation/SearchPO')
                .then(function (res) {
                    $scope.SearchPOList = res.data.SearchPOList || res.data.SearchCSList || [];
                    $scope.SearchPOListCollection = [].concat($scope.SearchPOList);
                    $scope.loading = false;
                }, function () { $scope.loading = false; toastr.error("Search failed."); });
            $('#SearchModal').modal('show');
        };

        $scope.ResetSearchModel = function () {
            $scope.SearchPOList = []; $scope.SearchPOListCollection = [];
        };

        /* ── FIX: loadExistingPO ─────────────────────────────────────
           KEY CHANGES vs original:
           1. Uses GetPOHeaderDetails to load header cleanly (POAmt,
              BillType, Category, Installment, Remarks) without depending
              on item rows having those fields.
           2. Passes row.ClientID (numeric) correctly — not ClientReqID.
           3. Sets WIInfoID on VendorCSInfo so terms API gets the right
              parameter.
           4. Populates SelectedVendorForBiddingDisplayedCollection so
              Post() has the vendor reference for edit save.
           5. Init edit datepicker after both header + items have loaded.
        ─────────────────────────────────────────────────────────────── */
        $scope.loadExistingPO = function (row, mode) {
            $('#SearchModal').modal('hide');
            $scope.loading = true;
            $scope.pageMode = mode;   // 'view' | 'edit'
            $scope.p = 1;

            // Resolve WIInfoID from whichever alias the search SP returned
            var wiInfoID = row.WIInfoID || row.WOInfoID || "";

            // Populate known header fields immediately (shown while items load)
            $scope.VendorCSInfo.VendorCSInfoID = row.PoPreparationID;
            $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
            $scope.VendorCSInfo.WIInfoID = wiInfoID;           // FIX: was missing
            $scope.VendorCSInfo.ClientID = row.ClientID;
            $scope.VendorCSInfo.VendorID = row.VendorID;
            $scope.VendorCSInfo.VendorName = row.VendorName;
            $scope.VendorCSInfo.CSRecDate = row.PoDate;
            $scope.VendorCSInfo.ProcessStatus = row.ProcessStatus;

            // So Post() still has the vendor reference
            $scope.SelectedVendorForBiddingDisplayedCollection = [{
                VendorID: row.VendorID,
                VendorName: row.VendorName
            }];

            // FIX: pass only VendorID + POPreparationID; SP no longer filters on ClientID
            $http.post("/PoRecom/GetVendorPORecomQuotationItem", {
                VendorID: row.VendorID,
                ClientID: row.ClientID || "",
                POPreparationID: row.PoPreparationID
            }).then(function (res) {
                var items = res.data.VenCSItemList || [];

                if (items.length > 0) {
                    var h = items[0];
                    $scope.VendorCSInfo.PoAmount = h.POAmt || "";
                    $scope.VendorCSInfo.BillType = h.BillType || "Default";
                    $scope.VendorCSInfo.Category = h.BillCategory || "Normal";
                    $scope.VendorCSInfo.Installment = h.Installment || 1;
                    $scope.VendorCSInfo.InstalledAmount = (h.InstalledAmount !== undefined && h.InstalledAmount !== null)
                        ? h.InstalledAmount
                        : (h.InstallmentAmt || "");
                    $scope.VendorCSInfo.Remarks = h.Remarks || "";
                    $scope.VendorCSInfo.CSRecDate = h.PODate || row.PoDate;
                    $scope.VendorCSInfo.VendorName = h.VendorName || row.VendorName;

                    if (mode === 'edit') {
                        $timeout(function () {
                            $('#CSRecDate')
                                .datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                                .on('changeDate', function (ev) {
                                    $scope.$apply(function () {
                                        $scope.VendorCSInfo.CSRecDate = $(ev.target).val();
                                    });
                                    $('.datepicker').hide();
                                });
                            $('#CSRecDate').val($scope.VendorCSInfo.CSRecDate);
                        }, 150);
                    }
                }

                $scope.VenCSItemList = items.map(mapItem);
                $scope.VenCSItemGridDisplayCollection = [].concat($scope.VenCSItemList);
                $scope.loading = false;
            }, function () {
                $scope.loading = false;
                toastr.error("Failed to load PO items.");
            });

            // Terms — FIX: use resolved wiInfoID
            $http.post('/POCreation/GetVendorPOInfoTermList', {
                VendorID: row.VendorID,
                ClientReqID: row.ClientReqID,
                WIInfoID: wiInfoID
            }).then(function (res) {
                $scope.ReqTermDataSetupGridData = res.data.VendorCSInfoTermList || [];
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
            }, function () {
                toastr.error("Failed to load terms.");
            });
        };


        /* ── Save / Update ────────────────────────────────────────── */
        $scope.Post = function () {
            if (!$scope.VendorCSInfo.ClientReqID) {
                toastr.error("Please select a Client Requisition first."); return;
            }
            if (!$scope.SelectedVendorForBiddingDisplayedCollection ||
                $scope.SelectedVendorForBiddingDisplayedCollection.length === 0) {
                toastr.error("Please select a Vendor."); return;
            }

            var poDate = ($scope.p === 1)
                ? ($('#CSRecDate').val() || $scope.VendorCSInfo.CSRecDate)
                : ($('#CSRecDate1').val() || $scope.VendorCSInfo.CSRecDate);

            if (!poDate) { toastr.error("PO Date is required."); return; }
            if (!$scope.VendorCSInfo.PoAmount) { toastr.error("PO Amount is required."); return; }

            $scope.VendorCSInfo.CSRecDate = poDate;
            $scope.isSaving = true;

            $http.post('/POCreation/SaveVendorPOInfo', {
                vendorCS: $scope.VendorCSInfo,
                vendorCSItem: $scope.VenCSItemGridDisplayCollection,
                vendorCSTerm: $scope.ReqTermGridDisplayCollection,
                vendorCSItemWise: $scope.SelectedVendorForBiddingDisplayedCollection
            }).then(function (res) {
                $scope.isSaving = false;
                var s = res.data.status;
                if (s === 'S201') {
                    toastr.success("Purchase Order saved successfully.");
                    $scope.toggleRefreshTable();
                } else if (s === 'S202') {
                    // FIX: was falling into the error branch before
                    toastr.success("Purchase Order updated successfully.");
                    $scope.toggleRefreshTable();
                } else {
                    toastr.error("Save failed. Status: " + (s || "unknown"));
                }
            }, function () {
                $scope.isSaving = false;
                toastr.error("Data save failed — network or server error.");
            });
        };

        /* ── Refresh ──────────────────────────────────────────────── */
        $scope.toggleRefreshTable = function () {
            $scope.isRefreshing = true;
            $timeout(function () { window.location.reload(); }, 1200);
        };

    }]);
</script>
