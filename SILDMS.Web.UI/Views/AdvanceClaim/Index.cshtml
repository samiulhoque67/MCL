@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header {
        font-size: 12px;
    }

    .btn {
        font-size: 12px;
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }

    input.form-control, button.form-control {
        font-size: 12px;
    }

    label {
        font-size: 12px;
    }

    .box.box-info {
        border-top: 1px solid #3003eb;
    }

    .fa {
        font-size: 12px;
    }
</style>

<div class="box box-primary box-body" ng-controller="QuotationApproveCntrl">

    <div class="box-header with-border bg-light-blue-gradient" style="height: 38px; border-radius: 5px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">Advance Claim from Client</h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button class="button-custom btn-warning" type="button" ng-click="toggleRefreshTable()" ng-disabled="btnRefresh">
                        <i class="fa fa-refresh" style="padding-right: 5px;"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button class="button-custom btn-primary" type="button" ng-click="SearchSaveClients()" ng-disabled="btnSearch">
                        <i class="fa fa-search" style="padding-right: 5px;"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">

                <!-- WO No -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="WorkOrderNo">Work Order No :</label>
                        </div>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                        <div style="position: relative;">
                            <input id="WorkOrderNo" name="WorkOrderNo" type="text" data-ng-model="WorkOrder.WorkOrderNo"
                                   class="form-control" ng-readonly="true"
                                   placeholder="Work Order No"
                                   style="height: 25px; font-size: smaller;" />
                            <button type="button" data-ng-click="SearchAvailableClients()"
                                    style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                    padding: 0px 10px; border: 2px solid black; background: transparent;">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- ClientName -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientName">Client Name :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientName" name="ClientName" type="text" data-ng-model="Client.ClientName" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- ClientRequisition No & Date -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionNo">Client Requisition No :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionNo" name="ClientRequisitionNo" type="text" data-ng-model="Client.ClientRequisitionNo" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionDate">Client Requisition Date:</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionDate" name="ClientRequisitionDate" type="text" data-ng-model="Client.ClientRequisitionDate" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Contact Person & Number -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactPerson">Contact Person :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactPerson" name="ContactPerson" type="text" data-ng-model="Client.ContactPerson" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactNumber">Contact Number :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactNumber" name="ContactNumber" type="text" data-ng-model="Client.ContactNumber" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- TIN & BIN -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactTIN">Contact TIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactTIN" name="ContactTIN" type="text" data-ng-model="Client.ContactTIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactBIN">Contact BIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactBIN" name="ContactBIN" type="text" data-ng-model="Client.ContactBIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactAddress">Contact Address :</label></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <input id="ContactAddress" name="ContactAddress" type="text" data-ng-model="Client.ContactAddress" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

            </div>
        </div>
    </div>

    <!-- ===== MODAL: Available Work Orders (for new claim) ===== -->
    <div id="QuotationForRecom" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" ng-click="ResetSearchModel()" aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive" ng-cloak>
                    <table st-table="AllQuotationsCollection" st-safe-src="AllQuotationsList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="7" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Available Work Order
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-1" data-ng-click="sortList('ClientCode')">
                                    Client Code
                                    <span ng-show="PagingInfo.sortBy == 'ClientCode' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientCode' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2" data-ng-click="sortList('ClientName')">
                                    Client Name
                                    <span ng-show="PagingInfo.sortBy == 'ClientName' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientName' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2" data-ng-click="sortList('ClientReqNo')">
                                    Requisition No
                                    <span ng-show="PagingInfo.sortBy == 'ClientReqNo' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientReqNo' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2">Requisition Date</th>
                                <th class="col-lg-2">Quotation Approve ID</th>
                                <th class="col-lg-2">Quotation Approve Date</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientCode" placeholder="Search Client Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientName" placeholder="Search Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientReqNo" placeholder="Search Req No" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllQuotationsList | orderBy:'IsBack':true">
                                <td class="text-center">{{row.ClientCode}}</td>
                                <td class="text-center">{{row.ClientName}}</td>
                                <td class="text-center">{{row.ClientReqNo}}</td>
                                <td class="text-center">{{row.RequisitionDate | date:'dd/MM/yyyy'}}</td>
                                <td class="text-center">{{row.ClientQutnAprvID}}</td>
                                <td class="text-center">{{row.ClientAdvanceClaimDate | date:'dd/MM/yyyy'}}</td>
                                <td class="col-lg-1 text-center">
                                    <a class="btn btn-sm btn-flat btn-success" ng-click="selectQuotationForRecom(row)">Select</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div ng-if="PagingInfo.totalItems > 0" class="text-center">
                        <ul uib-pagination total-items="PagingInfo.totalItems" ng-model="PagingInfo.page"
                            items-per-page="{{PagingInfo.itemsPerPage}}" max-size="7" boundary-links="true"
                            rotate="true" force-ellipses="true" ng-change="selectPageList()"></ul>
                    </div>
                    <div ng-if="PagingInfo.totalItems <= 0" class="text-center">NO ITEM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== MODAL: Saved Advance Claims (Search / View / Edit) ===== -->
    <div id="AllSavedAdvanceClaim" class="modal fade">
        <div class="modal-dialog" style="width: 80%;">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" ng-click="ResetSearchModel()" aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive" ng-cloak>
                    <table st-table="AllSavedAdvanceClaimCollection" st-safe-src="AllSavedAdvanceClaimList" class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="8" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Saved Advance Claims
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-1" data-ng-click="sortList('ClientCode')">
                                    Client Code
                                    <span ng-show="PagingInfo.sortBy == 'ClientCode' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientCode' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2" data-ng-click="sortList('ClientName')">
                                    Client Name
                                    <span ng-show="PagingInfo.sortBy == 'ClientName' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientName' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2" data-ng-click="sortList('ClientReqNo')">
                                    Requisition No
                                    <span ng-show="PagingInfo.sortBy == 'ClientReqNo' && !PagingInfo.reverse" class="fa fa-caret-down"></span>
                                    <span ng-show="PagingInfo.sortBy == 'ClientReqNo' && PagingInfo.reverse" class="fa fa-caret-up"></span>
                                </th>
                                <th class="col-lg-2">Requisition Date</th>
                                <th class="col-lg-2">Quotation Approve ID</th>
                                <th class="col-lg-2">Claim Date</th>
                                <!-- BUG FIX: Added separate View and Edit action columns -->
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientCode" placeholder="Search Client Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientName" placeholder="Search Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientReqNo" placeholder="Search Req No" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllSavedAdvanceClaimList | orderBy:'IsBack':true">
                                <td class="text-center">{{row.ClientCode}}</td>
                                <td class="text-center">{{row.ClientName}}</td>
                                <td class="text-center">{{row.ClientReqNo}}</td>
                                <td class="text-center">{{row.RequisitionDate | date:'dd/MM/yyyy'}}</td>
                                <td class="text-center">{{row.ClientQutnAprvID}}</td>
                                <td class="text-center">{{row.ClientAdvanceClaimDate | date:'dd/MM/yyyy'}}</td>
                                <!-- View button: loads read-only -->
                                <td class="text-center">
                                    <a class="btn btn-sm btn-flat btn-info" ng-click="openSavedClaimView(row)">
                                        <i class="fa fa-eye"></i> View
                                    </a>
                                
                                    <a class="btn btn-sm btn-flat btn-warning" ng-hide="row.ProcessStatus == 'Done'" ng-click="openSavedClaimEdit(row)">
                                        <i class="fa fa-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div ng-if="PagingInfo.totalItems > 0" class="text-center">
                        <ul uib-pagination total-items="PagingInfo.totalItems" ng-model="PagingInfo.page"
                            items-per-page="{{PagingInfo.itemsPerPage}}" max-size="7" boundary-links="true"
                            rotate="true" force-ellipses="true" ng-change="selectPageList()"></ul>
                    </div>
                    <div ng-if="PagingInfo.totalItems <= 0" class="text-center">NO ITEM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Advance Claim Info Section ===== -->
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info" style="border-bottom: 1px solid #d3e3e3;">
                <div class="box-header with-border" style="height: 40px; border-bottom: 1px solid #d3e3e3;">
                    <h2 class="box-title" style="font-family: math; font-size: 16px; font-weight: bold; color: black;">
                        Advance Claim Info
                        <!-- NEW: shows current mode label -->
                        <span ng-if="isEditMode" class="label label-warning" style="margin-left: 10px; font-size: 11px;">Edit Mode</span>
                        <span ng-if="onlyView" class="label label-info" style="margin-left: 10px; font-size: 11px;">View Mode</span>
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">

                <!-- Total WO Amount -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label>Total WO Amount :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input style="text-align:right" type="text" data-ng-model="AdvanceInformmation.WorkOrderAmount" readonly class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Installment WO Amount & Number -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label>Installment WO Amount :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input style="text-align:right" type="text" data-ng-model="AdvanceInformmation.WOInstallmentAmt" readonly class="form-control" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label>Installment Number :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input style="text-align:right" type="text" data-ng-model="AdvanceInformmation.WOInstallmentNo" readonly class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Advance Claim Amount -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="AdvanceClaimAmount">Advance Claim Amount :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <!--
                                BUG FIX #1: ng-keydown moved here (was wrongly on the readonly RemainingAmount input).
                                BUG FIX #2: ng-readonly uses onlyView only — edit mode allows input.
                            -->
                            <input id="AdvanceClaimAmount"
                                   style="text-align:right"
                                   name="AdvanceClaimAmount"
                                   autocomplete="off"
                                   type="text"
                                   data-ng-model="AdvanceInformmation.AdvanceClaimAmount"
                                   class="form-control"
                                   ng-readonly="onlyView == true"
                                   ng-keydown="calculateRemainingAmount($event)" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- Remaining Amount & Claim Date -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="RemainingAmount">Remaining Amount :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <!-- BUG FIX #1: ng-keydown removed from here (it's readonly; makes no sense here) -->
                            <input id="RemainingAmount"
                                   style="text-align:right"
                                   name="RemainingAmount"
                                   type="text"
                                   data-ng-model="AdvanceInformmation.RemainingAmount"
                                   readonly
                                   class="form-control" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="AdvanceClaimDate">Advance Claim Date :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <!-- BUG FIX: ng-disabled → use onlyView; edit mode allows date change -->
                            <input id="AdvanceClaimDate"
                                   name="AdvanceClaimDate"
                                   readonly
                                   type="text"
                                   class="DatePicker form-control"
                                   placeholder="DD/MM/YYYY"
                                   ng-model="AdvanceInformmation.AdvanceClaimDate"
                                   ng-disabled="onlyView == true"
                                   style="background-color:#ffffff;" />
                        </div>
                    </div>
                </div>

                <!-- Note -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="Note">Note :</label></div>
                    </div>
                    <div class="col-lg-5">
                        <div class="form-group">
                            <input id="Note"
                                   name="Note"
                                   type="text"
                                   autocomplete="off"
                                   data-ng-model="AdvanceInformmation.Note"
                                   class="form-control"
                                   ng-readonly="onlyView == true" />
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row">
                    <div class="col-lg-9"></div>
                    <div class="col-lg-3" style="text-align: right;">

                        <!-- NEW Submit button: shown only when NOT in view/edit mode (i.e., fresh new claim) -->
                        <button id="btnSaveMasterInitial"
                                type="button"
                                class="btn btn-success saveBtn"
                                ng-show="!onlyView && !isEditMode"
                                ng-click="openConfirmModal()"
                                title="Save"
                                style="padding: 6px 36px; box-shadow: -4px 5px 0px 0px rgba(0,0,0,0.1); border-radius: 5px; margin-right: 6px;">
                            <i class="fa fa-check"></i> Submit
                        </button>

                        <!-- NEW: Update button shown only in edit mode -->
                        <button type="button"
                                class="btn btn-warning"
                                ng-show="isEditMode"
                                ng-click="openUpdateConfirmModal()"
                                title="Update"
                                style="padding: 6px 36px; box-shadow: -4px 5px 0px 0px rgba(0,0,0,0.1); border-radius: 5px; margin-right: 6px;">
                            <i class="fa fa-save"></i> Update
                        </button>

                        <!-- NEW: Cancel Edit button -->
                        <button type="button"
                                class="btn btn-default"
                                ng-show="isEditMode"
                                ng-click="cancelEdit()"
                                title="Cancel"
                                style="padding: 6px 20px; border-radius: 5px;">
                            <i class="fa fa-times"></i> Cancel
                        </button>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ===== Confirm Save Modal ===== -->
    <div class="modal fade" id="ConfirmModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Confirm your Action</h4>
                </div>
                <div class="modal-body" style="height:80px;">
                    <h5 class="modal-title">Are you sure you want to Save?</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" style="color: white; background-color: darkgreen;" data-dismiss="modal" ng-click="SaveQuotToClient()">Confirm</button>
                    <button type="button" class="btn button-custom" data-dismiss="modal" style="color: white; background-color: darkred;">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== NEW: Confirm Update Modal ===== -->
    <div class="modal fade" id="UpdateConfirmModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Confirm Update</h4>
                </div>
                <div class="modal-body" style="height:80px;">
                    <h5 class="modal-title">Are you sure you want to Update this Advance Claim?</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" style="color: white; background-color: darkorange;" data-dismiss="modal" ng-click="UpdateAdvanceClaim()">Confirm Update</button>
                    <button type="button" class="btn button-custom" data-dismiss="modal" style="color: white; background-color: darkred;">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div>


<script type="text/javascript">

    app.controller('QuotationApproveCntrl', function ($scope, $http) {

        // ==================== PAGING ====================
        $scope.PagingInfo = {
            page: 1,
            itemsPerPage: 10,
            sortBy: null,
            reverse: false,
            search: null,
            totalItems: 0
        };

        // ==================== MODELS ====================
        $scope.Client = {
            ClientName: "", ClientRequisitionNo: "", ClientRequisitionDate: "",
            ContactPerson: "", ContactNumber: "", ContactTIN: "", ContactBIN: "", ContactAddress: ""
        };

        $scope.WorkOrder = { WorkOrderNo: "" };

        $scope.AdvanceInformmation = {
            AdvancClaimID: "",
            ClientID: "", ClientQutnAprvID: "", WOInfoID: "",
            WorkOrderAmount: "", AdvanceClaimAmount: "", AdvanceClaimDate: "",
            RemainingAmount: "", Note: "", WOInstallmentNo: "", WOInstallmentAmt: ""
        };

        // ==================== FLAGS ====================
        $scope.onlyView = false;   // true  → View mode (all inputs locked)
        $scope.isEditMode = false;  // true  → Edit mode (claim fields editable, WO fields locked)
        $scope.searchType = "";

        // ==================== DATE INIT ====================
        var todayISO = new Date().toISOString().split('T')[0];
        $scope.AdvanceInformmation.AdvanceClaimDate = todayISO;

        // DatePicker init (called after every modal close that might re-bind)
        function initDatePicker() {
            $('.DatePicker').datepicker({
                format: "yyyy-mm-dd",
                autoclose: true
            }).off('changeDate').on('changeDate', function (ev) {
                var selectedDate = $(this).val();
                $('.datepicker').hide();
                var scope = angular.element($(this)).scope();
                scope.$apply(function () {
                    scope.AdvanceInformmation.AdvanceClaimDate = selectedDate;
                });
            });
        }
        initDatePicker();

        // ==================== REMAINING AMOUNT CALC ====================
        // BUG FIX #2: performCalculation uses WOInstallmentAmt as the base
        // (matching the stored procedure and the installment model)
        function performCalculation() {
            var installment = parseFloat($scope.AdvanceInformmation.WOInstallmentAmt) || 0;
            var claimed = parseFloat($scope.AdvanceInformmation.AdvanceClaimAmount) || 0;
            $scope.AdvanceInformmation.RemainingAmount = (installment - claimed).toFixed(2);
        }

        // BUG FIX #1: This is now triggered from the AdvanceClaimAmount field (not RemainingAmount)
        $scope.calculateRemainingAmount = function (event) {
            if (event.keyCode === 13 || event.keyCode === 9) {
                performCalculation();
            }
        };

        // Also recalculate reactively on model change
        $scope.$watchGroup([
            'AdvanceInformmation.WOInstallmentAmt',
            'AdvanceInformmation.AdvanceClaimAmount'
        ], function () {
            performCalculation();
        });

        // ==================== SORT ====================
        // BUG FIX #3: was referencing $scope.pagingInfo (lowercase) — fixed to PagingInfo
        $scope.sortList = function (sortBy) {
            if (sortBy === $scope.PagingInfo.sortBy) {
                $scope.PagingInfo.reverse = !$scope.PagingInfo.reverse;
            } else {
                $scope.PagingInfo.sortBy = sortBy;
                $scope.PagingInfo.reverse = false;
            }
            $scope.PagingInfo.page = 1;
            $scope.selectPageList();
        };

        // ==================== SEARCH: AVAILABLE (New Claim) ====================
        $scope.SearchAvailableClients = function () {
            $scope.onlyView = false;
            $scope.isEditMode = false;
            $scope.Client = {};
            $http.post('/AdvanceClaim/AllAvailableClients', {
                page: $scope.PagingInfo.page,
                itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy,
                reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search,
                type: "isBack"
            }).success(function (response) {
                $scope.AllQuotationsList = response.AllAvailableClientsList;
                $scope.AllQuotationsCollection = [].concat($scope.AllQuotationsList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
            $('#QuotationForRecom').modal('show');
        };

        $scope.selectPageList = function () {
            $http.post('/AdvanceClaim/AllAvailableClients', {
                page: $scope.PagingInfo.page,
                itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy,
                reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search,
                type: "isBack"
            }).success(function (response) {
                $scope.AllQuotationsList = response.AllAvailableClientsList;
                $scope.AllQuotationsCollection = [].concat($scope.AllQuotationsList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        // ==================== SELECT NEW CLAIM ROW ====================
        $scope.selectQuotationForRecom = function (row) {
            $('#QuotationForRecom').modal('hide');
            $scope.loading = true;
            $scope.onlyView = false;
            $scope.isEditMode = false;
            $scope.WorkOrder.WorkOrderNo = row.WONo;

            $http.post('/QuotationToClient/AvailableClientDetailInfo', {
                ClientID: row.ClientID, ClientReqID: row.ClientReqID
            }).success(function (response) {
                var d = response.ClientDetails[0];
                $scope.Client = {
                    ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo,
                    ClientRequisitionDate: d.RequisitionDate, ContactPerson: d.ContactPerson,
                    ContactNumber: d.ContactNumber, ContactTIN: d.ClientTinNo,
                    ContactBIN: d.ClientBinNo, ContactAddress: d.Address
                };
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });

            $scope.GetClientReqDataInfo(row.ClientID, row.WOInfoID, row.WONo);
        };

        $scope.GetClientReqDataInfo = function (ClientID, WOInfoID, WONo) {
            $http.post('/AdvanceClaim/WoQtforAdvanClaim', {
                ClientID: ClientID, WOInfoID: WOInfoID, WONo: WONo
            }).success(function (response) {
                var d = response.WODetails[0];
                $scope.AdvanceInformmation = {
                    ClientID: d.ClientID,
                    WorkOrderAmount: d.WOAmt,
                    ClientQutnAprvID: d.ClientQutnAprvID,
                    WOInfoID: d.WOInfoID,
                    WOInstallmentAmt: d.WOInstallmentAmt,
                    WOInstallmentNo: d.WOInstallmentNo,
                    WOInstallmentID: d.WOInstallmentID,
                    BillCategory: d.BillCategory,
                    BillType: d.BillType,
                    AdvanceClaimDate: todayISO,
                    AdvanceClaimAmount: "",
                    RemainingAmount: ""
                };
                $scope.loading = false;
                initDatePicker();
            }).error(function () { $scope.loading = false; });
        };

        // ==================== SEARCH: SAVED CLAIMS ====================
        $scope.SearchSaveClients = function () {
            $scope.onlyView = false;
            $scope.isEditMode = false;
            $scope.Client = {};
            $scope.searchType = "MasterSearch";
            $http.post('/AdvanceClaim/AllSavedAdvanceClaim', {
                page: $scope.PagingInfo.page,
                itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy,
                reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search,
                type: "isBack"
            }).success(function (response) {
                $scope.AllSavedAdvanceClaimList = response.AllAvailableClientsList;
                $scope.AllSavedAdvanceClaimCollection = [].concat($scope.AllSavedAdvanceClaimList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
            $('#AllSavedAdvanceClaim').modal('show');
        };

        // ==================== VIEW saved claim (read-only) ====================
        $scope.openSavedClaimView = function (row) {
            $('#AllSavedAdvanceClaim').modal('hide');
            $scope.isEditMode = false;
            $scope.LoadSavedClaimData(row, true);   // true = onlyView
        };

        // ==================== NEW: Edit saved claim ====================
        $scope.openSavedClaimEdit = function (row) {
            $('#AllSavedAdvanceClaim').modal('hide');
            $scope.LoadSavedClaimData(row, false);  // false = editable
            $scope.isEditMode = true;
        };

        // Shared loader for View + Edit
        $scope.LoadSavedClaimData = function (row, viewOnly) {
            $scope.loading = true;
            $scope.onlyView = viewOnly;
            $scope.WorkOrder.WorkOrderNo = row.WONo;

            $http.post('/QuotationToClient/AvailableClientDetailInfo', {
                ClientID: row.ClientID, ClientReqID: row.ClientReqID
            }).success(function (response) {
                var d = response.ClientDetails[0];
                $scope.Client = {
                    ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo,
                    ClientRequisitionDate: d.RequisitionDate, ContactPerson: d.ContactPerson,
                    ContactNumber: d.ContactNumber, ContactTIN: d.ClientTinNo,
                    ContactBIN: d.ClientBinNo, ContactAddress: d.Address
                };
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });

            $scope.AllSavedAdvanceClaimDetails(row.ClientID, row.WOInfoID, row.WONo, row.AdvancClaimID);
        };

        $scope.AllSavedAdvanceClaimDetails = function (ClientID, WOInfoID, WONo, AdvancClaimID) {

            $http.post('/AdvanceClaim/AllSavedAdvanceClaimDetails', {
                ClientID: ClientID,
                WOInfoID: WOInfoID,
                WONo: WONo,
                AdvancClaimID: AdvancClaimID
            }).success(function (response) {

                var d = response.WODetails[0];

                $scope.AdvanceInformmation = {
                    AdvancClaimID: d.AdvancClaimID,
                    ClientID: d.ClientID,
                    ClientQutnAprvID: d.ClientQutnAprvID,
                    WOInfoID: d.WOInfoID,
                    WorkOrderAmount: d.WOAmt,
                    WOInstallmentAmt: d.WOInstallmentAmt,
                    WOInstallmentNo: d.WOInstallmentNo,
                    AdvanceClaimAmount: d.AdvancClaimAmt,
                    RemainingAmount: d.RemainingAmt,
                    Note: d.Note,
                    AdvanceClaimDate: d.AdvancClaimDate
                };

                $scope.loading = false;
                initDatePicker();

            }).error(function () {

                $scope.loading = false;

            });
        };

        // ==================== CANCEL EDIT ====================
        $scope.cancelEdit = function () {
            $scope.isEditMode = false;
            $scope.onlyView = false;
            $scope.toggleRefreshTable();
        };

        // ==================== VALIDATION & SUBMIT ====================
        // BUG FIX #5: .toString() before .trim() to avoid crash when value is numeric
        $scope.openConfirmModal = function () {
            var claimDate = ($scope.AdvanceInformmation.AdvanceClaimDate || "").toString().trim();
            var claimAmount = ($scope.AdvanceInformmation.AdvanceClaimAmount || "").toString().trim();
            if (!claimDate) {
                toastr.error('Please enter an Advance Claim Date');
            } else if (!claimAmount) {
                toastr.error('Please enter an Advance Claim Amount');
            } else {
                $('#ConfirmModal').modal('show');
            }
        };

        // BUG FIX #4: Proper success check (was: || "Operation Done" always true)
        $scope.SaveQuotToClient = function () {
            $http.post('/AdvanceClaim/SaveQuotToClient', {
                MasterData: [$scope.AdvanceInformmation]
            }).success(function (response) {
                if (response.status === "Successfully Submitted" || response.status === "Operation Done") {
                    toastr.success('Data Saved Successfully');
                    $scope.refreshPage();
                } else {
                    toastr.error('Something went wrong: ' + response.status);
                }
                $scope.loading = false;
            }).error(function () {
                $scope.loading = false;
                toastr.error('Data Loading Failed.');
            });
        };

        // ==================== NEW: UPDATE ====================
        $scope.openUpdateConfirmModal = function () {
            var claimDate = ($scope.AdvanceInformmation.AdvanceClaimDate || "").toString().trim();
            var claimAmount = ($scope.AdvanceInformmation.AdvanceClaimAmount || "").toString().trim();
            if (!claimDate) {
                toastr.error('Please enter an Advance Claim Date');
            } else if (!claimAmount) {
                toastr.error('Please enter an Advance Claim Amount');
            } else {
                $('#UpdateConfirmModal').modal('show');
            }
        };

        $scope.UpdateAdvanceClaim = function () {
            $http.post('/AdvanceClaim/UpdateAdvanceClaim', {
                MasterData: [$scope.AdvanceInformmation]
            }).success(function (response) {
                if (response.status === "Successfully Updated" || response.status === "Operation Done") {
                    toastr.success('Data Updated Successfully');
                    $scope.refreshPage();
                } else {
                    toastr.error('Update failed: ' + response.status);
                }
                $scope.loading = false;
            }).error(function () {
                $scope.loading = false;
                toastr.error('Update request failed.');
            });
        };

        // ==================== UTILITIES ====================
        $scope.toggleRefreshTable = function () { window.location.reload(); };

        $scope.refreshPage = function () {
            setTimeout(function () { window.location.reload(); }, 2000);
        };

        $scope.ResetSearchModel = function () { /* placeholder if needed */ };

        $scope.getRowStyle = function (row) {
            return row.selected ? { background: '#b9e7d8' } : {};
        };

    });

</script>
