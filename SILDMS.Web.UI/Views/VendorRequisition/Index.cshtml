@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    body {
        font-size: 12px;
    }

    .selected-row {
        background-color: #bbf0ea !important;
    }

    .box-body, .form-group, .btn, .form-control, .box-header {
        font-size: 12px;
    }

    .btn {
        font-size: 12px;
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }

    input.form-control, button.form-control {
        font-size: 12px;
    }

    label {
        font-size: 12px;
    }

    .fa {
        font-size: 12px;
    }

    .text-success {
        color: green;
        font-size: 14px;
    }

    .text-primary {
        color: blue;
        font-size: 14px;
    }


    #mydiv {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 99999;
    }

        #mydiv .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #mydiv .loder {
            background: #fff;
            padding: 20px 30px;
            border-radius: 6px;
            text-align: center;
        }
</style>

<div class="box box-primary box-body" ng-controller="VendorRequisitionCtrl">
    <div ng-show="loading"
         style="position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:red;
            z-index:99999;">
        TEST LOADER
    </div>


    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">Requisition to Vendor</h2>

        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="button-custom btn-warning">
                        <i class="fa fa-refresh" style="padding-right: 5px"></i> Refresh
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    @using (Html.BeginForm("RequisitionToVendorReport", "../Reports", FormMethod.Post, new { target = "_blank", name = "H1Form", id = "H1Form" }))
                    {
                        <input type="hidden" name="VendorReqID" id="hfVendorReqID" value="" />
                        <button type="submit" id="btnSubmit" name="ReportType" class="button-custom btn-success">
                            <i class="fa fa-print"></i> Print
                        </button>
                    }
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="SearchVendorReqModal()" class="button-custom btn-primary">
                        <i class="fa fa-search" style="padding-right: 5px;"></i> Search
                    </button>
                </div>

                @*BUG FIX: Save disabled in viewonlymode; Cancel never disabled *@
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Post()" class="button-custom btn-primary"
                            ng-disabled="viewonlymode">
                        <i class="fa fa-save" style="padding-right: 5px;"></i>
                        {{ VendorReq.VendorReqID ? 'Update' : 'Save' }}
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="Cancel()" class="button-custom btn-danger">
                        <i class="fa fa-times" style="padding-right: 5px;"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body" style="margin: 1%; padding: 5px;">
        <div class="row">
            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="ClientName">Client Name :</label>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    <div style="position: relative;">
                        <input id="ClientName" name="ClientName" type="text"
                               data-ng-model="VendorReq.ClientName"
                               class="form-control" ng-readonly="true"
                               placeholder="Client Name"
                               style="height: 25px; font-size: smaller;" />
                        @*BUG FIX: Hide search button in viewonlymode *@
                        <button type="button" data-ng-click="ShowClientReqList()"
                                ng-hide="viewonlymode"
                                style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                       padding: 0px 10px; border: 2px solid black; background: transparent;">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="SubmissionDate">Submission Date:</label>
                        <label style="font-size: larger; color:red;">*</label>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="form-group">
                        @*BUG FIX: readonly in viewonlymode *@
                        <input id="SubmissionDate" autocomplete="off" name="SubmissionDate" type="text"
                               class="DatePicker form-control" placeholder="DD/MM/YYYY"
                               ng-model="VendorReq.SubmissionDate"
                               ng-readonly="viewonlymode" />
                        <input type="hidden" id="VendorReqID" name="VendorReqID" ng-model="VendorReq.VendorReqID" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="Remarks">Project Name :</label>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="form-group">
                        @*BUG FIX: readonly in viewonlymode *@
                        <textarea id="Remarks" name="Remarks" data-ng-model="VendorReq.Remarks"
                                  class="form-control" placeholder="Project Name"
                                  ng-readonly="viewonlymode"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*==================== CLIENT REQ SELECTION MODAL ==================== *@
    <div id="ClientInfoModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">x</button>
                    <h3 class="modal-title">Client Requisition Information</h3>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="ClientDisplayedCollection" st-safe-src="ClientList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr>
                                <th class="col-lg-3" data-ng-click="sort('ClientName')">Client Name</th>
                                <th class="col-lg-1" data-ng-click="sort('RequisitionDate')">Requisition Date</th>
                                <th class="col-lg-3" data-ng-click="sort('Remarks')">Project Name</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in ClientDisplayedCollection">
                                <td class="hidden">{{row.ClientReqID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="text-left">{{row.ClientName}}</td>
                                <td class="text-center">{{row.RequisitionDate}}</td>
                                <td class="text-left">{{row.Remarks}}</td>
                                <td>
                                    <a class="btn btn-sm btn-flat btn-success" ng-href="#"
                                       data-ng-click="toggleClientReqSelect(row)">Select</a>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    @*==================== VENDOR SELECTION MODAL ==================== *@
    <div id="VendorInfoModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="VendorDisplayedCollection" st-safe-src="VendorList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="8" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Vendor Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th>ServiceItem Name</th>
                                <th>Vendor Code</th>
                                <th>Vendor Name</th>
                                <th>Contact Person</th>
                                <th>Contact Number</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Action</th>
                            </tr>
                            <tr>
                                <th></th>
                                <th><input st-search="VendorCode" placeholder="Vendor Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="VendorName" placeholder="Vendor Name" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in VendorDisplayedCollection">
                                <td class="hidden">{{row.VendorID}}</td>
                                <td class="hidden">{{row.ServiceItemID}}</td>
                                <td class="text-center">{{row.ServiceItemName}}</td>
                                <td class="text-center">{{row.VendorCode}}</td>
                                <td class="text-center">{{row.VendorName}}</td>
                                <td class="text-center">{{row.ContactPerson}}</td>
                                <td class="text-center">{{row.ContactNumber}}</td>
                                <td class="text-center">{{row.Email}}</td>
                                <td class="text-center">{{row.Address}}</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary btn-flat"
                                            data-ng-click="toggleVendorSelect(row)">
                                        <i class="fa fa-edit"></i> Select
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="8" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @*==================== SEARCH VENDOR REQ MODAL ==================== *@
    <div id="SearchVendorReqModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal"
                            aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="vendorReqDisplayedCollection" st-safe-src="vendorReqSearchList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="5" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Vendor Requisition Information
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th class="col-lg-3">Client Name</th>
                                <th class="col-lg-3">Project Name</th>
                                <th class="col-lg-1">Submission Date</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            @*BUG FIX: Added search row *@
                            <tr>
                                <th><input st-search="ClientName" placeholder="Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="Remarks" placeholder="Project Name" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in vendorReqDisplayedCollection">
                                <td class="hidden">{{row.VendorReqID}}</td>
                                <td class="hidden">{{row.ClientID}}</td>
                                <td class="text-left">{{row.ClientName}}</td>
                                <td class="text-left">{{row.Remarks}}</td>
                                <td class="text-center">{{row.SubmissionDate}}</td>
                                <td class="hidden">{{row.RequisitionNo}}</td>
                                <td class="text-center">

                                    <!-- Edit only when Rcvd -->
                                    <a class="btn btn-sm btn-flat btn-success"
                                       ng-if="row.ProcessStatus == 'Rcvd'"
                                       ng-click="toggleVendorReqSelect(row, 'edit')">
                                        Edit
                                    </a>

                                    <!-- Always visible -->
                                    <a class="btn btn-sm btn-flat btn-primary"
                                       ng-click="toggleVendorReqSelect(row, 'view')">
                                        View
                                    </a>

                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-center">
                                    <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="100"></div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @*==================== REQUISITION ITEM GRID ==================== *@
    <div class="row" style="margin: 1%; background-color: #f0f0f0; box-shadow: 2px 2px 5px #888888; padding: 5px 10px;">
        <div class="row">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px;">
                            <th colspan="10" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                Requisition Item List
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Item Code</th>
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: left;">Service Category</th>
                            <th style="text-align: left;">Description</th>
                            <th style="text-align: left;">Delivery Location</th>
                            <th style="text-align: left;">Delivery Date</th>
                            <th style="text-align: left;">Delivery Mode</th>
                            <th style="text-align: left;">Req. Qnty</th>
                            <th style="text-align: left;">Req. Unit</th>
                            @*BUG FIX: Action column only shown when not in viewonlymode *@
                            <th ng-hide="viewonlymode" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in GridDisplayCollection"
                            ng-class="{'selected-row': row.buttonCheckedforVendor}"
                            ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.index+1}}</td>
                            <td class="hidden">{{row.ClientReqItemID}}</td>
                            <td class="hidden">{{row.VendorReqItemID}}</td>
                            <td class="hidden">{{row.VendorReqID}}</td>
                            <td style="width:5%;">{{row.ServiceItemID}}</td>
                            <td style="width:5%;">{{row.ServiceItemName}}</td>
                            <td style="width:6%;">{{row.ServiceCategoryName}}</td>
                            <td style="width:6%;">{{row.Description}}</td>
                            <td style="width:6%;">{{row.DeliveryLocation}}</td>
                            <td style="width:6%;">{{row.DeliveryDate}}</td>
                            <td style="width:6%;">{{row.DeliveryMode}}</td>
                            <td style="width:6%;">{{row.ReqQnty | number:2}}</td>
                            <td style="width:5%;">{{row.ReqUnit}}</td>
                            @*BUG FIX: Checkbox column hidden in viewonlymode *@
                            <td ng-hide="viewonlymode" style="width:5%;">
                                <button type="button" class="ChildButtons" ng-click="selectEntity(row)" title="Select">
                                    <i ng-show="!row.buttonCheckedforVendor" class="fa fa-square-o"></i>
                                    <i ng-show="row.buttonCheckedforVendor" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @*==================== VENDOR ITEM WISE GRID ==================== *@
    <div class="row">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="VendorInfoDisplayedCollection" st-safe-src="ReqWiseVendorList"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Item</span>
                            </th>
                            <th style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="SelectedItemName" name="SelectedItemName" type="text"
                                           data-ng-model="VendorReq.SelectedItemName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                </div>
                            </th>
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Vendor List</span>
                            </th>
                            <th style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="VendorName" name="VendorName" type="text"
                                           data-ng-model="VendorReq.VendorName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    @*BUG FIX: Hide vendor search in viewonlymode *@
                                    <button type="button" ng-click="ShowVendorList()"
                                            ng-hide="viewonlymode"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>CS Status</span>
                                <label style="font-size: 8px; color:red;">*</label>
                            </th>
                            <th style="background: #ffffff; position: relative; padding: 5px;">
                                @*BUG FIX: readonly in viewonlymode *@
                                <select id="CsStatus" name="CsStatus"
                                        style="background-color: #ffffff; width: 120px; height: 26px; font-size: 12px; line-height: 26px; padding: 0;"
                                        class="form-control p-0" ng-model="VendorReq.CsStatus"
                                        ng-disabled="viewonlymode">
                                    <option value="WCS">With CS</option>
                                    <option value="NCS">Without CS</option>
                                </select>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th>Item Name</th>
                            <th>Vendor Code</th>
                            <th>Vendor Name</th>
                            <th>Contact Person</th>
                            <th>Contact Number</th>
                            <th>Address</th>
                            <th>Quantity</th>
                            @*BUG FIX: Action col hidden in viewonlymode *@
                            <th ng-hide="viewonlymode">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in VendorInfoDisplayedCollection">
                            <td class="hidden">{{row.VendorReqItemWiseID}}</td>
                            <td class="hidden">{{row.VendorID}}</td>
                            <td class="hidden">{{row.ServiceItemID}}</td>
                            <td class="text-center">{{row.ServiceItemName}}</td>
                            <td class="text-center">{{row.VendorCode}}</td>
                            <td class="text-center">{{row.VendorName}}</td>
                            <td class="text-center">{{row.ContactPerson}}</td>
                            <td class="text-center">{{row.ContactNumber}}</td>
                            <td class="text-center">{{row.Address}}</td>
                            <td>
                                @*BUG FIX: readonly in viewonlymode *@
                                <input class="form-control" style="width:100%; height:18px; font-size:10px"
                                       type="text" min="0" ng-model="row.VenReqQnty"
                                       ng-readonly="viewonlymode" />
                            </td>
                            <td ng-hide="viewonlymode">
                                <button type="button" class="btn btn-xs btn-danger btn-flat"
                                        data-ng-click="toggleVendorWiseItemReqDelete(row, $index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="8" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="100"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @*==================== TERMS & CONDITIONS GRID ==================== *@
    <div class="row">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            @*BUG FIX: Hide T&C search and Add in viewonlymode *@
                            <th ng-hide="viewonlymode" style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="FormName" name="FormName" type="text"
                                           data-ng-model="VendorReq.FormName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-hide="viewonlymode" style="background: #ffffff;">
                                <button type="button" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Terms Code</th>
                            <th colspan="13" style="text-align: left;">Terms & Conditions</th>
                            <th ng-hide="viewonlymode" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            @*BUG FIX: These were using ClientReq IDs instead of VendorReq IDs *@
                            <td class="hidden">{{row.VendorReqTermsID}}</td>
                            <td class="hidden">{{row.VendorReqID}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td style="width:5%;">{{row.TermsCode}}</td>
                            <td colspan="13" style="width:6%;">{{row.TermsName}}</td>
                            <td ng-hide="viewonlymode" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat"
                                        ng-click="toggleReqTermEdit(row, $index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-danger btn-flat"
                                        ng-click="toggleReqTermDelete(row, $index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @*==================== TERMS & CONDITIONS SEARCH MODAL ==================== *@
    <div id="VendorReqTermsConditionsModal" class="modal fade">
        <div class="modal-dialog">
