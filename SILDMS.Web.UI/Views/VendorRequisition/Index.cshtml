    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>



</div>

<script type="text/javascript">

    $(document).ready(function () {
        var today = new Date();
        var day = String(today.getDate()).padStart(2, '0');
        var month = String(today.getMonth() + 1).padStart(2, '0');
        var year = today.getFullYear();
        $('#SubmissionDate').val(day + '/' + month + '/' + year);
    });

    app.controller('VendorRequisitionCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        $scope.vendorReqItemArray = [];
        $scope.vendorReqTermArray = [];
        $scope.itemsByPage = 10;
        $scope.viewonlymode = false;   // BUG FIX: declare upfront

        // ── Service categories ───────────────────────────────────────────────────
        $http.get('/VendorRequisition/GetServicesCategory')
            .success(function (response) {
                $scope.serviceCategorys = response.result;
                $scope.loading = false;
            }).error(function () { });

        // ── Master models ────────────────────────────────────────────────────────
        $scope.VendorReq = {
            VendorReqID: "",
            ClientReqID: "",
            ClientReqNo: "",
            ClientID: "",
            ClientName: "",
            VendorID: "",
            VendorName: "",
            TermsID: "",
            FormName: "",
            RequisitionNo: "",
            SubmissionDate: "",
            RequisitionDate: "",
            LastDateofQuotation: "",
            Remarks: "",
            TolalItem: "",
            SelectedItem: "",
            SelectedItemName: "",
            CsStatus: "WCS",
            Status: ""
        };

        $scope.VendorReqItem = {
            VendorReqItemID: "",
            VendorReqID: "",
            Description: "",
            DeliveryLocation: "",
            DeliveryDate: "",
            ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
            ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
            DeliveryMode: "",
            ReqQnty: "",
            ReqUnit: ""
        };

        $scope.VendorReqTerm = {
            VendorReqTermsID: "",
            VendorReqID: "",
            TermsID: "",
            TermsCode: "",
            TermsName: ""
        };

        $scope.VendorWiseItemReq = {
            VendorReqID: "", VendorID: "", VendorName: "", TransactionName: "",
            ServiceItemID: "", ServiceItemName: "", VendorReqItemID: "",
            ContactPerson: "", ContactNumber: "", VendorTINNo: "", VendorBINNo: "",
            VendorEmail: "", VendorAddress: "", VenReqQnty: "", VenReqUnit: "", Status: ""
        };

        // ── Grids ────────────────────────────────────────────────────────────────
        $scope.masterDataSetupGridData = [];
        $scope.GridDisplayCollection = [];
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];
        $scope.ReqWiseVendorList = [];
        $scope.VendorInfoDisplayedCollection = [];

        // ── Selection tracking ───────────────────────────────────────────────────
        $scope.selectedRowsForVendor = [];
        $scope.SelectedVendorForBiddingDisplayedCollection = [];
        $scope.showVendorforBiddingArea = false;

        // Module-level variables shared across functions
        var ServiceItemID = "";
        var ServiceCategoryID = "";
        var VenReqQnty = "";

        // ── DatePicker ───────────────────────────────────────────────────────────
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        }).on('changeDate', function () {
            $('.datepicker').hide();
        });

        $(document).on('shown.bs.modal', '#RequisitionItemModal', function () {
            $('#DeliveryDate').datepicker({
                format: "dd/mm/yyyy",
                autoclose: true
            }).on('changeDate', function () {
                $('.datepicker').hide();
            });
        });

        // ── Cancel ───────────────────────────────────────────────────────────────
        // BUG FIX: Cancel was wired in HTML but function didn't exist
        $scope.Cancel = function () {
            $scope.clearVendorReq();
        };

        // ── Clear / reset full form ──────────────────────────────────────────────
        $scope.clearVendorReq = function () {
            $scope.viewonlymode = false;

            $scope.VendorReq = {
                VendorReqID: "", ClientReqID: "", ClientReqNo: "", ClientID: "",
                ClientName: "", VendorID: "", VendorName: "", TermsID: "",
                FormName: "", RequisitionNo: "", SubmissionDate: "",
                RequisitionDate: "", LastDateofQuotation: "", Remarks: "",
                TolalItem: "", SelectedItem: "", SelectedItemName: "",
                CsStatus: "WCS", Status: ""
            };

            $scope.resetVendorReqItem();
            $scope.resetVendorReqTerm();
            $scope.resetVendorWiseItemReq();

            $scope.masterDataSetupGridData = [];
            $scope.GridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.ReqWiseVendorList = [];
            $scope.VendorInfoDisplayedCollection = [];
            $scope.selectedRowsForVendor = [];
            $scope.SelectedVendorForBiddingDisplayedCollection = [];
            $scope.showVendorforBiddingArea = false;
            $scope.vendorReqItemArray = [];
            $scope.vendorReqTermArray = [];

            $('#DeliveryDate').val('');
            $('#hfVendorReqID').val('');
            // Reset today's date on SubmissionDate
            var today = new Date();
            var d = String(today.getDate()).padStart(2, '0');
            var m = String(today.getMonth() + 1).padStart(2, '0');
            var y = today.getFullYear();
            $('#SubmissionDate').val(d + '/' + m + '/' + y);
        };

        // ── Reset helpers ────────────────────────────────────────────────────────
        $scope.resetVendorReqItem = function () {
            $('#DeliveryDate').val('');
            $scope.VendorReqItem = {
                VendorReqItemID: "", VendorReqID: "", Description: "",
                DeliveryLocation: "", DeliveryDate: "",
                ServiceCategory: { ServiceCategoryID: "", ServiceCategoryName: "" },
                ServiceItem: { ServiceItemID: "", ServiceItemName: "" },
                DeliveryMode: "", ReqQnty: "", ReqUnit: ""
            };
        };

        $scope.resetVendorReqTerm = function () {
            $scope.VendorReqTerm = {
                VendorReqTermsID: "", VendorReqID: "", TermsID: "",
                TermsCode: "", TermsName: ""
            };
        };

        $scope.resetVendorWiseItemReq = function () {
            $scope.VendorWiseItemReq = {
                VendorReqID: "", VendorID: "", VendorName: "", TransactionName: "",
                ServiceItemID: "", ServiceItemName: "", VendorReqItemID: "",
                ContactPerson: "", ContactNumber: "", VendorTINNo: "", VendorBINNo: "",
                VendorEmail: "", VendorAddress: "", VenReqQnty: "", VenReqUnit: "", Status: ""
            };
        };

        // ── Show Client Req List ─────────────────────────────────────────────────
        $scope.ShowClientReqList = function () {
            $http.get("/VendorRequisition/GetClientListForVendorRequisition")
                .success(function (response) {
                    $scope.ClientList = response.clientReqSearchList;
                    $scope.ClientDisplayedCollection = [].concat($scope.ClientList);
                    $scope.loading = false;
                }).error(function () { });
            $('#ClientInfoModal').modal('show');
        };

        // ── Select Client Req ────────────────────────────────────────────────────
        $scope.toggleClientReqSelect = function (tableRow) {
            $scope.VendorReq.ClientReqID = tableRow.ClientReqID;
            $scope.VendorReq.ClientReqNo = tableRow.ClientReqNo;
            $scope.VendorReq.ClientID = tableRow.ClientID;
            $scope.VendorReq.ClientName = tableRow.ClientName;
            $scope.VendorReq.Remarks = tableRow.Remarks;

            // Reset item selections when a new client req is chosen
            $scope.selectedRowsForVendor = [];
            $scope.SelectedVendorForBiddingDisplayedCollection = [];
            $scope.ReqWiseVendorList = [];
            $scope.VendorInfoDisplayedCollection = [];

            $http.post('/ClientRequisition/GetClientReqItemList',
                { ClientReqID: tableRow.ClientReqID, ReqType: "QV" })
                .success(function (response) {
                    $scope.masterDataSetupGridData = response.ClientReqItemList;
                    $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                    $scope.GridDisplayCollection.forEach(function (item, idx) {
                        item.index = idx;
                        item.buttonCheckedforVendor = false;
                    });
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            $http.post('/ClientRequisition/GetClientReqTermList',
                { ClientReqID: tableRow.ClientReqID })
                .success(function (response) {
                    $scope.ReqTermDataSetupGridData = response.ClientReqTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            $('#ClientInfoModal').modal('hide');
        };

        // ── Show Vendor List ─────────────────────────────────────────────────────
        // BUG FIX: ServiceItemID was a local var with empty string at call time —
        //          now uses the module-level variable updated by selectEntity()
        $scope.ShowVendorList = function () {
            if (!ServiceItemID) {
                toastr.error("Please select an item from the list first.");
                return;
            }
            $http.get("/VendorRequisition/GetVendorWiseItemList?ServiceItemID=" + ServiceItemID)
                .success(function (response) {
                    $scope.VendorList = response.VendorInfoSearchList;
                    $scope.VendorDisplayedCollection = [].concat($scope.VendorList);
                    $scope.loading = false;
                }).error(function () { });
            $('#VendorInfoModal').modal('show');
        };

        // ── Service category change ──────────────────────────────────────────────
        $scope.ServiceCategoryChange = function () {
            ServiceCategoryID = $scope.VendorReqItem.ServiceCategory.ServiceCategoryID;
            $http.post("/ServiceItemInfo/GetServiceItemInfoSearchList?ServiceItemCategoryID=" + ServiceCategoryID)
                .success(function (response) {
                    $scope.serviceItems = response.ServiceItemInfoSearchList;
                    $scope.loading = false;
                }).error(function () { });
        };

        // ── Item selection (checkbox toggle) ─────────────────────────────────────
        $scope.selectEntity = function (row) {
            var selecteditems = {
                ServiceCategoryID: row.ServiceCategoryID,
                ServiceCategoryName: row.ServiceCategoryName,
                ServiceItemID: row.ServiceItemID,
                ServiceItemName: row.ServiceItemName,
                Description: row.Description,
                DeliveryDate: row.DeliveryDate,
                DeliveryLocation: row.DeliveryLocation,
                DeliveryMode: row.DeliveryMode,
                ReqQnty: row.ReqQnty,
                ReqUnit: row.ReqUnit,
                VendorReqItemID: row.VendorReqItemID,
                ClientReqItemID: row.ClientReqItemID,
                VendorReqID: row.VendorReqID,
                index: row.index
            };

            $scope.VendorReq.SelectedItemName = row.ServiceItemName;
            $scope.VendorReq.VendorName = "";

            ServiceItemID = row.ServiceItemID;
            ServiceCategoryID = row.ServiceCategoryID;
            VenReqQnty = row.ReqQnty;

            var indexToRemove = -1;
            $scope.selectedRowsForVendor.forEach(function (item, idx) {
                if (item.index === selecteditems.index) indexToRemove = idx;
            });

            if (indexToRemove !== -1) {
                $scope.selectedRowsForVendor.splice(indexToRemove, 1);
                $scope.SelectedVendorForBiddingDisplayedCollection.splice(indexToRemove, 1);
                row.buttonCheckedforVendor = false;
            } else {
                $scope.selectedRowsForVendor.push(selecteditems);
                $scope.SelectedVendorForBiddingDisplayedCollection = [].concat($scope.selectedRowsForVendor);
                row.buttonCheckedforVendor = true;
                $scope.showVendorforBiddingArea = true;
            }

            if ($scope.selectedRowsForVendor.length <= 0) {
                $scope.showVendorforBiddingArea = false;
            }
        };

        // ── Select Vendor ────────────────────────────────────────────────────────
        // BUG FIX: `VenReqQnty` was referenced before it was assigned as a var
        $scope.toggleVendorSelect = function (row) {
            var isAlreadySelected = $scope.VendorInfoDisplayedCollection.some(function (item) {
                return item.VendorID === row.VendorID && item.ServiceItemID === row.ServiceItemID;
            });

            if (isAlreadySelected) {
                toastr.error("This Vendor is already selected for " + row.ServiceItemName);
                return;
            }

            $scope.VendorReq.VendorID = row.VendorID;
            $scope.VendorReq.VendorCode = row.VendorCode;
            $scope.VendorReq.VendorName = row.VendorName;
            $scope.VendorReq.SelectedItemName = row.ServiceItemName;

            $scope.VendorWiseItemReq.ServiceItemID = row.ServiceItemID;
            $scope.VendorWiseItemReq.ServiceItemName = row.ServiceItemName;
            $scope.VendorWiseItemReq.VendorID = row.VendorID;
            $scope.VendorWiseItemReq.VendorCode = row.VendorCode;
            $scope.VendorWiseItemReq.VendorName = row.VendorName;
            $scope.VendorWiseItemReq.ContactPerson = row.ContactPerson;
            $scope.VendorWiseItemReq.ContactNumber = row.ContactNumber;
            $scope.VendorWiseItemReq.Email = row.Email;
            $scope.VendorWiseItemReq.Address = row.Address;
            $scope.VendorWiseItemReq.VenReqQnty = VenReqQnty; // BUG FIX: now correctly set

            $scope.VendorInfoDisplayedCollection = $scope.VendorInfoDisplayedCollection
                .concat(angular.copy($scope.VendorWiseItemReq));

            $scope.resetVendorWiseItemReq();
            $('#VendorInfoModal').modal('hide');
        };

        // ── Delete Vendor-Wise Item ──────────────────────────────────────────────
        // BUG FIX: Stored pending index so async confirm callback has it
        $scope.pendingDeleteVendorWiseIndex = null;

        $scope.toggleVendorWiseItemReqDelete = function (tableRow, idx) {
            if (!tableRow.VendorReqItemWiseID) {
                $scope.VendorInfoDisplayedCollection.splice(idx, 1);
                toastr.success('Item Deleted Successfully');
            } else {
                $scope.VendorWiseItemReq.VendorReqItemWiseID = tableRow.VendorReqItemWiseID;
                $scope.pendingDeleteVendorWiseIndex = idx;
                $('#deleteReqItemModal').modal('show');
            }
        };

        // BUG FIX: DeleteVendorReqItem used undefined $i; now uses pendingDeleteVendorWiseIndex
        $scope.DeleteVendorReqItem = function () {
            var idx = $scope.pendingDeleteVendorWiseIndex;
            $http.post('/VendorRequisition/DeleteVendorReqItemAndTerm',
                { VendorReqItemID: $scope.VendorWiseItemReq.VendorReqItemWiseID, VendorReqTermID: "" })
                .success(function (response) {
                    if (response.status === "S203") {
                        if (idx !== null) {
                            $scope.VendorInfoDisplayedCollection.splice(idx, 1);
                            $scope.pendingDeleteVendorWiseIndex = null;
                        }
                        $scope.resetVendorWiseItemReq();
                        toastr.success('Item Deleted Successfully');
                    }
                }).error(function () { toastr.error('Delete Failed'); });
        };

        // ── Search Vendor Req Modal ──────────────────────────────────────────────
        $scope.SearchVendorReqModal = function () {
            $scope.GetVendorReqSearchList();
            $('#SearchVendorReqModal').modal('show');
        };

        $scope.GetVendorReqSearchList = function () {
            $http.post("/VendorRequisition/GetVendorReqSearchList")
                .success(function (response) {
                    $scope.vendorReqSearchList = response.vendorReqSearchList;
                    $scope.vendorReqDisplayedCollection = [].concat($scope.vendorReqSearchList);
                }).error(function () { });
        };

        // ── Select Vendor Req (Edit / View) ──────────────────────────────────────
        // BUG FIX: was no viewonlymode logic at all — added ProcessStatus check
        $scope.toggleVendorReqSelect = function (tableRow, mode) {

            $scope.clearVendorReq();

            // View mode
            $scope.viewonlymode = (mode === 'view');

            // OR stricter validation:
            // $scope.viewonlymode = (tableRow.ProcessStatus !== 'Rcvd' || mode === 'view');

            $scope.VendorReq.VendorReqID = tableRow.VendorReqID;
            $scope.VendorReq.ClientID = tableRow.ClientID;
            $scope.VendorReq.ClientName = tableRow.ClientName;
            $scope.VendorReq.RequisitionNo = tableRow.RequisitionNo;
            $scope.VendorReq.RequisitionDate = tableRow.RequisitionDate;
            $scope.VendorReq.SubmissionDate = tableRow.SubmissionDate;
            $scope.VendorReq.LastDateofQuotation = tableRow.LastDateofQuotation;
            $scope.VendorReq.Remarks = tableRow.Remarks;
            $scope.VendorReq.Status = tableRow.Status;
            $scope.VendorReq.ClientReqNo = tableRow.ClientReqNo;

            $('#hfVendorReqID').val(tableRow.VendorReqID);
            // Set submission date
            $timeout(function () {
                if (tableRow.SubmissionDate) {
                    $('#SubmissionDate').val(tableRow.SubmissionDate);
                }
            }, 100);

            // Load items
            $http.post('/VendorRequisition/GetVendorReqItemList', {
                VendorReqID: tableRow.VendorReqID
            }).success(function (response) {

                $scope.masterDataSetupGridData = response.VendorReqItemList;
                $scope.GridDisplayCollection = [].concat($scope.masterDataSetupGridData);
                $scope.VendorReq.CsStatus = $scope.GridDisplayCollection[0].CsStatus

                // Mark saved items selected
                $scope.GridDisplayCollection.forEach(function (item, idx) {
                    item.index = idx;
                    item.buttonCheckedforVendor = true;
                });

                $scope.selectedRowsForVendor = [].concat($scope.GridDisplayCollection);
                $scope.SelectedVendorForBiddingDisplayedCollection = [].concat($scope.GridDisplayCollection);

                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            // Load terms
            $http.post('/VendorRequisition/GetVendorReqTermList', {
                VendorReqID: tableRow.VendorReqID
            }).success(function (response) {

                $scope.ReqTermDataSetupGridData = response.VendorReqTermList;
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);

                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            // Load vendors
            $http.post('/VendorRequisition/GetReqWiseVendorList', {
                VendorReqID: tableRow.VendorReqID
            }).success(function (response) {

                $scope.ReqWiseVendorList = response.ReqWiseVendorList;
                $scope.VendorInfoDisplayedCollection = [].concat($scope.ReqWiseVendorList);

                $scope.loading = false;

            }).error(function () {

                $scope.loading = false;

            });

            $('#SearchVendorReqModal').modal('hide');
        };

        // ── Terms & Conditions ───────────────────────────────────────────────────
        $scope.ShowTermsConditionsList = function () {
            $http.get("/VendorRequisition/GetTermsConditionsList")
                .success(function (response) {
                    $scope.TermsConditionsList = response.termsConditionsList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { });
            $('#VendorReqTermsConditionsModal').modal('show');
        };

        $scope.toggleTermsConditionsSelect = function (row) {
            $scope.VendorReq.TermsID = row.TermsID;
            $scope.VendorReq.FormName = row.FormName;
            $http.post('/VendorRequisition/GetVendorReqTermAgainstFormList', { TermsID: row.TermsID })
                .success(function (response) {
                    $scope.ReqTermDataSetupGridData = response.VendorReqTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#VendorReqTermsConditionsModal').modal('hide');
        };

        // ── Add Term Modal ───────────────────────────────────────────────────────
        $scope.AddReqTermModal = function () {
            if ($('#SubmissionDate').val() === "") {
                toastr.error("Submission Date Required."); return;
            }
            $scope.resetVendorReqTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('show');
        };

        $scope.AddReqTerm = function () {
            if (!$scope.VendorReqTerm.TermsCode) {
                toastr.error("Terms Code Required"); return;
            }
            if (!$scope.VendorReqTerm.TermsName) {
                toastr.error("Terms Name Required."); return;
            }

            $scope.vendorReqTermArray.push(angular.copy($scope.VendorReqTerm));
            $scope.ReqTermGridDisplayCollection = $scope.ReqTermGridDisplayCollection
                .concat(angular.copy($scope.VendorReqTerm));

            $scope.resetVendorReqTerm();
            $('#btnAddReqTermLabel').text('Add');
            $('#RequisitionTermModal').modal('hide');
        };

        // BUG FIX: toggleReqTermEdit used `tableRow.VendorReqTermD` (typo)
        $scope.toggleReqTermEdit = function (tableRow, idx) {
            $scope.resetVendorReqTerm();
            $scope.VendorReqTerm.VendorReqTermsID = tableRow.VendorReqTermID;  // BUG FIX: was VendorReqTermD
            $scope.VendorReqTerm.VendorReqID = tableRow.VendorReqID;
            $scope.VendorReqTerm.TermsID = tableRow.TermsID;
            $scope.VendorReqTerm.TermsCode = tableRow.TermsCode;
            $scope.VendorReqTerm.TermsName = tableRow.TermsName;
            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
            $scope.vendorReqTermArray.splice(idx, 1);
            $('#btnAddReqTermLabel').text('Update');
            $('#RequisitionTermModal').modal('show');
        };

        // BUG FIX: $i was undefined in delete callbacks — store index in scope
        $scope.pendingDeleteTermIndex = null;

        $scope.toggleReqTermDelete = function (tableRow, idx) {
            if (!tableRow.VendorReqTermID) {
                $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                $scope.vendorReqTermArray.splice(idx, 1);
                toastr.success('Term Deleted Successfully');
            } else {
                $scope.VendorReqTerm.VendorReqTermsID = tableRow.VendorReqTermID;
                $scope.pendingDeleteTermIndex = idx;
                $('#deleteReqTermModal').modal('show');
            }
        };

        // BUG FIX: button called DeleteReqTerm() but function was DeleteVendorReqTerm();
        //          also used undefined $i — now uses pendingDeleteTermIndex
        $scope.DeleteReqTerm = function () {
            var idx = $scope.pendingDeleteTermIndex;
            $http.post('/VendorRequisition/DeleteVendorReqItemAndTerm',
                { VendorReqItemID: "", VendorReqTermID: $scope.VendorReqTerm.VendorReqTermsID })
                .success(function (response) {
                    if (response.status === "S203") {
                        if (idx !== null) {
                            $scope.ReqTermGridDisplayCollection.splice(idx, 1);
                            $scope.vendorReqTermArray.splice(idx, 1);
                            $scope.pendingDeleteTermIndex = null;
                        }
                        $scope.resetVendorReqTerm();
                        toastr.success('Term Deleted Successfully');
                    }
                }).error(function () { toastr.error('Delete Failed'); });
        };

        // ── Save ─────────────────────────────────────────────────────────────────
        $scope.Post = function () {
            if (!$scope.VendorReq.ClientName) {
                toastr.error("Client Name Required."); return;
            }
            if ($('#SubmissionDate').val() === "") {
                toastr.error("Submission Date Required."); return;
            }
            if (!$scope.VendorReq.CsStatus) {
                toastr.error("CS Status Required."); return;
            }

            var allItems = $scope.GridDisplayCollection;
            var selectedItems = $scope.SelectedVendorForBiddingDisplayedCollection;
            var vendorItemWise = $scope.VendorInfoDisplayedCollection;

            // Validation: all items must be selected
            if (allItems.length !== selectedItems.length) {
                toastr.error("Please select all listed items before saving.");
                return;
            }

            // Validation: every item must have at least one vendor assigned
            var missingAssignments = allItems.filter(function (item) {
                return !vendorItemWise.some(function (v) {
                    return v.ServiceItemID === item.ServiceItemID;
                });
            });
            if (missingAssignments.length > 0) {
                var missingNames = missingAssignments.map(function (m) { return m.ServiceItemName; }).join(', ');
                toastr.error("Please assign a vendor for: " + missingNames);
                return;
            }

            $scope.VendorReq.SubmissionDate = $('#SubmissionDate').val();
            $scope.VendorReq.RequisitionDate = $('#RequisitionDate').val();
            $scope.VendorReq.LastDateofQuotation = $('#LastDateofQuotation').val();
            $scope.VendorReq.TolalItem = allItems.length;
            $scope.VendorReq.SelectedItem = selectedItems.length;

            $scope.loading = true;

            $http.post('/VendorRequisition/SaveVendorRequisition', {
                vendorReq: $scope.VendorReq,
                vendorReqItem: selectedItems,
                vendorReqTerm: $scope.ReqTermGridDisplayCollection,
                vendorReqItemWise: vendorItemWise
            })
                .success(function (response) {
                    if (response.status === "S201") {
                        toastr.success("Data Saved Successfully.");
                        // BUG FIX: Set hidden field for print form then submit
                        $('#hfVendorReqID').val(response.VendorReqID || $scope.VendorReq.VendorReqID);
                        $timeout(function () {
                            document.getElementById("H1Form").submit();
                        }, 500);
                    } else if (response.status === "S202") {
                        toastr.success("Data Updated Successfully.");
                    } else {
                        toastr.error("Data Save Failed.");
                    }
                    $scope.clearVendorReq();
                    $scope.loading = false;
                })
                .error(function () {
                    toastr.error("Data Save Failed.");
                    $scope.loading = false;
                });
        };

        // ── Refresh ──────────────────────────────────────────────────────────────
        $scope.toggleRefreshTable = function () {
            window.location.reload();
        };

        $scope.ResetSearchModel = function () { /* placeholder */ };

    }]);
</script>
