    @*==================== DELETE REQ TERM CONFIRM MODAL ==================== *@
    <div class="modal fade" id="deleteReqTermModal" tabindex="-1" role="dialog"
         style="position: fixed; top: 38%; left: 50%; transform: translate(-38%, -50%); background: rgba(0,0,0,0) !important">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 5px; width: 456px; height: 185px;">
                <div class="modal-header" style="height: 46px;">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Delete Selected Term</h4>
                </div>
                <div class="modal-body" style="height: 80px;">Are you sure to delete this term?</div>
                <div class="modal-footer">
                    <button type="button" class="btn button-custom" data-dismiss="modal"
                            style="color: white; background-color: red;"
                            ng-click="DeleteReqTerm()">
                        Yes
                    </button>
                    <button type="button" class="btn button-custom" data-dismiss="modal" style="color: white">No</button>
