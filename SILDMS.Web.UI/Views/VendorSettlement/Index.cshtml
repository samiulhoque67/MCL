@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-list {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-view {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .input-readonly {
        background-color: #ffffff !important;
        cursor: default;
    }

    .po-info-box {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px 14px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .po-info-box strong {
            color: #31708f;
        }

    .section-title {
        background-color: #cbd4d9;
        padding: 0.6%;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 6px;
    }

    .status-pending {
        color: #8a6d3b;
        background: #fcf8e3;
        border: 1px solid #faebcc;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }

    .status-done {
        color: #3c763d;
        background: #dff0d8;
        border: 1px solid #d6e9c6;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }

    .calc-box {
        background: #eef6fb;
        border: 1px solid #bce8f1;
        border-radius: 4px;
        padding: 10px 14px;
        font-size: 14px;
    }

        .calc-box table {
            width: 100%;
        }

        .calc-box td {
            padding: 3px 4px;
        }

            .calc-box td.amt {
                text-align: right;
                font-weight: bold;
                color: #31708f;
                width: 160px;
            }

        .calc-box tr.total td {
            border-top: 2px solid #31708f;
            font-size: 16px;
        }

        .calc-box .minus {
            color: #a94442;
        }

    .due-highlight {
        font-weight: bold;
        color: #a94442;
    }

    .sub-title {
        font-weight: bold;
        color: #31708f;
        margin: 4px 15px 8px 15px;
        border-bottom: 1px solid #bbb;
        padding-bottom: 3px;
    }
</style>

<div class="box box-primary box-body" ng-controller="VendorSettlementCtrl">

    <!-- TOOLBAR -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;border-radius:5px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Vendor Settlement
            <span ng-show="p===2" class="mode-badge mode-list">PAYMENT LIST</span>
            <span ng-show="p===1 && pageMode==='view'" class="mode-badge mode-view">VIEW HISTORY</span>
            <span ng-show="p===1 && pageMode==='edit'" class="mode-badge mode-edit">NEW SETTLEMENT ENTRY</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">

                <div class="btn-group pull-right" style="margin-left:4px;">
                    <button class="button-custom btn-warning" type="button"
                            ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                        <i class="fa fa-refresh" ng-class="{'fa-spin':isRefreshing}" style="padding-right:5px"></i> Refresh
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1 && pageMode==='edit'">
                    <button class="button-custom btn-success" type="button" ng-click="Post()" ng-disabled="isSaving">
                        <i class="fa fa-check" style="padding-right:5px"></i> Save Settlement
                    </button>
                </div>

                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1">
                    <button class="button-custom btn-default" type="button" ng-click="goBackToList()">
                        <i class="fa fa-arrow-left" style="padding-right:5px"></i> Back
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ p===2 : LIST ══════════════ -->
    <div ng-show="p===2">
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">

            <div ng-show="ListDisplayedCollection.length<=0" style="text-align:center;padding:20px;">
                <h4 style="color:red;">
                    Nothing to settle yet.
                    <br /><small>A payment appears here once it has a TDS amount, or the VDS is paid by the Vendor.</small>
                </h4>
            </div>

            <div ng-show="ListDisplayedCollection.length>0" class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Vendor Settlement List</div>

                <table st-table="ListDisplayedCollection" st-safe-src="List"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Vendor Name</th>
                            <th>Client Name</th>
                            <th>PO No</th>
                            <th>Money Receipt No</th>
                            <th style="text-align:right;">TDS Amount</th>
                            <th style="text-align:right;">TDS Due</th>
                            <th style="text-align:right;">VDS Amount (Vendor)</th>
                            <th style="text-align:right;">VDS Due</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ListDisplayedCollection" style="height:20px;font-size:13px;">
                            <td>{{row.VendorName}}</td>
                            <td>{{row.ClientName}}</td>
                            <td class="text-center">{{row.PoNo}}</td>
                            <td class="text-center">{{row.MoneyReceiptNo}}</td>
                            <td style="text-align:right;">{{row.TDSAmountTotal | number:2}}</td>
                            <td style="text-align:right;" ng-class="{'due-highlight': row.TDSDue > 0}">{{row.TDSDue | number:2}}</td>
                            <td style="text-align:right;">{{row.VDSAmountTotal | number:2}}</td>
                            <td style="text-align:right;" ng-class="{'due-highlight': row.VDSDue > 0}">{{row.VDSDue | number:2}}</td>
                            <td class="text-center">
                                <span ng-show="row.SettlementStatus==='Settled'" class="status-done">Settled</span>
                                <span ng-show="row.SettlementStatus!=='Settled'" class="status-pending">{{row.SettlementStatus}}</span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-flat btn-primary" ng-click="openDetail(row, 'view')">
                                    <i class="fa fa-eye"></i> View
                                </button>
                                <button type="button" class="btn btn-sm btn-flat btn-success" style="margin-left:3px;"
                                        ng-show="row.SettlementStatus!=='Settled'" ng-click="openDetail(row, 'edit')">
                                    <i class="fa fa-plus"></i> Add Settlement
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="10" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div><!-- /p===2 -->
    <!-- ══════════════ p===1 : DETAIL ══════════════ -->
    <div ng-show="p===1">

        <!-- Summary bar -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box">
                    <div class="row">
                        <div class="col-lg-3"><strong>PO No:</strong>&nbsp;{{Settlement.PoNo}}</div>
                        <div class="col-lg-3"><strong>Vendor:</strong>&nbsp;{{Settlement.VendorName}}</div>
                        <div class="col-lg-3"><strong>Client:</strong>&nbsp;{{Settlement.ClientName}}</div>
                        <div class="col-lg-3"><strong>Status:</strong>&nbsp;{{Settlement.SettlementStatus}}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- The bill payment this settlement belongs to, with its detail grid -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Bill Payment</div>

                <div class="calc-box" style="margin-bottom:10px;">
                    <table>
                        <tr>
                            <td>Bill Total (with VAT {{Settlement.VatPerc | number:2}}%)</td>
                            <td class="amt">{{Settlement.BillItemsAmount | number:2}}</td>
                        </tr>
                        <tr ng-show="Settlement.AdvanceAdjustedAmt > 0">
                            <td class="minus">less: Advance already paid</td>
                            <td class="amt minus">- {{Settlement.AdvanceAdjustedAmt | number:2}}</td>
                        </tr>
                        <tr>
                            <td class="minus">
                                less: TDS paid by Media Com
                                <span class="text-muted" style="font-size:12px;">
                                    ({{Settlement.TDSPerc | number:2}}% of {{Settlement.BillItemsAmountWithoutVat | number:2}})
                                </span>
                            </td>
                            <td class="amt minus">- {{Settlement.TDSAmountTotal | number:2}}</td>
                        </tr>
                        <tr ng-show="Settlement.VDSPaidBy==='Vendor'">
                            <td class="minus">less: VDS (VAT {{Settlement.VatPerc | number:2}}%) paid directly by Vendor</td>
                            <td class="amt minus">- {{Settlement.VDSAmountTotal | number:2}}</td>
                        </tr>
                        <tr class="total">
                            <td>
                                Payable Amount
                                <span class="text-muted" style="font-size:12px;">
                                    (Money Receipt {{Settlement.MoneyReceiptNo}}, paid {{Settlement.PaymentDate}})
                                </span>
                            </td>
                            <td class="amt">{{Settlement.PayableAmount | number:2}}</td>
                        </tr>
                    </table>
                </div>

                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Item Name</th>
                            <th style="text-align:right;">Qty</th>
                            <th style="text-align:right;">Unit Price</th>
                            <th style="text-align:right;">Amount (excl. VAT)</th>
                            <th style="text-align:right;">VAT (%)</th>
                            <th style="text-align:right;">VAT Amt</th>
                            <th style="text-align:right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ItemList" ng-cloak>
                            <td>{{row.ServiceItemName}}</td>
                            <td style="text-align:right;">{{row.BillQty | number:2}}</td>
                            <td style="text-align:right;">{{row.BillPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.BillAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillVatPerc | number:2}}%</td>
                            <td style="text-align:right;">{{row.BillVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.BillTotalAmt | number:2}}</td>
                        </tr>
                        <tr ng-if="ItemList.length===0">
                            <td colspan="7" class="text-center text-danger">No items found for this bill</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:bold;background:#f9f9f9;">
                            <td colspan="3" class="text-right">Bill Total</td>
                            <td style="text-align:right;">{{Settlement.BillItemsAmountWithoutVat | number:2}}</td>
                            <td style="text-align:right;">{{Settlement.VatPerc | number:2}}%</td>
                            <td style="text-align:right;">{{Settlement.BillVatAmt | number:2}}</td>
                            <td style="text-align:right;">{{Settlement.BillItemsAmount | number:2}}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Settlement entries already recorded -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <div class="section-title">Settlement History</div>
                <table style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Entered On</th>
                            <th style="text-align:right;">Challan Received</th>
                            <th style="text-align:right;">TDS Due After</th>
                            <th>TDS Challan No</th>
                            <th>TDS Challan Date</th>
                            <th>TDS Document</th>
                            <th style="text-align:right;">Mushak Received</th>
                            <th style="text-align:right;">VDS Due After</th>
                            <th>Mushak No</th>
                            <th>Mushak Date</th>
                            <th>Mushak Document</th>
                            <th>Entered By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="h in History" ng-cloak>
                            <td>{{h.SetOn}}</td>
                            <td style="text-align:right;">{{h.TDSChallanReceiveAmt | number:2}}</td>
                            <td style="text-align:right;">{{h.TDSDueAmt | number:2}}</td>
                            <td>{{h.TDSChallanNo}}</td>
                            <td>{{h.TDSChallanDate}}</td>
                            <td>
                                <a ng-show="h.HasTDSDoc==='1'" target="_blank"
                                   ng-href="/VendorSettlement/DownloadSettlementDocument?VendorSettlementID={{h.VendorSettlementID}}&DocType=TDS">
                                    <i class="fa fa-paperclip"></i> {{h.TDSDocName}}
                                </a>
                            </td>
                            <td style="text-align:right;">{{h.MushakReceiveAmt | number:2}}</td>
                            <td style="text-align:right;">{{h.VDSDueAmt | number:2}}</td>
                            <td>{{h.MushakNo}}</td>
                            <td>{{h.MushakDate}}</td>
                            <td>
                                <a ng-show="h.HasMushakDoc==='1'" target="_blank"
                                   ng-href="/VendorSettlement/DownloadSettlementDocument?VendorSettlementID={{h.VendorSettlementID}}&DocType=Mushak">
                                    <i class="fa fa-paperclip"></i> {{h.MushakDocName}}
                                </a>
                            </td>
                            <td>{{h.SetBy}}</td>
                        </tr>
                        <tr ng-if="History.length===0">
                            <td colspan="12" class="text-center text-muted">No settlement has been recorded yet</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- New entry form (edit mode only) -->
        <div ng-show="pageMode==='edit'" class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;padding:10px;">

            <!-- TDS -->
            <div ng-show="showTDS">
                <div class="sub-title">TDS (paid by Media Com)</div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>TDS Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly" readonly="readonly"
                               ng-model="Settlement.TDSAmountTotal" />
                    </div>
                    <div class="col-lg-2"><label>Challan Receive Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                               ng-model="Entry.TDSChallanReceiveAmt" ng-disabled="tdsFullyReceived"
                               ng-change="recalculateDue()" />
                        <div class="text-muted" style="font-size:11px;" ng-show="tdsFullyReceived">TDS challan already received in full.</div>
                        <div class="text-danger" style="font-size:11px;" ng-show="tdsOver">
                            Cannot exceed the TDS due ({{Settlement.TDSDue | number:2}}).
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>TDS Due Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly due-highlight" readonly="readonly"
                               ng-value="tdsDueAfter | number:2" />
                    </div>
                    <div class="col-lg-2"><label>TDS Challan No:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" maxlength="50"
                               ng-model="Entry.TDSChallanNo" ng-disabled="tdsFullyReceived" />
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>TDS Challan Date:</label></div>
                    <div class="col-lg-3">
                        <input id="TDSChallanDate" type="text" autocomplete="off" class="DatePicker form-control"
                               placeholder="DD/MM/YYYY" ng-model="Entry.TDSChallanDate" ng-disabled="tdsFullyReceived" />
                    </div>
                    <div class="col-lg-2"><label>TDS Document:</label></div>
                    <div class="col-lg-3">
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               file-model="Files.tds" ng-disabled="tdsFullyReceived" />
                        <div class="text-muted" style="font-size:11px;">PDF, JPG or PNG, up to 5 MB.</div>
                    </div>
                </div>
            </div>

            <!-- VDS / Mushak -->
            <div ng-show="showVDS">
                <div class="sub-title" style="margin-top:14px;">VDS / Mushak (mandatory — VDS paid by Vendor)</div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>VDS Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly" readonly="readonly"
                               ng-model="Settlement.VDSAmountTotal" />
                    </div>
                    <div class="col-lg-2"><label>Mushak Receive Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                               ng-model="Entry.MushakReceiveAmt" ng-disabled="vdsFullyReceived"
                               ng-change="recalculateDue()" />
                        <div class="text-muted" style="font-size:11px;" ng-show="vdsFullyReceived">Mushak already received in full.</div>
                        <div class="text-danger" style="font-size:11px;" ng-show="vdsOver">
                            Cannot exceed the VDS due ({{Settlement.VDSDue | number:2}}).
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>VDS Due Amount:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly due-highlight" readonly="readonly"
                               ng-value="vdsDueAfter | number:2" />
                    </div>
                    <div class="col-lg-2"><label>Mushak No:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control" maxlength="50"
                               ng-model="Entry.MushakNo" ng-disabled="vdsFullyReceived" />
                    </div>
                </div>

                <div class="row" style="margin-bottom:8px;">
                    <div class="col-sm-1"></div>
                    <div class="col-lg-2"><label>Mushak Date:</label></div>
                    <div class="col-lg-3">
                        <input id="MushakDate" type="text" autocomplete="off" class="DatePicker form-control"
                               placeholder="DD/MM/YYYY" ng-model="Entry.MushakDate" ng-disabled="vdsFullyReceived" />
                    </div>
                    <div class="col-lg-2"><label>Mushak Document:</label></div>
                    <div class="col-lg-3">
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               file-model="Files.mushak" ng-disabled="vdsFullyReceived" />
                        <div class="text-muted" style="font-size:11px;">PDF, JPG or PNG, up to 5 MB.</div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-top:6px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-10 text-muted" style="font-size:12px;">
                    Each save records one receipt. If an amount is still due afterwards, come back and add another entry when the next challan / Mushak arrives.
                </div>
            </div>
        </div>

    </div><!-- /p===1 -->
    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

</div><!-- /box -->

<script type="text/javascript">// Lets <input type="file" file-model="Files.tds"> publish the chosen File onto the scope.
    // Guarded so it can't be registered twice if the Client Settlement page's script is also on the page.
    if (!window.__fileModelRegistered) {
        window.__fileModelRegistered = true;
        app.directive('fileModel', ['$parse', function ($parse) {
            return {
                restrict: 'A',
                link: function (scope, element, attrs) {
                    var model = $parse(attrs.fileModel);
                    element.on('change', function () {
                        scope.$apply(function () {
                            model.assign(scope, element[0].files[0] || null);
                        });
                    });
                }
            };
        }]);
    }

    app.controller('VendorSettlementCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            $scope.itemsByPage = 10;
            $scope.loading = false;
            $scope.isSaving = false;
            $scope.isRefreshing = false;
            $scope.p = 2;
            $scope.pageMode = 'view';

            $scope.List = [];
            $scope.ListDisplayedCollection = [];
            $scope.ItemList = [];
            $scope.History = [];
            $scope.Settlement = {};
            $scope.Files = { tds: null, mushak: null };

            $scope.showTDS = false;
            $scope.showVDS = false;
            $scope.tdsFullyReceived = false;
            $scope.vdsFullyReceived = false;
            $scope.tdsDueAfter = 0;
            $scope.vdsDueAfter = 0;
            $scope.tdsOver = false;
            $scope.vdsOver = false;

            var MAX_BYTES = 5 * 1024 * 1024;
            var ALLOWED = ['pdf', 'jpg', 'jpeg', 'png'];

            function num(v) { return parseFloat(v) || 0; }
            function round2(v) { return Math.round(v * 100) / 100; }

            function emptyEntry() {
                return {
                    TDSChallanReceiveAmt: "", TDSChallanNo: "", TDSChallanDate: "",
                    MushakReceiveAmt: "", MushakNo: "", MushakDate: ""
                };
            }
            $scope.Entry = emptyEntry();

            /* ── Initial load ── */
            $scope.loading = true;
            $http.post("/VendorSettlement/GetVendorSettlementList/")
                .then(function (res) {
                    $scope.List = res.data.VendorSettlementList || [];
                    $scope.ListDisplayedCollection = [].concat($scope.List);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load settlement list.");
                });

            /* ── Dues after this entry (the server recomputes them from stored entries) ── */
            $scope.recalculateDue = function () {
                var tdsDue = num($scope.Settlement.TDSDue);
                var vdsDue = num($scope.Settlement.VDSDue);
                var tdsIn = num($scope.Entry.TDSChallanReceiveAmt);
                var mushakIn = num($scope.Entry.MushakReceiveAmt);

                $scope.tdsOver = tdsIn > tdsDue || tdsIn < 0;
                $scope.vdsOver = mushakIn > vdsDue || mushakIn < 0;
                $scope.tdsDueAfter = round2(tdsDue - tdsIn);
                $scope.vdsDueAfter = round2(vdsDue - mushakIn);
            };

            function datePickerInit(selector, ns, assign) {
                $(selector).datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                    .off('changeDate.' + ns)
                    .on('changeDate.' + ns, function (ev) {
                        $scope.$apply(function () { assign($(ev.target).val()); });
                        $('.datepicker').hide();
                    });
            }

            /* ── Open detail. view = history only; edit = add one more entry ── */
            $scope.openDetail = function (row, mode) {
                $scope.loading = true;
                $scope.p = 1;
                $scope.pageMode = mode;
                $scope.Settlement = row;
                $scope.Entry = emptyEntry();
                $scope.Files = { tds: null, mushak: null };

                $scope.showTDS = num(row.TDSAmountTotal) > 0;
                $scope.showVDS = row.VDSPaidBy === 'Vendor' && num(row.VDSAmountTotal) > 0;
                $scope.tdsFullyReceived = $scope.showTDS && num(row.TDSDue) <= 0;
                $scope.vdsFullyReceived = $scope.showVDS && num(row.VDSDue) <= 0;
                $scope.recalculateDue();

                if (mode === 'edit') {
                    $timeout(function () {
                        datePickerInit('#TDSChallanDate', 'tds', function (v) { $scope.Entry.TDSChallanDate = v; });
                        datePickerInit('#MushakDate', 'mushak', function (v) { $scope.Entry.MushakDate = v; });
                    }, 100);
                }

                $http.post("/VendorSettlement/GetVendorSettlementBillItem", { VendorFinalBillID: row.VendorFinalBillID })
                    .then(function (res) {
                        $scope.ItemList = res.data.VendorSettlementBillItemList || [];
                    }, function () {
                        toastr.error("Failed to load bill items.");
                    });

                $http.post("/VendorSettlement/GetVendorSettlementHistory", { VendorBillPaymentID: row.VendorBillPaymentID })
                    .then(function (res) {
                        $scope.History = res.data.VendorSettlementHistory || [];
                        $scope.loading = false;
                    }, function () {
                        $scope.loading = false;
                        toastr.error("Failed to load settlement history.");
                    });
            };

            $scope.goBackToList = function () {
                $scope.p = 2;
                $scope.pageMode = 'view';
                $scope.Settlement = {};
                $scope.ItemList = [];
                $scope.History = [];
                $scope.Entry = emptyEntry();
                $scope.Files = { tds: null, mushak: null };
            };

            var statusMessages = {
                E404: "Payment not found.",
                E420: "Enter a receive amount for TDS, Mushak, or both.",
                E421: "TDS challan amount is invalid or exceeds the TDS due.",
                E422: "TDS Challan No and Challan Date are required.",
                E423: "Mushak amount is invalid or exceeds the VDS due.",
                E424: "Mushak No and Mushak Date are required.",
                E440: "Session expired. Please sign in again."
            };

            function fileProblem(file, label) {
                if (!file) return null;
                var ext = (file.name.split('.').pop() || '').toLowerCase();
                if (ALLOWED.indexOf(ext) === -1) return label + ": only PDF, JPG or PNG files are allowed.";
                if (file.size > MAX_BYTES) return label + ": the file is larger than 5 MB.";
                return null;
            }

            /* ── Save (multipart: text fields + the two optional documents) ── */
            $scope.Post = function () {
                var e = $scope.Entry;
                var tdsIn = num(e.TDSChallanReceiveAmt);
                var mushakIn = num(e.MushakReceiveAmt);

                $scope.recalculateDue();
                if (tdsIn <= 0 && mushakIn <= 0) { toastr.error(statusMessages.E420); return; }

                var tdsDate = $('#TDSChallanDate').val() || e.TDSChallanDate;
                var mushakDate = $('#MushakDate').val() || e.MushakDate;

                if (tdsIn > 0) {
                    if (!$scope.showTDS || $scope.tdsOver) { toastr.error(statusMessages.E421); return; }
                    if (!e.TDSChallanNo || !e.TDSChallanNo.trim() || !tdsDate) { toastr.error(statusMessages.E422); return; }
                }
                if (mushakIn > 0) {
                    if (!$scope.showVDS || $scope.vdsOver) { toastr.error(statusMessages.E423); return; }
                    if (!e.MushakNo || !e.MushakNo.trim() || !mushakDate) { toastr.error(statusMessages.E424); return; }
                }

                var problem = (tdsIn > 0 ? fileProblem($scope.Files.tds, "TDS Document") : null) ||
                              (mushakIn > 0 ? fileProblem($scope.Files.mushak, "Mushak Document") : null);
                if (problem) { toastr.error(problem); return; }

                var fd = new FormData();
                fd.append('VendorBillPaymentID', $scope.Settlement.VendorBillPaymentID);
                fd.append('TDSChallanReceiveAmt', tdsIn > 0 ? tdsIn : 0);
                fd.append('TDSChallanNo', tdsIn > 0 ? e.TDSChallanNo.trim() : '');
                fd.append('TDSChallanDate', tdsIn > 0 ? tdsDate : '');
                fd.append('MushakReceiveAmt', mushakIn > 0 ? mushakIn : 0);
                fd.append('MushakNo', mushakIn > 0 ? e.MushakNo.trim() : '');
                fd.append('MushakDate', mushakIn > 0 ? mushakDate : '');
                if (tdsIn > 0 && $scope.Files.tds) fd.append('TDSDocument', $scope.Files.tds);
                if (mushakIn > 0 && $scope.Files.mushak) fd.append('MushakDocument', $scope.Files.mushak);

                $scope.isSaving = true;
                $http.post('/VendorSettlement/SaveVendorSettlementInfo', fd, {
                    transformRequest: angular.identity,
                    headers: { 'Content-Type': undefined }
                }).then(function (res) {
                    $scope.isSaving = false;
                    var s = res.data.status;
                    if (s === 'S201') {
                        toastr.success("Settlement entry saved.");
                        $scope.toggleRefreshTable();
                    } else {
                        toastr.error(res.data.msg || statusMessages[s] || ("Save Failed. Status: " + (s || "unknown")));
                    }
                }, function () {
                    $scope.isSaving = false;
                    toastr.error("Save Failed.");
                });
            };

            $scope.toggleRefreshTable = function () {
                $scope.isRefreshing = true;
                $timeout(function () { window.location.reload(); }, 1200);
            };

        }]);</script>
