@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header, label,
    input.form-control, button.form-control, .fa {
        font-size: 12px;
    }

    .btn {
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }
</style>

<div class="box box-primary box-body" ng-controller="QuotationApproveCntrl">

    <!-- Upper buttons -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">All Client Quotation Approval Data</h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <!-- Client-side HTML print; enabled once an approved quotation is loaded -->
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" ng-show="MasterData.ClientQutnAprvID" ng-disabled="showPrint"
                            class="button-custom btn-success" ng-click="printQuotation()">
                        <i class="fa fa-print" style="padding-right: 5px"></i> Quotation Print
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" ng-click="showActionLog()" class="button-custom">
                        <i class="fa fa-history" style="padding-right: 5px;"></i> History
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="button-custom" ng-disabled="btnRefresh">
                        <i class="fa fa-refresh" style="padding-right: 5px;"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="box-body">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">

                <!-- ClientName -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientName">Client Name :</label></div>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                        <div style="position: relative;">
                            <input id="ClientName" name="ClientName" type="text" data-ng-model="Client.ClientName"
                                   class="form-control" ng-readonly="true" placeholder="Client Name"
                                   style="height: 25px; font-size: smaller;" />
                            <button type="button" data-ng-click="SearchAvailableClients()"
                                    style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                           padding: 0px 10px; border: 2px solid black; background: transparent;">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- Requisition No & Date -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionNo">Client Requisition No :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionNo" type="text" data-ng-model="Client.ClientRequisitionNo" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionDate">Client Requisition Date:</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionDate" type="text" data-ng-model="Client.ClientRequisitionDate" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Contact Person & Number -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactPerson">Contact Person :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactPerson" type="text" data-ng-model="Client.ContactPerson" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactNumber">Contact Number :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactNumber" type="text" data-ng-model="Client.ContactNumber" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- TIN & BIN -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactTIN">Contact TIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactTIN" type="text" data-ng-model="Client.ContactTIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactBIN">Contact BIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactBIN" type="text" data-ng-model="Client.ContactBIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactAddress">Contact Address :</label></div>
                    </div>
                    <div class="col-lg-7">
                        <div class="form-group">
                            <input id="ContactAddress" type="text" data-ng-model="Client.ContactAddress" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- Uploaded documents -->
                <div class="row" ng-if="GetClientReqDetails.length > 0">
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="upload_documents">
                                Uploaded Documents <br>
                                (<span style="color:#ff4900;"> PDF Only </span>)
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span ng-hide="getDocumentList().length" style="color:#999; font-size:11px;">No document attached</span>
                        <button type="button" ng-repeat="docID in getDocumentList() track by $index"
                                ng-click="ViewDocument(docID)" class="btn button-custom btn-sm" style="margin: 0 4px 4px 0;">
                            <i class="fa fa-eye"></i> View Doc {{$index + 1}}
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Approved quotations list -->
    <div id="QuotationForRecom" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive" ng-cloak>
                    <table st-table="AllQuotationsCollection" st-safe-src="AllQuotationsList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="14" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Approved Quotations
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th style="text-align: left;">Client Name</th>
                                <th style="text-align: left;">Project Name</th>
                                <th style="text-align: left;">Representative</th>
                                <th style="text-align: left;">Client Req No</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th colspan="5">
                                    <input type="search" ng-model="PagingInfo.search" ng-model-options="{ debounce: 400 }"
                                           ng-change="SearchAvailableClients()"
                                           placeholder="Search Client Name / Req No / Representative..." class="input-sm form-control" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllQuotationsList | orderBy:'IsBack':true">
                                <td class="col-lg-2">{{row.ClientName}}</td>
                                <td class="col-lg-2">{{row.ProjectName}}</td>
                                <td class="col-lg-2">{{row.UserFullName}}</td>
                                <td class="col-lg-2">{{row.ClientReqNo}}</td>
                                <td class="col-lg-1 text-center">
                                    <a class="btn col-center btn-sm btn-flat btn-success" ng-click="selectQuotationForRecom(row, 'save')">Select</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div ng-if="PagingInfo.totalItems > 0" class="text-center">
                        <ul uib-pagination total-items="PagingInfo.totalItems" ng-model="PagingInfo.page"
                            items-per-page="{{PagingInfo.itemsPerPage}}" max-size="7" boundary-links="true"
                            rotate="true" force-ellipses="true" ng-change="selectPageList()"></ul>
                    </div>
                    <div ng-if="PagingInfo.totalItems <= 0" class="text-center">NO ITEM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Item and service list (read-only) -->
    <div class="row" ng-if="GetClientReqDetails.length > 0">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <table st-table="GetClientReqDetailsCollection" st-safe-src="GetClientReqDetails"
                   class="table table-condensed table-bordered table-striped table-hover pnlView">
                <thead>
                    <tr style="font-size: 15px;">
                        <th colspan="18" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                            Item and Service List
                        </th>
                    </tr>
                    <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                        <th style="text-align: left;">Item Code</th>
                        <th style="text-align: left;">Item Name</th>
                        <th style="text-align: left;">Description</th>
                        <th style="text-align: left;">Delivery Location</th>
                        <th style="text-align: left;">Delivery Date</th>
                        <th style="text-align: left;">Req Unit</th>
                        <th style="text-align: left;">Quoted Qty</th>
                        <th style="text-align: left;">C.Qut.Recom Unit Price (without vat)</th>
                        <th style="text-align: left;">Aprv Quoted Unit Price</th>
                        <th style="text-align: left;">C.Qut.Recom Amount (without vat)</th>
                        <th style="text-align: left;">Aprv Quoted Amount</th>
                        <th style="text-align: left;">ASF (%)</th>
                        <th style="text-align: left;">ASF Amount</th>
                        <th style="text-align: left;">Vat (%)</th>
                        <th style="text-align: left;">VAT Amount</th>
                        <th style="text-align: left;">Total C.Qut.Recom Amount (with vat)</th>
                        <th style="text-align: left;">Aprv Total Amount (with vat)</th>
                        <th style="text-align: left;">Vendor</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="row in GetClientReqDetailsCollection" ng-init="initializeDefaults(row)" ng-cloak style="font-size: 12px;">
                        <td style="width: 5%;">{{ row.ServiceItemID }}</td>
                        <td style="width: 5%;">{{ row.ServiceItemName }}</td>
                        <td style="width: 6%;">{{ row.Description }}</td>
                        <td style="width: 6%;">{{ row.DeliveryLocation }}</td>
                        <td style="width: 6%;">{{ row.DeliveryDate }}</td>
                        <td style="width: 5%;">{{ row.ReqUnit }}</td>
                        <td style="width: 6%;">{{ row.QutnQnty }}</td>
                        <td style="width: 6%;">{{ row.QutnPrice }}</td>
                        <td style="width: 6%;">{{ row.givenQutnPrice }}</td>
                        <td style="width: 6%;">{{ row.ClientQutnAmt }}</td>
                        <td style="width: 6%; color: #126e0f;">{{ row.givenQutnAmt }}</td>
                        <td style="width: 6%;">{{ row.ASFPerc }}</td>
                        <td style="width: 6%; text-align: right;">{{ row.TotGivenASFAmt | number:3 }}</td>
                        <td style="width: 6%;">{{ row.GivenVatPerc }}</td>
                        <td style="width: 6%;">{{ row.TotGivenVatAmt | number:3 }}</td>
                        <td style="width: 6%;">{{ row.TolAmt }}</td>
                        <td style="width: 6%; color: #126e0f;">{{ row.givenTolAmt }}</td>
                        <td style="width: 3%; text-align: center;">
                            <button type="button" class="button-detail" ng-click="detailVendorCS(row)" title="Show vendor detail">
                                <i class="fa fa-info"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Terms + notes + preview -->
    <div class="box-body" ng-show="showTermsItem === true">

        <!-- Terms selection modal -->
        <div id="ClientReqTermsConditionsModal" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div style="text-align: right;">
                        <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                            <i class="fa fa-remove"></i>
                        </button>
                    </div>
                    <div class="modal-body table-responsive">
                        <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                               class="table table-condensed table-bordered table-striped table-hover pnlView">
                            <thead>
                                <tr style="font-size: 15px;">
                                    <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                        Terms & Conditions Information
                                    </th>
                                </tr>
                                <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                    <th>Form Code</th>
                                    <th>Form Name</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                                <tr>
                                    <th><input st-search="FormCode" placeholder="Form Code" class="input-sm form-control" type="search" /></th>
                                    <th><input st-search="FormName" placeholder="Form Name" class="input-sm form-control" type="search" /></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="row in TermsConditionsDisplayedCollection">
                                    <td class="hidden">{{row.TermsID}}</td>
                                    <td class="text-center">{{row.FormCode}}</td>
                                    <td class="text-center">{{row.FormName}}</td>
                                    <td class="text-center">
                                        <span ng-attr-class="{{row.Status =='1'? 'label label-success' : 'label label-danger' }}">
                                            {{row.Status == '1'? 'Active':'InActive'}}
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary btn-flat" data-ng-click="toggleTermsConditionsSelect(row)">
                                            <i class="fa fa-edit"></i> Select
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" class="text-center">
                                        <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terms list table -->
        <div class="row">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            <th ng-show="pagefunction === 'savemode'" style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="FormName" name="FormName" type="text" data-ng-model="ClientReq.FormName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-show="pagefunction === 'savemode'" style="background: #ffffff;">
                                <button type="button" id="btnReqTermAdd" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Terms Code</th>
                            <th colspan="13" style="text-align: left;">Terms & Conditions</th>
                            <th ng-show="pagefunction !== 'viewmode'" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in TermsConditionsDisplayedCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.ClientReqTermsID}}</td>
                            <td class="hidden">{{row.ClientReqID}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td class="col-lg-1" style="width:5%;">{{row.TermsCode}}</td>
                            <td colspan="13" style="width:6%;">{{row.TermsName}}</td>
                            <td ng-show="pagefunction !== 'viewmode'" class="col-lg-1" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat" ng-click="toggleReqTermEdit(row,$index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-primary btn-flat btnDelete" ng-click="toggleReqTermDelete(row,$index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Add / Edit term modal -->
        <div id="RequisitionTermModal" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="row">
                            <div class="col-sm-5">
                                <h4 class="modal-title" style="font-family: initial; font-weight: 700">Terms & Conditions Information</h4>
                            </div>
                            <div style="text-align: right;">
                                <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div ng-cloak>
                        <div class="row" style="position:relative;top:5px;">
                            <div class="col-sm-1"></div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="TermsCode">Terms Code:</label>
                                    <label style="font-size:larger;color:red;">*</label>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <input id="TermsCode" name="TermsCode" type="text" class="form-control" placeholder="Terms Code" autocomplete="off"
                                       ng-model="ClientReqTerm.TermsCode" style="height: 25px; background-color:#ffffff; font-size: smaller" />
                            </div>
                        </div>
                        <div class="row" style="position:relative;top:5px;">
                            <div class="col-sm-1"></div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="TermsName">Terms and Conditions:</label>
                                    <label style="font-size:larger;color:red;">*</label>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                <input id="TermsName" name="TermsName" type="text" class="form-control" placeholder="Terms Name" autocomplete="off"
                                       ng-model="ClientReqTerm.TermsName" style="height: 25px; background-color:#ffffff; font-size: smaller" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <div class="btn-group pull-right" style="margin:2px;">
                                    <button type="button" id="btnAddReqTerm" data-ng-click="AddReqTerm()" class="button-detail btn">
                                        <i class="fa fa-save" style="padding-right: 3px"></i>Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="QuotationRecNote">Recommended Note :</label></div>
                    </div>
                    <div class="col-lg-10">
                        <div class="form-group">
                            <textarea id="QuotationRecNote" name="QuotationRecNote" class="form-control" readonly
                                      data-ng-model="MasterData.QuotationRecNote"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="QuotationAprvNote">Approved Note :</label></div>
                    </div>
                    <div class="col-lg-10">
                        <div class="form-group">
                            <textarea id="QuotationAprvNote" readonly name="QuotationAprvNote" class="form-control" autocomplete="off"
                                      data-ng-model="MasterData.QuotationAprvNote"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-9"></div>
                    <div ng-show="pagefunction === 'savemode'" class="col-lg-2">
                        <button type="button" class="btn btn-success saveBtn pull-right"
                                ng-click="openConfirmModal('save')" title="Preview"
                                style="padding: 6px 36px; box-shadow: -4px 5px 0px 0px rgba(0, 0, 0, 0.1); border-radius: 5px;">
                            <i class="fa fa-check"></i> Preview
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

    <!-- PDF viewer modal -->
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body" style="padding: 0; margin: 0;">
                    <iframe id="pdfViewer" style="width: 100%; height: 100vh; border: none;" title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Shared modals: vendor detail + action history -->
    @Html.Partial("_QutnCommonModals")

    <!-- ══════════════ PRINT SLIP (hidden; rendered into an iframe on print) ══════════════ -->
    <div id="masterRow" style="display:none;">

        <div style="margin-bottom:18px;">
            <img src="/Content/AdminLTE/img/MCL-logo.png" alt="MCL Logo"
                 style="max-height:85px; max-width:130px; display:block; margin-bottom:6px;" />
            <div style="font-size:11px; line-height:1.35; color:#222;">
                <strong style="font-size:13px;">MEDIACOM LIMITED</strong><br />
                SAMSON CENTER<br />
                Levels - 5 to 7<br />
                43 South Avenue, Road-126, Plot-CES (G) 5A,<br />
                Gulshan 1, Dhaka &ndash; 1212<br />
                IP No. 09610939393 extn: 1200/1205<br />
                email: mediacombd.com, www.mediacombd.com
            </div>
        </div>

        <p style="font-size:20px;font-weight:bold;text-decoration:underline;margin:0;">Client Quotation</p>

        <div style="display:flex;justify-content:space-between;margin-top:16px;">
            <div style="width:48%;">
                <p style="font-weight:bold;margin:0;">Prepare For</p>
                <p style="margin:2px 0;">Client Code:&nbsp;&nbsp;{{PrintHeader.ClientCode}}</p>
                <p style="margin:2px 0;">Client Name:&nbsp;&nbsp;{{PrintHeader.ClientName}}</p>
                <p style="margin:2px 0;">Address:&nbsp;&nbsp;{{PrintHeader.Address}}</p>
            </div>
            <div style="width:48%;">
                <table style="width:100%;border-collapse:collapse;font-size:12px;">
                    <tr>
                        <td style="border:1px solid #000;padding:5px;font-weight:bold;">Ref / Quotation Num</td>
                        <td style="border:1px solid #000;padding:5px;">{{PrintHeader.QuotationNo}}</td>
                    </tr>
                    <tr>
                        <td style="border:1px solid #000;padding:5px;font-weight:bold;">Created by :</td>
                        <td style="border:1px solid #000;padding:5px;">{{PrintHeader.CreatedBy}}</td>
                    </tr>
                    <tr>
                        <td style="border:1px solid #000;padding:5px;font-weight:bold;">Client Requisition No</td>
                        <td style="border:1px solid #000;padding:5px;">{{PrintHeader.ClientReqNo}}</td>
                    </tr>
                    <tr>
                        <td style="border:1px solid #000;padding:5px;font-weight:bold;">Briefing Date</td>
                        <td style="border:1px solid #000;padding:5px;">{{PrintHeader.BriefingDate}}</td>
                    </tr>
                    <tr>
                        <td style="border:1px solid #000;padding:5px;font-weight:bold;">Quotation Submission Date :</td>
                        <td style="border:1px solid #000;padding:5px;">{{PrintHeader.QuotationSubmissionDate}}</td>
                    </tr>
                </table>
            </div>
        </div>

        <table style="width:100%;border-collapse:collapse;margin-top:14px;font-size:12px;">
            <thead>
                <tr>
                    <th style="border:1px solid #000;padding:5px;text-align:left;">Service</th>
                    <th style="border:1px solid #000;padding:5px;text-align:left;">Description</th>
                    <th style="border:1px solid #000;padding:5px;text-align:left;">UOM</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">Unit Price</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">Quantity</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">Amount</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">ASF(%)</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">ASF Amt</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">VAT(%)</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">Vat Amt</th>
                    <th style="border:1px solid #000;padding:5px;text-align:right;">Total Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in PrintItems" ng-cloak>
                    <td style="border:1px solid #000;padding:5px;">{{row.ServiceItemName}}</td>
                    <td style="border:1px solid #000;padding:5px;">{{row.Description}}</td>
                    <td style="border:1px solid #000;padding:5px;">{{row.QutnUnit}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.AprvPrice | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.QutnQnty | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.AprvAmt | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.ASFPerc | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.ASFAmt | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.VatPerc | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.VatAmt | number:2}}</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;">{{row.TolAmt | number:2}}</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="10" style="border:1px solid #000;padding:5px;text-align:right;font-weight:bold;">Total (BDT)</td>
                    <td style="border:1px solid #000;padding:5px;text-align:right;font-weight:bold;">{{PrintGrandTotal | number:2}}</td>
                </tr>
                <tr>
                    <td colspan="4" style="border:1px solid #000;padding:5px;font-weight:bold;">Inwords Grand Total (BDT)</td>
                    <td colspan="7" style="border:1px solid #000;padding:5px;">{{PrintGrandTotalWords}}</td>
                </tr>
            </tfoot>
        </table>

        <div style="margin-top:16px;">
            <p style="margin:0;font-weight:bold;">Terms &amp; Conditions:</p>
            <ul style="list-style-type:none;padding-left:10px;margin-top:4px;">
                <li ng-repeat="row in PrintTerms" ng-cloak style="margin:2px 0;">*&nbsp;&nbsp;{{row.TermsName}}</li>
            </ul>
        </div>

        <div style="margin-top:60px;display:flex;justify-content:space-between;">
            <div style="text-align:center;width:30%;">
                <div style="height:50px;">
                    <img ng-if="Quotation.ClntQutnPrepBySignature" ng-src="{{toSignatureSrc(Quotation.ClntQutnPrepBySignature)}}"
                         style="max-height:50px;max-width:100%;" />
                </div>
                <p style="margin:16px 0 0 0;">Quotation Prepared by</p>
                <p style="margin:4px 0 0 0;font-weight:bold;">{{Quotation.ClntQutnPrepBy}}</p>
                <p style="margin:2px 0;font-size:11px;" ng-show="Quotation.ClntQutnPrepDesignation">{{Quotation.ClntQutnPrepDesignation}}</p>
            </div>
            <!-- Recommended-by / Approved-by signature blocks are intentionally not printed (as in the original) -->
        </div>

        <div style="margin-top:30px;">
            <p style="font-style:italic;font-weight:bold;">**This is a system generated document.**</p>
        </div>
    </div><!-- /masterRow -->

</div>

<script src="@Url.Content("~/Scripts/qutnCommon.js")?v=1"></script>
<script type="text/javascript">

    /* ── Number → words (Lakh / Crore system), Taka + Paisa ──────────── */
    function numberToWordsCore(num) {
        num = Math.round(num) || 0;
        if (num === 0) return 'Zero';

        var belowTwenty = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
            'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen',
            'Eighteen', 'Nineteen'];
        var tensWords = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

        function twoDigits(n) {
            if (n < 20) return belowTwenty[n];
            return tensWords[Math.floor(n / 10)] + (n % 10 ? '-' + belowTwenty[n % 10] : '');
        }
        function threeDigits(n) {
            var h = Math.floor(n / 100), r = n % 100, s = '';
            if (h) s += belowTwenty[h] + ' Hundred';
            if (r) s += (s ? ' ' : '') + twoDigits(r);
            return s;
        }

        var crore = Math.floor(num / 10000000); num %= 10000000;
        var lakh = Math.floor(num / 100000); num %= 100000;
        var thousand = Math.floor(num / 1000); num %= 1000;

        var parts = [];
        if (crore) parts.push(threeDigits(crore) + ' Crore');
        if (lakh) parts.push(threeDigits(lakh) + ' Lakh');
        if (thousand) parts.push(threeDigits(thousand) + ' Thousand');
        if (num) parts.push(threeDigits(num));
        return parts.join(' ');
    }

    function numberToWordsTakaPaisa(amount) {
        amount = parseFloat(amount) || 0;
        var taka = Math.floor(amount);
        var paisa = Math.round((amount - taka) * 100);
        var takaWords = numberToWordsCore(taka) + ' Taka';
        return paisa > 0 ? takaWords + ' And ' + numberToWordsCore(paisa) + ' Paisa Only' : takaWords + ' Only';
    }

    function toSignatureSrc(raw) {
        if (!raw) return '';
        if (raw.indexOf('data:image') === 0) return raw;
        return 'data:image/png;base64,' + raw;
    }

    app.controller('QuotationApproveCntrl', function ($scope, $http) {
        attachQutnCommon($scope, $http);

        $scope.toSignatureSrc = toSignatureSrc;

        $scope.PrintHeader = {};
        $scope.PrintItems = [];
        $scope.PrintTerms = [];
        $scope.PrintGrandTotal = 0;
        $scope.PrintGrandTotalWords = '';

        $scope.PagingInfo = { page: 1, itemsPerPage: 10, sortBy: null, reverse: false, search: null, totalItems: 0 };

        $scope.Client = {
            ClientName: "", ClientRequisitionNo: "", ClientReqID: "", ClientRequisitionDate: "",
            ContactPerson: "", ContactNumber: "", ContactTIN: "", ContactBIN: "", ContactAddress: ""
        };
        $scope.MasterData = { ClientID: "", ClientReqID: "", ClientQuotationID: "", ClientQutnRecmID: "", Operation: "", ClientQutnAprvID: "" };
        $scope.Quotation = { QuotationNo: "" };
        $scope.pagefunction = '';
        $scope.showTermsItem = false;

        // ── Approved list ─────────────────────────────────────────────
        function loadList() {
            return $http.post('/QuotationApproval/AllClientQuotationforApprvData', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack", action: 'AvailableSearch'
            }).success(function (r) {
                $scope.AllQuotationsList = r.AllAvailableClientsList;
                $scope.AllQuotationsCollection = [].concat($scope.AllQuotationsList);
                $scope.PagingInfo.totalItems = r.TotalItems || 0;
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        }

        $scope.SearchAvailableClients = function () {
            $scope.PagingInfo.page = 1;
            $scope.ClearEverything();
            loadList();
            $('#QuotationForRecom').modal('show');
        };
        $scope.selectPageList = function () { loadList(); };

        // ── Select an approved quotation ──────────────────────────────
        $scope.selectQuotationForRecom = function (row) {
            // names / designations / signatures for the print slip
            $scope.Quotation.ClntQutnPrepBy = row.ClntQutnPrepBy;
            $scope.Quotation.ClntQutnRecmBy = row.ClntQutnRecmBy;
            $scope.Quotation.ClntQutnAprvBy = row.ClntQutnAprvBy;
            $scope.Quotation.ClntQutnPrepDesignation = row.ClntQutnPrepDesignation;
            $scope.Quotation.ClntQutnRecmDesignation = row.ClntQutnRecmDesignation;
            $scope.Quotation.ClntQutnAprvDesignation = row.ClntQutnAprvDesignation;
            $scope.Quotation.ClntQutnPrepBySignature = row.ClntQutnPrepBySignature;
            $scope.Quotation.ClntQutnRecmBySignature = row.ClntQutnRecmBySignature;
            $scope.Quotation.ClntQutnAprvBySignature = row.ClntQutnAprvBySignature;

            $scope.pagefunction = 'savemode';
            $('#QuotationForRecom').modal('hide');
            $scope.loading = true;

            $http.post('/QuotationToClient/AvailableClientAprvInfo', {
                ClientID: row.ClientID, ClientReqID: row.ClientReqID
            }).success(function (response) {
                var d = response.ClientDetails[0];
                $scope.ClientDetails = [d];
                $scope.Client = {
                    ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo, ClientReqID: d.ClientReqID,
                    ClientRequisitionDate: d.RequisitionDate, ContactPerson: d.ContactPerson, ContactNumber: d.ContactNumber,
                    ContactTIN: d.ClientTinNo, ContactBIN: d.ClientBinNo, ContactAddress: d.Address,
                    DocumentID: d.DocumentID
                };
                $scope.MasterData = {
                    ClientReqID: d.ClientReqID,
                    QuotationRecNote: d.RecmRemarks,
                    QuotationAprvNote: d.AprvRemarks,
                    ClientQutnAprvID: d.ClientQutnAprvID
                };
                $scope.GetClientReqDataInfo(d.ClientID, d.ClientReqID);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        $scope.GetClientReqDataInfo = function (ClientID, ClientReqID) {
            $http.post('/QuotationApproval/GetClientReqDataInfoAprv', { ClientID: ClientID, ClientReqID: ClientReqID })
                .success(function (response) {
                    $scope.GetClientReqDetails = response.GetClientReqDetails;
                    $scope.GetClientReqDetailsCollection = [].concat($scope.GetClientReqDetails);
                    $scope.loading = false;
                    if ($scope.GetClientReqDetailsCollection.length) {
                        $scope.GetTermsItemList($scope.GetClientReqDetailsCollection[0].ClientQutnRecmID);
                    }
                }).error(function () { $scope.loading = false; });
        };

        $scope.GetTermsItemList = function (RecmID) {
            $http.post('/QuotationApproval/GetVendorTermList', { ClientQutnRecmID: RecmID })
                .success(function (response) {
                    $scope.TermsConditionsList = response.VendorTermTermList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { });
        };

        // ── Row display values ────────────────────────────────────────
        $scope.initializeDefaults = function (row) {
            row.givenQutnPrice = row.QutnPrice || 0;
            row.GivenVatPerc = row.VatPerc;
            $scope.calculateRowFields(row);
        };

        $scope.calculateRowFields = function (row) {
            row.givenQutnPrice = parseFloat(row.givenQutnPrice) || 0;
            row.givenQutnAmt = row.givenQutnPrice * row.QutnQnty;
            row.TotGivenASFAmt = row.givenQutnAmt * (row.ASFPerc / 100);
            row.TotGivenVatAmt = (row.givenQutnAmt + row.TotGivenASFAmt) * (row.GivenVatPerc / 100);
            row.givenTolAmt = row.givenQutnAmt + row.TotGivenASFAmt + row.TotGivenVatAmt;
            $scope.showTermsItem = true;          // reveals the terms / Preview section
        };

        // ── Preview = register the loaded approval ID, then print ─────
        $scope.openConfirmModal = function () { $scope.SaveQuotToClient(); };

        $scope.SaveQuotToClient = function () {
            $http.post('/QuotationApproval/SaveQuotToClientReport', {
                MasterData: [$scope.MasterData],
                DetailData: [],
                AllTermsDtl: $scope.TermsConditionsDisplayedCollection
            }).success(function (response) {
                if (response.status === "202" || response.status === "Successfully Submitted" || response.status === "Operation Done") {
                    toastr.success('Previewed Successfully');
                    if (response.ClientQutnAprvID) $scope.MasterData.ClientQutnAprvID = response.ClientQutnAprvID;
                    $scope.printQuotation();
                } else {
                    toastr.error('Something went wrong');
                }
                $scope.loading = false;
            }).error(function () {
                $scope.loading = false;
                toastr.error('Data Loading Failed.');
            });
        };

        // ── Print: fetch header / items / terms, render, print ────────
        $scope.printQuotation = function () {
            if (!$scope.MasterData.ClientQutnAprvID) { toastr.error("No quotation loaded to print."); return; }
            $scope.loading = true;

            $http.post('/QuotationApproval/GetClientQuotationApprovedPrintData', {
                ClientQutnAprvID: $scope.MasterData.ClientQutnAprvID
            }).success(function (response) {
                $scope.PrintHeader = response.Header || {};
                $scope.PrintItems = response.Items || [];
                $scope.PrintTerms = response.Terms || [];

                var grandTotal = 0;
                $scope.PrintItems.forEach(function (row) { grandTotal += parseFloat(row.TolAmt || 0); });
                $scope.PrintGrandTotal = grandTotal;
                $scope.PrintGrandTotalWords = numberToWordsTakaPaisa(grandTotal);

                setTimeout(function () {
                    document.getElementById('masterRow').style.display = 'block';
                    $scope.printData();
                    setTimeout(function () {
                        document.getElementById('masterRow').style.display = 'none';
                        $scope.loading = false;
                    }, 800);
                }, 200);
            }).error(function () {
                $scope.loading = false;
                toastr.error("Failed to load print data.");
            });
        };

        $scope.printData = function () {
            var slip = document.getElementById("masterRow");
            if (!slip) return;

            var iframe = document.createElement('iframe');
            iframe.style.position = 'absolute';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = 'none';
            document.body.appendChild(iframe);

            var doc = iframe.contentWindow.document;
            doc.open();
            doc.write('<html><head><title>Client Quotation - ' + ($scope.PrintHeader.QuotationNo || '') + '</title>');
            doc.write(`
                <style>
                    /* zero page margin hides the browser's default print header / footer */
                    @@page { size: auto; margin: 0; }
                    html, body { margin: 0; padding: 0; }
                    body { font-family: Arial, sans-serif; padding: 20px; box-sizing: border-box; font-size: 12px; }
                    table { width: 100%; border-collapse: collapse; }
                    td, th { padding: 5px; text-align: left; }
                    p { margin: 0; }
                </style>
            `);
            doc.write('</head><body>');
            doc.write(slip.outerHTML);
            doc.write('</body></html>');
            doc.close();

            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(function () { document.body.removeChild(iframe); }, 1000);
        };

        // ── Clear everything ──────────────────────────────────────────
        $scope.ClearEverything = function () {
            $scope.showTermsItem = false;
            $scope.pagefunction = '';
            $scope.clientReqTermArray = [];
            $scope.ClientReq = { TermsID: "", FormName: "" };
            $scope.resetClientReqTerm();
            $scope.Client = {
                ClientName: "", ClientRequisitionNo: "", ClientReqID: "", ClientRequisitionDate: "",
                ContactPerson: "", ContactNumber: "", ContactTIN: "", ContactBIN: "", ContactAddress: ""
            };
            $scope.MasterData = { ClientID: "", ClientReqID: "", QuotationRecNote: "", QuotationAprvNote: "", ClientQutnAprvID: "" };
            $scope.ClientDetails = [];
            $scope.GetClientReqDetails = [];
            $scope.GetClientReqDetailsCollection = [];
            $scope.TermsConditionsList = [];
            $scope.TermsConditionsDisplayedCollection = [];
            $scope.ActionLog = [];
        };
    });
</script>
