        /* ── Quotation Print: fetch header/items/terms then render + print ── */
        $scope.printQuotation = function () {
            if (!$scope.MasterData.ClientQutnAprvID) {
                toastr.error("No quotation loaded to print.");
                return;
            }

            $scope.loading = true;

            $http.post('/QuotationApproval/GetClientQuotationApprovedPrintData', {
                ClientQutnAprvID: $scope.MasterData.ClientQutnAprvID
            }).success(function (response) {

                $scope.PrintHeader = response.Header || {};
                $scope.PrintItems = response.Items || [];
                $scope.PrintTerms = response.Terms || [];

                var grandTotal = 0;
                $scope.PrintItems.forEach(function (row) {
                    grandTotal += parseFloat(row.TolAmt || 0);
                });
                $scope.PrintGrandTotal = grandTotal;
                $scope.PrintGrandTotalWords = numberToWordsTakaPaisa(grandTotal);

                setTimeout(function () {
                    document.getElementById('masterRow').style.display = 'block';
                    $scope.printData();

                    setTimeout(function () {
                        document.getElementById('masterRow').style.display = 'none';
                        $scope.loading = false;
                    }, 800);
                }, 200);

            }).error(function () {
                $scope.loading = false;
                toastr.error("Failed to load print data.");
            });
        };

        //print document

        $scope.printData = function () {
            var VendorSlip = document.getElementById("masterRow");
            if (!VendorSlip) return;

            // Create an iframe dynamically
            var iframe = document.createElement('iframe');
            iframe.style.position = 'absolute';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = 'none';
            document.body.appendChild(iframe);

            // Write the content to the iframe document
            var doc = iframe.contentWindow.document;
            doc.open();
            doc.write('<html><head><title>Client Quotation - ' + ($scope.PrintHeader.QuotationNo || '') + '</title>');

            // Add custom styles for printing
            doc.write(`
                <style>
                    /* Removing the page margin removes the space Chrome/Edge use
                       to draw the default print header (date/title) and
                       footer (url/page number) — this hides them without
                       touching the browser's print-dialog checkbox. */
                    @@page {
                        size: auto;
                        margin: 0;
                    }
                    html, body {
                        margin: 0;
                        padding: 0;
                    }
                    body {
                        font-family: Arial, sans-serif;
                        padding: 20px;
                        box-sizing: border-box;
                        font-size: 12px;
                    }
                    table { width: 100%; border-collapse: collapse; }
                    td, th { padding: 5px; text-align: left; }
                    p { margin: 0; }
                </style>
            `);

            doc.write('</head><body>');
            doc.write(VendorSlip.outerHTML);
            doc.write('</body></html>');
            doc.close();

            // Trigger print on the iframe content
            iframe.contentWindow.focus();
            iframe.contentWindow.print();

            // Remove the iframe from the DOM after printing
            setTimeout(function () { document.body.removeChild(iframe); }, 1000);
        }



        $scope.ViewDocument = function () {
            $scope.loading = true; // Show loading indicator

            // FTP details
            var ftpDetails = {

                serverUrl: "MCL/Client_Requisition",
                documentID: "CR_" + $scope.ClientDetails[0].ClientReqID,
                ext: "pdf"
            };

            // Construct URL with query parameters
            var requestUrl = "/ClientRequisition/ViewDocument?" +
                "&serverUrl=" + encodeURIComponent(ftpDetails.serverUrl) +
                "&DocID=" + encodeURIComponent(ftpDetails.documentID) +
                "&ext=" + encodeURIComponent(ftpDetails.ext);

            // Make GET request to fetch the PDF
            $http.get(requestUrl, { responseType: 'arraybuffer' })
                .then(function (response) {
                    var file = new Blob([response.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(file);
                    let zoomParam = "#view=Fit";

                    $("#pdfViewer").attr("src", fileURL + zoomParam);
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (error) {
                    toastr.error("Failed to load the PDF.");
                    console.error(error);
                })
                .finally(function () {
                    $scope.loading = false; // Hide the loading indicator
                });
        };

