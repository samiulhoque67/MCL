        $scope.checkUnitPrice = function (row) {

            // Validation
            if (!row.NegoQty || row.NegoQty <= 0) {
                toastr.error("Quantity cannot be zero or negative!");
                row.NegoQty = 1;
            }

            if (!row.NegoPrice || row.NegoPrice <= 0) {
                toastr.error("Price cannot be zero or negative!");
                row.NegoPrice = 1;
            }

            row.NegoAmt = parseFloat(row.NegoQty) * parseFloat(row.NegoPrice);
            $scope.checkVatPerc(row);

            var matchingVendor = $scope.selectedVendors.find(v =>
                v.VendorID == row.VendorID && v.ServiceItemID == row.ServiceItemID
            );

            if (matchingVendor) {
                matchingVendor.NegoQty = row.NegoQty;
                matchingVendor.NegoPrice = row.NegoPrice;
                matchingVendor.NegoAmt = row.NegoAmt;
                matchingVendor.NegoVatAmt = row.NegoVatAmt;
                matchingVendor.NegoTolAmt = row.NegoTolAmt;
            }
        };


        $scope.checkVatPerc = function (row) {
            var VatAmt = 0;
            VatAmt = (row.VatPerc * row.NegoAmt) / 100;
            row.NegoVatAmt = VatAmt;

            row.NegoTolAmt = row.NegoAmt + row.NegoVatAmt;
        };

