    $('#CSRecDate1').datepicker().on('changeDate', function (ev) {
        var EnteredDate = $('#CSRecDate1').val(); // For JQuery
        var date = EnteredDate.substring(0, 2);
        var month = EnteredDate.substring(3, 5);
        var year = EnteredDate.substring(6, 10);
        var myDate = new Date(year, month - 1, date);

        var today = new Date();
        if (myDate > today) {
            $('#CSRecDate1').val('');
            toastr.error("Date should not grater than system date.");
        }
        ////////////
        if ($('#CSRecDate').val() != '') {
            var EnteredToDate = $('#CSRecDate').val(); // For JQuery
            var date = EnteredToDate.substring(0, 2);
            var month = EnteredToDate.substring(3, 5);
            var year = EnteredToDate.substring(6, 10);
            var myToDate = new Date(year, month - 1, date);
            var today1 = new Date();
            if (myToDate > today1) {
                $('#CSRecDate').val('');
                toastr.error("Date should not grater than system date.");
            }
        }
        ///////

        $('.datepicker').hide();
    });

