<script type="text/javascript">

    /* ── Date picker setup ──────────────────────────────────────── */
    $('.DatePicker').datepicker({ format: "dd/mm/yyyy", autoclose: true });

    $('#CSRecDate1').datepicker().on('changeDate', function (ev) {
        var val = $('#CSRecDate1').val();
        var parts = val.split('/');
        var entered = new Date(parts[2], parts[1] - 1, parts[0]);
        if (entered > new Date()) {
            $('#CSRecDate1').val('');
            toastr.error("Date should not be greater than system date.");
        }
        $('.datepicker').hide();
    });

    $(document).ready(function () {
        var t = new Date();
        var f = String(t.getDate()).padStart(2, '0') + '/' +
            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
        $('#CSRecDate1').val(f);
    });

    /* ══════════════════════════════════════════════════════════════
       Angular Controller
       ══════════════════════════════════════════════════════════════ */
    app.controller('VendorCSInfoCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        /* ── Small helpers ───────────────────────────────────────── */
        var EPS = 0.0005;   // tolerance for 3-decimal quantity comparisons

        function num(v) {
            var n = parseFloat(v);
            return isNaN(n) ? 0 : n;
        }
        function fmt(n) {
            return (Math.round(n * 1000) / 1000).toString();
        }
        function emptyCS() {
            return {
                VendorCSRecmID: "", AutoCSNo: "", CSRecDate: "", Operation: "", Remarks: "",
                VendorCsRecmName: "", CSRecmVendorID: "",
                ServiceItemID: "", ServiceItemName: "", ServiceCategoryID: "",
                ClientReqID: "", ClientID: "", ClientName: "",
                VendorReqID: "", ClientReqNo: "",
                Description: "", DeliveryLocation: "", DeliveryDate: "", DeliveryMode: "",
                RptQutnQty: "", RptQutnUnit: "", VenReqItem: "", RequisitionDate: "",
                ReqQnty: "", ReqUnit: "",
                AwardMode: "REC"      // 'REC' = recommend one vendor, 'DIST' = distribute work among selected vendors
            };
        }
        function computeRow(row) {
            row.NegoAmt = num(row.NegoQty) * num(row.NegoPrice);
            row.NegoVatAmt = (num(row.VatPerc) * row.NegoAmt) / 100;
            row.NegoTolAmt = row.NegoAmt + row.NegoVatAmt;
        }

        /* ── State ───────────────────────────────────────────────── */
        $scope.vendorCSItemArray = [];
        $scope.vendorCSTermArray = [];
        $scope.itemsByPage = 10;
        $scope.p = 2;          // 2 = new/select mode, 1 = view/edit mode
        $scope.pageMode = 'new';      // 'new' | 'view' | 'edit'
        $scope.loading = false;
        $scope.saveWarnings = [];

        $scope.masterDataSetupGridData = [];
        $scope.GridDisplayCollection = [];
        $scope.isRowSelected = false;
        $scope.isMaterialRowSelected = false;
        $scope.selectedVendors = [];      // rows ticked by the user (shared references with the tables)
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];
        $scope.VendorCSList = [];
        $scope.VendorCSListCollection = [];
        $scope.MatWiseVendorList = [];
        $scope.MatWiseVendorListCollection = [];

        $scope.VendorCSInfo = emptyCS();

        /* ── Initial load ────────────────────────────────────────── */
        $scope.loading = true;
        $http.post('/VendorCSInfo/GetAllRequisition')
            .success(function (r) {
                $scope.GridDisplayCollection = [].concat(r.InvitationList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });

        /* ══════════════════════════════════════════════════════════
           QUOTATION STATUS  (ProcessStatus from GetVendorByMaterial)
           ══════════════════════════════════════════════════════════ */

        // A vendor row is "quoted" only when ProcessStatus === 'Done'.
        // Change this single function if your status values differ.
        $scope.isQuoted = function (row) {
            if (!row) return false;

            // View/Edit rows come from the CSVendor SP. Rows already saved in the CS stay valid,
            // and if that SP does not return ProcessStatus at all we do not block anything.
            if ($scope.pageMode !== 'new') {
                if (row.IsSelected == 1) return true;
                if (row.ProcessStatus === undefined) return true;
            }
            // Requisitioned vendors that have not quoted come back with a NULL quotation
            if ($scope.pageMode === 'new' && (row.VendorQutnID === null || row.VendorQutnID === undefined || row.VendorQutnID === '')) return false;

            var s = (row.ProcessStatus === null || row.ProcessStatus === undefined) ? '' : String(row.ProcessStatus);
            return s.trim().toLowerCase() === 'done';
        };

        $scope.currentVendorRows = function () {
            if ($scope.pageMode === 'new') {
                return $scope.isMaterialRowSelected ? ($scope.MatWiseVendorList || []) : [];
            }
            return $scope.VendorCSList || [];
        };
        $scope.notQuotedCount = function () {
            return $scope.currentVendorRows().filter(function (r) { return !$scope.isQuoted(r); }).length;
        };
        $scope.allNotQuoted = function () {
            var rows = $scope.currentVendorRows();
            return rows.length > 0 && $scope.notQuotedCount() === rows.length;
        };
        $scope.someNotQuoted = function () {
            return $scope.notQuotedCount() > 0 && !$scope.allNotQuoted();
        };
        // Save / Update is blocked in view mode and when the item has no quoted vendor at all
        $scope.saveBlocked = function () {
            if ($scope.wfIsWorkflowOp()) { return $scope.pageMode === 'view' || !$scope.wfCanSave(); }
            return $scope.pageMode === 'view' || $scope.notQuotedCount() > 0 || $scope.wfIsPostponed();
        };

        /* ══════════════════════════════════════════════════════════
           QUANTITY SUMMARY
           ══════════════════════════════════════════════════════════ */
        $scope.getReqQty = function () { return num($scope.VendorCSInfo.ReqQnty); };
        $scope.totalNegoQty = function () {
            return $scope.selectedVendors.reduce(function (s, v) { return s + num(v.NegoQty); }, 0);
        };
        // The recommended vendor's row (Award Type = recommend one)
        $scope.recmRow = function () {
            var id = $scope.VendorCSInfo.CSRecmVendorID;
            if (id === "" || id === null || id === undefined) return undefined;
            return $scope.selectedVendors.filter(function (v) { return String(v.VendorID) === String(id); })[0];
        };
        // recommend one  -> compare the recommended vendor's Nego Qty with Required Qty
        // distribute     -> compare the cumulative Nego Qty of all ticked vendors with Required Qty
        $scope.hasAllocation = function () {
            return $scope.VendorCSInfo.AwardMode === 'DIST' || !!$scope.recmRow();
        };
        $scope.allocatedQty = function () {
            if ($scope.VendorCSInfo.AwardMode === 'DIST') return $scope.totalNegoQty();
            var r = $scope.recmRow();
            return r ? num(r.NegoQty) : 0;
        };
        $scope.qtyLabel = function () {
            return $scope.VendorCSInfo.AwardMode === 'DIST' ? 'Cumulative Qty' : 'Recommended Vendor Qty';
        };
        $scope.qtyApplicable = function () {
            return $scope.getReqQty() > 0 && $scope.hasAllocation();
        };
        $scope.qtyDiff = function () { return $scope.allocatedQty() - $scope.getReqQty(); };
        $scope.qtyStatusClass = function () {
            if (!$scope.qtyApplicable()) return 'qty-neutral';
            var d = $scope.qtyDiff();
            if (d > EPS) return 'qty-over';
            if (Math.abs(d) <= EPS) return 'qty-ok';
            return 'qty-under';
        };

        /* ── Helper: reset everything to new-CS state ────────────── */
        $scope.startNewCS = function () {
            $scope.p = 2;
            $scope.pageMode = 'new';
            $scope.isRowSelected = false;
            $scope.isMaterialRowSelected = false;
            $scope.selectedVendors = [];
            $scope.selectedRow = null;
            $scope.selectedMaterialRow = null;
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.VendorCSList = [];
            $scope.VendorCSListCollection = [];
            $scope.MatWiseVendorList = [];
            $scope.MatWiseVendorListCollection = [];
            $scope.VendorCSInfo = emptyCS();
            // Reload requisition list
            $http.post('/VendorCSInfo/GetAllRequisition')
                .success(function (r) { $scope.GridDisplayCollection = [].concat(r.InvitationList); });
        };

        $scope.switchToEdit = function () {
            $scope.pageMode = 'edit';
        };

        /* ── Requisition selection (new mode) ───────────────────── */
        $scope.selectedRow = null;
        $scope.selectInvitation = function (row) {
            if ($scope.selectedRow === row) {
                row.selected = false;
                $scope.selectedRow = null;
                $scope.isRowSelected = false;
                $scope.isMaterialRowSelected = false;
            } else {
                if ($scope.selectedRow) $scope.selectedRow.selected = false;
                row.selected = true;
                $scope.selectedRow = row;
                $scope.isRowSelected = true;
                $scope.isMaterialRowSelected = false;

                $scope.VendorCSInfo.VendorReqID = row.VendorRequisitionNumber;
                $scope.VendorCSInfo.ClientReqNo = row.ClientRequisitionNumber;
                $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
                $scope.VendorCSInfo.ClientID = row.ClientID;
                $scope.VendorCSInfo.ClientName = row.ClientName;
                $scope.VendorCSInfo.RequisitionDate = row.RequisitionDate;
                $scope.VendorCSInfo.VenReqItem = row.Remarks;

                $scope.loading = true;
                $http.post('/VendorCSInfo/GetMaterialByRequisition', { VendorRequisitionNumber: row.VendorRequisitionNumber })
                    .success(function (r) {
                        $scope.ReqWiseMaterialList = r.ReqWiseMaterialList;
                        $scope.ReqWiseMaterialListCollection = [].concat($scope.ReqWiseMaterialList);
                        $scope.loading = false;
                    }).error(function () { $scope.loading = false; });
            }
        };

        /* ── Material/Item selection ─────────────────────────────── */
        $scope.selectedMaterialRow = null;
        $scope.selectMaterial = function (row) {
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.VendorCSInfo.VendorCsRecmName = "";
            $scope.VendorCSInfo.CSRecmVendorID = "";
            $scope.VendorCSInfo.Operation = "";
            $scope.VendorCSInfo.Remarks = "";
            $scope.selectedVendors = [];

            if ($scope.selectedMaterialRow === row) {
                row.selected = false;
                $scope.selectedMaterialRow = null;
                $scope.isMaterialRowSelected = false;
            } else {
                if ($scope.selectedMaterialRow) $scope.selectedMaterialRow.selected = false;
                row.selected = true;
                $scope.selectedMaterialRow = row;
                $scope.isMaterialRowSelected = true;

                $scope.VendorCSInfo.ServiceItemID = row.ServiceItemID;
                $scope.VendorCSInfo.ServiceItemName = row.ServiceItemName;
                $scope.VendorCSInfo.ServiceCategoryID = row.ServiceCategoryID;
                $scope.VendorCSInfo.Description = row.Description;
                $scope.VendorCSInfo.DeliveryDate = row.DeliveryDate;
                $scope.VendorCSInfo.DeliveryLocation = row.DeliveryLocation;
                $scope.VendorCSInfo.DeliveryMode = row.DeliveryMode;
                $scope.VendorCSInfo.ReqQnty = row.ReqQnty;
                $scope.VendorCSInfo.ReqUnit = row.ReqUnit;

                $scope.MatWiseVendorList = [];
                $scope.MatWiseVendorListCollection = [];

                $scope.loading = true;
                $http.post('/VendorCSInfo/GetVendorByMaterial', { VendorReqID: row.VendorReqID, ServiceItemID: row.ServiceItemID })
                    .success(function (r) {
                        $scope.MatWiseVendorList = r.MatWiseVendorList || [];
                        $scope.MatWiseVendorListCollection = [].concat($scope.MatWiseVendorList);
                        $scope.loading = false;

                        // Tell the user straight away when nothing can be saved for this item
                        if ($scope.notQuotedCount() > 0) {
                            toastr.warning($scope.notQuotedCount() + " of " + $scope.currentVendorRows().length + " requisitioned vendor(s) have not quoted yet. All vendors must be quoted before this CS can be saved.");
                        }
                    }).error(function () { $scope.loading = false; });
            }
        };

        /* ── Terms helpers ───────────────────────────────────────── */
        function removeTermsFor(id) {
            $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) { return t.VendorQutnID !== id; });
            $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
        }
        function loadTermsFor(id) {
            $http.post('/VendorCSInfo/GetVendorCSInfoTermList', { VendorQutnID: id })
                .success(function (r) {
                    var stillSelected = $scope.selectedVendors.some(function (v) { return v.VendorQutnID === id; });
                    if (!stillSelected) return;
                    $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) { return t.VendorQutnID !== id; });
                    $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.concat(r.VendorCSInfoTermList || []);
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                });
        }

        /* ── Vendor selection (new AND edit mode) ────────────────────
           Several vendors can be ticked; there is no single "recommended" vendor.
           selectedVendors holds the row objects themselves, so typing a Nego Qty
           updates the cumulative total live.                                  */
        $scope.selectVendor = function (row) {
            if (!$scope.isQuoted(row)) {
                toastr.warning("This vendor quotation is not quoted yet (ProcessStatus is not Done) and cannot be selected.");
                return;
            }

            var id = row.VendorQutnID;
            var idx = $scope.selectedVendors.findIndex(function (v) { return v.VendorQutnID === id; });

            if (idx !== -1) {
                // un-tick
                row.selected = false;
                $scope.selectedVendors.splice(idx, 1);
                removeTermsFor(id);
                // un-ticking the recommended vendor clears the recommendation
                if (String($scope.VendorCSInfo.CSRecmVendorID) === String(row.VendorID)) {
                    $scope.VendorCSInfo.CSRecmVendorID = "";
                    $scope.VendorCSInfo.VendorCsRecmName = "";
                }
                return;
            }

            // tick
            row.selected = true;
            $scope.selectedVendors.push(row);
            loadTermsFor(id);

            if ($scope.qtyApplicable() && $scope.qtyDiff() > EPS) {
                toastr.warning($scope.qtyLabel() + " (" + fmt($scope.allocatedQty()) + ") is now greater than the Required Qty (" + fmt($scope.getReqQty()) + ").");
            }
        };

        /* ── CS Recm Vendor popup (Award Type = recommend one) ───── */
        $scope.ShowVendorList = function () {
            if ($scope.selectedVendors.length <= 0) {
                toastr.error("Please tick at least one vendor first.");
                return;
            }
            $('#VendorInfoModal').modal('show');
        };

        $scope.selectCSRecVendor = function (row) {
            $scope.VendorCSInfo.CSRecmVendorID = row.VendorID;
            $scope.VendorCSInfo.VendorCsRecmName = row.VendorName;
            $scope.VendorCSInfo.RptQutnQty = row.QutnQnty;
            $scope.VendorCSInfo.RptQutnUnit = row.ReqUnit || row.QutnUnit;
            if ($scope.qtyApplicable() && $scope.qtyDiff() > EPS) {
                toastr.warning("Recommended vendor's Nego Qty (" + fmt($scope.allocatedQty()) + ") is greater than the Required Qty (" + fmt($scope.getReqQty()) + ").");
            }
        };

        $scope.onAwardModeChange = function () {
            if ($scope.VendorCSInfo.AwardMode === 'DIST') {
                $scope.VendorCSInfo.CSRecmVendorID = "";
                $scope.VendorCSInfo.VendorCsRecmName = "";
            }
        };

        /* ── Search CS (opens modal) ─────────────────────────────── */
        $scope.SearchCS = function () {
            $scope.loading = true;
            $http.post('/VendorCSInfo/SearchCS')
                .success(function (r) {
                    $scope.SearchCSList = r.SearchCSList;
                    $scope.SearchCSListCollection = [].concat($scope.SearchCSList);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#SearchModal').modal('show');
        };

        /* ── Load existing CS for view OR edit ───────────────────── */
        $scope.loadExistingCS = function (row, mode) {
            $('#SearchModal').modal('hide');
            $scope.loading = true;
            $scope.pageMode = mode;   // 'view' or 'edit'
            $scope.p = 1;
            $scope.selectedVendors = [];
            $scope.VendorCSList = [];
            $scope.VendorCSListCollection = [];

            // Populate header
            $scope.VendorCSInfo.VendorCSRecmID = row.VendorCSNumber;
            $scope.VendorCSInfo.AutoCSNo = row.VendorCSNumber;
            $scope.VendorCSInfo.CSRecDate = row.CSRecDate;
            $scope.VendorCSInfo.ServiceItemID = row.ServiceItemID;
            $scope.VendorCSInfo.ServiceItemName = row.ServiceItemName;
            // A saved CS with a recommended vendor = "recommend one"; without = "distribute"
            $scope.VendorCSInfo.CSRecmVendorID = row.CSRecmVendorID || "";
            $scope.VendorCSInfo.VendorCsRecmName = row.CSRecmVendorID ? (row.VendorCSRecmName || "") : "";
            $scope.VendorCSInfo.AwardMode = row.AwardMode || (row.CSRecmVendorID ? 'REC' : 'DIST');
            $scope.VendorCSInfo.Operation = row.Operation;
            $scope.VendorCSInfo.Remarks = row.Remarks;
            $scope.CSMaterial_Name = row.ServiceItemName;
            $scope.VendorCSInfo.ClientName = row.ClientName;

            // Load ALL vendors (selected + unselected)
            $http.post('/VendorCSInfo/CSVendor', { CSNumber: row.VendorCSNumber })
                .success(function (r) {
                    var list = r.VendorCSList || [];

                    // Pre-mark each row so the checkbox icon renders correctly
                    list.forEach(function (v) {
                        v.selected = (v.IsSelected === true || v.IsSelected === 1);
                    });

                    $scope.VendorCSList = list;
                    $scope.VendorCSListCollection = [].concat(list);

                    // Already-saved vendors are the starting selection (view AND edit,
                    // so switching View -> Edit keeps them)
                    $scope.selectedVendors = list.filter(function (v) { return v.selected; });

                    if (list.length > 0) {
                        $scope.VendorCSInfo.ServiceCategoryID = list[0].ServiceCategoryID;
                        $scope.VendorCSInfo.Description = list[0].Description;
                        $scope.VendorCSInfo.DeliveryDate = list[0].DeliveryDate;
                        $scope.VendorCSInfo.DeliveryLocation = list[0].DeliveryLocation;
                        $scope.VendorCSInfo.DeliveryMode = list[0].DeliveryMode;
                        $scope.VendorCSInfo.ReqUnit = list[0].ReqUnit || list[0].QutnUnit;

                        var withReq = list.filter(function (x) { return num(x.ReqQnty) > 0; })[0];
                        $scope.VendorCSInfo.ReqQnty = withReq ? withReq.ReqQnty : "";
                    }

                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            // Load terms
            $http.post('/VendorCSInfo/CSVendorTerms', { CSNumber: row.VendorCSNumber })
                .success(function (r) {
                    $scope.ReqTermDataSetupGridData = r.VendorCSInfoTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                }).error(function () { });
        };

        /* ── Keep old toggleCSSelect for backwards compat ───────── */
        $scope.toggleCSSelect = function (row) {
            $scope.loadExistingCS(row, 'view');
        };

        /* ── Nego calculations (new + edit) ──────────────────────── */
        $scope.checkUnitPrice = function (row) {
            if (!$scope.isQuoted(row)) return;

            var q = parseFloat(row.NegoQty);
            var p = parseFloat(row.NegoPrice);

            if (isNaN(q) || q <= 0) {
                toastr.error("Nego Qty must be a number greater than zero.");
                row.NegoQty = row.QutnQnty;
            }
            if (isNaN(p) || p <= 0) {
                toastr.error("Nego Price must be a number greater than zero.");
                row.NegoPrice = row.QutnPrice;
            }

            computeRow(row);

            // Early, non-blocking feedback (the final check runs again on save)
            if (row.selected && $scope.qtyApplicable() && $scope.qtyDiff() > EPS) {
                toastr.warning($scope.qtyLabel() + " (" + fmt($scope.allocatedQty()) + ") is greater than the Required Qty (" + fmt($scope.getReqQty()) + ").");
            }
        };

        /* ══════════════════════════════════════════════════════════
           VALIDATION
           errors   → block the save
           warnings → shown in a confirm dialog, user may continue
           ══════════════════════════════════════════════════════════ */
        function getCsDate() {
            return ($scope.pageMode === 'new')
                ? $('#CSRecDate1').val()
                : ($('#CSRecDate').val() || $scope.VendorCSInfo.CSRecDate);
        }

        $scope.validateCS = function () {
            var errors = [], warnings = [];
            var sel = $scope.selectedVendors;

            if ($scope.pageMode === 'new' && !$scope.VendorCSInfo.ServiceItemID) {
                errors.push("Please select a requisition item first.");
            }
            if ($scope.pageMode !== 'view' && $scope.notQuotedCount() > 0) {
                errors.push("All requisitioned vendors must be quoted before saving (" + $scope.notQuotedCount() + " of " + $scope.currentVendorRows().length + " not quoted yet).");
            }
            if (sel.length <= 0) {
                errors.push("Please select at least one vendor.");
            }

            var mode = $scope.VendorCSInfo.AwardMode;
            if (mode === 'REC') {
                if (!$scope.VendorCSInfo.CSRecmVendorID) {
                    errors.push("CS Recm. Vendor is required.");
                } else if (!$scope.recmRow()) {
                    errors.push("The recommended vendor must be one of the selected vendors.");
                }
            } else if (mode === 'DIST' && sel.length === 1) {
                warnings.push("Only one vendor is selected for distribution, so the whole work goes to that vendor.");
            }

            // Per-vendor checks
            var seenVendors = {};
            var units = {};
            sel.forEach(function (v) {
                var label = v.VendorName + " (" + v.VendorQutnNo + ")";
                var q = num(v.NegoQty), p = num(v.NegoPrice);

                if (q <= 0) errors.push(label + ": Nego Qty must be greater than zero.");
                if (p <= 0) errors.push(label + ": Nego Price must be greater than zero.");

                if (q > num(v.QutnQnty) + EPS) {
                    warnings.push(label + ": Nego Qty (" + fmt(q) + ") is more than the quoted qty (" + fmt(num(v.QutnQnty)) + ").");
                }
                if (p > num(v.QutnPrice) + EPS) {
                    warnings.push(label + ": Nego Price (" + fmt(p) + ") is higher than the quoted price (" + fmt(num(v.QutnPrice)) + ").");
                }
                if (v.VendorID !== undefined && seenVendors[v.VendorID]) {
                    warnings.push(v.VendorName + " is selected with more than one quotation.");
                }
                seenVendors[v.VendorID] = true;
                units[v.ReqUnit || v.QutnUnit || ''] = true;
            });

            if (mode === 'DIST' && Object.keys(units).length > 1) {
                warnings.push("Selected vendors use different units (" + Object.keys(units).join(", ") + "), so the cumulative qty may not be comparable.");
            }

            // Cumulative qty vs required qty (goes first in the list)
            var req = $scope.getReqQty();
            if (req > 0) {
                if (mode === 'DIST') {
                    var tot = $scope.totalNegoQty();
                    if (tot > req + EPS) {
                        warnings.unshift("Cumulative Nego Qty (" + fmt(tot) + ") is greater than the Required Qty (" + fmt(req) + ") by " + fmt(tot - req) + ".");
                    }
                } else if (mode === 'REC' && $scope.recmRow()) {
                    var rq = num($scope.recmRow().NegoQty);
                    if (rq > req + EPS) {
                        warnings.unshift("Recommended vendor's Nego Qty (" + fmt(rq) + ") is greater than the Required Qty (" + fmt(req) + ") by " + fmt(rq - req) + ".");
                    }
                }
            }

            // Header fields
            var csDate = getCsDate();
            if (!csDate) {
                errors.push("CS Date is required.");
            } else {
                var m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(String(csDate).trim());
                if (m) {
                    var d = new Date(m[3], m[2] - 1, m[1]);
                    if (d > new Date()) errors.push("CS Date cannot be greater than the system date.");
                } else if ($scope.pageMode === 'new') {
                    errors.push("CS Date must be in DD/MM/YYYY format.");
                }
            }
            if (!$scope.VendorCSInfo.Operation) errors.push("Please select an Operation.");

            return { errors: errors, warnings: warnings };
        };

        /* ── Save / Update ───────────────────────────────────────── */
        $scope.Post = function () {
            if ($scope.wfHandleOperation()) return;
            if (!$scope.wfPreSave()) return;
            if ($scope.btnSave) return;     // guard against double-click

            if ($scope.pageMode === 'view') return;

            if ($scope.notQuotedCount() > 0) {
                toastr.error("Cannot save: all requisitioned vendors must be quoted first. " + $scope.notQuotedCount() + " of " + $scope.currentVendorRows().length + " vendor(s) are not quoted yet.");
                return;
            }

            var v = $scope.validateCS();

            if (v.errors.length > 0) {
                v.errors.slice(0, 4).forEach(function (e) { toastr.error(e); });
                if (v.errors.length > 4) toastr.error("...and " + (v.errors.length - 4) + " more problem(s).");
                return;
            }

            if (v.warnings.length > 0) {
                $scope.saveWarnings = v.warnings;
                $('#QtyWarningModal').modal('show');
                return;
            }

            $scope.doSave();
        };

        $scope.doSave = function () {
            if ($scope.btnSave) return;
            $('#QtyWarningModal').modal('hide');

            // Re-check hard errors in case state changed while the dialog was open
            var v = $scope.validateCS();
            if (v.errors.length > 0) {
                v.errors.slice(0, 4).forEach(function (e) { toastr.error(e); });
                return;
            }

            $scope.VendorCSInfo.CSRecDate = getCsDate();

            if ($scope.VendorCSInfo.AwardMode === 'DIST') {
                // Work is distributed: no single recommended vendor
                $scope.VendorCSInfo.CSRecmVendorID = "";
                $scope.VendorCSInfo.VendorCsRecmName = "";
                $scope.VendorCSInfo.RptQutnQty = $scope.totalNegoQty();
                $scope.VendorCSInfo.RptQutnUnit = $scope.selectedVendors[0].ReqUnit || $scope.selectedVendors[0].QutnUnit || "";
            } else {
                // Recommend one: report qty/unit come from the recommended vendor
                var rr = $scope.recmRow();
                if (rr) {
                    $scope.VendorCSInfo.RptQutnQty = rr.QutnQnty;
                    $scope.VendorCSInfo.RptQutnUnit = rr.ReqUnit || rr.QutnUnit || "";
                }
            }

            var items = $scope.selectedVendors.map(function (r) {
                computeRow(r);
                var c = angular.copy(r);
                delete c.selected;
                return c;
            });

            $scope.btnSave = true;      // lock before the request goes out
            $scope.loading = true;

            $http.post('/VendorCSInfo/SaveVendorCSInfo', {
                vendorCS: $scope.VendorCSInfo,
                vendorCSItem: items,
                vendorCSTerm: $scope.ReqTermGridDisplayCollection
            })
                .success(function (r) {
                    $scope.loading = false;
                    $scope.btnSave = false;
                    if (r.status === 'S201') {
                        $scope.startNewCS();
                        toastr.success("Data Saved Successfully."); $scope.toggleRefreshTable();
                    }
                    else if (r.status === 'S202') { toastr.success("Data Updated Successfully."); $scope.toggleRefreshTable(); }
                    else { toastr.error("Save Failed. Status: " + r.status); }
                })
                .error(function () {
                    $scope.loading = false;
                    $scope.btnSave = false;   // unlock on error too, or user is stuck forever
                    toastr.error("Data Save Failed.");
                });
        };

        /* ── Row style ───────────────────────────────────────────── */
        $scope.getRowStyle = function (row) {
            return row.selected ? { background: '#8bf5d2' } : {};
        };

        /* ── View PDF ────────────────────────────────────────────── */
        function openQuotationPdf(row) {
            $scope.loading = true;
            var ftpDetails = {
                serverUrl: "MCL/Vendor_Requisition",
                documentID: "VR_" + row.VendorQutnID,
                ext: "pdf"
            };
            var url = "/VendorQuotation/ViewDocument?" +
                "&serverUrl=" + encodeURIComponent(ftpDetails.serverUrl) +
                "&DocID=" + encodeURIComponent(ftpDetails.documentID) +
                "&ext=" + encodeURIComponent(ftpDetails.ext);

            $http.get(url, { responseType: 'arraybuffer' })
                .then(function (r) {
                    var blob = new Blob([r.data], { type: 'application/pdf' });
                    $("#pdfViewer").attr("src", URL.createObjectURL(blob) + "#view=Fit");
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (e) { toastr.error("Failed to load the PDF."); console.error(e); })
                .finally(function () { $scope.loading = false; });
        }
        $scope.ViewDocument = openQuotationPdf;
        $scope.ViewDocumentFromList = openQuotationPdf;

        /* ── Refresh ─────────────────────────────────────────────── */
        /* ═══════════════════════════════════════════════════════════
   CS WORKFLOW : Back / Postpone / Resume (reason mandatory) + history
   Award Type (REC / DIST) is read from the CS and carried through every stage
   ═══════════════════════════════════════════════════════════ */
        var WF_STAGE = 'PREP';
        var WF_OBJ = 'VendorCSInfo';
        $scope.wf = { stage: WF_STAGE, primaryLabel: 'Save', stageNames: { PREP: 'CS Preparation', RECM: 'CS Recommendation', ACC: 'Recom Acc', VERIFY: 'CS Verify', APRV: 'CS Approval' }, state: null, history: [], busy: false, reason: '' };
        function wfObj() { return $scope[WF_OBJ] || {}; }
        function wfNum(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }

        $scope.wfDocId = function () { var o = wfObj(); return o.VendorCSRecmID || o.AutoCSNo || ''; };
        $scope.wfHasDoc = function () { return !!$scope.wfDocId(); };

        $scope.wfLoadState = function () {
            var id = $scope.wfDocId();
            if (!id) { $scope.wf.state = null; return; }
            $http.post('/VendorCSWorkflow/GetState', { Stage: WF_STAGE, DocID: id })
                .success(function (r) { $scope.wf.state = r.state || null; })
                .error(function () { $scope.wf.state = null; });
        };
        // reload the state whenever a different CS is loaded / cleared
        $scope.$watch(function () { return $scope.wfDocId(); }, function (n, o) { if (n !== o) $scope.wfLoadState(); });

        $scope.wfIsPostponed = function () { return !!($scope.wf.state && $scope.wf.state.WfState === 'POSTPONED'); };
        // can Back / Postpone be used on this page right now?
        $scope.wfCanAct = function () {
            var s = $scope.wf.state;
            if (!s) return true;
            if (s.WfState !== 'ACTIVE') return false;
            return WF_STAGE === 'PREP' ? true : s.CurrentStage === WF_STAGE;
        };
        $scope.wfCanResume = function () {
            var s = $scope.wf.state;
            return !!(s && s.WfState === 'POSTPONED' && (s.HeldAtStage || s.CurrentStage) === WF_STAGE);
        };
        // can the forward action (Recommend / Approve / Save) be used?
        $scope.wfCanForward = function () {
            var s = $scope.wf.state;
            if (!s) return true;
            if (WF_STAGE === 'PREP') return s.WfState !== 'POSTPONED';
            return s.WfState === 'ACTIVE' && s.CurrentStage === WF_STAGE;
        };
        $scope.wfActionClass = function (a) {
            return {
                BACK: 'label-warning', POSTPONE: 'label-danger', RESUME: 'label-success', RECOMMEND: 'label-primary',
                APPROVE: 'label-success', RESUBMIT: 'label-info'
            }[a] || 'label-default';
        };

        /* ── Operation drop-down drives the action:  Bck = Back,  Pst = Postpone,  Rsm = Resume ──
           Anything else (Rec / Vrf / Aprv / PRP ...) is the normal forward Save of the page. */
        var WF_OPS = { Bck: 'BACK', Pst: 'POSTPONE', Rsm: 'RESUME' };
        var WF_LABELS = { Bck: 'Back', Pst: 'Postpone', Rsm: 'Resume' };
        $scope.wfOp = function () { return wfObj().Operation || ''; };
        $scope.wfIsWorkflowOp = function () { return !!WF_OPS[$scope.wfOp()]; };
        $scope.wfNeedsReason = function () { return $scope.wfIsWorkflowOp(); };
        $scope.wfOpLabel = function () { return WF_LABELS[$scope.wfOp()] || ''; };
        $scope.wfReasonOk = function () { return ((($scope.wf.reason) || '').trim().length >= 5); };
        // is the Save button usable for the chosen Operation?
        $scope.wfCanSave = function () {
            var op = $scope.wfOp();
            if (op === 'Bck' || op === 'Pst') return $scope.wfCanAct();
            if (op === 'Rsm') return $scope.wfCanResume();
            return $scope.wfCanForward();
        };

        $scope.wfSend = function (action, reason) {
            if ($scope.wf.busy) return;
            $scope.wf.busy = true;
            $http.post('/VendorCSWorkflow/Act', { Stage: WF_STAGE, DocID: $scope.wfDocId(), Action: action, Reason: reason })
                .success(function (r) {
                    $scope.wf.busy = false;
                    if (r.status === 'S201') {
                        toastr.success({ BACK: 'Sent back to CS Preparation.', POSTPONE: 'CS postponed.', RESUME: 'CS resumed.' }[action]);
                        $scope.wf.reason = '';
                        $scope.wfLoadState();
                        $scope.toggleRefreshTable();
                    } else if (r.status === 'E400') { toastr.error('A reason (at least 5 characters) is required.'); }
                    else if (r.status === 'E409') { toastr.error('Not allowed in the CS\'s current state. Refresh and check its status.'); }
                    else if (r.status === 'E404') { toastr.error('CS workflow record not found.'); }
                    else { toastr.error('Action failed (' + r.status + ').'); }
                })
                .error(function () { $scope.wf.busy = false; toastr.error('Action failed.'); });
        };

        // Called at the top of Post(). Returns true when the chosen Operation was a workflow action (handled here).
        $scope.wfHandleOperation = function () {
            var action = WF_OPS[$scope.wfOp()];
            if (!action) return false;
            if (!$scope.wfHasDoc()) { toastr.error('Open a CS first.'); return true; }
            if (action === 'RESUME' ? !$scope.wfCanResume() : !$scope.wfCanAct()) {
                toastr.error('This action is not allowed in the CS\'s current state.'); return true;
            }
            if (!$scope.wfReasonOk()) { toastr.error('A reason (at least 5 characters) is required for ' + $scope.wfOpLabel() + '.'); return true; }
            var msg = {
                BACK: 'Send this CS back to CS Preparation?',
                POSTPONE: 'Postpone this CS? It will be stopped at every stage until it is resumed.',
                RESUME: 'Resume this CS?'
            }[action];
            if (!window.confirm(msg)) return true;
            $scope.wfSend(action, $scope.wf.reason.trim());
            return true;
        };

        $scope.wfShowHistory = function () {
            var id = $scope.wfDocId();
            if (!id) { toastr.error('Open a CS first.'); return; }
            $scope.wf.history = [];
            $http.post('/VendorCSWorkflow/GetHistory', { Stage: WF_STAGE, DocID: id })
                .success(function (r) { $scope.wf.history = r.history || []; })
                .error(function () { toastr.error('Could not load the history.'); });
            $('#WfHistoryModal').modal('show');
        };

        /* ── Award Type ───────────────────────────────────────────── */
        // 'REC' = recommend one vendor, 'DIST' = distribute work among selected vendors.
        // Older CS (before this feature) always had a single vendor, so they default to 'REC'.
        $scope.wfAwardMode = function () {
            var o = wfObj();
            if (o.AwardMode) return o.AwardMode;
            return $scope.wfHasDoc() ? 'REC' : '';
        };
        $scope.wfRows = function () { return $scope.MatWiseVendorListCollection || []; };
        $scope.wfReqQty = function () {
            var r = wfNum(wfObj().ReqQnty);
            if (r > 0) return r;
            var rows = $scope.wfRows();
            for (var i = 0; i < rows.length; i++) { var q = wfNum(rows[i].ReqQnty); if (q > 0) return q; }
            return 0;
        };
        $scope.wfAllocQty = function () {
            return ($scope.selectedVendors || []).reduce(function (s, v) { return s + wfNum(v.NegoQty); }, 0);
        };
        $scope.wfQtyDiff = function () { return $scope.wfAllocQty() - $scope.wfReqQty(); };
        $scope.wfSelectAll = function () {
            ($scope.wfRows()).forEach(function (row) { if (!row.selected) $scope.selectVendor(row); });
        };

        // called at the top of Post(): returns false to stop the save
        $scope.wfPreSave = function () {
            var s = $scope.wf.state;
            if (s && s.WfState === 'POSTPONED') { toastr.error('This CS is POSTPONED. Resume it before taking any action.'); return false; }
            if (s && s.WfState === 'RETURNED' && WF_STAGE !== 'PREP') { toastr.error('This CS was sent back to CS Preparation.'); return false; }
            if ($scope.wfAwardMode() === 'DIST' && WF_STAGE !== 'RECM' && WF_STAGE !== 'PREP') {
                if (($scope.selectedVendors || []).length <= 0) { toastr.error('Select the vendors the work is distributed to.'); return false; }
                var req = $scope.wfReqQty(), alloc = $scope.wfAllocQty();
                if (req > 0 && alloc > req + 0.0005 &&
                    !window.confirm('Cumulative qty (' + alloc + ') is greater than the Required Qty (' + req + '). Continue?')) return false;
            }
            return true;
        };
        $scope.wfLoadState();

        $scope.toggleRefreshTable = function () {
            $timeout(function () { window.location.reload(); }, 1000);
        };
    }]);
</script>
