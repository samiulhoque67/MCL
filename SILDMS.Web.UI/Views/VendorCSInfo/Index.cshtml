        $scope.selectVendor = function (row) {

            var id = row.VendorQutnID;

            // 🔒 Always enforce single source of truth
            var existsIndex = $scope.selectedVendors.findIndex(function (v) {
                return v.VendorQutnID === id;
            });

            if (existsIndex !== -1) {
                // =========================
                // ❌ UNSELECT (CLEAN REMOVE)
                // =========================
                row.selected = false;

                // Remove ALL duplicates safely
                $scope.selectedVendors = $scope.selectedVendors.filter(function (v) {
                    return v.VendorQutnID !== id;
                });

                // Remove related terms
                $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) {
                    return t.VendorQutnID !== id;
                });

                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);

                return;
            }

            // =========================
            // ✅ SELECT (CONTROLLED ADD)
            // =========================
            row.selected = true;

            var selectedVendorItem = {
                        ServiceCategoryID: row.ServiceCategoryID,
                        ServiceCategoryName: row.ServiceCategoryName,
                        ServiceItemID: row.ServiceItemID,
                        ServiceItemName: row.ServiceItemName,
                        Description: row.Description,
                        DeliveryLocation: row.DeliveryLocation,
                        DeliveryDate: row.DeliveryDate,                // Date object
                        Delivery_DateString: row.DeliveryDateString,    // Formatted string (e.g., 'yyyy/MM/dd')
                        DeliveryMode: row.DeliveryMode,
                        ReqQnty: row.ReqQnty,
                        ReqUnit: row.ReqUnit,
                        VendorQutnNo: row.VendorQutnNo,
                        VendorQutnID: row.VendorQutnID,
                        VendorID: row.VendorID,
                        VendorName: row.VendorName,

                        QutnQnty: row.QutnQnty,
                        NegoQty: row.NegoQty,
                        QutnPrice: row.QutnPrice,
                        NegoPrice: row.NegoPrice,
                        QutnUnit: row.QutnUnit,
                        QutnAmt: row.QutnAmt,
                        NegoAmt: row.NegoAmt,

                        VatPerc: row.VatPerc,
                        VatAmt: row.VatAmt,
                        NegoVatAmt: row.NegoVatAmt,
                        TolAmt: row.TolAmt,
                        NegoTolAmt: row.NegoTolAmt
            };

            // 🔒 Double-check before push (defensive programming)
            var alreadyExists = $scope.selectedVendors.some(function (v) {
                return v.VendorQutnID === id;
            });

            if (!alreadyExists) {
                $scope.selectedVendors.push(selectedVendorItem);
            }

            $scope.VendorCSInfo.VendorName = row.VendorName;

            // =========================
            // ⚠️ SAFE API CALL
            // =========================
            $http.post('/VendorCSInfo/GetVendorCSInfoTermList', { VendorQutnID: id })
                .success(function (response) {

                    // ❗ Check AGAIN (user may have unselected before response returned)
                    var stillSelected = $scope.selectedVendors.some(function (v) {
                        return v.VendorQutnID === id;
                    });

                    if (!stillSelected) return;

                    // Remove old terms first (avoid duplication)
                    $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) {
                        return t.VendorQutnID !== id;
                    });

                    // Add fresh terms
                    $scope.ReqTermDataSetupGridData =
                        $scope.ReqTermDataSetupGridData.concat(response.VendorCSInfoTermList);

                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                })
                .error(function () {
                    // optional: rollback selection if needed
                });
        };














