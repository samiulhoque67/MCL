        $scope.Post = function () {
            if ($scope.selectedVendors.length <= 0 && $scope.p != 1) {
                toastr.error("Please select at least one vendor");
                return;
            }

            if ($('#VendorCsRecmName').val() == "") {
                toastr.error("CS Vendor is  Required");
                return;
            }

            if ($scope.VendorCSInfo.AutoCSNo != "") {
                if ($('#CSRecDate').val() == "") {
                    toastr.error("CS Date  Required");
                    return;
                }
                $scope.VendorCSInfo.CSRecDate = $('#CSRecDate').val();
            }
            else {
                if ($('#CSRecDate1').val() == "") {
                    toastr.error("CS Date  Required");
                    return;
                }
                $scope.VendorCSInfo.CSRecDate = $('#CSRecDate1').val();
            }
            if (!$scope.VendorCSInfo.Operation) {
                toastr.error("please select an  operation");
                return;
            }
            if ($('#CSRecDate1').val() == "") {
                toastr.error("CS Date  Required");
                return;
            }

            $http.post('/VendorCSInfo/SaveVendorCSInfo',
                {
                    vendorCS: $scope.VendorCSInfo,
                    vendorCSItem: $scope.selectedVendors,
                    vendorCSTerm: $scope.ReqTermGridDisplayCollection,

                })
                .success(function (response) {
                    if (response.status == "S201") {
                        toastr.success("Data Saved Successfully.");
                        $scope.toggleRefreshTable();
                        $scope.clearVendorCSInfo();

                        $scope.loading = false;
                        return;
                    }
                    else if (response.status == "S202") {
                        toastr.success("Data Updated Successfully.");
                        $scope.toggleRefreshTable();
                        //$scope.clearVendorCSInfo();

                        $scope.loading = false;
                        return;
                    }
                    else if (response.status == "S203") {
                        toastr.success("Data Deleted Successfully.");
                        $scope.clearVendorCSInfo();
                        $scope.loading = false;
                        return;
                    }
                    else {
                        toastr.error("Data Save Failed.");
                        $scope.loading = false;
                        return;
                    }
                })
                .error(function () {
                    toastr.error("Data Save Failed.");
                    $scope.loading = false;
                    return;
                });
        }

