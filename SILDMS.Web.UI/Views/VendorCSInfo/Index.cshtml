@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .dbody {
        background-color: whitesmoke;
    }

    .font-weight-bold {
        font-weight: bold;
        color: darkgreen;
    }

    .w-100 {
        width: 100%;
    }

    .d-flex {
        display: flex;
    }

    .align-items-center {
        align-items: center;
    }

    .justify-content-center {
        justify-content: center;
    }

    .global-search {
        height: 34px;
    }

    .btn-round {
        border-radius: 17px;
    }

    .box.box-solid.box-primary > .box-header {
        text-align: center;
    }

    .table-header {
        background-color: #8aa4af !important;
        color: darkblue !important;
        font-size: 13px;
    }

    .tableVen-striped > tbody > tr:nth-of-type(odd) {
        background-color: rgba(23, 250, 132, 0.01);
    }

    .selected-row {
        background-color: #dff0d8;
    }
    /* Mode indicator badge */
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-view {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .mode-new {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    /* Vendor quotation rows whose ProcessStatus is not Done */
    .not-quoted-row > td {
        background: #eeeeee !important;
        color: #999 !important;
    }

    /* Required qty vs cumulative Nego qty bar */
    .qty-summary {
        overflow: hidden;
        padding: 8px 15px;
        margin: 5px 0 10px 0;
        border: 1px solid #ddd;
        border-left-width: 5px;
        background: #fff;
        font-size: 13px;
    }

        .qty-summary.qty-neutral {
            border-left-color: #999;
        }

        .qty-summary.qty-under {
            border-left-color: #3c8dbc;
        }

        .qty-summary.qty-ok {
            border-left-color: #00a65a;
        }

        .qty-summary.qty-over {
            border-left-color: #dd4b39;
            background: #fdf3f1;
        }

            .qty-summary.qty-over .qty-diff {
                color: #dd4b39;
                font-weight: bold;
            }

        .qty-summary.qty-ok .qty-diff {
            color: #00a65a;
            font-weight: bold;
        }

        .qty-summary.qty-under .qty-diff {
            color: #3c8dbc;
            font-weight: bold;
        }

    #mydiv {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 99999;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #mydiv .loder {
            background: #fff;
            padding: 20px 30px;
            border-radius: 6px;
            text-align: center;
        }
</style>

<div class="box box-primary box-body" ng-controller="VendorCSInfoCtrl">

    <!-- Reusable: Required Qty vs cumulative Nego Qty -->
    <script type="text/ng-template" id="qtySummary.html">
        <div class="qty-summary" ng-class="qtyStatusClass()">
            <div class="col-lg-3">
                <strong>Required Qty:</strong>
                <span ng-show="getReqQty() > 0">{{getReqQty() | number:3}} {{VendorCSInfo.ReqUnit}}</span>
                <span ng-show="getReqQty() <= 0">n/a</span>
            </div>
            <div class="col-lg-2"><strong>Selected Vendors:</strong> {{selectedVendors.length}}</div>
            <div class="col-lg-4">
                <strong>{{qtyLabel()}}:</strong>
                <span ng-show="hasAllocation()">{{allocatedQty() | number:3}}</span>
                <span ng-hide="hasAllocation()">not chosen yet</span>
            </div>
            <div class="col-lg-3 qty-diff" ng-show="qtyApplicable()">
                <span ng-show="qtyDiff() > 0.0005"><i class="fa fa-exclamation-triangle"></i> Exceeds Required Qty by {{qtyDiff() | number:3}}</span>
                <span ng-show="qtyDiff() < -0.0005">Remaining to allocate: {{-qtyDiff() | number:3}}</span>
                <span ng-show="qtyDiff() >= -0.0005 && qtyDiff() <= 0.0005"><i class="fa fa-check"></i> Fully allocated</span>
            </div>
        </div>
    </script>

    <!-- Reusable: award type + recommended vendor -->
    <script type="text/ng-template" id="awardBlock.html">
        <div class="row" style="margin-bottom: 6px; margin-right: -15px; margin-left: -31px;">
            <div class="col-sm-1"></div>
            <div class="col-lg-2"><label>Award Type:</label></div>
            <div class="col-lg-8" style="margin-bottom: 6px; margin-right: -15px; margin-left: 5px;">
                <label class="radio-inline">
                    <input type="radio" ng-model="VendorCSInfo.AwardMode" value="REC" ng-change="onAwardModeChange()" ng-disabled="pageMode==='view'" />
                    Recommend one vendor
                </label>
                <label class="radio-inline">
                    <input type="radio" ng-model="VendorCSInfo.AwardMode" value="DIST" ng-change="onAwardModeChange()" ng-disabled="pageMode==='view'" />
                    Distribute work among selected vendors
                </label>
            </div>
        </div>
        <div class="row" ng-show="VendorCSInfo.AwardMode==='REC'" style="margin-bottom: 6px; margin-right: -15px; margin-left: -31px;">
            <div class="col-sm-1"></div>
            <div class="col-lg-2"><label>CS Recm. Vendor:</label></div>
            <div class="col-lg-3" style="margin-bottom: 6px; margin-right: -15px; margin-left: 5px;">
                <input type="text" class="form-control" placeholder="CS Recm. Vendor"
                       ng-model="VendorCSInfo.VendorCsRecmName" ng-readonly="true" style="background:#fff;" />
            </div>
            <div class="col-lg-1" ng-show="pageMode!=='view'">
                <button type="button" class="btn btn-default" ng-click="ShowVendorList()" title="Choose the recommended vendor">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    </script>

    <!-- Reusable: not-quoted alerts -->
    <script type="text/ng-template" id="quoteAlerts.html">
        <div class="alert alert-danger" ng-show="pageMode !== 'view' && notQuotedCount() > 0" style="margin:8px 15px;">
            <i class="fa fa-exclamation-triangle"></i>
            <strong>All vendors must be quoted before you can save.</strong>
            {{notQuotedCount()}} of {{currentVendorRows().length}} requisitioned vendor(s) have not quoted yet. They are greyed out, and Save / Update stays disabled until every vendor has been quoted.
        </div>
    </script>

    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">
            Vendor CS Information
            <span ng-show="pageMode==='view'" class="mode-badge mode-view">VIEW</span>
            <span ng-show="pageMode==='edit'" class="mode-badge mode-edit">EDIT</span>
            <span ng-show="pageMode==='new'" class="mode-badge mode-new">NEW</span>
        </h2>

        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-warning" type="button" data-ng-click="toggleRefreshTable()" ng-disabled="btnRefresh">
                        <i class="fa fa-refresh" style="padding-right:5px"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-primary" type="button" data-ng-click="SearchCS()" ng-disabled="btnSearch">
                        <i class="fa fa-search" style="padding-right:5px"></i> Search
                    </button>
                </div>
                @*<div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                        @using (Html.BeginForm("VendorCSApprevedReport", "../Reports", FormMethod.Post, new { target = "_blank", name = "H1Form", id = "H1Form" }))
                        {
                            <button ng-disabled="showPrint" type="submit" id="btnSubmit" name="ReportType" class="button-custom btn-success pull-right">
                                <i class="fa fa-print" style="padding-right:5px"></i> CS Print
                            </button>
                        }
                    </div>*@
                <!-- Save/Update button — hidden in viewmode; disabled when the item is not quoted -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-hide="pageMode==='view'">
                    <button class="button-custom btn-success" type="button" data-ng-click="Post()"
                            ng-disabled="btnSave || saveBlocked()"
                            title="{{ saveBlocked() && pageMode !== 'view' ? 'All vendors must be quoted before saving' : '' }}">
                        <i class="fa fa-save" style="padding-right:5px"></i>
                        {{ pageMode === 'edit' ? 'Update' : 'Save' }}
                    </button>
                </div>
                <!-- Switch to Edit from View -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view'">
                    <button class="button-custom btn-warning" type="button" ng-click="switchToEdit()">
                        <i class="fa fa-edit" style="padding-right:5px"></i> Edit
                    </button>
                </div>
                <!-- CS WORKFLOW : history (Back / Postpone / Resume are chosen in the Operation drop-down) -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="wfHasDoc()">
                    <button class="button-custom btn-info" type="button" ng-click="wfShowHistory()" title="Back / Postpone / Recommend history with reasons">
                        <i class="fa fa-history" style="padding-right:5px"></i> History
                    </button>
                </div>
                <!-- New CS (clear form) -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view' || pageMode==='edit'">
                    <button class="button-custom" type="button" ng-click="startNewCS()">
                        <i class="fa fa-plus" style="padding-right:5px"></i> New
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CS WORKFLOW BANNER : latest Back / Postpone reason is always visible -->
    <div class="alert" ng-cloak ng-show="wf.state && wf.state.WfState && wf.state.WfState !== 'ACTIVE'"
         ng-class="wf.state.WfState === 'POSTPONED' ? 'alert-danger' : 'alert-warning'" style="margin:8px 15px;">
        <div ng-show="wf.state.WfState === 'POSTPONED'">
            <i class="fa fa-pause-circle"></i>
            <strong>POSTPONED</strong> at {{wf.stageNames[wf.state.HeldAtStage || wf.state.CurrentStage]}}
            <span ng-show="wf.state.LastActionByName"> by {{wf.state.LastActionByName}}</span>
            <span ng-show="wf.state.LastActionOnText"> on {{wf.state.LastActionOnText}}</span>.
            No action is possible at any stage until it is resumed.
        </div>
        <div ng-show="wf.state.WfState === 'RETURNED'">
            <i class="fa fa-undo"></i>
            <strong>SENT BACK to CS Preparation</strong> from {{wf.stageNames[wf.state.HeldAtStage]}}
            <span ng-show="wf.state.LastActionByName"> by {{wf.state.LastActionByName}}</span>
            <span ng-show="wf.state.LastActionOnText"> on {{wf.state.LastActionOnText}}</span>.
            <span ng-show="wf.stage === 'PREP'">Correct it and click <em>Update</em> to send it forward again.</span>
        </div>
        <div style="margin-top:4px;"><strong>Reason:</strong> {{wf.state.LastReason}}</div>
    </div>


    <!-- ══════════════════════════════════════════════════════════════════
         NEW MODE  (p===2): Requisition list → Items → Vendors → Form
         ══════════════════════════════════════════════════════════════════ -->
    <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="p===2">

        <!-- Requisition list -->
        <div class="row">
            <div ng-show="GridDisplayCollection.length<=0" style="text-align:center">
                <h4 style="color:red;">No data available!</h4>
            </div>
            <div ng-show="GridDisplayCollection.length>0" class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                       style="width:100%;" class="tableVen table-condensed table-bordered table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Requisition To Vendor List
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="text-align: left;" st-sort="">Client Name</th>
                            <th style="text-align: left;" st-sort="">Project Name</th>
                            <th style="text-align: left;" st-sort="">Representative</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in GridDisplayCollection" ng-cloak style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}" ng-style="getRowStyle(row)">
                            <td class="hidden">{{row.Id}}</td>
                            <td class="hidden">{{row.Remarks}}</td>

                            <td class="hidden">{{row.VendorRequisitionNumber}}</td>
                            <td class="hidden">{{row.RequisitionDate}}</td>
                            <td class="hidden">{{row.ClientName}}</td>
                            <td class="hidden">{{row.ClientRequisitionNumber}}</td>
                            <td class="hidden">{{row.LastDateofQuotation}}</td>

                            <td class="col-lg-2">{{row.ClientName}}</td>
                            <td class="col-lg-2">{{ row.ProjectName }} </td>
                            <td class="col-lg-2">{{row.UserFullName}}</td>

                            <td class="col-lg-1 text-center" style="font-weight:bold">
                                <button type="button" ng-click="selectInvitation(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Item list (shown after requisition selected) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="isRowSelected">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqWiseMaterialListCollection" st-safe-src="InvWiseMaterialList"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">Item List</th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Category Name</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>ReqQnty</th>
                            <th>ReqUnit</th>
                            <th>Description</th>
                            <th>DeliveryLocation</th>
                            <th>DeliveryDate</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqWiseMaterialListCollection" style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}" ng-style="getRowStyle(row)">
                            <td>{{row.ServiceCategoryName}}</td>
                            <td>{{row.ServiceItemID}}</td>
                            <td>{{row.ServiceItemName}}</td>
                            <td>{{row.ReqQnty | number:3}}</td>
                            <td>{{row.ReqUnit}}</td>
                            <td>{{row.Description}}</td>
                            <td>{{row.DeliveryLocation}}</td>
                            <td>{{row.DeliveryDate}}</td>
                            <td style="font-weight:bold">
                                <button type="button" ng-click="selectMaterial(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vendor list (shown after item selected) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="isMaterialRowSelected">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">

                <div ng-include="'quoteAlerts.html'"></div>
                <div ng-include="'qtySummary.html'"></div>

                <table st-table="MatWiseVendorListCollection" st-safe-src="MatWiseVendorList"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="16" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Selected Item : {{VendorCSInfo.ServiceItemName}}
                                <span style="font-size:12px;color:#777;margin-left:10px;">(tick the vendors to compare, then recommend one or distribute the work)</span>
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Quotation No</th>
                            <th>Vendor Name</th>
                            <th>ProposeQty</th>
                            <th>Nego Qty</th>
                            <th>Unit</th>
                            <th>QutnPrice</th>
                            <th>Propose Price</th>
                            <th>Vat %</th>
                            <th>Vat Amnt</th>
                            <th>Propose Vat Amnt</th>
                            <th>Total Price</th>
                            <th>Propose Total Price</th>
                            <th>Delivery Date</th>
                            <th>Status</th>
                            <th>Action</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in MatWiseVendorListCollection" style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected, 'not-quoted-row': !isQuoted(row)}" ng-style="getRowStyle(row)">
                            <td>{{row.VendorQutnNo}}</td>
                            <td>{{row.VendorName}}</td>
                            <td>{{row.QutnQnty | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoQty" ng-blur="checkUnitPrice(row)" ng-disabled="!isQuoted(row)" /></td>
                            <td>{{row.ReqUnit}}</td>
                            <td>{{row.QutnPrice | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoPrice" ng-blur="checkUnitPrice(row)" ng-disabled="!isQuoted(row)" /></td>
                            <td>{{row.VatPerc | number:2}}</td>
                            <td>{{row.VatAmt | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoVatAmt" ng-readonly="true" /></td>
                            <td>{{row.TolAmt | number:3}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoTolAmt" ng-readonly="true" /></td>
                            <td>{{row.DeliveryDate}}</td>
                            <td>
                                <span class="label label-success" ng-show="isQuoted(row)">Quoted</span>
                                <span class="label label-danger" ng-hide="isQuoted(row)" title="ProcessStatus: {{row.ProcessStatus || 'n/a'}}">Not quoted</span>
                            </td>
                            <td style="font-weight:bold" width="23px">
                                <button type="button" ng-click="selectVendor(row)" ng-disabled="!isQuoted(row)"
                                        title="{{ isQuoted(row) ? 'Select / Deselect' : 'Not quoted - cannot be selected' }}">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                            <td>
                                <button ng-hide="!row.DocumentID" ng-click="ViewDocument(row)" class="btn button-custom"><i class="fa fa-eye" style="width:11px;"></i></button>
                                <span ng-hide="row.DocumentID"
                                      style="color:#999; font-size:11px;">No document attached</span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br />

                <!-- CS Form (new mode) -->
                <div ng-include="'awardBlock.html'"></div>
                <div class="row">
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-lg-2"><label>CS Date:</label></div>
                        <div class="col-lg-3">
                            <input id="CSRecDate1" autocomplete="off" name="CSRecDate1" type="text"
                                   class="DatePicker form-control" placeholder="DD/MM/YYYY" ng-model="VendorCSInfo.CSRecDate" />
                        </div>
                        <div class="col-lg-2"><label>Operation:</label></div>
                        <div class="col-lg-3">
                            <select data-ng-model="VendorCSInfo.Operation" class="form-control" ng-change="wf.reason = ''">
                                <option value="">-- None --</option>
                                <option value="PRP" ng-disabled="!wfCanForward()">Preparation</option>

                                <option value="Pst" ng-disabled="!wfCanAct()">Postponed</option>
                                <option value="Rsm" ng-if="wfCanResume()">Resume</option>
                                <option value="Can">Cancel</option>
                            </select>
                            <div ng-show="wfNeedsReason()" style="margin-top:6px;">
                                <textarea class="form-control" rows="3" maxlength="1000" ng-model="wf.reason"
                                          placeholder="Reason for {{wfOpLabel()}} (required)" ng-style="!wfReasonOk() && {'border-color':'#a94442'}"></textarea>
                                <small ng-class="wfReasonOk() ? 'text-muted' : 'text-danger'"><i class="fa fa-asterisk" style="font-size:8px;"></i> Reason is mandatory &ndash; {{(wf.reason || '').trim().length}}/1000 (min 5)</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-lg-2"><label>Note:</label></div>
                        <div class="col-lg-8">
                            <textarea id="Remarks" name="Remarks" data-ng-model="VendorCSInfo.Remarks"
                                      class="form-control" placeholder="Note for CS"></textarea>
                            <input id="VenReqItem" type="hidden" ng-model="VendorCSInfo.VenReqItem" />
                            <input id="RptQutnQty" type="hidden" ng-model="VendorCSInfo.RptQutnQty" />
                            <input id="RptQutnUnit" type="hidden" ng-model="VendorCSInfo.RptQutnUnit" />
                        </div>
                    </div>
                </div>

                <br />

                <!-- Terms table (new mode) -->
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="4" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">Terms & Conditions</th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Vendor Name</th>
                            <th>Terms Code</th>
                            <th>Terms & Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.VendorCSInfoTermsID}}</td>
                            <td class="hidden">{{row.VendorCSInfoID}}</td>
                            <td style="width:35%;">{{row.VendorName}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td style="width:5%;">{{row.TermsCode}}</td>
                            <td style="width:60%;">{{row.TermsName}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         VIEW / EDIT MODE  (p===1): Loaded from Search → Select
         ══════════════════════════════════════════════════════════════════ -->
    <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="p===1">

        <!-- CS header info bar -->
        <div class="row" style="padding:8px 15px;background:#fff;border:1px solid #ddd;margin:5px 0;">
            <div class="col-lg-3"><strong>CS No:</strong>   {{VendorCSInfo.AutoCSNo}}</div>
            <div class="col-lg-2"><strong>CS Date:</strong> {{VendorCSInfo.CSRecDate}}</div>
            <div class="col-lg-3"><strong>Client:</strong>  {{VendorCSInfo.ClientName}}</div>
            <div class="col-lg-3"><strong>Item:</strong>    {{VendorCSInfo.ServiceItemName}}</div>
        </div>

        <div ng-include="'quoteAlerts.html'"></div>
        <div style="margin:0 15px;" ng-include="'qtySummary.html'"></div>

        <!-- Vendor table -->
        <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;overflow-x:auto;">
            <table st-table="VendorCSListCollection" st-safe-src="VendorCSList"
                   style="width:100%;font-size:12px;"
                   class="tableVen table-condensed table-bordered table-hover pnlView">
                <thead>
                    <tr style="font-size:14px;">
                        <th colspan="16" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                            Vendors For Item : <strong>{{VendorCSInfo.ServiceItemName}}</strong>
                        </th>
                    </tr>
                    <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                        <th>CS Number</th>
                        <th>Quotation No</th>
                        <th>Vendor Name</th>
                        <th style="text-align:right;">ProposeQty</th>
                        <th>Nego Qty</th>
                        <th>Unit</th>
                        <th style="text-align:right;">Propose Price</th>
                        <th style="text-align:right;">Vat %</th>
                        <th style="text-align:right;">Nego Vat Amt</th>
                        <th style="text-align:right;">Propose Total</th>
                        <th style="text-align:right;">Total Price</th>
                        <th>Delivery Date</th>
                        <th>Status</th>
                        <th ng-show="pageMode==='edit'">Action</th>
                        <th>View</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="row in VendorCSListCollection"
                        style="height:20px;font-size:12px;"
                        ng-style="getRowStyle(row)"
                        ng-class="{'selected-row': row.selected, 'not-quoted-row': pageMode!=='view' && !isQuoted(row)}">

                        <td>{{row.VendorCSInfoID || row.VendorCSRecmID}}</td>
                        <td>{{row.VendorQutnNo}}</td>
                        <td>{{row.VendorName}}</td>
                        <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>

                        <!-- Nego Qty: input in edit, plain text in view -->
                        <td>
                            <span ng-show="pageMode==='view'">{{row.NegoQty | number:2}}</span>
                            <input ng-show="pageMode==='edit'"
                                   class="form-control" style="width:80px;height:18px;font-size:10px;"
                                   type="text" ng-model="row.NegoQty"
                                   ng-disabled="!isQuoted(row)"
                                   ng-blur="checkUnitPrice(row)" />
                        </td>

                        <td>{{row.ReqUnit || row.QutnUnit}}</td>

                        <!-- Propose Price: input in edit, plain text in view -->
                        <td>
                            <span ng-show="pageMode==='view'">{{row.NegoPrice | number:2}}</span>
                            <input ng-show="pageMode==='edit'"
                                   class="form-control" style="width:80px;height:18px;font-size:10px;"
                                   type="text" ng-model="row.NegoPrice"
                                   ng-disabled="!isQuoted(row)"
                                   ng-blur="checkUnitPrice(row)" />
                        </td>

                        <td style="text-align:right;">{{row.VatPerc | number:2}}</td>
                        <td style="text-align:right;">{{row.NegoVatAmt | number:2}}</td>
                        <td style="text-align:right;">{{row.NegoTolAmt | number:3}}</td>
                        <td style="text-align:right;">{{row.TolAmt | number:3}}</td>
                        <td>{{row.DeliveryDate}}</td>

                        <td>
                            <span class="label label-success" ng-show="pageMode==='view' || isQuoted(row)">Quoted</span>
                            <span class="label label-danger" ng-show="pageMode!=='view' && !isQuoted(row)" title="ProcessStatus: {{row.ProcessStatus || 'n/a'}}">Not quoted</span>
                        </td>

                        <!-- Action checkbox — edit mode only -->
                        <td ng-show="pageMode==='edit'" style="text-align:center;font-weight:bold;">
                            <button type="button" ng-click="selectVendor(row)" ng-disabled="!isQuoted(row)"
                                    title="{{ isQuoted(row) ? 'Select / Deselect' : 'Not quoted - cannot be selected' }}">
                                <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                            </button>
                        </td>

                        <!-- View PDF button — always visible -->
                        <td style="text-align:center;">
                            <button ng-hide="!row.DocumentID" ng-click="ViewDocumentFromList(row)" class="btn button-custom" title="View quotation PDF">
