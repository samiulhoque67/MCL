@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .dbody {
        background-color: whitesmoke;
    }

    .font-weight-bold {
        font-weight: bold;
        color: darkgreen;
    }

    .w-100 {
        width: 100%;
    }

    .d-flex {
        display: flex;
    }

    .align-items-center {
        align-items: center;
    }

    .justify-content-center {
        justify-content: center;
    }

    .global-search {
        height: 34px;
    }

    .btn-round {
        border-radius: 17px;
    }

    .box.box-solid.box-primary > .box-header {
        text-align: center;
    }

    .table-header {
        background-color: #8aa4af !important;
        color: darkblue !important;
        font-size: 13px;
    }

    .tableVen-striped > tbody > tr:nth-of-type(odd) {
        background-color: rgba(23, 250, 132, 0.01);
    }

    .selected-row {
        background-color: #dff0d8;
    }
    /* Mode indicator badge */
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-view {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .mode-new {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }
</style>

<div class="box box-primary box-body" ng-controller="VendorCSInfoCtrl">
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">
            Vendor CS Information
            <span ng-show="pageMode==='view'" class="mode-badge mode-view">VIEW</span>
            <span ng-show="pageMode==='edit'" class="mode-badge mode-edit">EDIT</span>
            <span ng-show="pageMode==='new'" class="mode-badge mode-new">NEW</span>
        </h2>

        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-warning" type="button" data-ng-click="toggleRefreshTable()" ng-disabled="btnRefresh">
                        <i class="fa fa-refresh" style="padding-right:5px"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    <button class="button-custom btn-primary" type="button" data-ng-click="SearchCS()" ng-disabled="btnSearch">
                        <i class="fa fa-search" style="padding-right:5px"></i> Search
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;">
                    @using (Html.BeginForm("VendorCSApprevedReport", "../Reports", FormMethod.Post, new { target = "_blank", name = "H1Form", id = "H1Form" }))
                    {
                        <button ng-disabled="showPrint" type="submit" id="btnSubmit" name="ReportType" class="button-custom btn-success pull-right">
                            <i class="fa fa-print" style="padding-right:5px"></i> CS Print
                        </button>
                    }
                </div>
                <!-- Save/Update button — hidden in viewmode -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-hide="pageMode==='view'">
                    <button class="button-custom btn-success" type="button" data-ng-click="Post()" ng-disabled="btnSave">
                        <i class="fa fa-save" style="padding-right:5px"></i>
                        {{ pageMode === 'edit' ? 'Update' : 'Save' }}
                    </button>
                </div>
                <!-- Switch to Edit from View -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view'">
                    <button class="button-custom btn-warning" type="button" ng-click="switchToEdit()">
                        <i class="fa fa-edit" style="padding-right:5px"></i> Edit
                    </button>
                </div>
                <!-- New CS (clear form) -->
                <div class="btn-group pull-right" style="margin-left:4px;margin-right:4px;" ng-show="pageMode==='view' || pageMode==='edit'">
                    <button class="button-custom" type="button" ng-click="startNewCS()">
                        <i class="fa fa-plus" style="padding-right:5px"></i> New
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         NEW MODE  (p===2): Requisition list → Items → Vendors → Form
         ══════════════════════════════════════════════════════════════════ -->
    <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="p===2">

        <!-- Requisition list -->
        <div class="row">
            <div ng-show="GridDisplayCollection.length<=0" style="text-align:center">
                <h4 style="color:red;">No data available!</h4>
            </div>
            <div ng-show="GridDisplayCollection.length>0" class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="GridDisplayCollection" st-safe-src="masterDataSetupGridData"
                       style="width:100%;" class="tableVen table-condensed table-bordered table-hover pnlView">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Requisition To Vendor List
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="text-align: left;" st-sort="">Client Name</th>
                            <th style="text-align: left;" st-sort="">Project Name</th>
                            <th style="text-align: left;" st-sort="">Representative</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in GridDisplayCollection" ng-cloak style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}" ng-style="getRowStyle(row)">
                            <td class="hidden">{{row.Id}}</td>
                            <td class="hidden">{{row.Remarks}}</td>

                            <td class="hidden">{{row.VendorRequisitionNumber}}</td>
                            <td class="hidden">{{row.RequisitionDate}}</td>
                            <td class="hidden">{{row.ClientName}}</td>
                            <td class="hidden">{{row.ClientRequisitionNumber}}</td>
                            <td class="hidden">{{row.LastDateofQuotation}}</td>

                            <td class="col-lg-2">{{row.ClientName}}</td>
                            <td class="col-lg-2">{{ row.ProjectName }} </td>
                            <td class="col-lg-2">{{row.UserFullName}}</td>

                            <td class="col-lg-1 text-center" style="font-weight:bold">
                                <button type="button" ng-click="selectInvitation(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Item list (shown after requisition selected) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="isRowSelected">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqWiseMaterialListCollection" st-safe-src="InvWiseMaterialList"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">Item List</th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Category Name</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>ReqQnty</th>
                            <th>ReqUnit</th>
                            <th>Description</th>
                            <th>DeliveryLocation</th>
                            <th>DeliveryDate</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqWiseMaterialListCollection" style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}" ng-style="getRowStyle(row)">
                            <td>{{row.ServiceCategoryName}}</td>
                            <td>{{row.ServiceItemID}}</td>
                            <td>{{row.ServiceItemName}}</td>
                            <td>{{row.ReqQnty | number:3}}</td>
                            <td>{{row.ReqUnit}}</td>
                            <td>{{row.Description}}</td>
                            <td>{{row.DeliveryLocation}}</td>
                            <td>{{row.DeliveryDate}}</td>
                            <td style="font-weight:bold">
                                <button type="button" ng-click="selectMaterial(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vendor list (shown after item selected) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="isMaterialRowSelected">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="MatWiseVendorListCollection" st-safe-src="MatWiseVendorList"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="16" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                Selected Item : {{VendorCSInfo.ServiceItemName}}
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Quotation No</th>
                            <th>Vendor Name</th>
                            <th>ProposeQty</th>
                            <th>Nego Qty</th>
                            <th>Unit</th>
                            <th>QutnPrice</th>
                            <th>Propose Price</th>
                            <th>Vat %</th>
                            <th>Vat Amnt</th>
                            <th>Propose Vat Amnt</th>
                            <th>Total Price</th>
                            <th>Propose Total Price</th>
                            <th>Delivery Date</th>
                            <th>Action</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in MatWiseVendorListCollection" style="height:20px;font-size:13px;"
                            ng-class="{'selected-row': row.selected}" ng-style="getRowStyle(row)">
                            <td>{{row.VendorQutnNo}}</td>
                            <td>{{row.VendorName}}</td>
                            <td>{{row.QutnQnty | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoQty" ng-blur="checkUnitPrice(row)" /></td>
                            <td>{{row.ReqUnit}}</td>
                            <td>{{row.QutnPrice | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoPrice" ng-blur="checkUnitPrice(row)" /></td>
                            <td>{{row.VatPerc | number:2}}</td>
                            <td>{{row.VatAmt | number:2}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoVatAmt" ng-readonly="true" /></td>
                            <td>{{row.TolAmt | number:3}}</td>
                            <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoTolAmt" ng-readonly="true" /></td>
                            <td>{{row.DeliveryDate}}</td>
                            <td style="font-weight:bold" width="23px">
                                <button type="button" ng-click="selectVendor(row)" title="Select">
                                    <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                    <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                                </button>
                            </td>
                            <td>
                                <button ng-hide="!row.DocumentID" ng-click="ViewDocument(row)" class="btn button-custom"><i class="fa fa-eye" style="width:11px;"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br />

                <!-- CS Form (new mode) -->
                <div class="row">
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-lg-2"><label>CS Recm. Vendor:</label></div>
                        <div class="col-lg-3">
                            <input id="VendorCsRecmName" type="text" class="form-control" placeholder="CS Recm. Vendor"
                                   ng-model="VendorCSInfo.VendorCsRecmName" ng-readonly="true" />
                            <input id="CSRecmVendorID" type="hidden" ng-model="VendorCSInfo.CSRecmVendorID" />
                        </div>
                        <div class="col-lg-1">
                            <button type="button" ng-click="ShowVendorList()"
                                    style="position:absolute;right:1px;top:50%;transform:translateY(-11%) translateX(-75px);padding:4px 10px;border:2px solid black;background:transparent;">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-lg-2"><label>CS Date:</label></div>
                        <div class="col-lg-3">
                            <input id="CSRecDate1" autocomplete="off" name="CSRecDate1" type="text"
                                   class="DatePicker form-control" placeholder="DD/MM/YYYY" ng-model="VendorCSInfo.CSRecDate" />
                        </div>
                        <div class="col-lg-2"><label>Operation:</label></div>
                        <div class="col-lg-3">
                            <select data-ng-model="VendorCSInfo.Operation" class="form-control">
                                <option value="">-- None --</option>
                                <option value="PRP">Preparation</option>
                                <option value="Bck">Back</option>
                                <option value="Pst">Postponed</option>
                                <option value="Can">Cancel</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-lg-2"><label>Note:</label></div>
                        <div class="col-lg-8">
                            <textarea id="Remarks" name="Remarks" data-ng-model="VendorCSInfo.Remarks"
                                      class="form-control" placeholder="Note for CS"></textarea>
                            <input id="VenReqItem" type="hidden" ng-model="VendorCSInfo.VenReqItem" />
                            <input id="RptQutnQty" type="hidden" ng-model="VendorCSInfo.RptQutnQty" />
                            <input id="RptQutnUnit" type="hidden" ng-model="VendorCSInfo.RptQutnUnit" />
                        </div>
                    </div>
                </div>

                <br />

                <!-- Terms table (new mode) -->
                <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
                       class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                    <thead>
                        <tr style="font-size:15px;">
                            <th colspan="4" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">Terms & Conditions</th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Vendor Name</th>
                            <th>Terms Code</th>
                            <th>Terms & Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.VendorCSInfoTermsID}}</td>
                            <td class="hidden">{{row.VendorCSInfoID}}</td>
                            <td style="width:35%;">{{row.VendorName}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td style="width:5%;">{{row.TermsCode}}</td>
                            <td style="width:60%;">{{row.TermsName}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         VIEW / EDIT MODE  (p===1): Loaded from Search → Select
         ══════════════════════════════════════════════════════════════════ -->
    <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888888;padding:5px 10px;" ng-show="p===1">

        <!-- CS header info bar -->
        <div class="row" style="padding:8px 15px;background:#fff;border:1px solid #ddd;margin:5px 0;">
            <div class="col-lg-3"><strong>CS No:</strong>   {{VendorCSInfo.AutoCSNo}}</div>
            <div class="col-lg-2"><strong>CS Date:</strong> {{VendorCSInfo.CSRecDate}}</div>
            <div class="col-lg-3"><strong>Client:</strong>  {{VendorCSInfo.ClientName}}</div>
            <div class="col-lg-3"><strong>Item:</strong>    {{VendorCSInfo.ServiceItemName}}</div>
        </div>

        <!-- Vendor table — matches the image exactly -->
        <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;overflow-x:auto;">
            <table st-table="VendorCSListCollection" st-safe-src="VendorCSList"
                   style="width:100%;font-size:12px;"
                   class="tableVen table-condensed table-bordered table-hover pnlView">
                <thead>
                    <tr style="font-size:14px;">
                        <th colspan="16" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                            Selected Vendor For Item : <strong>{{VendorCSInfo.ServiceItemName}}</strong>
                        </th>
                    </tr>
                    <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                        <th>CS Number</th>
                        <th>Quotation No</th>
                        <th>Vendor Name</th>
                        <th style="text-align:right;">ProposeQty</th>
                        <th>Nego Qty</th>
                        <th>Unit</th>
                        <th style="text-align:right;">Propose Price</th>
                        <!-- VAT % column — was missing -->
                        <th style="text-align:right;">Vat %</th>
                        <th style="text-align:right;">Nego Vat Amt</th>
                        <th style="text-align:right;">Propose Total</th>
                        <th style="text-align:right;">Total Price</th>
                        <th>Delivery Date</th>
                        <!-- Action + View — were missing -->
                        <th ng-show="pageMode==='edit'">Action</th>
                        <th>View</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="row in VendorCSListCollection"
                        style="height:20px;font-size:12px;"
                        ng-style="getRowStyle(row)"
                        ng-class="{'selected-row': row.selected}">

                        <td>{{row.VendorCSInfoID || row.VendorCSRecmID}}</td>
                        <td>{{row.VendorQutnNo}}</td>
                        <td>{{row.VendorName}}</td>
                        <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>

                        <!-- Nego Qty: input in edit, plain text in view -->
                        <td>
                            <span ng-show="pageMode==='view'">{{row.NegoQty | number:2}}</span>
                            <input ng-show="pageMode==='edit'"
                                   class="form-control" style="width:80px;height:18px;font-size:10px;"
                                   type="text" ng-model="row.NegoQty"
                                   ng-blur="checkUnitPriceEdit(row)" />
                        </td>

                        <td>{{row.ReqUnit || row.QutnUnit}}</td>

                        <!-- Propose Price: input in edit, plain text in view -->
                        <td>
                            <span ng-show="pageMode==='view'">{{row.NegoPrice | number:2}}</span>
                            <input ng-show="pageMode==='edit'"
                                   class="form-control" style="width:80px;height:18px;font-size:10px;"
                                   type="text" ng-model="row.NegoPrice"
                                   ng-blur="checkUnitPriceEdit(row)" />
                        </td>

                        <!-- VAT % — readonly always, comes from quotation -->
                        <td style="text-align:right;">{{row.VatPerc | number:2}}</td>

                        <!-- Nego Vat Amt — computed, always readonly -->
                        <td style="text-align:right;">{{row.NegoVatAmt | number:2}}</td>

                        <!-- Propose Total (NegoTolAmt) -->
                        <td style="text-align:right;">{{row.NegoTolAmt | number:3}}</td>

                        <!-- Original Total -->
                        <td style="text-align:right;">{{row.TolAmt | number:3}}</td>

                        <td>{{row.DeliveryDate}}</td>

                        <!-- Action checkbox — edit mode only -->
                        <td ng-show="pageMode==='edit'" style="text-align:center;font-weight:bold;">
                            <button type="button" ng-click="toggleVendorSelectionEdit(row)" title="Select / Deselect">
                                <i ng-show="!row.selected" class="fa fa-square-o"></i>
                                <i ng-show="row.selected" class="fa fa-check-square-o"></i>
                            </button>
                        </td>

                        <!-- View PDF button — always visible -->
                        <td style="text-align:center;">
                            <button  ng-hide="!row.DocumentID"  ng-click="ViewDocumentFromList(row)" class="btn button-custom" title="View quotation PDF">
                                <i class="fa fa-eye" style="width:11px;"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <br />

        <!-- CS form fields (view / edit) -->
        <div class="row">
            <!-- Row 1: CS Date + CS No -->
            <div class="row">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>CS Date:</label></div>
                <div class="col-lg-3">
                    <input ng-show="pageMode==='view'" type="text" class="form-control"
                           ng-model="VendorCSInfo.CSRecDate" ng-readonly="true" style="background:#fff;" />
                    <input ng-show="pageMode==='edit'" id="CSRecDate" name="CSRecDate" type="text"
                           class="DatePicker form-control" placeholder="DD/MM/YYYY"
                           ng-model="VendorCSInfo.CSRecDate" />
                </div>
                <div class="col-lg-2"><label>CS No:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control" ng-model="VendorCSInfo.AutoCSNo" ng-readonly="true" style="background:#fff;" />
                </div>
            </div>

            <!-- Row 2: CS Recm Vendor -->
            <div class="row">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>CS Recm. Vendor:</label></div>
                <div class="col-lg-3" ng-readonly="true">
                    <input type="text" class="form-control" ng-model="VendorCSInfo.VendorCsRecmName"  placeholder="CS Recm. Vendor"
                           ng-readonly="true" style="background:#fff;" />
                </div>
             <div class="col-lg-1"  ng-show="pageMode==='edit'">
              <button type="button" ng-click="ShowVendorList()"
                      style="position:absolute;right:1px;top:50%;transform:translateY(-0%) translateX(-83px);padding:4px 10px;border:2px solid black;background:transparent;">
                  <i class="fa fa-search"></i>
              </button>
             </div>

            </div>

            <!-- Row 3: Operation + Note -->
            <div class="row">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Operation:</label></div>
                <div class="col-lg-3">
                    <span ng-show="pageMode==='view'" class="form-control" style="background:#fff;">
                        {{
                            VendorCSInfo.Operation === 'Rec' ? 'Recommended' :
                            VendorCSInfo.Operation === 'PRP' ? 'Preparation' :
                            VendorCSInfo.Operation === 'Bck' ? 'Back' :
                            VendorCSInfo.Operation === 'Pst' ? 'Postponed' :
                            VendorCSInfo.Operation === 'Can' ? 'Cancel' :
                            VendorCSInfo.Operation
                        }}
                    </span>
                    <select ng-show="pageMode==='edit'" data-ng-model="VendorCSInfo.Operation" class="form-control">
                        <option value="">-- None --</option>
                        <option value="Rec">Recommended</option>
                        <option value="PRP">Preparation</option>
                        <option value="Bck">Back</option>
                        <option value="Pst">Postponed</option>
                        <option value="Can">Cancel</option>
                    </select>
                </div>
                <div class="col-lg-2"><label>Note:</label></div>
                <div class="col-lg-3">
                    <input ng-show="pageMode==='view'" type="text" class="form-control"
                           ng-model="VendorCSInfo.Remarks" ng-readonly="true" style="background:#fff;" />
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           ng-model="VendorCSInfo.Remarks" placeholder="Note for CS" />
                </div>
            </div>
        </div>

        <br />

        <!-- Terms table -->
        <table st-table="ReqTermGridDisplayCollection" st-safe-src="ReqTermDataSetupGridData"
               class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
            <thead>
                <tr style="font-size:15px;">
                    <th colspan="4" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                        Terms & Conditions
                    </th>
                </tr>
                <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                    <th>Vendor Name</th>
                    <th>Terms Code</th>
                    <th>Terms & Conditions</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in ReqTermGridDisplayCollection" ng-cloak style="font-size:12px;">
                    <td style="width:35%;">{{row.VendorName}}</td>
                    <td style="width:5%;">{{row.TermsCode}}</td>
                    <td style="width:60%;">{{row.TermsName}}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         MODALS
         ══════════════════════════════════════════════════════════════════ -->
    <!-- CS Recm Vendor picker -->
    <div id="VendorInfoModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div style="text-align:right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color:#fff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive">
                    <table st-table="MatWiseVendorListCollection1" st-safe-src="MatWiseVendorList1"
                           class="tableVen table-condensed table-bordered table-hover pnlView" style="width:100%;">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="14" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Select CS Recommended Vendor — Item : {{VendorCSInfo.ServiceItemName}}
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>Quotation No</th>
                                <th>Vendor Name</th>
                                <th>ProposeQty</th>
                                <th>Nego Qty</th>
                                <th>Unit</th>
                                <th>QutnPrice</th>
                                <th>Propose Price</th>
                                <th>Vat %</th>
                                <th>Vat Amnt</th>
                                <th>Propose Vat Amnt</th>
                                <th>Total Price</th>
                                <th>Propose Total Price</th>
                                <th>Delivery Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in MatWiseVendorListCollection1">
                                <td>{{row.VendorQutnNo}}</td>
                                <td>{{row.VendorName}}</td>
                                <td>{{row.QutnQnty | number:2}}</td>
                                <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoQty" ng-blur="checkUnitPrice(row)" /></td>
                                <td>{{row.ReqUnit}}</td>
                                <td>{{row.QutnPrice | number:2}}</td>
                                <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoPrice" ng-blur="checkUnitPrice(row)" /></td>
                                <td>{{row.VatPerc | number:2}}</td>
                                <td>{{row.VatAmt | number:2}}</td>
                                <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoVatAmt" ng-readonly="true" /></td>
                                <td>{{row.TolAmt | number:3}}</td>
                                <td><input class="form-control" style="width:100%;height:18px;font-size:10px" type="text" ng-model="row.NegoTolAmt" ng-readonly="true" /></td>
                                <td>{{row.DeliveryDate}}</td>
                                <td>
                                    <button type="button" ng-click="selectCSRecVendor(row)" data-dismiss="modal">Select</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Search CS Modal — now has View and Edit buttons -->
    <div id="SearchModal" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div style="text-align:right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color:#fff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="table-responsive" ng-cloak>
                    <table st-table="SearchCSListCollection" st-safe-src="SearchCSList"
                           style="width:100%" class="tableVen table-condensed table-bordered table-hover pnlView">
                        <thead>
                            <tr style="font-size:15px;">
                                <th colspan="12" style="text-align:left;color:black;font-weight:100;font-family:math;background:#fff;border:1px solid #3003eb">
                                    Comparative Statement List
                                </th>
                            </tr>
                            <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                                <th>#</th>
                                <th>CS Number</th>
                                <th>Vendor Requisition Number</th>
                                <th>Service Code</th>
                                <th>Service Name</th>
                                <th>CS Date</th>
                                <th>Recm. Vendor</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in SearchCSListCollection">
                                <td>{{$index+1}}</td>
                                <td>{{row.VendorCSNumber}}</td>
                                <td>{{row.VendorRequisitionNumber}}</td>
                                <td>{{row.ServiceItemID}}</td>
                                <td>{{row.ServiceItemName}}</td>
                                <td>{{row.CSRecDate}}</td>
                                <td>{{row.VendorCSRecmName}}</td>
                                <td>
                                    <!-- FIX: separate View and Edit actions -->
                                    <a class="btn btn-sm btn-flat btn-primary" ng-click="loadExistingCS(row, 'view')">
                                        <i class="fa fa-eye"></i> View
                                    </a>
                                    <a class="btn btn-sm btn-flat btn-warning" ng-hide="row.ProcessStatus == 1" ng-click="loadExistingCS(row, 'edit')" style="margin-left:3px;">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr><td colspan="8" class="text-center"><div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div></td></tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- PDF Viewer Modal -->
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body" style="padding:0;margin:0;">
                    <iframe id="pdfViewer" style="width:100%;height:100vh;border:none;" title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    /* ── Date picker setup ──────────────────────────────────────── */
    $('.DatePicker').datepicker({ format: "dd/mm/yyyy", autoclose: true });

    $('#CSRecDate1').datepicker().on('changeDate', function (ev) {
        var val = $('#CSRecDate1').val();
        var parts = val.split('/');
        var entered = new Date(parts[2], parts[1] - 1, parts[0]);
        if (entered > new Date()) {
            $('#CSRecDate1').val('');
            toastr.error("Date should not be greater than system date.");
        }
        $('.datepicker').hide();
    });

    $(document).ready(function () {
        var t = new Date();
        var f = String(t.getDate()).padStart(2, '0') + '/' +
            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
        $('#CSRecDate1').val(f);
    });

    /* ══════════════════════════════════════════════════════════════
       Angular Controller
       ══════════════════════════════════════════════════════════════ */
    app.controller('VendorCSInfoCtrl', ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {

        /* ── State ───────────────────────────────────────────────── */
        $scope.vendorCSItemArray = [];
        $scope.vendorCSTermArray = [];
        $scope.itemsByPage = 10;
        $scope.p = 2;          // 2 = new/select mode, 1 = view/edit mode
        $scope.pageMode = 'new';      // 'new' | 'view' | 'edit'
        $scope.loading = false;

        $scope.masterDataSetupGridData = [];
        $scope.GridDisplayCollection = [];
        $scope.isRowSelected = false;
        $scope.isMaterialRowSelected = false;
        $scope.selectedVendors = [];
        $scope.ReqTermDataSetupGridData = [];
        $scope.ReqTermGridDisplayCollection = [];
        $scope.VendorCSList = [];
        $scope.VendorCSListCollection = [];

        /* ── VendorCSInfo model ──────────────────────────────────── */
        $scope.VendorCSInfo = {
            VendorCSRecmID: "", AutoCSNo: "", CSRecDate: "", Operation: "", Remarks: "",
            VendorCsRecmName: "", CSRecmVendorID: "",
            ServiceItemID: "", ServiceItemName: "", ServiceCategoryID: "",
            ClientReqID: "", ClientID: "", ClientName: "",
            VendorReqID: "", ClientReqNo: "",
            Description: "", DeliveryLocation: "", DeliveryDate: "", DeliveryMode: "",
            RptQutnQty: "", RptQutnUnit: "", VenReqItem: "", RequisitionDate: ""
        };

        /* ── Initial load ────────────────────────────────────────── */
        $scope.loading = true;
        $http.post('/VendorCSInfo/GetAllRequisition')
            .success(function (r) {
                $scope.GridDisplayCollection = [].concat(r.InvitationList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });

        /* ── Helper: reset everything to new-CS state ────────────── */
        $scope.startNewCS = function () {
            $scope.p = 2;
            $scope.pageMode = 'new';
            $scope.isRowSelected = false;
            $scope.isMaterialRowSelected = false;
            $scope.selectedVendors = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.VendorCSList = [];
            $scope.VendorCSListCollection = [];
            $scope.VendorCSInfo = {
                VendorCSRecmID: "", AutoCSNo: "", CSRecDate: "", Operation: "", Remarks: "",
                VendorCsRecmName: "", CSRecmVendorID: "",
                ServiceItemID: "", ServiceItemName: "", ServiceCategoryID: "",
                ClientReqID: "", ClientID: "", ClientName: "",
                VendorReqID: "", ClientReqNo: "",
                Description: "", DeliveryLocation: "", DeliveryDate: "", DeliveryMode: "",
                RptQutnQty: "", RptQutnUnit: "", VenReqItem: "", RequisitionDate: ""
            };
            // Reload requisition list
            $http.post('/VendorCSInfo/GetAllRequisition')
                .success(function (r) { $scope.GridDisplayCollection = [].concat(r.InvitationList); });
        };

        $scope.switchToEdit = function () {
            $scope.pageMode = 'edit';
        };

        /* ── Requisition selection (new mode) ───────────────────── */
        $scope.selectedRow = null;
        $scope.selectInvitation = function (row) {
            if ($scope.selectedRow === row) {
                row.selected = false;
                $scope.selectedRow = null;
                $scope.isRowSelected = false;
                $scope.isMaterialRowSelected = false;
            } else {
                if ($scope.selectedRow) $scope.selectedRow.selected = false;
                row.selected = true;
                $scope.selectedRow = row;
                $scope.isRowSelected = true;
                $scope.isMaterialRowSelected = false;

                $scope.VendorCSInfo.VendorReqID = row.VendorRequisitionNumber;
                $scope.VendorCSInfo.ClientReqNo = row.ClientRequisitionNumber;
                $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
                $scope.VendorCSInfo.ClientID = row.ClientID;
                $scope.VendorCSInfo.ClientName = row.ClientName;
                $scope.VendorCSInfo.RequisitionDate = row.RequisitionDate;
                $scope.VendorCSInfo.VenReqItem = row.Remarks;

                $scope.loading = true;
                $http.post('/VendorCSInfo/GetMaterialByRequisition', { VendorRequisitionNumber: row.VendorRequisitionNumber })
                    .success(function (r) {
                        $scope.ReqWiseMaterialList = r.ReqWiseMaterialList;
                        $scope.ReqWiseMaterialListCollection = [].concat($scope.ReqWiseMaterialList);
                        $scope.loading = false;
                    }).error(function () { $scope.loading = false; });
            }
        };

        /* ── Material/Item selection ─────────────────────────────── */
        $scope.selectedMaterialRow = null;
        $scope.selectMaterial = function (row) {
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];
            $scope.VendorCSInfo.VendorCsRecmName = "";
            $scope.VendorCSInfo.CSRecmVendorID = "";
            $scope.VendorCSInfo.Operation = "";
            $scope.VendorCSInfo.Remarks = "";
            $scope.selectedVendors = [];

            if ($scope.selectedMaterialRow === row) {
                row.selected = false;
                $scope.selectedMaterialRow = null;
                $scope.isMaterialRowSelected = false;
            } else {
                if ($scope.selectedMaterialRow) $scope.selectedMaterialRow.selected = false;
                row.selected = true;
                $scope.selectedMaterialRow = row;
                $scope.isMaterialRowSelected = true;

                $scope.VendorCSInfo.ServiceItemID = row.ServiceItemID;
                $scope.VendorCSInfo.ServiceItemName = row.ServiceItemName;
                $scope.VendorCSInfo.ServiceCategoryID = row.ServiceCategoryID;
                $scope.VendorCSInfo.Description = row.Description;
                $scope.VendorCSInfo.DeliveryDate = row.DeliveryDate;
                $scope.VendorCSInfo.DeliveryLocation = row.DeliveryLocation;
                $scope.VendorCSInfo.DeliveryMode = row.DeliveryMode;

                $scope.loading = true;
                $http.post('/VendorCSInfo/GetVendorByMaterial', { VendorReqID: row.VendorReqID, ServiceItemID: row.ServiceItemID })
                    .success(function (r) {
                        $scope.MatWiseVendorList = r.MatWiseVendorList;
                        $scope.MatWiseVendorListCollection = [].concat($scope.MatWiseVendorList);
                        $scope.loading = false;
                    }).error(function () { $scope.loading = false; });
            }
        };

        /* ── Vendor selection (checkbox in vendor table) ─────────── */
        $scope.selectVendor = function (row) {

            $scope.VendorCSInfo.VendorCsRecmName = null;
            $scope.VendorCSInfo.CSRecmVendorID = null;



            var id = row.VendorQutnID;
            var idx = $scope.selectedVendors.findIndex(function (v) { return v.VendorQutnID === id; });

            if (idx !== -1) {
                row.selected = false;
                $scope.selectedVendors = $scope.selectedVendors.filter(function (v) { return v.VendorQutnID !== id; });
                $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) { return t.VendorQutnID !== id; });
                $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                return;
            }

            row.selected = true;
            var item = {
                ServiceCategoryID: row.ServiceCategoryID, ServiceCategoryName: row.ServiceCategoryName,
                ServiceItemID: row.ServiceItemID, ServiceItemName: row.ServiceItemName,
                Description: row.Description, DeliveryLocation: row.DeliveryLocation,
                DeliveryDate: row.DeliveryDate, DeliveryMode: row.DeliveryMode,
                ReqQnty: row.ReqQnty, ReqUnit: row.ReqUnit,
                VendorQutnNo: row.VendorQutnNo, VendorQutnID: row.VendorQutnID,
                VendorID: row.VendorID, VendorName: row.VendorName,
                QutnQnty: row.QutnQnty, NegoQty: row.NegoQty,
                QutnPrice: row.QutnPrice, NegoPrice: row.NegoPrice,
                QutnUnit: row.QutnUnit, QutnAmt: row.QutnAmt, NegoAmt: row.NegoAmt,
                VatPerc: row.VatPerc, VatAmt: row.VatAmt, NegoVatAmt: row.NegoVatAmt,
                TolAmt: row.TolAmt, NegoTolAmt: row.NegoTolAmt
            };

            if (!$scope.selectedVendors.some(function (v) { return v.VendorQutnID === id; })) {
                $scope.selectedVendors.push(item);
            }

            $http.post('/VendorCSInfo/GetVendorCSInfoTermList', { VendorQutnID: id })
                .success(function (r) {
                    var stillSelected = $scope.selectedVendors.some(function (v) { return v.VendorQutnID === id; });
                    if (!stillSelected) return;
                    $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.filter(function (t) { return t.VendorQutnID !== id; });
                    $scope.ReqTermDataSetupGridData = $scope.ReqTermDataSetupGridData.concat(r.VendorCSInfoTermList);
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                });
        };

        /* ── CS Recm Vendor popup ────────────────────────────────── */
        $scope.ShowVendorList = function () {
            if ($scope.selectedVendors.length <= 0) {
                toastr.error("Please check a vendor first");
                return;
            }
            $scope.MatWiseVendorList1 = [].concat($scope.selectedVendors);
            $scope.MatWiseVendorListCollection1 = [].concat($scope.selectedVendors);
            $('#VendorInfoModal').modal('show');
        };

        $scope.selectCSRecVendor = function (row) {
            $scope.VendorCSInfo.CSRecmVendorID = row.VendorID;
            $scope.VendorCSInfo.VendorCsRecmName = row.VendorName;
            $scope.VendorCSInfo.RptQutnQty = row.QutnQnty;
            $scope.VendorCSInfo.RptQutnUnit = row.ReqUnit;
        };

        /* ── Search CS (opens modal) ─────────────────────────────── */
        $scope.SearchCS = function () {
            $scope.loading = true;
            $http.post('/VendorCSInfo/SearchCS')
                .success(function (r) {
                    $scope.SearchCSList = r.SearchCSList;
                    $scope.SearchCSListCollection = [].concat($scope.SearchCSList);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#SearchModal').modal('show');
        };

        /* ── FIX: Load existing CS for view OR edit ──────────────── */
        $scope.loadExistingCS = function (row, mode) {
            $('#SearchModal').modal('hide');
            $scope.loading = true;
            $scope.pageMode = mode;   // 'view' or 'edit'
            $scope.p = 1;

            // Populate header
            $scope.VendorCSInfo.VendorCSRecmID = row.VendorCSNumber;
            $scope.VendorCSInfo.AutoCSNo = row.VendorCSNumber;
            $scope.VendorCSInfo.CSRecDate = row.CSRecDate;
            $scope.VendorCSInfo.ServiceItemID = row.ServiceItemID;
            $scope.VendorCSInfo.ServiceItemName = row.ServiceItemName;
            $scope.VendorCSInfo.VendorCsRecmName = row.VendorCSRecmName;
            $scope.VendorCSInfo.CSRecmVendorID = row.CSRecmVendorID;
            $scope.VendorCSInfo.Operation = row.Operation;
            $scope.VendorCSInfo.Remarks = row.Remarks;
            $scope.CSMaterial_Name = row.ServiceItemName;
            $scope.VendorCSInfo.ClientName = row.ClientName;


            // Load ALL vendors (selected + unselected) via fixed OBS_CSVendor SP
            $http.post('/VendorCSInfo/CSVendor', { CSNumber: row.VendorCSNumber })
                .success(function (r) {
                    $scope.VendorCSList = r.VendorCSList;

                    // Pre-mark each row so the checkbox icon renders correctly
                    $scope.VendorCSList.forEach(function (v) {
                        v.selected = (v.IsSelected === true || v.IsSelected === 1);
                    });

                    $scope.VendorCSListCollection = [].concat($scope.VendorCSList);

                    // In edit mode, pre-populate selectedVendors with the already-saved rows
                    if (mode === 'edit') {
                        $scope.VendorCSInfo.ServiceCategoryID = $scope.VendorCSList[0].ServiceCategoryID;
                        $scope.VendorCSInfo.Description = $scope.VendorCSList[0].Description;
                        $scope.VendorCSInfo.DeliveryDate = $scope.VendorCSList[0].DeliveryDate;
                        $scope.VendorCSInfo.DeliveryLocation = $scope.VendorCSList[0].DeliveryLocation;
                        $scope.VendorCSInfo.DeliveryMode = $scope.VendorCSList[0].DeliveryMode;

                        $scope.selectedVendors = $scope.VendorCSList.filter(function (v) {
                            return v.selected;
                        });
                    }

                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            // Load terms
            $http.post('/VendorCSInfo/CSVendorTerms', { CSNumber: row.VendorCSNumber })
                .success(function (r) {
                    $scope.ReqTermDataSetupGridData = r.VendorCSInfoTermList;
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                }).error(function () { });
        };


        /* ── Keep old toggleCSSelect for backwards compat ───────── */
        $scope.toggleCSSelect = function (row) {
            $scope.loadExistingCS(row, 'view');
        };


        // Used by the Action checkbox in the edit-mode vendor table.
        $scope.toggleVendorSelectionEdit = function (row) {
            row.selected = !row.selected;
            $scope.VendorCSInfo.VendorCsRecmName = null;
            $scope.VendorCSInfo.CSRecmVendorID = null;


            if (row.selected) {
                // Add to selectedVendors if not already there
                var exists = $scope.selectedVendors.some(function (v) {
                    return v.VendorQutnID === row.VendorQutnID;
                });
                if (!exists) {
                    $scope.selectedVendors.push(row);
                }
            } else {
                // Remove from selectedVendors
                $scope.selectedVendors = $scope.selectedVendors.filter(function (v) {
                    return v.VendorQutnID !== row.VendorQutnID;
                });
            }
        };



        $scope.checkUnitPriceEdit = function (row) {
            if (!row.NegoQty || row.NegoQty <= 0) { toastr.error("Quantity cannot be zero or negative!"); row.NegoQty = row.QutnQnty; }
            if (!row.NegoPrice || row.NegoPrice <= 0) { toastr.error("Price cannot be zero or negative!"); row.NegoPrice = row.QutnPrice; }

            row.NegoAmt = parseFloat(row.NegoQty) * parseFloat(row.NegoPrice);
            row.NegoVatAmt = (parseFloat(row.VatPerc) * row.NegoAmt) / 100;
            row.NegoTolAmt = row.NegoAmt + row.NegoVatAmt;

            // Keep selectedVendors in sync
            var match = $scope.selectedVendors.find(function (v) {
                return v.VendorQutnID === row.VendorQutnID;
            });
            if (match) {
                match.NegoQty = row.NegoQty;
                match.NegoPrice = row.NegoPrice;
                match.NegoAmt = row.NegoAmt;
                match.NegoVatAmt = row.NegoVatAmt;
                match.NegoTolAmt = row.NegoTolAmt;
            }
        };

        /* ── Save / Update ───────────────────────────────────────── */
        $scope.Post = function () {
            if ($scope.pageMode === 'new') {
                if ($scope.selectedVendors.length <= 0) { toastr.error("Please select at least one vendor"); return; }
                if (!$scope.VendorCSInfo.VendorCsRecmName) { toastr.error("CS Recm. Vendor is Required"); return; }
                var csDate = $('#CSRecDate1').val();
                if (!csDate) { toastr.error("CS Date Required"); return; }
                $scope.VendorCSInfo.CSRecDate = csDate;
                if (!$scope.VendorCSInfo.Operation) { toastr.error("Please select an Operation"); return; }

            } else if ($scope.pageMode === 'edit') {
                if ($scope.selectedVendors.length <= 0) { toastr.error("Please select at least one vendor"); return; }
                if (!$scope.VendorCSInfo.VendorCsRecmName) { toastr.error("CS Recm. Vendor is Required"); return; }
                var csDateEdit = $('#CSRecDate').val() || $scope.VendorCSInfo.CSRecDate;
                if (!csDateEdit) { toastr.error("CS Date Required"); return; }
                $scope.VendorCSInfo.CSRecDate = csDateEdit;
                if (!$scope.VendorCSInfo.Operation) { toastr.error("Please select an Operation"); return; }

                // In edit mode selectedVendors holds the currently-ticked rows
                if ($scope.selectedVendors.length <= 0) { toastr.error("Please select at least one vendor"); return; }
            }

            $scope.loading = true;
            $http.post('/VendorCSInfo/SaveVendorCSInfo', {
                vendorCS: $scope.VendorCSInfo,
                vendorCSItem: $scope.selectedVendors,          // only ticked rows
                vendorCSTerm: $scope.ReqTermGridDisplayCollection
            })
                .success(function (r) {
                    $scope.loading = false;
                    if (r.status === 'S201') { toastr.success("Data Saved Successfully."); $scope.toggleRefreshTable(); }
                    else if (r.status === 'S202') { toastr.success("Data Updated Successfully."); $scope.toggleRefreshTable(); }
                    else { toastr.error("Save Failed. Status: " + r.status); }
                })
                .error(function () { $scope.loading = false; toastr.error("Data Save Failed."); });
        };

        /* ── Nego calculations ───────────────────────────────────── */
        $scope.checkUnitPrice = function (row) {
            if (!row.NegoQty || row.NegoQty <= 0) {
                toastr.error("Quantity cannot be zero or negative!");
                row.NegoQty = 1;
            }
            if (!row.NegoPrice || row.NegoPrice <= 0) {
                toastr.error("Price cannot be zero or negative!");
                row.NegoPrice = 1;
            }
            row.NegoAmt = parseFloat(row.NegoQty) * parseFloat(row.NegoPrice);
            row.NegoVatAmt = (row.VatPerc * row.NegoAmt) / 100;
            row.NegoTolAmt = row.NegoAmt + row.NegoVatAmt;

            // Sync into selectedVendors (new mode) or VendorCSListCollection (edit mode)
            var arr = ($scope.pageMode === 'edit') ? $scope.VendorCSListCollection : $scope.selectedVendors;
            var match = arr.find(function (v) {
                return v.VendorID === row.VendorID && v.ServiceItemID === row.ServiceItemID;
            });
            if (match) {
                match.NegoQty = row.NegoQty;
                match.NegoPrice = row.NegoPrice;
                match.NegoAmt = row.NegoAmt;
                match.NegoVatAmt = row.NegoVatAmt;
                match.NegoTolAmt = row.NegoTolAmt;
            }
        };

        /* ── Row style ───────────────────────────────────────────── */
        $scope.getRowStyle = function (row) {
            return row.selected ? { background: '#8bf5d2' } : {};
        };
        /* ── View PDF ────────────────────────────────────────────── */
