@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>

    [ng-cloak] {
        display: none !important;
    }
    .mode-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 10px;
        vertical-align: middle;
    }

    .mode-list {
        background: #d9edf7;
        color: #31708f;
        border: 1px solid #bce8f1;
    }

    .mode-view {
        background: #dff0d8;
        color: #3c763d;
        border: 1px solid #d6e9c6;
    }

    .mode-edit {
        background: #fcf8e3;
        color: #8a6d3b;
        border: 1px solid #faebcc;
    }

    .input-readonly {
        background-color: #ffffff !important;
        cursor: default;
    }

    .po-info-box {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px 14px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .po-info-box strong {
            color: #31708f;
        }

    .status-pending {
        color: #8a6d3b;
        background: #fcf8e3;
        border: 1px solid #faebcc;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }

    .status-done {
        color: #3c763d;
        background: #dff0d8;
        border: 1px solid #d6e9c6;
        border-radius: 3px;
        padding: 1px 7px;
        font-size: 11px;
    }
</style>

<div class="box box-primary box-body" ng-controller="PoRecomCtrl">

    <!-- TOOLBAR -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;border-radius:5px;">
        <h2 class="box-title" style="font-family:math;font-weight:500;">
            Purchase Order Recommendation
            <span ng-show="p===2" class="mode-badge mode-list">PO LIST</span>
            <span ng-show="p===1 && pageMode==='view'" class="mode-badge mode-view">VIEW</span>
            <span ng-show="p===1 && pageMode==='edit'" class="mode-badge mode-edit">EDIT</span>
        </h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">

                <div class="btn-group pull-right" style="margin-left:4px;">
                    <button class="button-custom btn-warning" type="button"
                            ng-click="toggleRefreshTable()" ng-disabled="isRefreshing">
                        <i class="fa fa-refresh" ng-class="{'fa-spin':isRefreshing}"
                           style="padding-right:5px"></i> Refresh
                    </button>
                </div>

                <!-- Save/Update: hidden in view mode -->
                <div class="btn-group pull-right" style="margin-left:4px;"
                     ng-show="p===1 && pageMode!=='view'">
                    <button class="button-custom btn-success" type="button"
                            ng-click="Post()" ng-disabled="isSaving">
                        <i class="fa fa-save" style="padding-right:5px"></i>
                        {{ pageMode==='edit' ? 'Recommend' : 'Save' }}
                    </button>
                </div>

                <!-- Edit button: only in view mode -->
                @*<div class="btn-group pull-right" style="margin-left:4px;"
                         ng-show="p===1 && pageMode==='view'">
                        <button class="button-custom btn-warning" type="button"
                                ng-click="switchToEdit()">
                            <i class="fa fa-edit" style="padding-right:5px"></i> Edit
                        </button>
                    </div>*@

                <!-- Back -->
                <div class="btn-group pull-right" style="margin-left:4px;" ng-show="p===1">
                    <button class="button-custom btn-primary" type="button"
                            ng-click="goBackToList()">
                        <i class="fa fa-arrow-left" style="padding-right:5px"></i> Back
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ p===2 : PO LIST ══════════════ -->
    <div ng-show="p===2">
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888;padding:5px 10px;">

            <div ng-show="CSClientDisplayedCollection.length<=0"
                 style="text-align:center;padding:20px;">
                <h4 style="color:red;">No PO available for recommendation!</h4>
            </div>

            <div ng-show="CSClientDisplayedCollection.length>0"
                 class="row" style="padding:11px;margin-right:15px;margin-left:15px;">

                <div style="background-color:#cbd4d9;padding:0.7%;border-radius:4px;
                            font-size:15px;font-weight:bold;margin-bottom:6px;">
                    Purchase Order List
                </div>

                <table st-table="CSClientDisplayedCollection" st-safe-src="CSClientList"
                       style="width:100%;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Client Name</th>
                            <th>Requisition No</th>
                            <th>Project Name</th>
                            <th>PO Date</th>
                            <th>Vendor Name</th>
                            <th>Recom Status</th>
                            <th>Action</th>
                        </tr>

                        <!-- Individual Column Search -->
                        <tr>
                            <th>
                                <input type="text" st-search="ClientName"
                                       placeholder="Search Client"
                                       class="form-control input-sm" />
                            </th>
                            <th>
                                <input type="text" st-search="ClientReqNo"
                                       placeholder="Search Req No"
                                       class="form-control input-sm" />
                            </th>
                            <th>
                                <input type="text" st-search="ProjectName"
                                       placeholder="Search Project"
                                       class="form-control input-sm" />
                            </th>
                            <th>
                                <input type="text" st-search="RequisitionDate"
                                       placeholder="Search PO Date"
                                       class="form-control input-sm" />
                            </th>
                            <th>
                                <input type="text" st-search="VendorName"
                                       placeholder="Search Vendor"
                                       class="form-control input-sm" />
                            </th>
                            <th>
                                <select class="form-control input-sm"
                                        ng-model="poStatusFilter"
                                        ng-change="filterPOStatus()">
                                    <option value="">All Status</option>
                                    <option value="Recommended">Recommended</option>
                                    <option value="Pending">Pending</option>
                                </select>
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in CSClientDisplayedCollection"
                            style="height:20px;font-size:13px;">
                            <td class="hidden">{{row.POPreparationID}}</td>
                            <td>{{row.ClientName}}</td>
                            <td>{{row.ClientReqNo}}</td>

                            <td>{{row.ProjectName}}</td>
                            <td class="text-center">{{row.RequisitionDate}}</td>
                            <td class="text-center">{{row.VendorName}}</td>

                            <!-- ← Status badge column -->
                            <td class="text-center">
                                <span ng-show="row.PORecmID" class="status-done">Recommended</span>
                                <span ng-hide="row.PORecmID" class="status-pending">Pending</span>
                            </td>

                            <!-- ← View / Edit buttons like POCreation -->
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-flat btn-primary"
                                        ng-click="openDetail(row, 'view')">
                                    <i class="fa fa-eye"></i> View
                                </button>
                                <!-- Edit hidden when recommendation already exists -->
                                <button type="button"
                                        class="btn btn-sm btn-flat btn-warning"
                                        style="margin-left:3px;"
                                        ng-hide="row.PORecmID"
                                        ng-click="openDetail(row, 'edit')">
                                    <i class="fa fa-edit"></i> Recommend
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage"
                                     st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div><!-- /p===2 -->
    <!-- ══════════════ p===1 : DETAIL VIEW/EDIT ══════════════ -->
    <div ng-show="p===1">

        <!-- PO summary bar -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box">
                    <div class="row">
                        <div class="col-lg-3"><strong>PO No:</strong>&nbsp;{{VendorCSInfo.AutoPoNo}}</div>
                        <div class="col-lg-3"><strong>Client:</strong>&nbsp;{{VendorCSInfo.ClientName}}</div>
                        <div class="col-lg-3"><strong>Vendor:</strong>&nbsp;{{VendorCSInfo.VendorName}}</div>
                        <div class="col-lg-3"><strong>PO Date:</strong>&nbsp;{{VendorCSInfo.CSRecDate}}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- See Workorder Detail against this PO -->
        <div class="row" style="margin:1%;">
            <div class="col-lg-12">
                <div class="po-info-box" style="background:#e8f4f8; border-color:#5bc0de;">
                    <div class="row">
                        <div class="col-lg-9" style="padding-top:6px;">
                            <strong style="color:#31708f;">
                                <i class="fa fa-file-text-o"></i> See Workorder Detail against this PO
                            </strong>
                            @*<span style="margin-left:12px; font-size:12px; color:#555;">
                                ClientReqNo: {{VendorCSInfo.ClientReqNo || '—'}} |
                                ClientID: {{VendorCSInfo.ClientID || '—'}}
                            </span>*@
                        </div>
                        <div class="col-lg-3 text-right">
                            <button type="button"
                                    class="btn btn-sm btn-info"
                                    ng-click="openWorkorderDetail()"
                                    ng-disabled="!VendorCSInfo.ClientReqID">
                                <i class="fa fa-search"></i> View Workorder
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Item grid (always readonly in recom page) -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;box-shadow:2px 2px 5px #888;
                                padding:5px 10px;overflow-x:auto;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="VenCSItemGridDisplayCollection" st-safe-src="VenCSItemList"
                       style="width:100%;font-size:12px;"
                       class="table table-condensed table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th colspan="14" style="text-align:left;color:black;font-weight:100;
                                                    font-family:math;background:#fff;border:1px solid #3003eb;">
                                Item List
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th>Item Name</th>
                            <th>Description</th>
                            <th style="text-align:left;">Service Category</th>
                            <th>Unit</th>

                            <th style="text-align:right;">PO Qnty</th>
                            <th style="text-align:right;">PO Unit/Price</th>
                            <th style="text-align:right;">PO Amt</th>
                            @*<th style="text-align:right;">POQnty</th>*@
                            @*<th style="text-align:right;">PoPrice</th>*@
                            @*<th style="text-align:right;">PoAmt</th>*@
                            <th style="text-align:right;">Vat%</th>
                            <th style="text-align:right;">VatAmt</th>
                            <th style="text-align:right;">PO Total Amt</th>
                            @*<th style="text-align:right;">PoVatAmt</th>*@
                            @*<th style="text-align:right;">PoTotalAmt</th>*@

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in VenCSItemGridDisplayCollection"
                            ng-cloak style="font-size:12px;">
                            <td>{{row.ServiceItemName}}</td>
                            <td>{{row.Description}}</td>
                            <td>{{row.ServiceCategoryName}}</td>
                            <td>{{row.QutnUnit}}</td>

                            <td style="text-align:right;">{{row.QutnQnty | number:2}}</td>
                            <td style="text-align:right;">{{row.QutnPrice | number:2}}</td>
                            <td style="text-align:right;">{{row.QutnAmt | number:2}}</td>
                            @*<td style="text-align:right;">{{row.NegoQty | number:2}}</td>*@
                            @*<td style="text-align:right;">{{row.NegoPrice | number:2}}</td>*@
                            @*<td style="text-align:right;">{{row.NegoAmt | number:2}}</td>*@
                            <td style="text-align:right;">{{row.VatPerc | number:2}}</td>
                            <td style="text-align:right;">{{row.VatAmt | number:2}}</td>
                            <td style="text-align:right;">{{row.TolAmt | number:2}}</td>
                            @*<td style="text-align:right;">{{row.NegoVatAmt | number:2}}</td>*@
                            @*<td style="text-align:right;">{{row.NegoTolAmt | number:2}}</td>*@
                        </tr>
                        <tr ng-if="VenCSItemGridDisplayCollection.length===0">
                            <td colspan="12" class="text-center text-danger">No items available</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="12" class="text-center">
                                <div st-pagination="" st-items-by-page="itemsByPage"
                                     st-displayed-pages="10"></div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Recom Form — view vs edit mirrors POCreation pattern -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                                box-shadow:2px 2px 5px #888;padding:10px;">

            <!-- Bill Category + Bill Type -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Bill Category:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Category" ng-readonly="true" />
                </div>
                @*<div class="col-lg-2"><label>Bill Type:</label></div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control input-readonly"
                               ng-model="VendorCSInfo.BillType" ng-readonly="true" />
                    </div>*@
            </div>

            <!-- Installment (conditional) -->
            <div class="row" style="margin-bottom:8px;"
                 ng-show="VendorCSInfo.BillType==='Installment'">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>Installment:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.Installment" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>Installment Amount:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.InstalledAmount" ng-readonly="true" />
                </div>
            </div>

            <!-- PO No + PO Date -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO No:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.AutoPoNo" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>PO Date:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.CSRecDate" ng-readonly="true" />
                </div>
            </div>

            <!-- PO Amount + Recommended Amount -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Preparation Amount:</label></div>
                <div class="col-lg-3">
                    <input type="text" class="form-control input-readonly"
                           ng-model="VendorCSInfo.TolAmt" ng-readonly="true" />
                </div>
                <div class="col-lg-2"><label>Recommended Amount:</label></div>
                <div class="col-lg-3">
                    @*VIEW: readonly*@
                    <input ng-show="pageMode==='view'" type="text"
                           class="form-control input-readonly"
                           ng-model="VendorCSInfo.RecommendedAmount" ng-readonly="true" />
                    @*EDIT: editable*@
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           placeholder="Enter recommended amount"
                           ng-model="VendorCSInfo.RecommendedAmount" />
                </div>
            </div>

            <!-- Recom Date + Note -->
            <div class="row" style="margin-bottom:8px;">
                <div class="col-sm-1"></div>
                <div class="col-lg-2"><label>PO Recom Date:</label></div>
                <div class="col-lg-3">
                    <!-- VIEW -->
                    <input ng-show="pageMode==='view'" type="text"
                           class="form-control input-readonly"
                           ng-model="VendorCSInfo.PORecDate" ng-readonly="true" />
                    <!-- EDIT -->
                    <input ng-show="pageMode==='edit'" id="PORecDate" type="text"
                           class="DatePicker form-control" placeholder="DD/MM/YYYY"
                           ng-model="VendorCSInfo.PORecDate" />
                </div>
                <div class="col-lg-2"><label>Note:</label></div>
                <div class="col-lg-3">
                    <!-- VIEW -->
                    <input ng-show="pageMode==='view'" type="text"
                           class="form-control input-readonly"
                           ng-model="VendorCSInfo.RecomRemarks" ng-readonly="true" />
                    <!-- EDIT -->
                    <input ng-show="pageMode==='edit'" type="text" class="form-control"
                           placeholder="Note for recommendation"
                           ng-model="VendorCSInfo.RecomRemarks" />
                </div>
            </div>
        </div>

        <!-- Terms -->
        <div class="row" style="margin:1%;background-color:#f0f0f0;
                         box-shadow:2px 2px 5px #888;padding:5px 10px;">
            <div class="row" style="padding:11px;margin-right:15px;margin-left:15px;">
                <table st-table="ReqTermGridDisplayCollection"
                       st-safe-src="ReqTermDataSetupGridData"
                       class="table table-condensed table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th colspan="2" style="text-align:left;color:black;font-weight:100;
                                            font-family:math;background:#fff;
                                            border:1px solid #3003eb;">
                                Terms &amp; Conditions
                            </th>
                        </tr>
                        <tr style="background-color:#82b0c9;color:#010823;font-size:11px;">
                            <th style="width:10%;">Terms Code</th>
                            <th style="width:90%;">Terms &amp; Conditions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in ReqTermGridDisplayCollection | orderBy:'TermsCode'"
                            ng-cloak
                            style="font-size:12px;">

                            <td>{{row.TermsCode}}</td>
                            <td>{{row.TermsName}}</td>

                        </tr>

                        <tr ng-if="ReqTermGridDisplayCollection.length===0">
                            <td colspan="2" class="text-center text-muted">
                                No terms available
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /p===1 -->
    <!-- Recommended Amount Warning Modal -->
    <div class="modal fade"
         ng-cloak
         ng-show="showAmountWarning"
         ng-class="{ 'in': showAmountWarning }"
         ng-style="showAmountWarning && {
         'display': 'block',
         'background': 'rgba(0,0,0,0.45)'
     }"
         style="z-index:1050;"
         role="dialog">

        <div class="modal-dialog modal-sm" style="margin-top:150px;">
            <div class="modal-content">

                <div class="modal-header"
                     style="background:#fcf8e3; color:#8a6d3b;">
                    <button type="button" class="close"
                            ng-click="cancelAmountWarning()">
                        &times;
                    </button>
                    <h4 class="modal-title">
                        <i class="fa fa-exclamation-triangle"></i>
                        Amount Warning
                    </h4>
                </div>

                <div class="modal-body">
                    <p>
                        <strong>Warning!</strong> Recommended Amount
                        is different from PO Amount.
                    </p>

                    <p>
                        <strong>PO Amount:</strong>
                        {{VendorCSInfo.TolAmt | number:2}}
                    </p>

                    <p>
                        <strong>Recommended Amount:</strong>
                        {{VendorCSInfo.RecommendedAmount | number:2}}
                    </p>

                    <p>Do you want to continue?</p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-default"
                            ng-click="cancelAmountWarning()">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            ng-click="confirmAmountWarning()"
                            ng-disabled="isSaving">
                        <i class="fa fa-check"></i> Continue
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Workorder Detail Modal -->
    <div class="modal fade"
         ng-cloak
         ng-show="showWoModal"
         ng-class="{ 'in': showWoModal }"
         ng-style="showWoModal && { 'display': 'block', 'background': 'rgba(0,0,0,0.45)' }"
         style="z-index:1060;"
         role="dialog">
        <div class="modal-dialog modal-lg" style="margin-top:60px; width:90%; max-width:1100px;">
            <div class="modal-content">
                <div class="modal-header" style="background:#5bc0de; color:#fff;">
                    <button type="button" class="close" ng-click="closeWorkorderDetail()" style="color:#fff; opacity:0.9;">
                        &times;
                    </button>
                    <h4 class="modal-title">
                        <i class="fa fa-file-text-o"></i> Workorder Detail against this PO
                    </h4>
                </div>
                <div class="modal-body" style="max-height:70vh; overflow-y:auto;">
                    <div ng-if="woLoading" class="text-center" style="padding:30px;">
                        <i class="fa fa-spinner fa-spin fa-2x"></i>
                        <p>Loading workorder...</p>
                    </div>

                    <div ng-if="!woLoading && !WoInfo">
                        <div class="alert alert-warning">No workorder found for this Client Requisition.</div>
                    </div>

                    <div ng-if="!woLoading && WoInfo">
                        <!-- Header info -->
                        <div class="row" style="margin-bottom:12px;">
                            @*<div class="col-md-3"><strong>WO No:</strong> {{WoInfo.AutoWONo || WoInfo.WONo || '—'}}</div>*@
                            <div class="col-md-3"><strong>WO Date:</strong> {{WoInfo.WODate || '—'}}</div>
                            <div class="col-md-3"><strong>WO Amount:</strong> {{WoInfo.WOAmt | number:2}}</div>
                            @*<div class="col-md-3"><strong>Bill Category:</strong> {{WoInfo.BillCategory || '—'}}</div>*@
                        </div>
                        <div class="row" style="margin-bottom:12px;">
                            <div class="col-md-3"><strong>Client Req No:</strong> {{WoInfo.ClientReqNo || '—'}}</div>
                            <div class="col-md-4"><strong>WO submitted by:</strong> {{WoInfo.SetBy || '—'}}</div>
                            @*<div class="col-md-3"><strong>Bill Type:</strong> {{WoInfo.BillType || '—'}}</div>
                            <div class="col-md-3"><strong>Installments:</strong> {{WoInfo.NoOfInstallment || '—'}}</div>
                            <div class="col-md-3"><strong>Installment Amt:</strong> {{WoInfo.InstallmentAmt | number:2}}</div>*@
                        </div>
                        <div class="row" style="margin-bottom:15px;" ng-if="WoInfo.Remarks">
                            <div class="col-md-12"><strong>Project:</strong> {{WoInfo.Remarks}}</div>
                        </div>

                        <!-- Items -->
                        <table class="table table-condensed table-bordered table-striped" style="font-size:12px;">
                            <thead>
                                <tr style="background:#82b0c9; color:#010823;">
                                    <th>Service Item</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th class="text-right">WO Qty</th>
                                    <th class="text-right">WO Price</th>
                                    <th class="text-right">WO Amt</th>
                                    <th class="text-right">ASF %</th>
                                    <th class="text-right">ASF Amt</th>
                                    <th class="text-right">VAT %</th>
                                    <th class="text-right">VAT Amt</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in WoItemList">
                                    <td>{{item.ServiceItemName}}</td>
                                    <td>{{item.ServiceCategoryName}}</td>
                                    <td>{{item.Description}}</td>
                                    <td class="text-right">{{item.WOQnty | number:2}}</td>
                                    <td class="text-right">{{item.WOPrice | number:2}}</td>
                                    <td class="text-right">{{item.WOAmt | number:2}}</td>
                                    <td class="text-right">{{item.ASFPerc | number:2}}</td>
                                    <td class="text-right">{{item.TotGivenASFAmt | number:2}}</td>
                                    <td class="text-right">{{item.VatPerc | number:2}}</td>
                                    <td class="text-right">{{item.VatAmt | number:2}}</td>
                                    <td class="text-right">{{item.TolAmt | number:2}}</td>
                                </tr>
                                <tr ng-if="!WoItemList || WoItemList.length === 0">
                                    <td colspan="11" class="text-center text-muted">No items found</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" ng-click="closeWorkorderDetail()">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" />
                <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">

    app.controller('PoRecomCtrl', ['$scope', '$http', '$timeout',
        function ($scope, $http, $timeout) {

            /* ── State ── */
            $scope.itemsByPage = 10;
            $scope.loading = false;
            $scope.isSaving = false;
            $scope.isRefreshing = false;
            $scope.p = 2;          // 2=list, 1=detail
            $scope.pageMode = 'view';     // 'view' | 'edit'

            /* ── Collections ── */
            $scope.CSClientList = [];
            $scope.CSClientDisplayedCollection = [];
            $scope.VenCSItemList = [];
            $scope.VenCSItemGridDisplayCollection = [];
            $scope.ReqTermDataSetupGridData = [];
            $scope.ReqTermGridDisplayCollection = [];


            $scope.showAmountWarning = false;
            $scope.pendingRecommendationSave = false;

            /* ── Model ── */
            function emptyInfo() {
                return {
                    POPreparationID: "", PORecmID: "",
                    ClientID: "", ClientName: "",
                    ClientReqID: "", VendorID: "", VendorName: "",
                    AutoPoNo: "", CSRecDate: "", PORecDate: "",
                    PoAmount: "", RecommendedAmount: "",
                    TolAmt: "", RecommendedAmount: "",
                    BillType: "", Category: "",
                    Installment: "", InstalledAmount: "",
                    Remarks: "", RecomRemarks: "", SetBy: ""
                };
            }
            $scope.VendorCSInfo = emptyInfo();

            /* ── Initial load ── */
            $scope.loading = true;
            $http.post("/PORecom/GetPoRecomClientInfo/")
                .then(function (res) {
                    $scope.CSClientList = res.data.CSClientList || [];
                    $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load PO list.");
                });

            $scope.poStatusFilter = "";

            $scope.filterPOStatus = function () {
                var status = $scope.poStatusFilter;

                if (status === "Recommended") {
                    $scope.CSClientDisplayedCollection = $scope.CSClientList.filter(
                        function (row) {
                            return !!row.PORecmID;
                        }
                    );
                } else if (status === "Pending") {
                    $scope.CSClientDisplayedCollection = $scope.CSClientList.filter(
                        function (row) {
                            return !row.PORecmID;
                        }
                    );
                } else {
                    $scope.CSClientDisplayedCollection = [].concat($scope.CSClientList);
                }
            };


            /* ── Open detail ── */
            $scope.openDetail = function (row, mode) {
                $scope.loading = true;
                $scope.p = 1;
                $scope.pageMode = mode;   // 'view' or 'edit'
                $scope.VendorCSInfo = emptyInfo();

                // Keys always needed
                $scope.VendorCSInfo.POPreparationID = row.POPreparationID;
                $scope.VendorCSInfo.ClientID = row.ClientID;
                $scope.VendorCSInfo.ClientReqID = row.ClientReqID;
                $scope.VendorCSInfo.VendorID = row.VendorID;
                $scope.VendorCSInfo.ClientName = row.ClientName;
                $scope.VendorCSInfo.VendorName = row.VendorName;

                // If an existing recommendation exists, pre-fill recom fields
                if (row.PORecmID) {
                    $scope.VendorCSInfo.PORecmID = row.PORecmID;
                    $scope.VendorCSInfo.RecommendedAmount = row.RecommendedAmount;
                    $scope.VendorCSInfo.PORecDate = row.PORecDate;
                    $scope.VendorCSInfo.RecomRemarks = row.RecomRemarks;
                }

                // Set today as default recom date only for new recommendation
                $timeout(function () {
                    if (mode === 'edit') {
                        var t = new Date();
                        var tod = String(t.getDate()).padStart(2, '0') + '/' +
                            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
                        var dateVal = $scope.VendorCSInfo.PORecDate || tod;
                        $('#PORecDate').val(dateVal);
                        $scope.VendorCSInfo.PORecDate = dateVal;

                        $('#PORecDate').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                            .off('changeDate.recom')
                            .on('changeDate.recom', function (ev) {
                                $scope.$apply(function () {
                                    $scope.VendorCSInfo.PORecDate = $(ev.target).val();
                                });
                                $('.datepicker').hide();
                            });
                    }
                }, 100);

                // Load items
                $http.post("/PoRecom/GetVendorPORecomQuotationItem", {
                    VendorID: row.VendorID,
                    ClientID: row.ClientID,
                    POPreparationID: row.POPreparationID
                }).then(function (res) {
                    var items = res.data.VenCSItemList || [];
                    if (items.length > 0) {
                        var h = items[0];
                        $scope.VendorCSInfo.AutoPoNo = h.PONo || "";
                        $scope.VendorCSInfo.CSRecDate = h.PODate || "";
                        $scope.VendorCSInfo.TolAmt = h.TolAmt || "";
                        if (!$scope.VendorCSInfo.PORecmID) {
                            $scope.VendorCSInfo.RecommendedAmount = h.TolAmt || "";
                        }
                        $scope.VendorCSInfo.BillType = h.BillType || "";
                        $scope.VendorCSInfo.Category = h.BillCategory || "";
                        $scope.VendorCSInfo.Installment = h.Installment || "";
                        $scope.VendorCSInfo.InstalledAmount = h.InstalledAmount !== undefined
                            ? h.InstalledAmount
                            : (h.InstallmentAmt || "");
                        $scope.VendorCSInfo.Remarks = h.Remarks || "";
                        $scope.VendorCSInfo.VendorName = h.VendorName || row.VendorName;
                    }
                    $scope.VenCSItemList = items.map(mapItem);
                    $scope.VenCSItemGridDisplayCollection = [].concat($scope.VenCSItemList);
                    $scope.loading = false;
                }, function () {
                    $scope.loading = false;
                    toastr.error("Failed to load PO items.");
                });

                // Load terms
                $http.post('/PoRecom/GetPORecomInfoTermList', {
                    POPreparationID: row.POPreparationID
                }).then(function (res) {
                    $scope.ReqTermDataSetupGridData = res.data.VendorCSInfoTermList || [];
                    $scope.ReqTermGridDisplayCollection = [].concat($scope.ReqTermDataSetupGridData);
                }, function () {
                    toastr.error("Failed to load terms.");
                });
            };

            /* ── Switch to edit (from view mode) ── */
            $scope.switchToEdit = function () {
                // Guard: if already recommended, allow edit (SP handles UPDATE via PORecmID)
                $scope.pageMode = 'edit';
                $timeout(function () {
                    var dateVal = $scope.VendorCSInfo.PORecDate;
                    if (!dateVal) {
                        var t = new Date();
                        dateVal = String(t.getDate()).padStart(2, '0') + '/' +
                            String(t.getMonth() + 1).padStart(2, '0') + '/' + t.getFullYear();
                    }
                    $('#PORecDate').val(dateVal);
                    $scope.VendorCSInfo.PORecDate = dateVal;
                    $('#PORecDate').datepicker({ format: 'dd/mm/yyyy', autoclose: true })
                        .off('changeDate.recom')
                        .on('changeDate.recom', function (ev) {
                            $scope.$apply(function () {
                                $scope.VendorCSInfo.PORecDate = $(ev.target).val();
                            });
                            $('.datepicker').hide();
                        });
                }, 100);
            };

            /* ── Back to list ── */
            $scope.goBackToList = function () {
                $scope.p = 2;
                $scope.pageMode = 'view';
                $scope.VendorCSInfo = emptyInfo();
                $scope.VenCSItemList = [];
                $scope.VenCSItemGridDisplayCollection = [];
                $scope.ReqTermDataSetupGridData = [];
                $scope.ReqTermGridDisplayCollection = [];
            };

            /* ── Item mapping ── */
            function mapItem(item) {
                item.NegoTolAmt = parseFloat(item.NegoTolAmt || 0).toFixed(2);
                item.NegoAmt = parseFloat(item.NegoAmt || 0).toFixed(2);
                item.NegoVatAmt = parseFloat(item.NegoVatAmt || 0).toFixed(2);
                item.QutnQnty = parseFloat(item.QutnQnty || 0).toFixed(2);
                item.QutnPrice = parseFloat(item.QutnPrice || 0).toFixed(2);
                item.QutnAmt = parseFloat(item.QutnAmt || 0).toFixed(2);
                return item;
            }

            /* ── Save ── */

            /* Save button */
            $scope.Post = function () {

                if (!$scope.VendorCSInfo.POPreparationID) {
                    toastr.error("No PO selected.");
                    return;
                }

                if ($scope.VendorCSInfo.RecommendedAmount === "" ||
                    $scope.VendorCSInfo.RecommendedAmount === null ||
                    $scope.VendorCSInfo.RecommendedAmount === undefined) {
                    toastr.error("Recommended Amount is required.");
                    return;
                }

                var recomDate = $('#PORecDate').val() ||
                    $scope.VendorCSInfo.PORecDate;

                if (!recomDate) {
                    toastr.error("PO Recom Date is required.");
                    return;
                }

                $scope.VendorCSInfo.PORecDate = recomDate;
                $scope.VendorCSInfo.Remarks = $scope.VendorCSInfo.RecomRemarks;

                // Convert amounts to numbers, handling comma separators
                var poAmount = parseFloat(
                    String($scope.VendorCSInfo.TolAmt || 0).replace(/,/g, '')
                );

                var recommendedAmount = parseFloat(
                    String($scope.VendorCSInfo.RecommendedAmount).replace(/,/g, '')
                );

                // Show warning if Recommended Amount differs from PO Amount
                if (Math.abs(poAmount - recommendedAmount) > 0.000001) {
                    $scope.showAmountWarning = true;
                    $scope.pendingRecommendationSave = true;
                    return;
                }

                // Amounts match: save directly
                saveRecommendation();
            };


            /* Cancel the warning and return to editing */
            $scope.cancelAmountWarning = function () {
                $scope.showAmountWarning = false;
                $scope.pendingRecommendationSave = false;
            };


            /* Confirm and continue saving */
            $scope.confirmAmountWarning = function () {
                if (!$scope.pendingRecommendationSave || $scope.isSaving) {
                    return;
                }

                $scope.showAmountWarning = false;
                $scope.pendingRecommendationSave = false;

                saveRecommendation();
            };


            /* Actual save operation */
            function saveRecommendation() {

                $scope.isSaving = true;

                $http.post('/PoRecom/SaveVendorPORecomInfo', {
                    vendorCS: $scope.VendorCSInfo,
                    vendorCSItem: $scope.VenCSItemGridDisplayCollection,
                    vendorCSTerm: $scope.ReqTermGridDisplayCollection
                }).then(function (res) {

                    $scope.isSaving = false;

                    var s = res.data.status;

                    if (s === 'S201') {
                        toastr.success("Recommendation Saved Successfully.");
                        $scope.toggleRefreshTable();

                    } else if (s === 'S202') {
                        toastr.success("Recommendation Updated Successfully.");
                        $scope.toggleRefreshTable();

                    } else {
                        toastr.error("Save Failed. Status: " + (s || "unknown"));
                    }

                }, function () {
                    $scope.isSaving = false;
                    toastr.error("Save Failed.");
                });
            }


            /* ── Workorder Modal ── */
            $scope.showWoModal = false;
            $scope.woLoading = false;
            $scope.WoInfo = null;
            $scope.WoItemList = [];

            $scope.openWorkorderDetail = function () {
                if (!$scope.VendorCSInfo.ClientReqID) {
                    toastr.warning("Client Requisition ID not available.");
                    return;
                }
                $scope.showWoModal = true;
                $scope.woLoading = true;
                $scope.WoInfo = null;
                $scope.WoItemList = [];

                $http.post("/PORecom/GetWorkorderDetailByClientReq", {
                    ClientID: $scope.VendorCSInfo.ClientID,
                    ClientReqID: $scope.VendorCSInfo.ClientReqID,
                    ClientReqNo: $scope.VendorCSInfo.ClientReqNo
                }).then(function (res) {
                    $scope.woLoading = false;
                    $scope.WoInfo = res.data.WoInfo || null;
                    $scope.WoItemList = res.data.WoItemList || [];
                    if (!$scope.WoInfo) {
                        toastr.info("No workorder found for this requisition.");
                    }
                }, function () {
                    $scope.woLoading = false;
                    toastr.error("Failed to load workorder details.");
                });
            };

            $scope.closeWorkorderDetail = function () {
                $scope.showWoModal = false;
                $scope.WoInfo = null;
                $scope.WoItemList = [];
            };

            /* ── Refresh ── */
            $scope.toggleRefreshTable = function () {
                $scope.isRefreshing = true;
                $timeout(function () { window.location.reload(); }, 1200);
            };
        

 }]);
</script>