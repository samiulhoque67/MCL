@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    body {
        font-size: 12px;
    }

    .box-body, .form-group, .btn, .form-control, .box-header, label,
    input.form-control, button.form-control, .fa {
        font-size: 12px;
    }

    .btn {
        padding: 4px 8px;
    }

    h3.box-title {
        font-size: 14px;
    }
</style>
<style>
    .text-success {
        color: green;
        font-size: 14px;
    }

    .text-primary {
        color: blue;
        font-size: 14px;
    }
</style>

<div class="box box-primary box-body" ng-controller="WorkOrderInfoCntrl">

    <!-- Upper buttons -->
    <div class="box-header with-border bg-light-blue-gradient" style="height:38px;">
        <h2 class="box-title" style="font-family: math; font-weight: 500;">Quotation to Client</h2>
        <div class="box-tools pull-right">
            <div class="col-lg-12 pull-right">
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" ng-click="showActionLog()" class="button-custom">
                        <i class="fa fa-history" style="padding-right: 5px;"></i> History
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="toggleRefreshTable()" class="button-custom" ng-disabled="btnRefresh">
                        <i class="fa fa-refresh" style="padding-right: 5px;"></i> Refresh
                    </button>
                </div>
                <div class="btn-group pull-right" style="margin-left: 4px; margin-right: 4px;">
                    <button type="button" data-ng-click="SearchSaveClients()" class="button-custom" ng-disabled="btnSearch">
                        <i class="fa fa-search" style="padding-right: 5px;"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Returned (Back) banner: filled by loadActionLog when the latest action was Back -->
    <div class="alert alert-danger" ng-if="BackInfo" style="margin: 5px 15px;">
        <i class="fa fa-undo"></i>
        Returned from <b>{{stageLabel(BackInfo.Stage)}}</b> by {{BackInfo.ActionByName}}
        on {{formatDate(BackInfo.ActionOn)}} &mdash; Reason: <b>{{BackInfo.Reason}}</b>
    </div>

    <div class="box-body">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">

                <!-- ClientName -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientName">Client Name :</label></div>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                        <div style="position: relative;">
                            <input id="ClientName" name="ClientName" type="text" data-ng-model="Client.ClientName"
                                   class="form-control" ng-readonly="true" placeholder="Client Name"
                                   style="height: 25px; font-size: smaller;" />
                            <button type="button" data-ng-click="SearchAvailableClients()"
                                    style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                           padding: 0px 10px; border: 2px solid black; background: transparent;">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- Requisition No & Date -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionNo">Client Requisition No :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionNo" type="text" data-ng-model="Client.ClientRequisitionNo" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ClientRequisitionDate">Client Requisition Date:</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ClientRequisitionDate" type="text" data-ng-model="Client.ClientRequisitionDate" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Contact Person & Number -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactPerson">Contact Person :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactPerson" type="text" data-ng-model="Client.ContactPerson" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactNumber">Contact Number :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactNumber" type="text" data-ng-model="Client.ContactNumber" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- TIN & BIN -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactTIN">Contact TIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactTIN" type="text" data-ng-model="Client.ContactTIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactBIN">Contact BIN :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input id="ContactBIN" type="text" data-ng-model="Client.ContactBIN" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="ContactAddress">Contact Address :</label></div>
                    </div>
                    <div class="col-lg-7">
                        <div class="form-group">
                            <input id="ContactAddress" type="text" data-ng-model="Client.ContactAddress" class="form-control" ng-readonly="true" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                </div>

                <!-- Uploaded documents -->
                <div class="row" ng-if="GetClientReqDetails.length > 0">
                    <div class="col-lg-2">
                        <div class="form-group">
                            <label for="upload_documents">
                                Uploaded Documents <br>
                                (<span style="color:#ff4900;"> PDF Only </span>)
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span ng-hide="getDocumentList().length" style="color:#999; font-size:11px;">No document attached</span>
                        <button type="button" ng-repeat="docID in getDocumentList() track by $index"
                                ng-click="ViewDocument(docID)" class="btn button-custom btn-sm" style="margin: 0 4px 4px 0;">
                            <i class="fa fa-eye"></i> View Doc {{$index + 1}}
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Available clients modal (new quotation) -->
    <div id="AvailableClients" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive" ng-cloak>
                    <table st-table="AllAvailableClientstCollection" st-safe-src="AllAvailableClientsList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    Available Clients for Quotation
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th style="text-align: left;">Client Name</th>
                                <th style="text-align: left;">Project Name</th>
                                <th style="text-align: left;">Representative</th>
                                <th class="col-lg-1">Action</th>
                            </tr>
                            <tr>
                                <th colspan="4">
                                    <input type="search" ng-model="PagingInfo.search" ng-model-options="{ debounce: 400 }"
                                           ng-change="SearchAvailableClients()"
                                           placeholder="Search Client / Project / Representative..." class="input-sm form-control" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllAvailableClientsList | orderBy:'IsBack':true">
                                <td class="col-lg-2">{{row.ClientName}}</td>
                                <td class="col-lg-2">{{row.ProjectName}}</td>
                                <td class="col-lg-2">{{row.UserFullName}}</td>
                                <td class="col-lg-1 text-center">
                                    <a class="btn col-center btn-sm btn-flat btn-success" ng-click="selectAvailableClient(row, 'save')">Select</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div ng-if="PagingInfo.totalItems > 0" class="text-center">
                        <ul uib-pagination total-items="PagingInfo.totalItems" ng-model="PagingInfo.page"
                            items-per-page="{{PagingInfo.itemsPerPage}}" max-size="7" boundary-links="true"
                            rotate="true" force-ellipses="true" ng-change="selectPageList()"></ul>
                    </div>
                    <div ng-if="PagingInfo.totalItems <= 0" class="text-center">NO ITEM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Item & service list -->
    <div class="row" ng-if="GetClientReqDetails.length > 0">
        <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
            <table st-table="GetClientReqDetailsCollection" st-safe-src="GetClientReqDetails"
                   style="width:100%" class="table table-condensed table-bordered table-striped table-hover pnlView">
                <thead>
                    <tr style="font-size: 15px;">
                        <th colspan="14" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                            Item and Service List
                        </th>
                    </tr>
                    <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                        <th style="text-align: left;">Item Code</th>
                        <th style="text-align: left;">Item Name</th>
                        <th style="text-align: left;">Description</th>
                        <th style="text-align: left;">Delivery Location</th>
                        <th style="text-align: left;">Delivery Date</th>
                        <th style="text-align: left;">Requested Qty</th>
                        <th style="text-align: left;">Req Unit</th>
                        <th style="text-align: left;">Quotation Amount</th>
                        <th style="text-align: left;">Given Quotation Amount</th>
                        <th style="text-align: left;">ASF (%)</th>
                        <th style="text-align: left;">ASF Amount</th>
                        <th style="text-align: left;">Vat (%)</th>
                        <th style="text-align: left;">Vat Amount</th>
                        <th style="text-align: left;">Given Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="row in GetClientReqDetailsCollection" ng-init="initializeDefaults(row)" ng-cloak
                        ng-style="{'background-color': row.ReqType === 'QC' ? '#a9c7f8' : ''}" style="font-size: 12px;">

                        <td style="width: 5%;">{{ row.ServiceItemID }}</td>
                        <td style="width: 5%;">{{ row.ServiceItemName }}</td>
                        <td style="width: 6%;">{{ row.Description }}</td>
                        <td style="width: 6%;">{{ row.DeliveryLocation }}</td>
                        <td style="width: 6%;">{{ row.DeliveryDate }}</td>

                        <!-- Qty: save = ReqQnty, view/edit = QutnQnty -->
                        <td ng-show="pagefunction === 'savemode'" style="width: 6%; text-align: right;">{{ row.ReqQnty | number: 2 }}</td>
                        <td ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'" style="width: 6%; text-align: right;">{{ row.QutnQnty | number: 2 }}</td>

                        <td style="width: 5%;">{{ row.ReqUnit }}</td>

                        <!-- Quotation price input -->
                        <td style="width: 6%;">
                            <input class="form-control" style="width: 100%; height: 18px; font-size: 10px;" type="number"
                                   ng-readonly="pagefunction === 'viewmode'"
                                   ng-model="row.givenQutnPrice"
                                   ng-change="calculateRowFields(row)"
                                   ng-blur="validateInput0('givenQutnPrice', row)" />
                        </td>

                        <!-- Given quotation amount -->
                        <td ng-show="pagefunction === 'savemode'" style="width: 6%; text-align: right; color: #126e0f;">{{ row.givenQutnAmt | number: 2 }}</td>
                        <td ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'" style="width: 6%; text-align: right; color: #126e0f;">{{ row.QutnAmt | number: 2 }}</td>

                        <!-- ASF % -->
                        <td style="width: 6%;">
                            <input class="form-control" style="width: 100%; height: 18px; font-size: 10px; text-align: right" type="text"
                                   ng-show="pagefunction === 'savemode' || pagefunction === 'editmode'"
                                   ng-model="row.GivenASFPerc"
                                   ng-change="calculateRowFields(row)"
                                   ng-blur="validateInput('GivenASFPerc', row)" />
                            <input class="form-control" style="width: 100%; height: 18px; font-size: 10px;" type="text"
                                   ng-show="pagefunction === 'viewmode'" ng-readonly="true" ng-model="row.GivenASFPerc" />
                        </td>

                        <!-- ASF amount -->
                        <td ng-show="pagefunction === 'savemode'" style="width: 6%; text-align: right;">{{ (row.TotGivenASFAmt | number:2) || '0.00' }}</td>
                        <td ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'" style="width: 6%; text-align: right;">{{ (row.TotGivenASFAmt | number:2) || row.ASFAmt }}</td>

                        <!-- VAT % -->
                        <td style="width: 6%;">
                            <input class="form-control" style="width: 100%; height: 18px; font-size: 10px; text-align: right" type="text"
                                   ng-show="pagefunction === 'savemode' || pagefunction === 'editmode'"
                                   ng-model="row.GivenVatPerc"
                                   ng-change="calculateRowFields(row)"
                                   ng-blur="validateInput('GivenVatPerc', row)" />
                            <input class="form-control" style="width: 100%; height: 18px; font-size: 10px;" type="text"
                                   ng-show="pagefunction === 'viewmode'" ng-readonly="true" ng-model="row.GivenVatPerc" />
                        </td>

                        <!-- VAT amount -->
                        <td ng-show="pagefunction === 'savemode'" style="width: 6%; text-align: right;">{{ (row.TotGivenVatAmt | number:2) || '0.00' }}</td>
                        <td ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'" style="width: 6%; text-align: right;">{{ (row.TotGivenVatAmt | number:2) || row.VatAmt }}</td>

                        <!-- Total + vendor-detail button (now for CS, NCS and QC items, in every mode) -->
                        <td style="width: 6%; color: #126e0f; text-align: right;">
                            <div style="display: inline-flex; align-items: center;">
                                <span ng-show="pagefunction === 'savemode'">{{ (row.givenTolAmt | number:2) || '0.00' }}</span>
                                <span ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'">{{ (row.givenTolAmt | number:2) || row.TolAmt }}</span>
                                <button type="button" class="button-detail" style="margin-left: 5px;"
                                        ng-hide="row.ReqType === 'QC'"
                                        ng-click="detailVendorCS(row)" title="Show vendor detail">
                                    <i class="fa fa-info"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Terms & conditions + quotation fields -->
    <div class="box-body" ng-show="showTermsItem === true">

        <!-- Terms selection modal -->
        <div id="ClientReqTermsConditionsModal" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div style="text-align: right;">
                        <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                            <i class="fa fa-remove"></i>
                        </button>
                    </div>
                    <div class="modal-body table-responsive">
                        <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                               class="table table-condensed table-bordered table-striped table-hover pnlView">
                            <thead>
                                <tr style="font-size: 15px;">
                                    <th colspan="12" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                        Terms & Conditions Information
                                    </th>
                                </tr>
                                <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                    <th>Form Code</th>
                                    <th>Form Name</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                                <tr>
                                    <th><input st-search="FormCode" placeholder="Form Code" class="input-sm form-control" type="search" /></th>
                                    <th><input st-search="FormName" placeholder="Form Name" class="input-sm form-control" type="search" /></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="row in TermsConditionsDisplayedCollection">
                                    <td class="hidden">{{row.TermsID}}</td>
                                    <td class="text-center">{{row.FormCode}}</td>
                                    <td class="text-center">{{row.FormName}}</td>
                                    <td class="text-center">
                                        <span ng-attr-class="{{row.Status =='1'? 'label label-success' : 'label label-danger' }}">
                                            {{row.Status == '1'? 'Active':'InActive'}}
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary btn-flat" data-ng-click="toggleTermsConditionsSelect(row)">
                                            <i class="fa fa-edit"></i> Select
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" class="text-center">
                                        <div st-pagination="" st-items-by-page="itemsByPage" st-displayed-pages="10"></div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terms list table -->
        <div class="row">
            <div class="row" style="padding: 11px; margin-right: 15px; margin-left: 15px;">
                <table st-table="TermsConditionsDisplayedCollection" st-safe-src="TermsConditionsList"
                       class="table table-condensed table-bordered table-striped table-hover pnlView">
                    <thead>
                        <tr style="font-size: 15px; border: 1px solid #3003eb; background: #ffffff;">
                            <th style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff;">
                                <span>Terms & Conditions List</span>
                            </th>
                            <th ng-show="pagefunction === 'savemode'" style="background: #ffffff; position: relative; padding: 5px;">
                                <div style="position: relative; display: inline-block; width: 200px;">
                                    <input id="FormName" name="FormName" type="text" data-ng-model="ClientReq.FormName"
                                           class="form-control" ng-readonly="true"
                                           style="width: 100%; height: 25px; font-size: smaller; padding-right: 35px;" />
                                    <button type="button" ng-click="ShowTermsConditionsList()"
                                            style="position: absolute; right: 1px; top: 50%; transform: translateY(-50%);
                                                   padding: 0px 10px; border: 2px solid black; background: transparent;">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </th>
                            <th ng-show="pagefunction === 'savemode'" style="background: #ffffff;">
                                <button type="button" id="btnReqTermAdd" ng-click="AddReqTermModal()" class="button-detail btn">
                                    <i class="fa fa-plus" style="padding-right: 3px"></i> Add
                                </button>
                            </th>
                        </tr>
                        <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                            <th style="text-align: left;">Terms Code</th>
                            <th colspan="13" style="text-align: left;">Terms & Conditions</th>
                            <th ng-show="pagefunction !== 'viewmode'" style="text-align: left;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="row in TermsConditionsDisplayedCollection" ng-cloak style="font-size:12px;">
                            <td class="hidden">{{row.ClientReqTermsID}}</td>
                            <td class="hidden">{{row.ClientReqID}}</td>
                            <td class="hidden">{{row.TermsID}}</td>
                            <td class="col-lg-1" style="width:5%;">{{row.TermsCode}}</td>
                            <td colspan="13" style="width:6%;">{{row.TermsName}}</td>
                            <td ng-show="pagefunction !== 'viewmode'" class="col-lg-1" style="width:5%;">
                                <button type="button" class="btn btn-xs btn-primary btn-flat" ng-click="toggleReqTermEdit(row,$index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-primary btn-flat btnDelete" ng-click="toggleReqTermDelete(row,$index)">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Add / Edit term modal -->
        <div id="RequisitionTermModal" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="row">
                            <div class="col-sm-5">
                                <h4 class="modal-title" style="font-family: initial; font-weight: 700">Terms & Conditions Information</h4>
                            </div>
                            <div style="text-align: right;">
                                <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                                    <i class="fa fa-remove"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div ng-cloak>
                        <div class="row" style="position:relative;top:5px;">
                            <div class="col-sm-1"></div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="TermsCode">Terms Code:</label>
                                    <label style="font-size:larger;color:red;">*</label>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <input id="TermsCode" name="TermsCode" type="text" class="form-control" placeholder="Terms Code" autocomplete="off"
                                       ng-model="ClientReqTerm.TermsCode" style="height: 25px; background-color:#ffffff; font-size: smaller" />
                            </div>
                        </div>
                        <div class="row" style="position:relative;top:5px;">
                            <div class="col-sm-1"></div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="TermsName">Terms and Conditions:</label>
                                    <label style="font-size:larger;color:red;">*</label>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                <input id="TermsName" name="TermsName" type="text" class="form-control" placeholder="Terms Name" autocomplete="off"
                                       ng-model="ClientReqTerm.TermsName" style="height: 25px; background-color:#ffffff; font-size: smaller" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <div class="btn-group pull-right" style="margin:2px;">
                                    <button type="button" id="btnAddReqTerm" data-ng-click="AddReqTerm()" class="button-detail btn">
                                        <i class="fa fa-save" style="padding-right: 3px"></i>Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Briefing date / quotation date / project name -->
        <div class="row">
            <div class="col-sm-1 col-md-1 col-lg-1"></div>
            <div class="col-sm-10 col-md-10 col-lg-10">

                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="BriefingDate">Client Briefing Date :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div ng-show="pagefunction === 'savemode' || pagefunction === 'editmode'" class="form-group">
                            <input id="BriefingDate" name="BriefingDate" readonly type="datetime"
                                   class="DatePicker form-control" placeholder="DD/MM/YYYY"
                                   ng-model="MasterData.BriefingDate" style="height: 25px; background-color:#ffffff;" />
                        </div>
                        <div ng-show="pagefunction === 'viewmode'" class="form-group">
                            <input name="BriefingDateView" readonly type="text" placeholder="DD/MM/YYYY"
                                   ng-model="MasterData.BriefingDate" class="form-control"
                                   style="height: 25px; background-color:#ffffff;" />
                        </div>
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-2">
                        <div class="form-group"><label for="QuotationDate">Quotation Date :</label></div>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-group">
                            <input ng-show="pagefunction === 'savemode'" id="QuotationDate" name="QuotationDate"
                                   type="text" class="form-control" style="background-color:#ffffff;" readonly />
                            <input ng-show="pagefunction === 'viewmode' || pagefunction === 'editmode'"
                                   type="text" ng-model="MasterData.QuotationDate"
                                   class="form-control" style="background-color:#ffffff;" readonly />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-2">
                        <div class="form-group"><label for="QuotationNote">Project Name :</label></div>
                    </div>
                    <div class="col-lg-9">
                        <div class="form-group">
                            <textarea id="QuotationNote" name="QuotationNote" ng-readonly="pagefunction === 'viewmode'"
                                      ng-model="MasterData.QuotationNote" class="form-control" rows="3"
                                      style="resize: vertical;"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-9"></div>
                    <div ng-show="pagefunction === 'savemode'" class="col-lg-2">
                        <button type="button" class="btn btn-success saveBtn pull-right"
                                ng-click="openConfirmModal('save')" title="Save"
                                style="padding: 6px 36px; box-shadow: -4px 5px 0px 0px rgba(0,0,0,0.1); border-radius: 5px;">
                            <i class="fa fa-check"></i> Submit
                        </button>
                    </div>
                    <div ng-show="pagefunction === 'editmode'" class="col-lg-2">
                        <button type="button" class="btn btn-success saveBtn pull-right"
                                ng-click="openConfirmModal('edit')" title="Update"
                                style="padding: 6px 36px; box-shadow: -4px 5px 0px 0px rgba(0,0,0,0.1); background-color: #ac5604c2; border-radius: 5px;">
                            <i class="fa fa-check"></i> Re-submit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Saved quotations (view / edit). Edit is offered ONLY for quotations sent Back -->
    <div id="QuotationForRecom" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div style="text-align: right;">
                    <button type="button" class="btn-danger" data-dismiss="modal" aria-hidden="true" style="color: #ffffff;">
                        <i class="fa fa-remove"></i>
                    </button>
                </div>
                <div class="modal-body table-responsive" ng-cloak>
                    <table st-table="AllQuotationsCollection" st-safe-src="AllQuotationsList"
                           class="table table-condensed table-bordered table-striped table-hover pnlView">
                        <thead>
                            <tr style="font-size: 15px;">
                                <th colspan="8" style="text-align: left; color: black; font-weight: 100; font-family: math; background: #ffffff; border: 1px solid #3003eb">
                                    All Saved Client Quotations
                                </th>
                            </tr>
                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th data-ng-click="sortList('ClientName')">Client Name</th>
                                <th data-ng-click="sortList('ClientReqNo')">Requisition No</th>
                                <th>Project Name</th>
                                <th>Requisition Date</th>
                                <th>Quotation No</th>
                                <th>Quotation Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                            <tr>
                                <th colspan="8">
                                    <input type="search" ng-model="PagingInfo.search" ng-model-options="{ debounce: 400 }"
                                           ng-change="SearchSaveClients()"
                                           placeholder="Search Client Code / Name / Req No..." class="input-sm form-control" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllQuotationsList | orderBy:'IsBack':true">
                                <td class="text-center">{{row.ClientName}}</td>
                                <td class="text-center">{{row.ClientReqNo}}</td>
                                <td class="text-center">{{row.ProjectName}}</td>
                                <td class="text-center">{{row.RequisitionDate | date:'dd/MM/yyyy'}}</td>
                                <td class="text-center">{{row.QuotationNo}}</td>
                                <td class="text-center">{{row.ClientAdvanceClaimDate | date:'dd/MM/yyyy'}}</td>
                                <td class="text-center">
                                    <span class="label"
                                          ng-class="{'label-danger': row.ProcessStatus === 'Back',
                                                     'label-warning': row.ProcessStatus === 'Postponed',
                                                     'label-success': row.ProcessStatus === 'Done',
                                                     'label-default': row.ProcessStatus === 'Rcvd'}">
                                        {{ row.ProcessStatus === 'Rcvd' ? 'Submitted' : row.ProcessStatus }}
                                    </span>
                                </td>
                                <td class="col-lg-2 text-center">
                                    <button type="button" ng-click="selectAvailableClient(row, 'view')"
                                            class="btn btn-flat btn-primary btn-xs" ng-disabled="loading">
                                        <span class="fa fa-search-plus"> View</span>
                                    </button>
                                    <button type="button" ng-click="selectAvailableClient(row, 'edit')"
                                            ng-show="row.ProcessStatus === 'Back'"
                                            class="btn btn-flat btn-warning btn-xs" style="margin-left: 5px;">
                                        <span class="fa fa-edit"> Edit</span>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div ng-if="PagingInfo.totalItems > 0" class="text-center">
                        <ul uib-pagination total-items="PagingInfo.totalItems" ng-model="PagingInfo.page"
                            items-per-page="{{PagingInfo.itemsPerPage}}" max-size="7" boundary-links="true"
                            rotate="true" force-ellipses="true" ng-change="selectSavePageList()"></ul>
                    </div>
                    <div ng-if="PagingInfo.totalItems <= 0" class="text-center">NO ITEM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zero-ASF confirmation -->
    <div id="confirmModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content" style="border-radius: 4px; overflow: hidden;">
                <div class="modal-header" style="background-color: #3c8dbc; color: #fff; padding: 12px 15px;">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #fff; opacity: 1;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" style="font-weight: 600;"><i class="fa fa-exclamation-triangle"></i> Confirmation</h4>
                </div>
                <div class="modal-body" style="padding: 25px 20px; text-align: center;">
                    <div style="font-size: 45px; color: #f39c12; margin-bottom: 12px;">
                        <i style="font-size:50px" class="fa fa-exclamation-circle"></i>
                    </div>
                    <p style="font-size: 15px; margin-bottom: 5px;">
                        You have set <strong>ASF (%)</strong> to <strong style="color: #dd4b39;">0 (Zero)</strong>.
                    </p>
                    <p style="font-size: 14px; color: #777; margin-bottom: 0;">Are you sure you want to proceed?</p>
                </div>
                <div class="modal-footer" style="padding: 10px 15px;">
                    <button type="button" class="btn btn-flat btn-sm btn-default" data-dismiss="modal">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button ng-show="pagefunction === 'savemode'" type="button" class="btn btn-flat btn-sm btn-warning" ng-click="SaveQuotToClient('save')">
                        <i class="fa fa-check"></i> Proceed
                    </button>
                    <button ng-show="pagefunction === 'editmode'" type="button" class="btn btn-flat btn-sm btn-warning" ng-click="SaveQuotToClient('edit')">
                        <i class="fa fa-check"></i> Proceed
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div id="mydiv" data-ng-show="loading">
        <div class="overlay">
            <div class="loder">
                <img src="~/Content/AdminLTE/img/cube.gif" /> <span class="text-bold">Loading...</span>
            </div>
        </div>
    </div>

    <!-- PDF viewer modal -->
    <div id="ShowPDFModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body" style="padding: 0; margin: 0;">
                    <iframe id="pdfViewer" style="width: 100%; height: 100vh; border: none;" title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Shared modals: vendor detail + action history -->
    @Html.Partial("_QutnCommonModals")

</div>

<script src="@Url.Content("~/Scripts/qutnCommon.js")?v=1"></script>
<script type="text/javascript">
    app.controller('WorkOrderInfoCntrl', function ($scope, $http) {
        attachQutnCommon($scope, $http);

        $scope.PagingInfo = { page: 1, itemsPerPage: 8, sortBy: null, reverse: false, search: null, totalItems: 0 };

        $scope.Client = {
            ClientName: "", ClientRequisitionNo: "", ClientReqID: "", ClientRequisitionDate: "",
            ContactPerson: "", ContactNumber: "", ContactTIN: "", ContactBIN: "", ContactAddress: ""
        };
        $scope.MasterData = {
            ClientID: "", ClientReqID: "", ClientReqNo: "",
            BriefingDate: "", QuotationNote: "", QuotationNo: "", QuotationDate: ""
        };
        $scope.Quotation = { QuotationNo: "" };
        $scope.pagefunction = '';
        $scope.ReqType = '';
        $scope.SavedClientQutnID = '';
        $scope.showTermsItem = false;
        $scope.selectedRows = [];

        // ── Date picker ───────────────────────────────────────────────
        $('.DatePicker').datepicker({ format: "dd/mm/yyyy", autoclose: true })
            .on('changeDate', function () {
                var val = $(this).val();
                $('.datepicker').hide();
                var s = angular.element($(this)).scope();
                s.$apply(function () { s.MasterData.BriefingDate = val; });
            });

        // today's date for save mode
        (function () {
            var d = new Date();
            var el = document.getElementById("QuotationDate");
            if (el) el.value = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        })();

        function setClient(d) {
            $scope.ClientDetails = [d];
            $scope.Client = {
                ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo, ClientReqID: d.ClientReqID,
                ClientRequisitionDate: d.RequisitionDate, ContactPerson: d.ContactPerson, ContactNumber: d.ContactNumber,
                ContactTIN: d.ClientTinNo, ContactBIN: d.ClientBinNo, ContactAddress: d.Address,
                DocumentID: d.DocumentID
            };
        }

        // ── Search (new quotation) ────────────────────────────────────
        function loadAvailable() {
            return $http.post('/QuotationToClient/AllAvailableClients', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllAvailableClientsList = r.AllAvailableClientsList;
                $scope.AllAvailableClientstCollection = [].concat($scope.AllAvailableClientsList);
                $scope.PagingInfo.totalItems = r.TotalItems || 0;
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        }

        $scope.SearchAvailableClients = function () {
            $scope.PagingInfo.page = 1;
            $scope.ClearEverything();
            loadAvailable();
            $('#AvailableClients').modal('show');
        };
        $scope.selectPageList = function () { loadAvailable(); };

        $scope.sortList = function (sortBy) {
            if (sortBy === $scope.PagingInfo.sortBy) {
                $scope.PagingInfo.reverse = !$scope.PagingInfo.reverse;
            } else {
                $scope.PagingInfo.sortBy = sortBy;
                $scope.PagingInfo.reverse = false;
            }
            $scope.PagingInfo.page = 1;
        };

        // ── Select a client row (save / view / edit) ──────────────────
        $scope.selectAvailableClient = function (row, action) {
            $scope.MasterData.ClientReqID = row.ClientReqID;
            $scope.MasterData.ClientID = row.ClientID;
            $scope.ReqType = row.ReqType;
            $scope.BackInfo = null;

            if (action === 'save') {
                $scope.pagefunction = 'savemode';
                $('#AvailableClients').modal('hide');
            } else {
                $scope.pagefunction = (action === 'view') ? 'viewmode' : 'editmode';
                $('#QuotationForRecom').modal('hide');
                // history + "returned from ..." banner
                $scope.loadActionLog(row.ClientReqID, false);
            }
            $scope.loading = true;

            $http.post('/QuotationToClient/AvailableClientDetailInfo', {
                ClientID: row.ClientID, ClientReqID: row.ClientReqID, ReqType: $scope.ReqType
            }).success(function (r) {
                var d = r.ClientDetails[0];
                setClient(d);
                if (action === 'save') $scope.MasterData.QuotationNote = d.Remarks;
                $scope.GetClientReqDataInfo(d.ClientID, d.ClientReqID, action === 'save' ? null : row.ClientQutnID, action);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        // ── Load item rows ────────────────────────────────────────────
        $scope.GetClientReqDataInfo = function (ClientID, ClientReqID, ClientQutnID, action) {
            if (action === 'save') {
                $http.post('/QuotationToClient/GetClientReqDataInfo', {
                    ClientID: ClientID, ClientReqID: ClientReqID, ReqType: $scope.ReqType
                }).success(function (r) {
                    $scope.GetClientReqDetails = r.GetClientReqDetails;
                    $scope.GetClientReqDetailsCollection = [].concat($scope.GetClientReqDetails);
                    $scope.loading = false;
                    if ($scope.GetClientReqDetailsCollection.length > 0) {
                        $scope.GetTermsItemList($scope.GetClientReqDetailsCollection[0].VendorCSAprvID, ClientReqID, action);
                    }
                }).error(function () { $scope.loading = false; });

            } else {   // view / edit
                $scope.SavedClientQutnID = ClientQutnID;
                $http.post('/QuotationRecommendation/GetClientReqDataInfo', {
                    ClientID: ClientID, ClientReqID: ClientReqID, ClientQutnID: ClientQutnID
                }).success(function (r) {
                    $scope.GetClientReqDetails = r.GetClientReqDetails;
                    $scope.GetClientReqDetailsCollection = [].concat($scope.GetClientReqDetails);
                    $scope.loading = false;
                    if ($scope.GetClientReqDetailsCollection.length > 0) {
                        var first = $scope.GetClientReqDetailsCollection[0];
                        $scope.MasterData = {
                            ClientID: ClientID, ClientReqID: ClientReqID,
                            ClientQuotationID: first.ClientQuotationID,
                            QuotationNo: first.QutnNo, BriefingDate: first.BriefingDate,
                            QuotationDate: first.QuotationDate, QuotationNote: first.Remarks
                        };
                        $scope.showTermsItem = true;
                        $scope.GetTermsItemList(first.ClientQuotationID, ClientReqID, action);
                    }
                }).error(function () { $scope.loading = false; });
            }
        };

        // ── Row defaults / calculation ────────────────────────────────
        $scope.initializeDefaults = function (row) {
            if (row._initialized) return;
            row.givenQutnPrice = parseFloat(row.QutnPrice) || 0;
            row.GivenASFPerc = parseFloat(row.ASFPerc) || 0;
            if ($scope.pagefunction === 'savemode') {
                row.GivenVatPerc = 15;                       // default VAT for a new entry
                row._initialized = true;
                $scope.calculateRowFields(row);
            } else {                                          // view / edit: load DB values
                row.GivenVatPerc = parseFloat(row.VatPerc) || 0;
                row._initialized = true;
                $scope.recalcOnly(row);
                if ($scope.pagefunction === 'editmode') $scope.selectEntity(row, 'edit-init');
            }
        };

        // calculates derived fields without touching selectedRows
        $scope.recalcOnly = function (row) {
            var qty = parseFloat(($scope.pagefunction === 'savemode') ? row.ReqQnty : row.QutnQnty) || 0;
            row.givenQutnPrice = parseFloat(row.givenQutnPrice) || 0;
            var asfPerc = parseFloat(row.GivenASFPerc) || 0;
            var vatPerc = parseFloat(row.GivenVatPerc) || 0;

            row.givenQutnAmt = row.givenQutnPrice * qty;
            row.TotGivenASFAmt = row.givenQutnAmt * (asfPerc / 100);
            var basePlusASF = row.givenQutnAmt + row.TotGivenASFAmt;
            row.TotGivenVatAmt = Math.round(basePlusASF * (vatPerc / 100) * 100) / 100;
            row.givenTolAmt = parseFloat(row.givenQutnAmt + row.TotGivenASFAmt + row.TotGivenVatAmt).toFixed(2);
        };

        $scope.calculateRowFields = function (row) {
            $scope.recalcOnly(row);
            if ($scope.pagefunction === 'savemode' || $scope.pagefunction === 'editmode') {
                $scope.selectEntity(row, 'save');
            }
        };

        $scope.selectEntity = function (row, action) {
            if (action === 'save') {
                var item = {
                    ClientQuotationID: ($scope.pagefunction === 'editmode') ? row.ClientQuotationID : undefined,
                    VendorCSAprvID: row.VendorCSAprvID,
                    VendorCSAprvItemID: row.VendorCSAprvItemID,
                    ServiceCategoryID: row.ServiceCategoryID,
                    TermsID: row.TermsID,
                    ServiceItemID: row.ServiceItemID,
                    Description: row.Description,
                    DeliveryLocation: row.DeliveryLocation,
                    DeliveryDate: row.DeliveryDate,
                    DeliveryMode: row.DeliveryMode,
                    QutnQnty: ($scope.pagefunction === 'editmode') ? row.QutnQnty : row.ReqQnty,
                    QutnUnit: row.ReqUnit,
                    VenPrice: row.QutnPrice,
                    MclPrice: row.givenQutnPrice,
                    QutnAmt: row.givenQutnAmt,
                    ASFPerc: row.GivenASFPerc,
                    ASFAmt: row.TotGivenASFAmt,
                    VatPerc: row.GivenVatPerc,
                    VatAmt: row.TotGivenVatAmt,
                    TolAmt: row.givenTolAmt
                };

                var existing = $scope.selectedRows.find(function (i) {
                    return (row.VendorCSAprvItemID && row.VendorCSAprvItemID !== 'N/A' && i.VendorCSAprvItemID === row.VendorCSAprvItemID)
                        || i.ServiceItemID === row.ServiceItemID;
                });

                if (existing) {
                    existing.MclPrice = row.givenQutnPrice;
                    existing.QutnAmt = row.givenQutnAmt;
                    existing.ASFPerc = row.GivenASFPerc;
                    existing.ASFAmt = row.TotGivenASFAmt;
                    existing.VatPerc = row.GivenVatPerc;
                    existing.VatAmt = row.TotGivenVatAmt;
                    existing.TolAmt = row.givenTolAmt;
                } else {
                    $scope.selectedRows.push(item);
                }
                $scope.showTermsItem = $scope.selectedRows.length > 0;

            } else if (action === 'edit-init') {
                var dup = $scope.selectedRows.find(function (i) { return i.ServiceItemID === row.ServiceItemID; });
                if (!dup) {
                    $scope.selectedRows.push({
                        ClientQuotationID: row.ClientQuotationID,
                        ServiceCategoryID: row.ServiceCategoryID,
                        TermsID: row.TermsID,
                        ServiceItemID: row.ServiceItemID,
                        Description: row.Description,
                        DeliveryLocation: row.DeliveryLocation,
                        DeliveryDate: row.DeliveryDate,
                        DeliveryMode: row.DeliveryMode,
                        QutnQnty: row.QutnQnty,
                        QutnUnit: row.ReqUnit,
                        VenPrice: row.QutnPrice,
                        MclPrice: row.givenQutnPrice,
                        QutnAmt: row.givenQutnAmt,
                        ASFPerc: row.GivenASFPerc,
                        ASFAmt: row.TotGivenASFAmt,
                        VatPerc: row.GivenVatPerc,
                        VatAmt: row.TotGivenVatAmt,
                        TolAmt: row.givenTolAmt
                    });
                }
            }
        };

        // ── Terms item list ───────────────────────────────────────────
        $scope.GetTermsItemList = function (TempID, ClientReqID, action) {
            var req = (action === 'save')
                ? $http.post('/QuotationToClient/GetVendorTermList', { VendorCSAprvID: TempID, ClientReqID: ClientReqID, ReqType: $scope.ReqType })
                : $http.post('/QuotationRecommendation/GetVendorTermList', { ClientQuotationID: TempID });
            req.success(function (r) {
                $scope.TermsConditionsList = r.VendorTermTermList;
                $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                $scope.loading = false;
            }).error(function () { });
        };

        // ── Validation ────────────────────────────────────────────────
        $scope.validateInput = function (field, row) {
            var re = /^[0-9]*\.?[0-9]*$/;
            if (!re.test(row[field]) || row[field] === '') row[field] = 0;
            $scope.calculateRowFields(row);
        };

        $scope.validateInput0 = function (field, row) {
            if (field === 'givenQutnPrice' && (row.givenQutnPrice <= 0 || !row.givenQutnPrice)) {
                toastr.error("Given Quotation Price must be greater than 0.");
                row.givenQutnPrice = null;
            }
        };

        // ── Confirm & save ────────────────────────────────────────────
        $scope.openConfirmModal = function (action) {
            if (!$scope.MasterData.BriefingDate || $scope.MasterData.BriefingDate.trim() === '') {
                toastr.error('Please enter a Briefing Date');
            } else if ($scope.selectedRows.some(function (i) { return !i.MclPrice || i.MclPrice <= 0; })) {
                toastr.error('Given Quotation Amount must be greater than 0.');
            } else if ($scope.selectedRows.some(function (i) { return !i.ASFPerc || i.ASFPerc <= 0; })) {
                $("#confirmModal").modal("show");
            } else {
                $scope.SaveQuotToClient(action);
            }
        };

        $scope.SaveQuotToClient = function (action) {
            $("#confirmModal").modal("hide");
            $scope.MasterData.BriefingDate = $('#BriefingDate').val() || $scope.MasterData.BriefingDate;

            var matches = $scope.ReqType ? $scope.ReqType.match(/\b(QV|QC)\b/g) : [];
            var cleanedReqType = matches ? matches.join(', ') : '';

            $scope.loading = true;

            $http.post('/QuotationToClient/SaveQuotToClient', {
                action: action,
                MasterData: [$scope.MasterData],
                DetailData: $scope.selectedRows,
                AllTermsDtl: $scope.TermsConditionsDisplayedCollection,
                ReqType: cleanedReqType
            }).success(function (response) {
                var s = (response.status || '').trim();
                if (s === 'Successfully Submitted' || s === 'Operation Done') {
                    toastr.success(action === 'edit' ? 'Re-submitted for recommendation.' : 'Data Saved Successfully');
                    $scope.Quotation.QuotationNo = response.ClientQutnID;
                    $scope.SavedClientQutnID = response.ClientQutnID;
                    $scope.ClearEverything();
                    $scope.refreshPage();
                } else {
                    toastr.error('Error: ' + (response.ClientQutnID || response.message || s));
                }
                $scope.loading = false;
            }).error(function () {
                $scope.loading = false;
                toastr.error('Data Loading Failed.');
            });
        };

        // ── Search saved quotations ───────────────────────────────────
        function loadSaved() {
            return $http.post('/QuotationRecommendation/AllSavcdClientsQuotation', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllQuotationsList = r.AllAvailableClientsList;      // status is shown, so no filtering
                $scope.AllQuotationsCollection = [].concat($scope.AllQuotationsList);
                $scope.PagingInfo.totalItems = r.TotalItems || 0;
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        }

        $scope.SearchSaveClients = function () {
            $scope.PagingInfo.page = 1;
            $scope.ClearEverything();
            loadSaved();
            $('#QuotationForRecom').modal('show');
        };
        $scope.selectSavePageList = function () { loadSaved(); };

        // ── Clear everything ──────────────────────────────────────────
        $scope.ClearEverything = function () {
            $scope.showTermsItem = false;
            $scope.ReqType = '';
            $scope.pagefunction = '';
            $scope.clientReqTermArray = [];
            $scope.ClientReq = { TermsID: "", FormName: "" };
            $scope.resetClientReqTerm();
            $scope.Client = {
                ClientName: "", ClientRequisitionNo: "", ClientReqID: "", ClientRequisitionDate: "",
                ContactPerson: "", ContactNumber: "", ContactTIN: "", ContactBIN: "", ContactAddress: ""
            };
            $scope.MasterData = { ClientID: "", ClientReqID: "", BriefingDate: "", QuotationNote: "", QuotationDate: "" };
            $scope.ClientDetails = [];
            $scope.GetClientReqDetails = [];
            $scope.GetClientReqDetailsCollection = [];
            $scope.TermsConditionsList = [];
            $scope.TermsConditionsDisplayedCollection = [];
            $scope.AllAvailableClientsList = [];
            $scope.AllAvailableClientstCollection = [];
            $scope.selectedRows = [];
            $scope.Quotation = { QuotationNo: "" };
            $scope.SavedClientQutnID = '';
            $scope.BackInfo = null;
            $scope.ActionLog = [];
        };


        $scope.formatDate = function (dateStr) {
            if (!dateStr) return '';
            var d;
            if (typeof dateStr === 'string' && dateStr.startsWith('/Date(')) {
                d = new Date(parseInt(dateStr.match(/\d+/)[0], 10));
            } else {
                d = new Date(dateStr);
            }
            if (isNaN(d.getTime())) return '';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var year = d.getFullYear();
            return day + '/' + month + '/' + year;
        };

    });
</script>
