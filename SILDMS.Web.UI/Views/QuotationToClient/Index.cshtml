                            <input id="BriefingDate" name="BriefingDate" readonly type="datetime"
                                   class="DatePicker form-control" placeholder="DD/MM/YYYY"
                                   ng-model="MasterData.BriefingDate" style="height: 25px; background-color:#ffffff;" />
                        </div>
                        <!-- viewmode: plain text -->
