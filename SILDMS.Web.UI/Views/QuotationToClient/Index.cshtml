<script type="text/javascript">
    app.controller('WorkOrderInfoCntrl', function ($scope, $http) {
        $scope.clientReqTermArray = [];
        $scope.PagingInfo = {
            page: 1, itemsPerPage: 100,
            sortBy: null, reverse: false,
            search: null, totalItems: 0
        };

        $scope.ClientReq = { TermsID: "", FormName: "" };
        $scope.ClientReqTerm = { ClientReqTermsID: "", ClientReqID: "", TermsID: "", TermsCode: "", TermsName: "" };
        $scope.Client = {
            ClientName: "", ClientRequisitionNo: "", ClientReqID: "",
            ClientRequisitionDate: "", ContactPerson: "", ContactNumber: "",
            ContactTIN: "", ContactBIN: "", ContactAddress: ""
        };
        $scope.MasterData = {
            ClientID: "", ClientReqID: "", ClientReqNo: "",
            BriefingDate: "", QuotationNote: "", QuotationNo: "", QuotationDate: ""
        };
        $scope.Quotation = { QuotationNo: "" };
        $scope.pagefunction = '';
        $scope.ReqType = '';
        $scope.SavedClientQutnID = '';
        $scope.showTermsItem = false;
        $scope.selectedRows = [];
        $scope.TermsConditionsList = [];
        $scope.TermsConditionsDisplayedCollection = [];

        // ── Date picker ───────────────────────────────────────────────
        $('.DatePicker').datepicker({
            format: "dd/mm/yyyy", autoclose: true
        }).on('changeDate', function (ev) {
            var val = $(this).val();
            $('.datepicker').hide();
            var s = angular.element($(this)).scope();
            s.$apply(function () { s.MasterData.BriefingDate = val; });
        });

        // Set today's date for save mode
        (function () {
            var d = new Date();
            var dd = String(d.getDate()).padStart(2, '0');
            var mm = String(d.getMonth() + 1).padStart(2, '0');
            var yyyy = d.getFullYear();
            var el = document.getElementById("QuotationDate");
            if (el) el.value = yyyy + '-' + mm + '-' + dd;
        })();

        // ── Search (new save) ─────────────────────────────────────────
        $scope.SearchAvailableClients = function () {
            $scope.ClearEverything();
            $http.post('/QuotationToClient/AllAvailableClients', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllAvailableClientsList = r.AllAvailableClientsList;
                $scope.AllAvailableClientstCollection = [].concat($scope.AllAvailableClientsList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
            $('#AvailableClients').modal('show');
        };

        $scope.selectPageList = function () {
            $http.post('/QuotationToClient/AllAvailableClients', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllAvailableClientsList = r.AllAvailableClientsList;
                $scope.AllAvailableClientstCollection = [].concat($scope.AllAvailableClientsList);
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        $scope.sortList = function (sortBy) {
            if (sortBy === $scope.PagingInfo.sortBy) {
                $scope.PagingInfo.reverse = !$scope.PagingInfo.reverse;
            } else {
                $scope.PagingInfo.sortBy = sortBy;
                $scope.PagingInfo.reverse = false;
            }
            $scope.PagingInfo.page = 1;
        };

        // ── Select a client row (save / view / edit) ──────────────────
        $scope.selectAvailableClient = function (row, action) {
            $scope.MasterData.ClientReqID = row.ClientReqID;
            $scope.MasterData.ClientID = row.ClientID;

            if (action === 'save') {
                $scope.pagefunction = 'savemode';
                $scope.ReqType = row.ReqType;
                $('#AvailableClients').modal('hide');
                $scope.loading = true;

                $http.post('/QuotationToClient/AvailableClientDetailInfo', {
                    ClientID: row.ClientID, ClientReqID: row.ClientReqID, ReqType: row.ReqType
                }).success(function (r) {
                    $scope.ClientDetails = r.ClientDetails;
                    var d = r.ClientDetails[0];
                    $scope.Client = {
                        ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo,
                        ClientReqID: d.ClientReqID, ClientRequisitionDate: d.RequisitionDate,
                        ContactPerson: d.ContactPerson, ContactNumber: d.ContactNumber,
                        ContactTIN: d.ClientTinNo, ContactBIN: d.ClientBinNo, ContactAddress: d.Address
                    };
                    $scope.MasterData.QuotationNote = d.Remarks;
                    $scope.GetClientReqDataInfo(d.ClientID, d.ClientReqID, null, action);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });

            } else if (action === 'view' || action === 'edit') {
                $scope.ReqType = row.ReqType;
                $scope.pagefunction = (action === 'view') ? 'viewmode' : 'editmode';
                $('#QuotationForRecom').modal('hide');
                $scope.loading = true;

                $http.post('/QuotationToClient/AvailableClientDetailInfo', {
                    ClientID: row.ClientID, ClientReqID: row.ClientReqID, ReqType: $scope.ReqType
                }).success(function (r) {
                    $scope.ClientDetails = r.ClientDetails;
                    var d = r.ClientDetails[0];
                    $scope.Client = {
                        ClientName: d.ClientName, ClientRequisitionNo: d.ClientReqNo,
                        ClientReqID: d.ClientReqID, ClientRequisitionDate: d.RequisitionDate,
                        ContactPerson: d.ContactPerson, ContactNumber: d.ContactNumber,
                        ContactTIN: d.ClientTinNo, ContactBIN: d.ClientBinNo, ContactAddress: d.Address
                    };
                    $scope.GetClientReqDataInfo(d.ClientID, d.ClientReqID, row.ClientQutnID, action);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            }
        };

        // ── Load item rows ────────────────────────────────────────────
        $scope.GetClientReqDataInfo = function (ClientID, ClientReqID, ClientQutnID, action) {
            if (action === 'save') {
                $http.post('/QuotationToClient/GetClientReqDataInfo', {
                    ClientID: ClientID, ClientReqID: ClientReqID, ReqType: $scope.ReqType
                }).success(function (r) {
                    $scope.GetClientReqDetails = r.GetClientReqDetails;
                    $scope.GetClientReqDetailsCollection = [].concat($scope.GetClientReqDetails);
                    $scope.loading = false;
                    if ($scope.GetClientReqDetailsCollection.length > 0) {
                        $scope.GetTermsItemList($scope.GetClientReqDetailsCollection[0].VendorCSAprvID, ClientReqID, action);
                    }
                }).error(function () { $scope.loading = false; });

            } else if (action === 'view' || action === 'edit') {
                $scope.SavedClientQutnID = ClientQutnID;

                $http.post('/QuotationRecommendation/GetClientReqDataInfo', {
                    ClientID: ClientID, ClientReqID: ClientReqID, ClientQutnID: ClientQutnID
                }).success(function (r) {
                    $scope.GetClientReqDetails = r.GetClientReqDetails;
                    $scope.GetClientReqDetailsCollection = [].concat($scope.GetClientReqDetails);
                    $scope.loading = false;

                    if ($scope.GetClientReqDetailsCollection.length > 0) {
                        var first = $scope.GetClientReqDetailsCollection[0];
                        // Populate MasterData from DB
                        $scope.MasterData = {
                            ClientID: ClientID,
                            ClientReqID: ClientReqID,
                            ClientQuotationID: first.ClientQuotationID,
                            QuotationNo: first.QutnNo,
                            BriefingDate: first.BriefingDate,
                            QuotationDate: first.QuotationDate,
                            QuotationNote: first.Remarks
                        };
                        // Show Terms section
                        $scope.showTermsItem = true;
                        $scope.GetTermsItemList(first.ClientQuotationID, ClientReqID, action);
                    }
                }).error(function () { $scope.loading = false; });
            }
        };

        // ── initializeDefaults: called once per row via ng-init ───────
        // FIX: only set defaults in savemode; in view/edit, copy DB values into
        // the "Given*" fields so the single editable model works correctly.
        $scope.initializeDefaults = function (row) {
            if ($scope.pagefunction === 'savemode') {
                // New entry – default price from vendor, VAT = 15
                if (row._initialized) return;
                row.givenQutnPrice = parseFloat(row.QutnPrice) || 0;
                row.GivenASFPerc = parseFloat(row.ASFPerc) || 0;
                row.GivenVatPerc = 15;
                row._initialized = true;
                $scope.calculateRowFields(row);

            } else if ($scope.pagefunction === 'editmode' || $scope.pagefunction === 'viewmode') {
                // Existing entry – load from DB fields
                if (row._initialized) return;
                row.givenQutnPrice = parseFloat(row.QutnPrice) || 0;
                row.GivenASFPerc = parseFloat(row.ASFPerc) || 0;
                row.GivenVatPerc = parseFloat(row.VatPerc) || 0;
                row._initialized = true;
                // Recalculate so derived fields (TotGivenASFAmt etc.) are populated
                // but do NOT push into selectedRows again here
                $scope.recalcOnly(row);
                // For editmode, register into selectedRows once
                if ($scope.pagefunction === 'editmode') {
                    $scope.selectEntity(row, 'edit-init');
                }
            }
        };

        // recalcOnly: calculates derived fields without touching selectedRows
        $scope.recalcOnly = function (row) {
            var qty = parseFloat(($scope.pagefunction === 'savemode') ? row.ReqQnty : row.QutnQnty) || 0;
            row.givenQutnPrice = parseFloat(row.givenQutnPrice) || 0;
            var asfPerc = parseFloat(row.GivenASFPerc) || 0;
            var vatPerc = parseFloat(row.GivenVatPerc) || 0;

            row.givenQutnAmt = row.givenQutnPrice * qty;
            row.TotGivenASFAmt = row.givenQutnAmt * (asfPerc / 100);
            var basePlusASF = row.givenQutnAmt + row.TotGivenASFAmt;
            row.TotGivenVatAmt = Math.round(basePlusASF * (vatPerc / 100) * 100) / 100;
            row.givenTolAmt = parseFloat(row.givenQutnAmt + row.TotGivenASFAmt + row.TotGivenVatAmt).toFixed(2);
        };

        // calculateRowFields: called on user input (ng-change / ng-blur)
        $scope.calculateRowFields = function (row) {
            $scope.recalcOnly(row);
            // In savemode or editmode, update selectedRows
            if ($scope.pagefunction === 'savemode' || $scope.pagefunction === 'editmode') {
                $scope.selectEntity(row, 'save');
            }
        };

        // ── selectEntity ──────────────────────────────────────────────
        $scope.selectEntity = function (row, action) {
            if (action === 'save') {
                var item = {
                    VendorCSAprvID: row.VendorCSAprvID,
                    VendorCSAprvItemID: row.VendorCSAprvItemID,
                    ServiceCategoryID: row.ServiceCategoryID,
                    TermsID: row.TermsID,
                    ServiceItemID: row.ServiceItemID,
                    Description: row.Description,
                    DeliveryLocation: row.DeliveryLocation,
                    DeliveryDate: row.DeliveryDate,
                    DeliveryMode: row.DeliveryMode,
                    QutnQnty: row.ReqQnty,
                    QutnUnit: row.ReqUnit,
                    VenPrice: row.QutnPrice,
                    MclPrice: row.givenQutnPrice,
                    QutnAmt: row.givenQutnAmt,
                    ASFPerc: row.GivenASFPerc,
                    ASFAmt: row.TotGivenASFAmt,
                    VatPerc: row.GivenVatPerc,
                    VatAmt: row.TotGivenVatAmt,
                    TolAmt: row.givenTolAmt
                };

                var existing = $scope.selectedRows.find(function (i) {
                    return (row.VendorCSAprvItemID && row.VendorCSAprvItemID !== 'N/A' && i.VendorCSAprvItemID === row.VendorCSAprvItemID)
                        || i.ServiceItemID === row.ServiceItemID;
                });

                if (existing) {
                    existing.MclPrice = row.givenQutnPrice;
                    existing.QutnAmt = row.givenQutnAmt;
                    existing.ASFPerc = row.GivenASFPerc;
                    existing.ASFAmt = row.TotGivenASFAmt;
                    existing.VatPerc = row.GivenVatPerc;
                    existing.VatAmt = row.TotGivenVatAmt;
                    existing.TolAmt = row.givenTolAmt;
                } else {
                    $scope.selectedRows.push(item);
                }
                $scope.showTermsItem = $scope.selectedRows.length > 0;

            } else if (action === 'edit-init') {
                // Initial population of selectedRows for editmode (from DB values)
                var editItem = {
                    ClientQuotationID: row.ClientQuotationID,
                    ServiceCategoryID: row.ServiceCategoryID,
                    TermsID: row.TermsID,
                    ServiceItemID: row.ServiceItemID,
                    Description: row.Description,
                    DeliveryLocation: row.DeliveryLocation,
                    DeliveryDate: row.DeliveryDate,
                    DeliveryMode: row.DeliveryMode,
                    QutnQnty: row.QutnQnty,
                    QutnUnit: row.ReqUnit,
                    VenPrice: row.QutnPrice,
                    MclPrice: row.givenQutnPrice,
                    QutnAmt: row.givenQutnAmt,
                    ASFPerc: row.GivenASFPerc,
                    ASFAmt: row.TotGivenASFAmt,
                    VatPerc: row.GivenVatPerc,
                    VatAmt: row.TotGivenVatAmt,
                    TolAmt: row.givenTolAmt
                };
                var dup = $scope.selectedRows.find(function (i) {
                    return i.ServiceItemID === row.ServiceItemID;
                });
                if (!dup) $scope.selectedRows.push(editItem);
            }
        };

        // ── Vendor detail popup ───────────────────────────────────────
        $scope.detailVendorCS = function (row) {
            $http.post('/QuotationToClient/GetClientReqDataItemPopup', {
                VendorCSAprvID: row.VendorCSAprvID, ServiceItemID: row.ServiceItemID
            }).success(function (r) {
                $scope.GetClientReqDataItemPopup = r.GetClientReqDataItemPopup;
                $scope.GetClientReqDataItemPopupCollection = [].concat($scope.GetClientReqDataItemPopup);
                $('#detailVendorCSModal').modal('show');
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        // ── Terms item list ───────────────────────────────────────────
        $scope.GetTermsItemList = function (TempID, ClientReqID, action) {
            if (action === 'save') {
                $http.post('/QuotationToClient/GetVendorTermList',
                    { VendorCSAprvID: TempID, ClientReqID: ClientReqID, ReqType: $scope.ReqType })
                    .success(function (r) {
                        $scope.TermsConditionsList = r.VendorTermTermList;
                        $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                        $scope.loading = false;
                    }).error(function () { });

            } else if (action === 'view' || action === 'edit') {
                $http.post('/QuotationRecommendation/GetVendorTermList',
                    { ClientQuotationID: TempID, ClientReqID: ClientReqID, ReqType: $scope.ReqType })
                    .success(function (r) {
                        $scope.TermsConditionsList = r.VendorTermTermList;
                        $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                        $scope.loading = false;
                    }).error(function () { });
            }
        };

        // ── Validation ────────────────────────────────────────────────
        $scope.validateInput = function (field, row) {
            var re = /^[0-9]*\.?[0-9]*$/;
            if (!re.test(row[field]) || row[field] === '') row[field] = 0;
            $scope.calculateRowFields(row);
        };

        $scope.validateInput0 = function (field, row) {
            if (field === 'givenQutnPrice' && (row.givenQutnPrice <= 0 || !row.givenQutnPrice)) {
                toastr.error("Given Quotation Price must be greater than 0.");
                row.givenQutnPrice = null;
            }
        };

        // ── Confirm & Save ────────────────────────────────────────────
        $scope.openConfirmModal = function (action) {
            if (!$scope.MasterData.BriefingDate || $scope.MasterData.BriefingDate.trim() === '') {
                toastr.error('Please enter a Briefing Date');
            } else if ($scope.selectedRows.some(function (i) { return !i.MclPrice || i.MclPrice <= 0; })) {
                toastr.error('Given Quotation Amount must be greater than 0.');
            } else {
                $scope.SaveQuotToClient(action);
            }
        };

        $scope.SaveQuotToClient = function (action) {
            $scope.MasterData.BriefingDate = $('#BriefingDate').val();

            var matches = $scope.ReqType ? $scope.ReqType.match(/\b(QV|QC)\b/g) : [];
            var cleanedReqType = matches ? matches.join(', ') : '';

            $http.post('/QuotationToClient/SaveQuotToClient', {
                action: action,
                MasterData: [$scope.MasterData],
                DetailData: $scope.selectedRows,
                AllTermsDtl: $scope.TermsConditionsDisplayedCollection,
                ReqType: cleanedReqType
            })
                .success(function (response) {
                    var s = (response.status || '').trim();

                    if (s === 'Successfully Submitted' || s === 'Operation Done') {
                        toastr.success('Data Saved Successfully');

                        // For save: show the new ID.  For edit: show the existing ID.
                        $scope.Quotation.QuotationNo = response.ClientQutnID;
                        $scope.SavedClientQutnID = response.ClientQutnID;

                        $scope.refreshPage();
                    } else {
                        // Surface the actual SP error message so it's visible in the toast
                        toastr.error('Error: ' + (response.ClientQutnID || s));
                    }
                    $scope.loading = false;
                })
                .error(function () {
                    $scope.loading = false;
                    toastr.error('Data Loading Failed.');
                });
        };

        // ── Search saved quotations ───────────────────────────────────
        $scope.SearchSaveClients = function () {
            $scope.ClearEverything();
            $http.post('/QuotationRecommendation/AllSavcdClientsQuotation', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllQuotationsList = r.AllAvailableClientsList;
                $scope.AllQuotationsCollection = $scope.AllQuotationsList.filter(function (i) {
                    return i.ProcessStatus == null || i.ProcessStatus === '';
                });
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
            $('#QuotationForRecom').modal('show');
        };

        $scope.selectSavePageList = function () {
            $http.post('/QuotationRecommendation/AllAvailableClients', {
                page: $scope.PagingInfo.page, itemsPerPage: $scope.PagingInfo.itemsPerPage,
                sortBy: $scope.PagingInfo.sortBy, reverse: $scope.PagingInfo.reverse,
                search: $scope.PagingInfo.search, type: "isBack"
            }).success(function (r) {
                $scope.AllQuotationsList = r.AllAvailableClientsList;
                $scope.AllQuotationsCollection = $scope.AllQuotationsList.filter(function (i) {
                    return i.ProcessStatus == null || i.ProcessStatus === '';
                });
                $scope.loading = false;
            }).error(function () { $scope.loading = false; });
        };

        // ── Terms & Conditions helpers ────────────────────────────────
        $scope.ShowTermsConditionsList = function () {
            $http.get("/ClientRequisition/GetTermsConditionsList")
                .success(function (r) {
                    $scope.TermsConditionsList = r.termsConditionsList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { });
            $('#ClientReqTermsConditionsModal').modal('show');
        };

        $scope.toggleTermsConditionsSelect = function (row) {
            $scope.ClientReq.TermsID = row.TermsID;
            $scope.ClientReq.FormName = row.FormName;
            $http.post('/ClientRequisition/GetClientReqTermAgainstFormList', { TermsID: row.TermsID })
                .success(function (r) {
                    $scope.TermsConditionsList = r.ClientReqTermList;
                    $scope.TermsConditionsDisplayedCollection = [].concat($scope.TermsConditionsList);
                    $scope.loading = false;
                }).error(function () { $scope.loading = false; });
            $('#ClientReqTermsConditionsModal').modal('hide');
        };

        $scope.AddReqTermModal = function () { $('#RequisitionTermModal').modal('show'); };

        $scope.AddReqTerm = function () {
            if (!$('#TermsCode').val()) { toastr.error("Terms Code is required."); return; }
            if (!$('#TermsName').val()) { toastr.error("Terms Name is required."); return; }
            var newTerm = { TermsCode: $('#TermsCode').val(), TermsName: $('#TermsName').val() };
            $scope.clientReqTermArray.push(newTerm);
            $scope.TermsConditionsDisplayedCollection = $scope.TermsConditionsDisplayedCollection.concat(newTerm);
            $scope.resetClientReqTerm();
            $("#btnAddReqTerm").html('Add');
            $('#RequisitionTermModal').modal('hide');
        };

        $scope.resetClientReqTerm = function () {
            $scope.ClientReqTerm = { ClientReqTermsID: "", ClientReqID: "", TermsID: "", TermsCode: "", TermsName: "" };
        };

        $scope.toggleReqTermEdit = function (tableRow, index) {
            $('#RequisitionTermModal').modal('show');
            $scope.resetClientReqTerm();
            $scope.ClientReqTerm = angular.copy(tableRow);
            $scope.TermsConditionsDisplayedCollection.splice(index, 1);
            $scope.clientReqTermArray.splice(index, 1);
            $("#btnAddReqTerm").html('Update');
        };

        $scope.toggleReqTermDelete = function (tableRow, index) {
            if (!tableRow.ClientReqTermID) {
                $scope.resetClientReqTerm();
                $scope.TermsConditionsDisplayedCollection.splice(index, 1);
                $scope.clientReqTermArray.splice(index, 1);
                toastr.success('Data deleted successfully.');
            } else {
                $scope.resetClientReqTerm();
                $scope.ClientReqTerm = angular.copy(tableRow);
                $('#deleteReqTermModal').modal('show');
            }
        };

        // ── Clear everything ──────────────────────────────────────────
        $scope.ClearEverything = function () {
            $scope.showTermsItem = false;
            $scope.ReqType = '';
            $scope.pagefunction = '';
            $scope.clientReqTermArray = [];
            $scope.ClientReq = { TermsID: "", FormName: "" };
            $scope.ClientReqTerm = { ClientReqTermsID: "", ClientReqID: "", TermsID: "", TermsCode: "", TermsName: "" };
            $scope.Client = {
                ClientName: "", ClientRequisitionNo: "", ClientReqID: "",
                ClientRequisitionDate: "", ContactPerson: "", ContactNumber: "",
                ContactTIN: "", ContactBIN: "", ContactAddress: ""
            };
            $scope.MasterData = { ClientID: "", ClientReqID: "", BriefingDate: "", QuotationNote: "", QuotationDate: "" };
            $scope.ClientDetails = [];
            $scope.GetClientReqDetails = [];
            $scope.GetClientReqDetailsCollection = [];
            $scope.TermsConditionsList = [];
            $scope.TermsConditionsDisplayedCollection = [];
            $scope.AllAvailableClientsList = [];
            $scope.AllAvailableClientstCollection = [];
            $scope.selectedRows = [];
            $scope.Quotation = { QuotationNo: "" };
            $scope.SavedClientQutnID = '';
        };

        // ── Misc ──────────────────────────────────────────────────────
        $scope.toggleRefreshTable = function () { window.location.reload(); };
        $scope.refreshPage = function () { setTimeout(function () { window.location.reload(); }, 2000); };

        $scope.ViewDocument = function () {
            $scope.loading = true;
            var ftpDetails = {
                serverIP: "172.16.189.34", ftpPort: "21",
                ftpUserName: "ftpuser", ftpPassword: "Ftp@Cbps#2k25",
                serverUrl: "MCL/Client_Requisition",
                documentID: "CR_" + $scope.ClientDetails[0].ClientReqID, ext: "pdf"
            };
            var url = "/ClientRequisition/ViewDocument?" +
                "serverIP=" + encodeURIComponent(ftpDetails.serverIP) +
                "&ftpPort=" + encodeURIComponent(ftpDetails.ftpPort) +
                "&ftpUserName=" + encodeURIComponent(ftpDetails.ftpUserName) +
                "&ftpPassword=" + encodeURIComponent(ftpDetails.ftpPassword) +
                "&serverUrl=" + encodeURIComponent(ftpDetails.serverUrl) +
                "&DocID=" + encodeURIComponent(ftpDetails.documentID) +
                "&ext=" + encodeURIComponent(ftpDetails.ext);

            $http.get(url, { responseType: 'arraybuffer' })
                .then(function (r) {
                    var blob = new Blob([r.data], { type: 'application/pdf' });
                    var fileURL = URL.createObjectURL(blob);
                    $("#pdfViewer").attr("src", fileURL + "#view=Fit");
                    $('#ShowPDFModal').modal('show');
                })
                .catch(function (e) { toastr.error("Failed to load the PDF."); console.error(e); })
                .finally(function () { $scope.loading = false; });
        };
    });
</script>
