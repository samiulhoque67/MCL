                                    <button type="button"
                                            ng-click="selectAvailableClient(row, 'edit')"
                                            ng-hide="row.ProcessStatus === 'Done'"
                                            class="btn btn-flat btn-warning btn-xs"
                                            style="margin-left: 5px;">
                                        <span class="fa fa-edit"> Edit</span>
