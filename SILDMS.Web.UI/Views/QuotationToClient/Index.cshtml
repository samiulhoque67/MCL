                            <tr style="background-color: #82b0c9; color: #010823; font-size: 11px;">
                                <th data-ng-click="sortList('ClientCode')">Client Code</th>
                                <th data-ng-click="sortList('ClientName')">Client Name</th>
                                <th data-ng-click="sortList('ClientReqNo')">Requisition No</th>
