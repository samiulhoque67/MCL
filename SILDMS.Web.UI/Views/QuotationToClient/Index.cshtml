                        <div class="row" style="position:relative;top:5px;">
                            <div class="col-sm-1"></div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="TermsName">Terms and Conditions:</label>
                                    <label style="font-size:larger;color:red;">*</label>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                <input id="TermsName" name="TermsName" type="text" class="form-control"
                                       placeholder="Terms Name" autocomplete="off"
                                       ng-model="ClientReqTerm.TermsName"
                                       style="height: 25px; background-color:#ffffff; font-size: smaller" />
