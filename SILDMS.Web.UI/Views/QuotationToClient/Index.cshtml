                                <button type="button" class="btn btn-xs btn-primary btn-flat"
                                        ng-click="toggleReqTermEdit(row,$index)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-xs btn-primary btn-flat btnDelete"
                                        ng-click="toggleReqTermDelete(row,$index)">
