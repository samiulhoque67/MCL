                            <tr>
                                <th><input st-search="ClientCode" placeholder="Search Client Code" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientName" placeholder="Search Client Name" class="input-sm form-control" type="search" /></th>
                                <th><input st-search="ClientReqNo" placeholder="Search Req No" class="input-sm form-control" type="search" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in AllQuotationsList | orderBy:'IsBack':true">
                                <td class="text-center">{{row.ClientCode}}</td>
